# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# Worker RUNTIME secrets for `wrangler dev` (SANITY_TOKEN for the live preview).
# Real values only; .dev.vars.example is the committed template.
.dev.vars

# wrangler local cache (Cloudflare adapter)
.wrangler/

# generated artifacts
tmp/
# `sanity schema extract --force` writes this at the repo root now that the
# nested studio/ package is gone (2026-08-28). It is an intermediate for
# `sanity typegen generate`; the generated src/lib/sanity.types.ts IS committed.
schema.json
# A standalone Studio bundle, only if someone runs `npx sanity build .studio-dist`.
# The real Studio is built by `astro build` and served at /studio.
.studio-dist/
# scripts/lib/sanity-lib.mjs caches uploaded Sanity asset ids here so a re-run
# of a seed script never re-uploads. Machine-local, never committed.
scripts/.asset-map.json

# transient commit message files
.git-commit-msg.tmp

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Playwright
test-results/
playwright-report/
