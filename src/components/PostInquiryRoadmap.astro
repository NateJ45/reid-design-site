---
// Safe to edit by hand
// "What happens next" on the contact page: the postInquiryRoadmap array from
// the contactPage singleton, as a short real sequence.
//
// Rebuilt 2026-09-30 (phase 2 of the art-direction rebuild; DESIGN.md
// "Contact and Privacy"). A paper band: eyebrow line + headline on the left,
// the steps hung from one thread like samples pinned along a board. Each step
// has a pin, a title, the body, and its time estimate on a small linen tag.
// No 01/02 numerals (2026-09-30, the no-decorative-numbering rule in
// DESIGN.md): the thread and the <ol> carry the order.
// Desktop: steps side by side along a horizontal thread. Phones: a vertical
// thread down the left edge.
//
// Fallback behaviour is unchanged: when the roadmap array is empty this
// renders nothing and contact.astro falls back to whatToExpectContent. The two
// never render together (contact.astro does the branching).

interface Step {
  title?: string;
  body?: string;
  timeEstimate?: string;
}

interface Props {
  steps?: Step[] | null;
  /** Optional small line above the headline. Defaults to "After you reach out". */
  eyebrow?: string;
  /** Optional heading. Defaults to "Here's what happens next." */
  headline?: string;
}

const {
  steps,
  eyebrow = 'After you reach out',
  headline = 'Here’s what happens next.',
} = Astro.props as Props;

// Skip steps without a title so a half-filled list never shows empty stops.
const validSteps = (steps ?? []).filter((s) => s?.title?.trim());

if (validSteps.length === 0) return null;
---

<section aria-labelledby="roadmap-heading" class="road">
  <div class="r-wrap road__grid">
    <div class="road__head">
      {eyebrow && <p class="road__eyebrow">{eyebrow}</p>}
      <h2 id="roadmap-heading" class="r-h2 road__h">{headline}</h2>
    </div>

    <ol class="road__steps" role="list" style={`--steps:${validSteps.length}`}>
      {
        validSteps.map((step) => (
          <li class="road__step">
            <span class="road__pin" aria-hidden="true" />
            <h3 class="road__title">{step.title}</h3>
            {step.body && <p class="road__body">{step.body}</p>}
            {step.timeEstimate && (
              <p class="road__time">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <circle cx="8" cy="8" r="6.25" />
                  <path d="M8 4.75V8l2.25 1.5" />
                </svg>
                {step.timeEstimate}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .road {
    background: var(--color-paper);
    border-block: 1px solid var(--color-rule);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .road__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .road__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    font: 500 0.95rem/1.35 var(--font-body);
    color: var(--color-chip-7);
  }
  .road__eyebrow::before {
    content: '';
    flex: none;
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .road__h {
    margin: 0;
    max-width: 16ch;
    color: var(--color-ink);
  }

  .road__steps {
    position: relative;
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0 0 0 2.25rem;
    list-style: none;
  }
  /* The thread. Phones: down the left edge, through every pin. */
  .road__steps::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--color-chip-4);
  }
  .road__step {
    position: relative;
    min-width: 0;
  }
  .road__pin {
    position: absolute;
    left: -2.25rem;
    top: 0.25rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--color-chip-5);
    box-shadow:
      0 0 0 4px var(--color-paper),
      0 3px 6px rgb(35 30 27 / 0.25);
  }
  .road__title {
    margin: 0;
    font: 400 var(--text-h3) / 1.1 var(--font-display);
    font-size: clamp(1.35rem, 1.15rem + 0.6vw, 1.7rem);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .road__body {
    margin: 0.65rem 0 0;
    max-width: 34ch;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .road__time {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--color-chip-1);
    font: 500 0.85rem/1.2 var(--font-body);
    color: var(--color-ink);
  }
  .road__time svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /* Desktop: steps side by side along a horizontal thread under the head. */
  @media (min-width: 1024px) {
    .road__steps {
      grid-template-columns: repeat(var(--steps, 4), minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
      padding: 2.5rem 0 0;
    }
    .road__steps::before {
      left: 0;
      right: 0;
      top: 0.45rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .road__pin {
      left: 0;
      top: -2.5rem;
    }
  }
</style>
