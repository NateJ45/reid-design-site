---
// About "story" section, extracted verbatim from about.astro so the marker-based
// page builder can render it in any order. Content still comes from the aboutPage
// fields (passed in), so nothing migrated. Keeps its original bg-background
// surface so the default order is pixel-identical. Safe to edit by hand.
import SectionHeading from '@/components/SectionHeading.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';

interface Props {
  eyebrow?: string;
  headline?: string;
  content?: any;
  photo?: any;
  attribution?: string;
  backgroundLine?: string;
  serviceAreaMention?: string;
  headingId?: string;
}

const {
  eyebrow = 'My Story.',
  headline = 'Why I Started Reid Design.',
  content,
  photo,
  attribution,
  backgroundLine,
  serviceAreaMention,
  headingId = 'about-story-heading',
} = Astro.props as Props;
---

<section class="bg-background" aria-labelledby={headingId}>
  <div
    class="mx-auto grid max-w-content grid-cols-1 items-start gap-l px-m py-section-lg md:grid-cols-[1fr_1.2fr] md:gap-section-md"
  >
    <div class="md:sticky md:top-section-lg">
      {
        photo?.asset ? (
          <SanityImage
            source={photo}
            width={900}
            sizes="(min-width: 768px) 40vw, 100vw"
            quality={75}
            class="h-auto w-full rounded-md"
          />
        ) : (
          <div class="aspect-[4/5] rounded-md bg-muted" aria-hidden="true" />
        )
      }
      {
        attribution && (
          <p class="mt-s text-xs tracking-widest text-foreground/80 uppercase">{attribution}</p>
        )
      }
    </div>

    <div>
      <SectionHeading eyebrow={eyebrow} headline={headline} headingId={headingId} />

      {
        content && (
          <PortableText
            value={content}
            className="mt-l text-foreground/85 text-lg leading-relaxed"
          />
        )
      }

      {
        (backgroundLine || serviceAreaMention) && (
          <div class="mt-section-md space-y-m border-t border-border-soft pt-l text-foreground/80">
            {backgroundLine && (
              <p>
                <span class="mb-xs block text-xs tracking-widest text-foreground/80 uppercase">
                  Background
                </span>
                {backgroundLine}
              </p>
            )}
            {serviceAreaMention && (
              <p>
                <span class="mb-xs block text-xs tracking-widest text-foreground/80 uppercase">
                  Service area
                </span>
                {serviceAreaMention}
              </p>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
