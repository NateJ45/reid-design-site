---
// Safe to edit by hand
// Page-builder block: one photo beside words (rebuilt 2026-09-30, phase 2 of
// the art-direction rebuild; see DESIGN.md "Blocks and Portfolio"). The same
// grammar as the home page's "Meet Staci": a framed crop, a sample tag tied to
// its corner, the heading big in Zodiak beside it.
//
// The crop is honest to the photo: a portrait photo is framed 4:5 and a
// landscape one 5:4, so a phone shot is never stretched into a shape it was not
// taken in. The Sanity hotspot decides what stays in frame.
//
// The sample tag carries the eyebrow (small line) and the image's alt text
// (the note), when either is set. The eyebrow is not printed above the heading:
// the rebuild drops that grammar (DESIGN.md "Type").
//
// No photo yet: a blank paint chip holds the space, so the section still reads
// as deliberate while Staci finds the picture.
//
// LOAD-BEARING STRINGS (src/lib/section-fields.test.ts reads this file): the two
// `md:order-*` ternaries must stay exactly as written. The tag's overhang keys
// off those same classes, so the Studio's live side swap looks right too.
//
// Surface (background / muted) comes from SectionRenderer.
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import CtaLink from '@/components/CtaLink.astro';
import { parseSanityAssetDimensions } from '@/lib/sanity';

interface Props {
  image?: any;
  imageSide?: 'left' | 'right';
  eyebrow?: string;
  heading?: string;
  body?: any;
  cta?: any;
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  image,
  imageSide = 'left',
  eyebrow,
  heading,
  body,
  cta,
  surface = 'background',
  headingId,
} = Astro.props as Props;

const imageFirst = imageSide === 'left';
const dims = image?.asset ? parseSanityAssetDimensions(image) : null;
const landscape = dims ? dims.width > dims.height : false;
const crop = landscape ? { width: 1200, height: 960 } : { width: 900, height: 1125 };
const note: string | undefined = image?.alt || undefined;
---

<section
  class:list={['imt', surface === 'muted' ? 'imt--paper' : 'imt--linen']}
  aria-labelledby={heading ? headingId : undefined}
>
  <div class="r-wrap imt__row">
    <figure
      class:list={[
        'imt__media',
        'r-frame',
        landscape ? 'imt__media--wide' : 'imt__media--tall',
        imageFirst ? 'md:order-1' : 'md:order-2',
      ]}
    >
      {
        image?.asset ? (
          <div class="imt__frame">
            <SanityImage
              source={image}
              width={crop.width}
              height={crop.height}
              sizes="(min-width: 768px) 44vw, 100vw"
              quality={75}
              class="imt__img"
            />
          </div>
        ) : (
          <div class="imt__swatch" aria-hidden="true" />
        )
      }
      {
        (eyebrow || note) && (
          <figcaption class="r-tag imt__tag">
            {eyebrow && <small>{eyebrow}</small>}
            {note && <strong>{note}</strong>}
          </figcaption>
        )
      }
    </figure>

    <div class:list={['imt__copy', imageFirst ? 'md:order-2' : 'md:order-1']}>
      {
        heading && (
          <h2 id={headingId} class="imt__h">
            {heading}
          </h2>
        )
      }
      {body && <PortableText value={body} className="imt__body" />}
      {
        cta?.label && (
          <div class="imt__cta">
            <CtaLink cta={cta} variant="secondary" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .imt {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .imt--linen {
    background: var(--color-bg);
  }
  .imt--paper {
    background: var(--color-paper);
  }
  .imt__row {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }
  .imt__media {
    position: relative;
    margin: 0;
    max-width: 34rem;
  }
  /* The figure hangs in the house frame (.r-frame: paper mat, bronze
     keyline, soft shadow; 2026-09-30 design pass); this inner box clips the
     photo's settle zoom to the picture, inside the mat. */
  .imt__frame {
    overflow: clip;
  }
  .imt__frame :global(.imt__img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .imt__media--tall :global(.imt__img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .imt__media--wide :global(.imt__img) {
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }
  /* No photo: a blank paint chip with its punched hole. */
  .imt__swatch {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-chip-2);
  }
  .imt__swatch::before {
    content: '';
    position: absolute;
    top: 1rem;
    left: 50%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    translate: -50% 0;
    background: var(--color-bg);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.2);
  }
  .imt__tag {
    position: absolute;
    right: 1rem;
    bottom: 1.25rem;
    max-width: min(17rem, calc(100% - 2rem));
  }
  .imt__tag strong {
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .imt__h {
    margin: 0;
    max-width: 16ch;
    font: 300 clamp(2.1rem, 1.25rem + 2.6vw, 3.75rem) / 1.02 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .imt__copy :global(.imt__body) {
    max-width: 46ch;
    margin-top: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .imt__copy :global(.imt__body p) {
    color: inherit;
  }
  .imt__copy :global(.imt__body > :first-child) {
    margin-top: 0;
  }
  .imt__copy :global(.imt__body > :last-child) {
    margin-bottom: 0;
  }
  .imt__cta {
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .imt__row {
      flex-direction: row;
      align-items: center;
      gap: clamp(2.5rem, 7vw, 7rem);
    }
    .imt__media {
      flex: 0 0 44%;
      max-width: none;
    }
    .imt__copy {
      flex: 1 1 0;
      min-width: 0;
    }
    /* The tag hangs off the corner that faces the words. */
    .imt__media[class~='md:order-1'] .imt__tag {
      right: -1.5rem;
    }
    .imt__media[class~='md:order-2'] .imt__tag {
      right: auto;
      left: -1.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .imt__frame :global(.imt__img) {
        animation: imt-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes imt-settle {
    from {
      scale: 1.1;
    }
  }
</style>
