---
// Safe to edit by hand
// Page-builder block: "As featured in" (2026-10-18). The newest entries from
// the Press list (pressMention documents, src/lib/queries.ts getPressMentions)
// set as the site's sample tags, the outlet's name in Zodiak and the month
// small above it, the whole tag a link when the piece is online. The newest
// mention that carries a line about the studio sits beside them as a pull
// quote. Fills itself, so it renders NOTHING while the list is empty, and a
// mention added once shows on every page that has this section.
//
// Surface: its own linen band, like the hero, so SectionRenderer's cadence
// treats it as a self-surfaced row (it is not in CONTENT_TYPES). Logos are
// deliberately not drawn: a row of mismatched logo files never looks like the
// rest of the site, and the outlet's name in the site's type always does.
import SectionHeading from '@/components/SectionHeading.astro';

interface Mention {
  _id: string;
  outlet?: string;
  title?: string;
  date?: string;
  url?: string;
  quote?: string;
}

interface Props {
  mentions?: Mention[];
  heading?: string;
  headingId: string;
}

const { mentions = [], heading, headingId } = Astro.props as Props;
const list = mentions.filter((m) => m?.outlet);

const month = (d?: string) =>
  d && /^\d{4}-\d{2}-\d{2}$/.test(d)
    ? new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(
        new Date(`${d}T12:00:00`),
      )
    : '';

const lead = list.find((m) => m.quote && m.quote.trim());
// Only https links become links: a typed address that is not one stays a tag.
const href = (u?: string) => (u && /^https:\/\//.test(u) ? u : undefined);
---

{list.length > 0 && (
  <section class="press" aria-labelledby={headingId}>
    <div class="r-wrap press__inner">
      <div class="press__head">
        <SectionHeading headline={heading || 'As featured in'} headingId={headingId} />
      </div>
      <div class:list={['press__body', lead && 'press__body--quote']}>
        <ul class="press__tags" role="list">
          {list.map((m) => {
            const link = href(m.url);
            const inner = (
              <>
                {month(m.date) && <small>{month(m.date)}</small>}
                <strong>{m.outlet}</strong>
              </>
            );
            return (
              <li>
                {link ? (
                  <a
                    class="r-tag press__tag"
                    href={link}
                    target="_blank"
                    rel="noopener"
                    title={m.title || undefined}
                  >
                    {inner}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <span class="r-tag press__tag">{inner}</span>
                )}
              </li>
            );
          })}
        </ul>
        {lead && (
          <figure class="press__quote">
            <blockquote>
              <p>{lead.quote}</p>
            </blockquote>
            <figcaption>
              {lead.outlet}
              {month(lead.date) && <span>, {month(lead.date)}</span>}
            </figcaption>
          </figure>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .press {
    background: var(--color-bg);
    color: var(--color-ink);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .press__head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .press__body {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 900px) {
    .press__body--quote {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .press__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .press__tag {
    max-width: 100%;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a.press__tag {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  a.press__tag:hover {
    transform: rotate(-1.5deg);
  }
  a.press__tag:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    a.press__tag {
      transition: none;
    }
    a.press__tag:hover {
      transform: none;
    }
  }
  .press__quote {
    margin: 0;
    border-left: 2px solid var(--color-chip-5);
    padding-left: clamp(1rem, 3vw, 1.75rem);
  }
  .press__quote blockquote {
    margin: 0;
  }
  .press__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.3;
    text-wrap: pretty;
  }
  .press__quote figcaption {
    margin-top: 1rem;
    font: 500 0.9rem/1.4 var(--font-body);
    color: var(--color-ink-2);
  }
</style>
