---
// Services "tier list" section, extracted verbatim from services.astro for the
// marker-based page builder. The on-page TOC chips link to the builders +
// service-area sections; pass their presence in so the chips only show when
// those sections exist. Keeps surface-warm bg-background. Safe to edit by hand.
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  services?: any[];
  hasBuilders?: boolean;
  hasServiceArea?: boolean;
  visibleEDesign?: boolean;
}

const {
  eyebrow = 'The Tiers.',
  headline = 'Find the right fit for your project.',
  subhead,
  services = [],
  hasBuilders = false,
  hasServiceArea = false,
  visibleEDesign = false,
} = Astro.props as Props;
---

<section class="surface-warm bg-background" aria-labelledby="services-list-heading">
  <div class="mx-auto max-w-content px-m py-section-lg">
    <SectionHeading
      eyebrow={eyebrow}
      headline={headline}
      subhead={subhead}
      headingId="services-list-heading"
      align="center"
      class="mx-auto"
    />

    {
      services.length >= 3 && (
        <nav class="mt-m flex flex-col items-center gap-s" aria-label="On this page">
          <p class="text-xs tracking-eyebrow text-foreground/80 uppercase">On this page</p>
          <ul class="flex list-none flex-wrap justify-center gap-xs p-0">
            {services.map((service: any) =>
              service.slug?.current ? (
                <li>
                  <a
                    href={`#${service.slug.current}`}
                    class="press-tactile inline-flex min-h-[36px] items-center rounded-full border border-border-soft px-s py-1.5 text-xs tracking-eyebrow text-foreground/85 uppercase transition-colors hover:border-primary hover:text-link"
                  >
                    {service.name}
                  </a>
                </li>
              ) : null,
            )}
            {hasBuilders && (
              <li>
                <a
                  href="#builders"
                  class="press-tactile inline-flex min-h-[36px] items-center rounded-full border border-border-soft px-s py-1.5 text-xs tracking-eyebrow text-foreground/85 uppercase transition-colors hover:border-primary hover:text-link"
                >
                  Builders &amp; Realtors
                </a>
              </li>
            )}
            {hasServiceArea && (
              <li>
                <a
                  href="#service-area"
                  class="press-tactile inline-flex min-h-[36px] items-center rounded-full border border-border-soft px-s py-1.5 text-xs tracking-eyebrow text-foreground/85 uppercase transition-colors hover:border-primary hover:text-link"
                >
                  Service area
                </a>
              </li>
            )}
          </ul>
        </nav>
      )
    }

    {
      services.length > 0 ? (
        <div
          class="mt-section-lg grid grid-cols-1 gap-l md:grid-cols-2 lg:grid-cols-3"
          data-stagger-grid
        >
          {services.map((service: any) => (
            <ServiceCard service={service} withAnchor={true} />
          ))}
        </div>
      ) : null
    }

    {
      visibleEDesign && services.some((s: any) => s.slug?.current === 'e-design') && (
        <div class="mt-section-md flex justify-center">
          <a
            href="/e-design"
            class="press-tactile inline-flex min-h-[36px] items-center gap-xs rounded-full border border-border-soft px-m py-1.5 text-xs tracking-eyebrow text-link uppercase transition-colors hover:border-primary hover:text-primary-dark"
          >
            See the full E-Design overview <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }

    {
      services.length === 0 && (
        <p class="mt-section-lg text-center text-muted-foreground italic">
          Services are being updated.{' '}
          <a href="/contact" class="text-link underline underline-offset-2">
            Get in touch
          </a>{' '}
          and we'll talk through what you need.
        </p>
      )
    }
  </div>
</section>
