---
// Safe to edit by hand
// Services page price list (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; see DESIGN.md "Services and E-Design").
//
// Two parts on the paper ground (the same ground as the home services band):
//
//   1. The DECK INDEX: the back page of a fan deck. Every service with a
//      swatch of its tone, its name, a dotted leader and its price, so the
//      whole price list reads at a glance before anyone scrolls. Each line
//      jumps to its service. Builders and service area follow as plain links
//      when those sections exist.
//   2. The STRIP: one ServiceCard per service, stacked so the chips touch and
//      form a single paint strip down the left, palest to deepest.
//
// Data and props are unchanged (servicesPage.servicesList* fields plus the
// service collection in Staci's order). `eyebrow` is accepted but not printed,
// the same as SectionHeading.
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { chipPrice, toneFor } from '@/components/services/tones';
// Google reviews insertion (2026-09-30): the rating tag under the price index.
import RatingTag from '@/components/reviews/RatingTag.astro';
import { googleRatingFrom, type GoogleRatingSettings } from '@/lib/reviews';

interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  services?: any[];
  hasBuilders?: boolean;
  hasServiceArea?: boolean;
  visibleEDesign?: boolean;
  /** siteSettings, for the Google rating tag (renders nothing without data). */
  ratingSettings?: GoogleRatingSettings | null;
}

const {
  headline = 'Find the right fit for your project.',
  subhead,
  services = [],
  hasBuilders = false,
  hasServiceArea = false,
  visibleEDesign = false,
  ratingSettings,
} = Astro.props as Props;

const n = services.length;
const showIndex = n >= 3;
---

<section class="svcs" aria-labelledby="services-list-heading">
  <div class="r-wrap">
    <SectionHeading headline={headline} subhead={subhead} headingId="services-list-heading" />

    {
      showIndex && (
        <nav class="deck" aria-label="Services and prices on this page">
          <ol class="deck__list">
            {services.map((s: any, i: number) =>
              s.slug?.current ? (
                <li style={`--tone:${toneFor(i, n).bg}`}>
                  <a class="deck__link" href={`#${s.slug.current}`}>
                    <span class="deck__sw" aria-hidden="true" />
                    <span class="deck__name">{s.name}</span>
                    <span class="deck__dots" aria-hidden="true" />
                    <span class="deck__price">{chipPrice(s.price).short}</span>
                  </a>
                </li>
              ) : null,
            )}
          </ol>
          {(hasBuilders || hasServiceArea) && (
            <p class="deck__also">
              <span>Also on this page</span>
              {hasBuilders && (
                <a class="r-link" href="#builders">
                  Builders and realtors
                </a>
              )}
              {hasServiceArea && (
                <a class="r-link" href="#service-area">
                  Service area and travel
                </a>
              )}
            </p>
          )}
        </nav>
      )
    }

    {/* ---- Google reviews insertion (2026-09-30) ---- */}
    {
      googleRatingFrom(ratingSettings) && (
        <div class:list={['svcs__rating', { 'is-under-deck': showIndex }]}>
          <RatingTag settings={ratingSettings} />
        </div>
      )
    }

    {
      n > 0 ? (
        <ol class="strip">
          {services.map((service: any, i: number) => (
            <li>
              <ServiceCard
                service={service}
                withAnchor={true}
                index={i}
                total={n}
                secondary={
                  visibleEDesign && service.slug?.current === 'e-design'
                    ? { href: '/e-design/', label: 'See the full E-Design overview' }
                    : null
                }
              />
            </li>
          ))}
        </ol>
      ) : (
        <p class="svcs__empty">
          Services are being updated.{' '}
          <a class="r-link" href="/contact/">
            Get in touch
          </a>{' '}
          and we'll talk through what you need.
        </p>
      )
    }
  </div>
</section>

<style>
  .svcs {
    background: var(--color-paper);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  /* Google reviews insertion (2026-09-30): the rating tag hangs off the
     index's bottom rule on the right, like a tag tied to the deck. */
  .svcs__rating {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
    padding-right: 1rem;
    --rt-face: var(--color-chip-1);
  }
  .svcs__rating.is-under-deck {
    margin-top: -1.35rem;
  }

  /* ---- Deck index ---- */
  .deck {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.25rem 1.5rem;
    border-block: 1px solid var(--color-ink);
  }
  .deck__list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 22rem;
    column-gap: clamp(2rem, 5vw, 5rem);
  }
  .deck__list li {
    break-inside: avoid;
  }
  .deck__link {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    min-height: 2.9rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    text-decoration: none;
  }
  .deck__sw {
    flex: none;
    align-self: center;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--tone);
    box-shadow: inset 0 0 0 1px rgb(35 30 27 / 0.18);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .deck__name {
    font: 400 1.1rem/1.25 var(--font-body);
  }
  .deck__dots {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1.5px dotted rgb(35 30 27 / 0.35);
    transform: translateY(-0.3em);
  }
  .deck__price {
    flex: none;
    font: 400 1.35rem/1 var(--font-display);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .deck__link:hover .deck__sw,
  .deck__link:focus-visible .deck__sw {
    transform: scale(1.25) rotate(-6deg);
  }
  .deck__link:hover .deck__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .deck__link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .deck__also {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: 1.25rem 0 0;
    color: var(--color-ink-2);
    font-size: 0.95rem;
  }
  .deck__also a {
    color: var(--color-ink);
  }

  /* ---- The strip ---- */
  .strip {
    list-style: none;
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    padding: 0;
  }
  /* The strip's card: rounded top with the punched hole it hangs from, and a
     rounded foot. Only the chip column carries it. */
  .strip > li:first-child :global(.svc__chip) {
    border-radius: 0.6rem 0.6rem 0 0;
    padding-top: 2.6rem;
  }
  .strip > li:first-child :global(.svc__chip)::before {
    content: '';
    position: absolute;
    top: 0.95rem;
    left: 50%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    translate: -50% 0;
    background: var(--color-paper);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.2);
  }
  .strip > li:last-child :global(.svc__chip) {
    border-radius: 0 0 0.6rem 0.6rem;
  }
  .strip > li:last-child :global(.svc__body) {
    border-bottom: 0;
  }

  /* Scroll-driven, CSS only: each chip settles into the strip as its row
     comes into view. The default (no support, reduced motion, screenshots)
     is the finished strip. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
      /* :not(:target) leaves the arrival pull (ServiceCard) its own animation. */
      .strip > li :global(.svc:not(:target) .svc__chip) {
        animation: strip-in 1ms cubic-bezier(0.23, 1, 0.32, 1) both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }
  @keyframes strip-in {
    from {
      transform: translateX(-2.25rem) rotate(-1.5deg);
    }
  }

  .svcs__empty {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    color: var(--color-ink-2);
  }

  @media (max-width: 899px) {
    .strip > li:first-child :global(.svc__chip),
    .strip > li:last-child :global(.svc__chip),
    .strip :global(.svc__chip) {
      border-radius: 0.5rem 0.5rem 0 0;
    }
    .strip > li:first-child :global(.svc__chip)::before {
      display: none;
    }
    .strip > li:first-child :global(.svc__chip) {
      padding-top: 1.25rem;
    }
    .deck__name {
      font-size: 1rem;
    }
    .deck__price {
      font-size: 1.15rem;
    }
  }
</style>
