---
// Services "Service area + travel fees" section, extracted verbatim from
// services.astro. Travel fees come from businessInfo (via the page query).
// Self-suppresses with no headline + no travel fees. Keeps bg-background.
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  areaSec?: any;
  travelFees?: any[];
}

const { areaSec, travelFees = [] } = Astro.props as Props;
const show = areaSec?.headline || travelFees.length > 0;
---

{
  show && (
    <section
      id="service-area"
      class="scroll-mt-24 bg-background"
      aria-labelledby="service-area-heading"
    >
      <div class="mx-auto grid max-w-content grid-cols-1 items-start gap-l px-m py-section-lg md:grid-cols-2 md:gap-section-md">
        <div>
          <SectionHeading
            eyebrow={areaSec?.eyebrow ?? 'Service Area.'}
            headline={areaSec?.headline ?? 'Travel for Out-of-Area Projects.'}
            headingId="service-area-heading"
          />
          {areaSec?.description && (
            <p class="mt-m text-lg leading-relaxed text-foreground/85">{areaSec.description}</p>
          )}
        </div>

        {travelFees.length > 0 && (
          <div class="rounded-md bg-muted p-l">
            <p class="mb-m text-xs tracking-widest text-foreground/80 uppercase">
              Travel fee tiers
            </p>
            <dl class="divide-y divide-border-soft">
              {travelFees.map((tier: any) => (
                <div class="flex items-baseline justify-between gap-m py-s">
                  <dt class="text-foreground/85">{tier.distanceLabel}</dt>
                  <dd class="font-mono text-sm font-semibold whitespace-nowrap text-link">
                    {tier.fee}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    </section>
  )
}
