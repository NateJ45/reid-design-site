---
// Safe to edit by hand
// Services "Service area + travel fees" (rebuilt 2026-09-30, phase 2 of the
// art-direction rebuild; see DESIGN.md "Services and E-Design").
//
// Reads like the home ServiceAreaCue (towns set large, home base first in
// Espresso italic), then the travel fees as CLOCKS (2026-10-01; a tape
// measure until then, which said distance when the fees are about time).
// Each tier is a small stopwatch in her line style with its drive-time
// window shaded, read from the tier's own label by src/lib/drive-time.ts
// ("45 to 75 minutes" -> 45 to 75). Each is a real 60-minute clock face
// (2026-10-01; a two-hour dial drew "within 30" as a quarter turn, which
// reads as 15): the wedge runs from the start minute to the end minute the
// way a minute hand would, wrapping over the top past the hour, and a
// window that ends past the hour carries a small "+1 hr" under the pin. A
// label with no number still gets a clock, just with no wedge.
//
// Data unchanged: servicesPage.serviceAreaSection (headline, description) and
// businessInfo.travelFees. `cities` (businessInfo.serviceAreas, first = home
// base) is optional; with none, the towns line is skipped.
// Self-suppresses with no headline and no travel fees.

import {
  DIAL_MINUTES,
  handPoint,
  parseDriveWindow,
  pastTheHour,
  wedgePath,
} from '@/lib/drive-time';

interface Props {
  areaSec?: any;
  travelFees?: any[];
  cities?: string[] | null;
}

const { areaSec, travelFees = [], cities } = Astro.props as Props;
const show = areaSec?.headline || travelFees.length > 0;
const cityList = Array.isArray(cities) ? cities.filter(Boolean) : [];
const [home, ...rest] = cityList;

// The clocks: one window per tier, each on a 60-minute face.
const windows = travelFees.map((t: any) => parseDriveWindow(t?.distanceLabel));
// Dial geometry (viewBox 0 0 100 112): the face centred at (50, 62), the
// crown and button above it like a stopwatch.
const CX = 50;
const CY = 62;
const R = 38;
const ticks = Array.from({ length: DIAL_MINUTES / 5 }, (_, i) => {
  const m = i * 5;
  const a = (m / DIAL_MINUTES) * 2 * Math.PI - Math.PI / 2;
  const major = m % 15 === 0;
  const r1 = R - (major ? 7 : 3.5);
  return {
    major,
    x1: +(CX + r1 * Math.cos(a)).toFixed(2),
    y1: +(CY + r1 * Math.sin(a)).toFixed(2),
    x2: +(CX + (R - 1) * Math.cos(a)).toFixed(2),
    y2: +(CY + (R - 1) * Math.sin(a)).toFixed(2),
  };
});
---

{
  show && (
    <section id="service-area" class="sa" aria-labelledby="service-area-heading">
      <div class="r-wrap">
        <div class="sa__grid">
          <h2 id="service-area-heading" class="r-h2 sa__h">
            {areaSec?.headline ?? 'Travel for out-of-area projects'}
          </h2>
          <div class="sa__side">
            {cityList.length > 0 && (
              <p class="sa__towns">
                <b>{home}</b>
                {rest.map((c) => (
                  <>
                    {' '}
                    <i aria-hidden="true">/</i> {c}
                  </>
                ))}
              </p>
            )}
            {areaSec?.description && <p class="sa__desc">{areaSec.description}</p>}
          </div>
        </div>

        {travelFees.length > 0 && (
          <div class="sa__fees">
            <ul class="sa__tiers" role="list" style={`--n:${travelFees.length}`}>
              {travelFees.map((tier: any, i: number) => {
                const w = windows[i] ?? null;
                const wedge = wedgePath(w, CX, CY, R - 1);
                const hand = handPoint(w, CX, CY, R - 11);
                const overHour = pastTheHour(w);
                return (
                  <li class="sa__tier">
                    <svg
                      class="sa__clock"
                      viewBox="0 0 100 112"
                      aria-hidden="true"
                      focusable="false"
                    >
                      {/* Crown and side button: the stopwatch silhouette. */}
                      <rect class="sa__crown" x="44" y="6" width="12" height="7" rx="1.5" />
                      <path class="sa__line" d="M50 13v11" />
                      <path class="sa__line" d="M77 30l5-5" />
                      <circle class="sa__face" cx={CX} cy={CY} r={R} />
                      {wedge && <path class="sa__wedge" d={wedge} />}
                      {ticks.map((t) => (
                        <line
                          class:list={['sa__tick', t.major && 'sa__tick--major']}
                          x1={t.x1}
                          y1={t.y1}
                          x2={t.x2}
                          y2={t.y2}
                        />
                      ))}
                      {hand && <line class="sa__hand" x1={CX} y1={CY} x2={hand.x} y2={hand.y} />}
                      <circle class="sa__pin" cx={CX} cy={CY} r="2.4" />
                      {overHour && (
                        <text class="sa__lap" x={CX} y={CY + 21} text-anchor="middle">
                          +1 hr
                        </text>
                      )}
                    </svg>
                    <div class="sa__words">
                      <p class="sa__when">{tier.distanceLabel}</p>
                      <p class="sa__fee">{tier.fee}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
            <p class="sa__caption">Travel fee by drive time from {home || 'Plainfield'}</p>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .sa {
    scroll-margin-top: 5rem;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    overflow-x: clip;
  }
  .sa__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .sa__h {
    grid-column: 1 / 6;
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.2rem, 1.3rem + 2.8vw, 4rem);
  }
  .sa__side {
    grid-column: 6 / 13;
  }
  .sa__towns {
    margin: 0;
    font: 300 clamp(1.6rem, 1.15rem + 1.5vw, 2.6rem) / 1.25 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-ink-2);
  }
  .sa__towns b {
    font-weight: 300;
    font-style: italic;
    color: var(--color-chip-7);
  }
  .sa__towns i {
    font-style: normal;
    color: var(--color-chip-3);
    padding-inline: 0.15em;
  }
  .sa__desc {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  /* ---- Travel fees as clocks ---- */
  .sa__fees {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--color-rule);
  }
  .sa__tiers {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sa__tier {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* The stopwatch, in her fine line: a paper face outlined in Walnut, Warm
     Bronze ticks (quarter hours longer, in Walnut), the window shaded in
     Sandbar, and an Espresso hand to the end of the window. */
  .sa__clock {
    flex: none;
    width: clamp(5.5rem, 4rem + 4vw, 8rem);
    height: auto;
    overflow: visible;
  }
  .sa__face {
    fill: var(--color-paper);
    stroke: var(--color-chip-6);
    stroke-width: 1.25;
  }
  .sa__crown {
    fill: var(--color-paper);
    stroke: var(--color-chip-6);
    stroke-width: 1.25;
  }
  .sa__line {
    fill: none;
    stroke: var(--color-chip-6);
    stroke-width: 1.25;
    stroke-linecap: round;
  }
  .sa__wedge {
    fill: var(--color-chip-3);
    fill-opacity: 0.55;
  }
  .sa__tick {
    stroke: var(--color-chip-5);
    stroke-width: 0.8;
    stroke-linecap: round;
  }
  .sa__tick--major {
    stroke: var(--color-chip-6);
    stroke-width: 1.2;
  }
  .sa__hand {
    stroke: var(--color-chip-7);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  /* "+1 hr" under the pin when the window runs past the hour. */
  .sa__lap {
    font: 600 8.5px var(--font-body);
    letter-spacing: 0.02em;
    fill: var(--color-chip-7);
  }
  .sa__pin {
    fill: var(--color-chip-7);
  }
  .sa__when {
    margin: 0;
    font: 500 0.95rem/1.3 var(--font-body);
    color: var(--color-chip-7);
  }
  .sa__fee {
    margin: 0.4rem 0 0;
    font: 300 clamp(2rem, 1.4rem + 1.8vw, 3.2rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .sa__caption {
    margin: 2.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-2);
  }

  /* Motion: the shaded window sweeps in as the band scrolls up (CSS only;
     at rest, or under reduced motion, it is simply there). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sa__wedge {
        animation: sa-sweep linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
        transform-origin: 50px 62px;
      }
    }
  }
  @keyframes sa-sweep {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  /* Phone and tablet: stacked, one clock per row beside its words. */
  @media (max-width: 1023px) {
    .sa__grid {
      display: block;
    }
    .sa__side {
      margin-top: 1.5rem;
    }
    .sa__tiers {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
