---
// Safe to edit by hand
// Services "Service area + travel fees" (rebuilt 2026-09-30, phase 2 of the
// art-direction rebuild; see DESIGN.md "Services and E-Design").
//
// Reads like the home ServiceAreaCue (towns set large, home base first in
// Espresso italic), then the travel fees hang off a TAPE MEASURE: travel is
// priced by drive time, so each tier is a mark further along the tape. Same
// tape as home/TapeProcess.astro, pulled out on scroll (CSS only).
//
// Data unchanged: servicesPage.serviceAreaSection (headline, description) and
// businessInfo.travelFees. `cities` (businessInfo.serviceAreas, first = home
// base) is optional; with none, the towns line is skipped.
// Self-suppresses with no headline and no travel fees.

interface Props {
  areaSec?: any;
  travelFees?: any[];
  cities?: string[] | null;
}

const { areaSec, travelFees = [], cities } = Astro.props as Props;
const show = areaSec?.headline || travelFees.length > 0;
const cityList = Array.isArray(cities) ? cities.filter(Boolean) : [];
const [home, ...rest] = cityList;
---

{
  show && (
    <section id="service-area" class="sa" aria-labelledby="service-area-heading">
      <div class="r-wrap">
        <div class="sa__grid">
          <h2 id="service-area-heading" class="r-h2 sa__h">
            {areaSec?.headline ?? 'Travel for out-of-area projects'}
          </h2>
          <div class="sa__side">
            {cityList.length > 0 && (
              <p class="sa__towns">
                <b>{home}</b>
                {rest.map((c) => (
                  <>
                    {' '}
                    <i aria-hidden="true">/</i> {c}
                  </>
                ))}
              </p>
            )}
            {areaSec?.description && <p class="sa__desc">{areaSec.description}</p>}
          </div>
        </div>

        {travelFees.length > 0 && (
          <div class="sa__fees">
            <div class="sa__tape" aria-hidden="true" />
            <dl class="sa__tiers" style={`--n:${travelFees.length}`}>
              {travelFees.map((tier: any) => (
                <div class="sa__tier">
                  <dt>{tier.distanceLabel}</dt>
                  <dd>{tier.fee}</dd>
                </div>
              ))}
            </dl>
            <p class="sa__caption">Travel fee by drive time from {home || 'Plainfield'}</p>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .sa {
    scroll-margin-top: 5rem;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    overflow-x: clip;
  }
  .sa__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .sa__h {
    grid-column: 1 / 6;
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.2rem, 1.3rem + 2.8vw, 4rem);
  }
  .sa__side {
    grid-column: 6 / 13;
  }
  .sa__towns {
    margin: 0;
    font: 300 clamp(1.6rem, 1.15rem + 1.5vw, 2.6rem) / 1.25 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-ink-2);
  }
  .sa__towns b {
    font-weight: 300;
    font-style: italic;
    color: var(--color-chip-7);
  }
  .sa__towns i {
    font-style: normal;
    color: var(--color-chip-3);
    padding-inline: 0.15em;
  }
  .sa__desc {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  /* ---- Travel fees on the tape ---- */
  .sa__fees {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }
  .sa__tape {
    height: 2.6rem;
    border-radius: 2px 0.5rem 0.5rem 2px;
    background:
      repeating-linear-gradient(90deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 / 0.75rem
        0.7rem repeat-x,
      repeating-linear-gradient(90deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 / 3.75rem
        1.2rem repeat-x,
      repeating-linear-gradient(90deg, var(--color-ink) 0 1.5px, transparent 1.5px 100%) 0 0 /
        7.5rem 1.7rem repeat-x,
      var(--color-chip-2);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.06);
  }
  .sa__tiers {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
  }
  .sa__tier {
    position: relative;
    padding-top: 3rem;
  }
  /* The drop from the tape and its pin, as on the home process tape. */
  .sa__tier::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1.5px;
    height: 2.1rem;
    background: var(--color-chip-5);
  }
  .sa__tier::after {
    content: '';
    position: absolute;
    left: -4px;
    top: 2rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-chip-5);
  }
  .sa__tier dt {
    font: 500 0.95rem/1.3 var(--font-body);
    color: var(--color-chip-7);
  }
  .sa__tier dd {
    margin: 0.5rem 0 0;
    font: 300 clamp(2rem, 1.4rem + 1.8vw, 3.2rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .sa__caption {
    margin: 2rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-2);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sa__tape {
        animation: sa-pull linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }
  @keyframes sa-pull {
    from {
      clip-path: inset(0 82% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Phone and tablet: stacked, and the tape turns vertical down the left of
     the tiers, like the home process ruler. */
  @media (max-width: 1023px) {
    .sa__grid {
      display: block;
    }
    .sa__side {
      margin-top: 1.5rem;
    }
    .sa__tape {
      display: none;
    }
    .sa__tiers {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-left: 3.6rem;
    }
    .sa__tiers::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1.9rem;
      border-radius: 2px 2px 0.5rem 0.5rem;
      background:
        repeating-linear-gradient(180deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 /
          0.75rem 0.75rem repeat-y,
        repeating-linear-gradient(180deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 /
          1.25rem 3.75rem repeat-y,
        var(--color-chip-2);
    }
    .sa__tier {
      padding: 0 0 0 0.75rem;
    }
    .sa__tier::before {
      left: -1.75rem;
      top: 0.55rem;
      width: 1.75rem;
      height: 1.5px;
    }
    .sa__tier::after {
      left: -0.2rem;
      top: 0.3rem;
    }
  }
</style>
