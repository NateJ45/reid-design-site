---
// Resources optional intro band, extracted verbatim from resources.astro.
// Self-suppresses when blank. Keeps bg-background.
interface Props {
  intro?: string;
}
const { intro } = Astro.props as Props;
---

{
  intro && (
    <section class="border-b border-border bg-background">
      <div class="mx-auto max-w-content px-m py-section-md">
        <p class="mx-auto max-w-2xl text-center text-lg leading-relaxed text-foreground/80">
          {intro}
        </p>
      </div>
    </section>
  )
}
