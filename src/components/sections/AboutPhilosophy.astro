---
// Safe to edit by hand
// About "philosophy" (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; see DESIGN.md "About (phase 2)"). Same props: philosophyEyebrow,
// philosophyHeadline, and the philosophyPoint collection (title, description)
// in Staci's order. Self-suppresses when there are no points, as before.
//
// Set on the INK band, as a typographic list rather than three identical
// cards: each belief is a big Zodiak statement with its reasoning set beside
// it, rows separated by hairlines. No 01/02/03: the beliefs are not a
// sequence, so numbering them would be decoration pretending to be order.
// Every second statement is italic in Sandbar, and the statements step in
// from the left on desktop, so the list has a hand-set rhythm without
// becoming a grid.
//
// Contrast on ink: cream text 14.2, Sandbar (display size only) about 8.
import AboutKicker from '@/components/about/AboutKicker.astro';

interface PhilosophyPoint {
  title?: string;
  description?: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  points?: PhilosophyPoint[];
  headingId?: string;
}

const {
  eyebrow = 'How I work',
  headline = 'A philosophy that puts your home first.',
  points = [],
  headingId = 'about-philosophy-heading',
} = Astro.props as Props;

const list = (points ?? []).filter((p) => p?.title?.trim());
---

{
  list.length > 0 && (
    <section class="bel" aria-labelledby={headingId}>
      <div class="r-wrap">
        <AboutKicker text={eyebrow} tone="ink" />
        <h2 id={headingId} class="r-h2 bel__h">
          {headline}
        </h2>

        <ul class="bel__list" role="list">
          {list.map((point, i) => (
            <li
              class:list={['bel__item', i % 2 === 1 && 'bel__item--alt']}
              style={`--step:${i % 3}`}
            >
              <h3 class="bel__title">{point.title}</h3>
              {point.description && <p class="bel__why">{point.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .bel {
    background: var(--color-ink);
    color: var(--color-cream);
    padding-block: clamp(5rem, 10vw, 8.5rem);
  }
  .bel__h {
    margin: 0;
    max-width: 16ch;
    color: var(--color-cream);
  }
  .bel__list {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .bel__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  /* The hairline above each row, drawn as its own box so it can grow in
     from the left on scroll without touching the text. */
  .bel__item::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: rgb(245 237 227 / 0.2);
    transform-origin: 0 50%;
  }
  .bel__item:last-child {
    border-bottom: 1px solid rgb(245 237 227 / 0.2);
  }
  .bel__title {
    margin: 0;
    padding-left: calc(var(--step, 0) * clamp(0rem, 6vw, 6rem));
    font: 300 clamp(2.3rem, 1.2rem + 3.6vw, 4.9rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-wrap: balance;
  }
  .bel__item--alt .bel__title {
    font-style: italic;
    color: var(--color-chip-3);
  }
  .bel__why {
    margin: 0;
    max-width: 36ch;
    font-size: 1.04rem;
    line-height: 1.6;
    color: rgb(245 237 227 / 0.86);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bel__item::before {
        animation: bel-rule linear backwards;
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
      .bel__title {
        animation: bel-in linear backwards;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }
  @keyframes bel-rule {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes bel-in {
    from {
      translate: -0.35em 0;
    }
  }

  @media (max-width: 1023px) {
    .bel__item {
      grid-template-columns: 1fr;
      row-gap: 1rem;
    }
    .bel__title {
      padding-left: 0;
    }
  }
</style>
