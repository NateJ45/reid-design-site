---
// Resources card grid, extracted verbatim from resources.astro. Uses the Sanity
// cards when present, else nav-style fallback cards, filtered by section
// visibility. Keeps bg-muted surface-warm. Safe to edit by hand.
import SanityImage from '@/components/SanityImage.astro';

interface Props {
  sanityCards?: any[];
  visible: any;
}

const { sanityCards, visible } = Astro.props as Props;

// Nav-link fallback cards (no prices) used when the Sanity doc has none.
const FALLBACK_CARDS = [
  { title: 'Style Quiz', blurb: 'Find your design archetype and get a personal recommendation from Staci.', link: '/quiz' },
  { title: 'Budget Calculator', blurb: 'Get a rough idea of what a project costs before reaching out.', link: '/calculator' },
  { title: 'Free Guides', blurb: 'Room-by-room checklists and sourcing guides you can download and keep.', link: '/guides' },
  { title: 'FAQ', blurb: 'Pricing, process, logistics, and service area, all in one place.', link: '/faq' },
  { title: 'Journal', blurb: 'Behind-the-scenes look at projects, sourcing notes, and design decisions.', link: '/journal' },
];

function isCardVisible(link: string): boolean {
  if (link === '/quiz') return visible.styleQuiz;
  if (link === '/calculator') return visible.budgetCalculator;
  if (link === '/guides') return visible.guides;
  if (link === '/journal') return visible.journal;
  return true;
}

const hasSanityCards = Array.isArray(sanityCards) && sanityCards.length > 0;
const rawCards = hasSanityCards ? sanityCards : FALLBACK_CARDS;
const cards = rawCards.filter((card: any) => isCardVisible(card.link ?? '/'));
---

<section class="bg-muted surface-warm" aria-label="Free tools and resources">
  <div class="mx-auto max-w-content px-m py-section-lg">
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-m list-none p-0 m-0" role="list">
      {cards.map((card: any) => {
        const cardTitle: string = card.title ?? '';
        const cardBlurb: string = card.blurb ?? '';
        const cardLink: string = card.link ?? '/';
        const cardIcon = card.icon?.asset ? card.icon : null;
        const isExternal: boolean = cardLink.startsWith('http');

        return (
          <li>
            <a
              href={cardLink}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class="card-lift card-lift-slow group relative flex flex-col h-full bg-card text-card-foreground border border-border-soft rounded-md overflow-hidden transition-colors hover:border-primary/40 shadow-[0_4px_18px_-14px_rgba(61,61,61,0.18)] no-underline"
              aria-label={cardTitle}
            >
              <div class="h-0.5 bg-primary" aria-hidden="true"></div>

              {cardIcon && (
                <div class="aspect-[3/2] overflow-hidden bg-muted">
                  <SanityImage
                    source={cardIcon}
                    width={480}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    class="w-full h-full object-cover transition-transform duration-[1500ms] group-hover:scale-[1.02]"
                  />
                </div>
              )}

              <div class="flex flex-col flex-1 p-l">
                <h2 class="font-display text-h3 text-foreground group-hover:text-primary-dark transition-colors">
                  {cardTitle}
                </h2>

                {cardBlurb && (
                  <p class="mt-s text-foreground/80 text-base leading-relaxed flex-1">{cardBlurb}</p>
                )}

                <p
                  class="mt-m text-xs font-semibold uppercase tracking-eyebrow text-link group-hover:text-primary-dark transition-colors flex items-center gap-xs"
                  aria-hidden="true"
                >
                  {isExternal ? 'Visit' : 'Go'}{' '}
                  <span aria-hidden="true">&#8594;</span>
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
