---
// Safe to edit by hand
// Satisfaction guarantee (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; see DESIGN.md "Services and E-Design"). One confident typographic
// moment: Staci's promise set large in Zodiak on the Oat chip (ink on Oat is
// 10.9:1), with a round studio stamp beside it that turns slowly as the band
// scrolls past (CSS only, reduced-motion safe, decorative).
//
// On the Services page it usually sits between the linen service area and the
// Walnut closing CTA, so the page steps down the paint strip: linen, Oat,
// Walnut, then the ink footer.
//
// Data: siteSettings.satisfactionGuarantee. Self-suppresses when blank.
interface Props {
  text?: string;
}
const { text } = Astro.props as Props;
---

{
  text && (
    <section class="gtee" aria-labelledby="guarantee-heading">
      <div class="r-wrap gtee__grid">
        <div>
          <h2 id="guarantee-heading" class="gtee__label">
            The guarantee
          </h2>
          <p class="gtee__text">{text}</p>
        </div>
        <svg class="gtee__stamp" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
          <defs>
            <path id="gtee-ring" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" />
          </defs>
          <circle cx="100" cy="100" r="96" class="gtee__o" />
          <circle cx="100" cy="100" r="56" class="gtee__o" />
          <text class="gtee__ring">
            <textPath href="#gtee-ring" textLength="460" lengthAdjust="spacing">
              Satisfaction guarantee · Reid Design · Plainfield, Indiana ·
            </textPath>
          </text>
          <g class="gtee__sprig">
            <path d="M72 124 C92 110 110 98 132 78" />
            <path d="M88 113 C84 102 88 94 97 90 C99 99 96 107 88 113Z" />
            <path d="M88 113 C79 117 71 116 65 110 C73 105 82 107 88 113Z" />
            <path d="M110 97 C107 86 111 78 120 74 C122 83 119 91 110 97Z" />
            <path d="M110 97 C101 102 92 101 86 95 C94 90 103 91 110 97Z" />
          </g>
        </svg>
      </div>
    </section>
  )
}

<style>
  .gtee {
    background: var(--color-chip-2);
    color: var(--color-ink);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    overflow: clip;
  }
  .gtee__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .gtee__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.75rem;
    font: 500 0.95rem/1.3 var(--font-body);
    color: var(--color-chip-7);
  }
  .gtee__label::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .gtee__text {
    margin: 0;
    max-width: 30ch;
    font: 300 clamp(1.9rem, 1.1rem + 2.7vw, 3.6rem) / 1.1 var(--font-display);
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }
  .gtee__stamp {
    width: clamp(9rem, 16vw, 14rem);
    height: auto;
    rotate: -12deg;
    color: var(--color-chip-7);
  }
  .gtee__o {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .gtee__ring {
    font: 500 13.5px var(--font-body);
    letter-spacing: 0.06em;
    fill: currentColor;
  }
  .gtee__sprig path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .gtee__stamp {
        animation: gtee-turn linear both;
        animation-timeline: view();
      }
    }
  }
  @keyframes gtee-turn {
    from {
      rotate: -40deg;
    }
    to {
      rotate: 20deg;
    }
  }
  @media (max-width: 719px) {
    .gtee__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .gtee__stamp {
      order: -1;
      width: 7.5rem;
    }
  }
</style>
