---
// Safe to edit by hand
// Satisfaction guarantee (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; see DESIGN.md "Services and E-Design"). One confident typographic
// moment on paper: "The guarantee" set big in Zodiak with the italic accent,
// Staci's promise under it as a lede (heading and text swapped weights on
// 2026-10-01), and a round studio stamp beside them that turns slowly as the
// band scrolls past (CSS only, reduced-motion safe, decorative).
//
// On the Services page it usually sits between the linen service area and the
// Walnut closing CTA: linen, paper, Walnut, then the ink footer.
//
// The stamp's middle is Staci's own RD monogram (2026-09-30 design pass; it
// was a small hand-drawn sprig nobody could read). The monogram is a MASK
// (src/assets/logo-mark.png, white ink on transparent, cut from the same
// source as the share-card masks in scripts/og-assets/), so CSS paints it in
// the stamp's Espresso ink. Only the lettered ring turns on scroll; the
// monogram stays upright so it always reads.
//
// Data: siteSettings.satisfactionGuarantee. Self-suppresses when blank.
import { getImage } from 'astro:assets';
import markAsset from '@/assets/logo-mark.png';

interface Props {
  text?: string;
}
const { text } = Astro.props as Props;
// The monogram shows at most ~125px wide; 320px keeps it crisp on 2x screens.
const mark = await getImage({ src: markAsset, format: 'webp', width: 320 });
---

{
  text && (
    <section class="gtee" aria-labelledby="guarantee-heading">
      <div class="r-wrap gtee__grid">
        <div>
          <h2 id="guarantee-heading" class="gtee__h">
            The <span class="r-accent">guarantee</span>
          </h2>
          <p class="gtee__text">{text}</p>
        </div>
        <div class="gtee__stamp" aria-hidden="true">
          <svg class="gtee__ring-svg" viewBox="0 0 200 200" focusable="false">
            <defs>
              <path id="gtee-ring" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" />
            </defs>
            <circle cx="100" cy="100" r="96" class="gtee__o" />
            <circle cx="100" cy="100" r="92" class="gtee__o gtee__o--fine" />
            <text class="gtee__ring">
              <textPath href="#gtee-ring" textLength="460" lengthAdjust="spacing">
                Satisfaction guarantee · Reid Design · Plainfield, Indiana ·
              </textPath>
            </text>
          </svg>
          <span class="gtee__mark" style={`--mark: url(${mark.src})`} />
        </div>
      </div>
    </section>
  )
}

<style>
  .gtee {
    background: var(--color-paper);
    color: var(--color-ink);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    overflow: clip;
  }
  .gtee__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  /* The heading is the big moment (2026-10-01, Nathan: the old small
     "The guarantee" eyebrow should lead, not the paragraph). Zodiak at h2
     size with the house italic accent; the promise itself reads under it
     as a lede. */
  .gtee__h {
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    font: 300 var(--text-h2) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .gtee__text {
    margin: 0;
    max-width: 44ch;
    font: 400 var(--text-lede) / 1.5 var(--font-body);
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .gtee__stamp {
    position: relative;
    width: clamp(9rem, 16vw, 14rem);
    aspect-ratio: 1;
    color: var(--color-chip-7);
  }
  .gtee__ring-svg {
    display: block;
    width: 100%;
    height: 100%;
    rotate: -12deg;
  }
  /* Her monogram, painted in the stamp's ink through the mask. */
  .gtee__mark {
    position: absolute;
    inset: 22%;
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }
  .gtee__o {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .gtee__o--fine {
    stroke-width: 0.6;
  }
  .gtee__ring {
    font: 500 13.5px var(--font-body);
    letter-spacing: 0.06em;
    fill: currentColor;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .gtee__ring-svg {
        animation: gtee-turn linear both;
        animation-timeline: view();
      }
    }
  }
  @keyframes gtee-turn {
    from {
      rotate: -40deg;
    }
    to {
      rotate: 20deg;
    }
  }
  @media (max-width: 719px) {
    .gtee__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .gtee__stamp {
      order: -1;
      width: 7.5rem;
    }
  }
</style>
