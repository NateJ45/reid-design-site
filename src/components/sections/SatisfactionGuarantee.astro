---
// Satisfaction-guarantee band, extracted verbatim from services.astro. Sourced
// from siteSettings.satisfactionGuarantee. Self-suppresses when blank.
interface Props {
  text?: string;
}
const { text } = Astro.props as Props;
---

{
  text && (
    <section class="bg-background" aria-label="Satisfaction guarantee">
      <div class="mx-auto max-w-content px-m py-l">
        <p class="rounded-md border border-border-soft bg-muted px-l py-m text-center text-sm text-foreground/80">
          {text}
        </p>
      </div>
    </section>
  )
}
