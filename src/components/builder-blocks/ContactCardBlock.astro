---
// Safe to edit by hand
// Contact details on one card (refoundation phase B, 2026-10-28; starter card
// 193, drawn in Reid's look): phone, email, address with a directions link and
// opening hours, a column each on a wide screen, set off by hairlines.
//
// The phone, email, address and hours default to the business's facts (Site
// settings and Business info, card 196, read through resolveBusinessFacts), so
// a bare block fills itself; a block can type its own for a one-off and that
// wins. A fact from Business info shows only once it is CONFIRMED there, and
// the phone strictly so: the phone line and the big Call button stay hidden
// until "The phone number is confirmed" is ticked (Reid has no "To confirm" tag
// on its live pages, so an unconfirmed fact is left out rather than flagged).
// Lines that are empty are left out, and with none at all the block draws
// nothing.
//
// "Lead with big Call and Email buttons" (callButtons) puts two buttons above
// the details. Call is the page's one filled ink tag when SectionRenderer hands
// this block the accent budget; otherwise it, and always Email, is the
// underline link.
import BuilderBand from './BuilderBand.astro';
import CtaLink from '@/components/CtaLink.astro';
import { getSiteSettings } from '@/lib/queries';
import { resolveBusinessFacts, type RawBusinessFacts } from '@/lib/business-facts';
import { weekRows } from '@/lib/business-hours';
import { eventPlace, plain, telHref } from '@/lib/builder-blocks';
import type { CadenceSurface } from '@/lib/surfaces';
import type { ProjectedContactCardSection } from '@/lib/builderBlocks.types';

interface Props {
  block: ProjectedContactCardSection;
  surface?: CadenceSurface;
  headingId: string;
  primaryVariant?: 'primary' | 'secondary';
}

const { block, surface, headingId, primaryVariant = 'secondary' } = Astro.props;

const settings = (await getSiteSettings()) as RawBusinessFacts | null;
const loose = resolveBusinessFacts(settings);
const strict = resolveBusinessFacts(settings, { strict: true });

// Own words win; the confirmed facts fill whatever is left empty.
const ownPhone = plain(block.phone);
const phone = ownPhone || (strict.phone?.confirmed ? strict.phone.display : '');
const tel = telHref(phone);
const ownEmail = plain(block.email);
const email = ownEmail || (loose.email?.confirmed ? loose.email.address : '');
const ownPlace = eventPlace(block.address);
const place =
  ownPlace ??
  (loose.address?.confirmed
    ? { lines: loose.address.lines, mapsUrl: loose.address.mapsUrl }
    : null);
const ownHours = plain(block.hours)
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean);
const hours =
  ownHours.length > 0
    ? ownHours
    : loose.hasHours
      ? weekRows(loose.hours, { grouped: true }).map((r) => `${r.label}: ${r.text}`)
      : [];
const hoursNote = ownHours.length === 0 && loose.hasHours ? loose.hoursNote : '';

const count = [Boolean(tel), Boolean(email), Boolean(place), hours.length > 0].filter(
  Boolean,
).length;
const big = block.callButtons === true;
---

{count > 0 && (
  <BuilderBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label="Contact details"
  >
    {big && (tel || email) && (
      <div class="bb-call" data-call-buttons>
        {tel && (
          <CtaLink
            cta={{ label: `Call ${phone}`, linkType: 'phone', phoneNumber: phone }}
            variant={primaryVariant === 'primary' ? 'primary' : 'secondary'}
          />
        )}
        {email && (
          <CtaLink
            cta={{ label: 'Email the studio', linkType: 'email', emailAddress: email }}
            variant="secondary"
          />
        )}
      </div>
    )}
    <dl class="bb-board" data-n={count}>
      {tel && (
        <div class="bb-board__cell">
          <dt>Phone</dt>
          <dd>
            <a href={tel}>{phone}</a>
          </dd>
        </div>
      )}
      {email && (
        <div class="bb-board__cell">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${email}`}>{email}</a>
          </dd>
        </div>
      )}
      {place && (
        <div class="bb-board__cell">
          <dt>Studio</dt>
          <dd>
            {place.lines.map((line) => (
              <span class="bb-line">{line}</span>
            ))}
            <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer">
              Get directions<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>
      )}
      {hours.length > 0 && (
        <div class="bb-board__cell">
          <dt>Hours</dt>
          <dd>
            {hours.map((line) => (
              <span class="bb-line">{line}</span>
            ))}
            {hoursNote && <span class="bb-line">{hoursNote}</span>}
          </dd>
        </div>
      )}
    </dl>
  </BuilderBand>
)}
