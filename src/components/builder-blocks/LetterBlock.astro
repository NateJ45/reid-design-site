---
// Safe to edit by hand
// A letter (for Reid Design, a note from Staci): one narrow column on a sheet
// of paper set into the page (refoundation phase B, 2026-10-28; starter card
// 173, drawn in Reid's look). A sentence-case line above, the greeting in
// Zodiak, the letter at a comfortable reading size, the sign-off, then the
// signature picture (or the name in Zodiak when there is none), the role, and
// an optional underline link. The sheet is the house paper with a hairline
// and square corners, like the framed photos; the band around it comes from
// the cadence (Standard or Quiet, rule 9). No Feature: a letter is paper.
import PortableText from '@/components/PortableText';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import { surfaceClass, type CadenceSurface } from '@/lib/surfaces';
import type { ProjectedLetterSection } from '@/lib/builderBlocks.types';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import type { PortableTextBlock } from '@portabletext/types';

interface Props {
  block: ProjectedLetterSection;
  surface?: CadenceSurface;
  headingId: string;
}

const { block, surface = 'background', headingId } = Astro.props;
const body = (block.body ?? []) as PortableTextBlock[];
const signature = block.signature?.asset ? (block.signature as SanityImageObject) : null;
const greeting = block.greeting?.trim() || 'Dear friends,';
---

<section
  class={surfaceClass(surface)}
  data-builder-block="letterSection"
  aria-labelledby={headingId}
>
  <div class="r-wrap">
    <article class="bb-letter">
      {block.eyebrow && <p class="bb-letter__eyebrow">{block.eyebrow}</p>}
      <h2 id={headingId} class="bb-letter__greeting">
        {greeting}
      </h2>
      <PortableText value={body} className="bb-letter__body" />
      <footer class="bb-letter__sign">
        {block.signOff && <p class="bb-letter__off">{block.signOff}</p>}
        {signature && (
          <SanityImage
            source={signature}
            width={440}
            sizes="220px"
            quality={80}
            class="bb-letter__signature"
          />
        )}
        {block.name && <p class:list={['bb-letter__name', signature && 'sr-only']}>{block.name}</p>}
        {block.role && <p class="bb-letter__role">{block.role}</p>}
      </footer>
      {block.link?.label && (
        <p class="bb-actions">
          <CtaLink cta={block.link} variant="secondary" />
        </p>
      )}
    </article>
  </div>
</section>
