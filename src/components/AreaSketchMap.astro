---
// Foundation, edit with care
// The service area as a designer's sketch map (2026-09-30 design pass).
//
// Greater Indianapolis drawn in fine line in the house colours: the I-465
// loop and the interstates as double-line roads, the White River and Fall
// Creek, Geist and Eagle Creek as hatched water, the Mile Square downtown, a
// north arrow and a five-mile scale bar, and a dot and name for every town
// Staci serves, with her home base ringed. It replaces the OpenStreetMap
// embed (Nathan: "ugly looking") and is also the backdrop of the home page's
// "Based in Plainfield" band. No tiles, no third-party request, no script.
//
// Two looks:
//   variant="ambient"  no frame, transparent ground, decorative (aria-hidden).
//                      The home band lays it behind/beside the towns list.
//   variant="framed"   in the house photo frame on paper, with a short label,
//                      exposed to assistive tech as one described image.
//
// The towns are Business info -> Service areas (first = home base). The
// geography and the town table live in src/lib/area-map.ts; a town the
// table does not know is simply not drawn (it still appears in the text).
//
// The roads draw themselves in as the map scrolls into view (CSS only,
// behind @supports and prefers-reduced-motion; otherwise fully drawn).
import {
  DOWNTOWN,
  LAKES,
  LOOP,
  MAP_H,
  MAP_W,
  RIVERS,
  ROADS,
  milesToUnits,
  placeTowns,
  project,
  smoothPath,
} from '@/lib/area-map';

interface Props {
  towns?: string[] | null;
  /** Home base; defaults to the first town. */
  home?: string | null;
  variant?: 'ambient' | 'framed';
  /** Unique per page if the map is used twice (SVG ids). */
  idPrefix?: string;
  class?: string;
}

const { towns, home, variant = 'ambient', idPrefix = 'asm', class: cls } = Astro.props as Props;

const list = (towns ?? []).filter(Boolean);
// Always draw the home base even when the list is empty.
const placed = placeTowns(list.length > 0 ? list : ['Plainfield'], home ?? undefined);
const homeName = placed.find((t) => t.home)?.name ?? 'Plainfield';

const loop = smoothPath(LOOP, true);
const roads = ROADS.map((r) => ({
  ...r,
  d: smoothPath(r.points),
  minor: r.name === '31',
  at: r.label ? project(r.label) : null,
}));
const rivers = RIVERS.map((r) => smoothPath(r));
const lakes = LAKES.map((l) => smoothPath(l, true));
const [dx, dy] = project(DOWNTOWN);

// Five-mile scale bar, bottom right.
const mile5 = Math.round(milesToUnits(5));
const scaleX = MAP_W - 70 - mile5;
const scaleY = MAP_H - 58;

// Label placement by side (SVG units).
const labelAt = (t: { x: number; y: number; side: string; home: boolean }) => {
  const gap = t.home ? 26 : 15;
  switch (t.side) {
    case 'left':
      return { x: t.x - gap, y: t.y + 8, anchor: 'end' };
    case 'above':
      return { x: t.x, y: t.y - gap, anchor: 'middle' };
    case 'below':
      return { x: t.x, y: t.y + gap + 18, anchor: 'middle' };
    default:
      return { x: t.x + gap, y: t.y + 8, anchor: 'start' };
  }
};

const framed = variant === 'framed';
const label = `Sketch map of Greater Indianapolis. ${homeName} is the home base; also served: ${placed
  .filter((t) => !t.home)
  .map((t) => t.name)
  .join(', ')}.`;
const wobble = `${idPrefix}-wobble`;
const hatch = `${idPrefix}-hatch`;
---

<figure class:list={['asm', `asm--${variant}`, framed && 'r-frame', cls]}>
  <svg
    viewBox={`0 0 ${MAP_W} ${MAP_H}`}
    role={framed ? 'img' : undefined}
    aria-label={framed ? label : undefined}
    aria-hidden={framed ? undefined : 'true'}
    focusable="false"
  >
    <defs>
      {/* A whisper of hand wobble on the line work (never on the words). */}
      <filter id={wobble} x="-2%" y="-2%" width="104%" height="104%">
        <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="7"
        ></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="3.2"></feDisplacementMap>
      </filter>
      <pattern
        id={hatch}
        width="9"
        height="9"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(35)"
      >
        <line x1="0" y1="0" x2="0" y2="9" class="asm__hatch"></line>
      </pattern>
    </defs>

    {framed && <rect width={MAP_W} height={MAP_H} class="asm__ground" />}

    <g filter={`url(#${wobble})`}>
      {lakes.map((d) => <path d={d} class="asm__lake" fill={`url(#${hatch})`} />)}
      {rivers.map((d) => <path d={d} class="asm__river asm__draw" pathLength="1" />)}

      {/* Roads: a wide stroke under a narrow ground-coloured one = double line. */}
      {
        roads.map((r) =>
          r.minor ? (
            <path d={r.d} class="asm__minor" />
          ) : (
            <g class="asm__road">
              <path d={r.d} class="asm__road-out asm__draw" pathLength="1" />
              <path d={r.d} class="asm__road-in" />
            </g>
          ),
        )
      }
      <g class="asm__road asm__road--loop">
        <path d={loop} class="asm__road-out asm__draw" pathLength="1"></path>
        <path d={loop} class="asm__road-in"></path>
      </g>

      {/* The Mile Square and Monument Circle, downtown. */}
      <rect x={dx - 12} y={dy - 12} width="24" height="24" class="asm__square"></rect>
      <path
        d={`M${dx - 12} ${dy - 12} L${dx + 12} ${dy + 12} M${dx + 12} ${dy - 12} L${dx - 12} ${dy + 12}`}
        class="asm__square"></path>
    </g>

    {/* Road numbers on small paper ovals. */}
    {
      roads
        .filter((r) => r.at)
        .map((r) => (
          <g class="asm__shield" transform={`translate(${r.at![0]} ${r.at![1]})`}>
            <rect x="-21" y="-14" width="42" height="28" rx="14" />
            <text y="6" text-anchor="middle">
              {r.name}
            </text>
          </g>
        ))
    }
    <g class="asm__shield" transform={`translate(${project([39.665, -86.15]).join(' ')})`}>
      <rect x="-27" y="-14" width="54" height="28" rx="14"></rect>
      <text y="6" text-anchor="middle"> 465 </text>
    </g>

    {/* The towns. */}
    {
      placed.map((t) => {
        const l = labelAt(t);
        return (
          <g class:list={['asm__town', t.home && 'asm__town--home']}>
            {t.home && <circle cx={t.x} cy={t.y} r="17" class="asm__ring" />}
            <circle cx={t.x} cy={t.y} r={t.home ? 7 : 5.5} class="asm__dot" />
            <text x={l.x} y={l.y} text-anchor={l.anchor} class="asm__name">
              {t.name}
            </text>
            {t.home && (
              <text x={l.x} y={l.y + 30} text-anchor={l.anchor} class="asm__note">
                the studio
              </text>
            )}
          </g>
        );
      })
    }

    {/* North arrow and scale, bottom right. */}
    <g class="asm__furniture">
      <g transform={`translate(${MAP_W - 52} ${MAP_H - 150})`}>
        <path d="M0 -38 L9 8 L0 0 L-9 8 Z" class="asm__north"></path>
        <text y="34" text-anchor="middle" class="asm__n">N</text>
      </g>
      <path
        d={`M${scaleX} ${scaleY - 7} V${scaleY} H${scaleX + mile5} V${scaleY - 7} M${scaleX + mile5 / 2} ${scaleY} V${scaleY - 5}`}
        class="asm__scale"></path>
      <text x={scaleX + mile5 / 2} y={scaleY + 28} text-anchor="middle" class="asm__small">
        5 miles
      </text>
    </g>

    {
      framed && (
        <text x="44" y="70" class="asm__title">
          Greater Indianapolis
        </text>
      )
    }
  </svg>
</figure>

<style>
  .asm {
    /* Ink for the drawing. The ground colour matters: the double-line roads
       paint their middle in it. */
    --asm-ground: var(--color-bg);
    --asm-line: var(--color-chip-6);
    --asm-fine: var(--color-chip-5);
    --asm-water: var(--color-chip-4);
    margin: 0;
  }
  .asm--framed {
    --asm-ground: var(--color-paper);
  }
  .asm svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .asm__ground {
    fill: var(--asm-ground);
  }

  .asm__road-out {
    fill: none;
    stroke: var(--asm-line);
    stroke-width: 6.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .asm__road-in {
    fill: none;
    stroke: var(--asm-ground);
    stroke-width: 3.6;
    stroke-linecap: round;
  }
  .asm__road--loop .asm__road-out {
    stroke-width: 8;
    opacity: 0.75;
  }
  .asm__road--loop .asm__road-in {
    stroke-width: 4.4;
  }
  .asm__minor {
    fill: none;
    stroke: var(--asm-fine);
    stroke-width: 1.6;
    stroke-dasharray: 10 7;
    opacity: 0.55;
  }
  .asm__river {
    fill: none;
    stroke: var(--asm-water);
    stroke-width: 2.4;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .asm__lake {
    stroke: var(--asm-water);
    stroke-width: 1.6;
    opacity: 0.85;
  }
  .asm__hatch {
    stroke: var(--asm-water);
    stroke-width: 1.2;
    opacity: 0.6;
  }
  .asm__square {
    fill: none;
    stroke: var(--asm-line);
    stroke-width: 1.4;
    opacity: 0.7;
  }

  .asm__shield rect {
    fill: var(--asm-ground);
    stroke: var(--asm-fine);
    stroke-width: 1.4;
  }
  .asm__shield text {
    font: 600 15px var(--font-body);
    fill: var(--color-chip-7);
  }

  .asm__dot {
    fill: var(--asm-ground);
    stroke: var(--color-chip-7);
    stroke-width: 2;
  }
  .asm__town--home .asm__dot {
    fill: var(--color-chip-7);
  }
  .asm__ring {
    fill: none;
    stroke: var(--color-chip-5);
    stroke-width: 1.5;
  }
  .asm__name {
    font: 300 italic 27px var(--font-display);
    fill: var(--color-ink);
    letter-spacing: -0.01em;
    paint-order: stroke;
    stroke: var(--asm-ground);
    stroke-width: 7px;
    stroke-linejoin: round;
  }
  .asm__town--home .asm__name {
    font-size: 38px;
    fill: var(--color-chip-7);
  }
  .asm__note {
    font: 500 17px var(--font-body);
    fill: var(--color-ink-2);
    paint-order: stroke;
    stroke: var(--asm-ground);
    stroke-width: 6px;
  }

  .asm__north {
    fill: var(--asm-line);
    opacity: 0.8;
  }
  .asm__n {
    font: 300 italic 26px var(--font-display);
    fill: var(--asm-line);
  }
  .asm__scale {
    fill: none;
    stroke: var(--asm-line);
    stroke-width: 1.5;
  }
  .asm__small {
    font: 500 16px var(--font-body);
    fill: var(--color-ink-2);
  }
  .asm__title {
    font: 300 italic 34px var(--font-display);
    fill: var(--color-chip-7);
  }

  /* On a phone the drawing is ~360px wide, so 27-unit names would be ~10px.
     Set them larger there (SVG units scale with the drawing). */
  @media (max-width: 640px) {
    .asm__name {
      font-size: 36px;
      stroke-width: 8px;
    }
    .asm__town--home .asm__name {
      font-size: 48px;
    }
    .asm__note {
      font-size: 24px;
    }
    .asm__shield,
    .asm__furniture,
    .asm__title {
      display: none;
    }
  }

  /* The roads and rivers draw themselves in as the map arrives. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .asm__draw {
        stroke-dasharray: 1;
        animation: asm-draw linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes asm-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
