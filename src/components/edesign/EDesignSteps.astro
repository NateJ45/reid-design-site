---
// Safe to edit by hand
// E-Design "How it works" (phase 2 rebuild, 2026-09-30; DESIGN.md "Services
// and E-Design"). Each step hangs off one thread that runs left to right
// (top to bottom on a phone), the way the plan travels from your photos to
// your inbox, pinned by a paint-chip swatch that deepens down the ramp. No
// 01/02 numerals (2026-09-30, the no-decorative-numbering rule in DESIGN.md):
// the thread and the order carry the sequence. The thread draws
// itself as the section scrolls in (CSS only; the default is fully drawn).
//
// Data: eDesignPage.howItWorks[] (stepNumber, title, body). Renders nothing
// with no steps.
import SectionHeading from '@/components/SectionHeading.astro';

interface Step {
  stepNumber?: number;
  title?: string;
  body?: string;
}
interface Props {
  steps?: Step[] | null;
}
const { steps } = Astro.props as Props;
const list = steps ?? [];
// Pin tones, palest to deepest along the thread (never Warm Bronze, which is
// the thread's own colour).
const PIN_TONES = [2, 3, 4, 6, 7];
---

{
  list.length > 0 && (
    <section class="eds" aria-labelledby="edesign-how-heading">
      <div class="r-wrap">
        <SectionHeading headline="How E-Design works" headingId="edesign-how-heading" />
        <ol class="eds__list" style={`--n:${list.length}`}>
          {list.map((step, i) => (
            <li class="eds__step">
              <span
                class="eds__pin"
                aria-hidden="true"
                style={`--tone:var(--color-chip-${PIN_TONES[i % PIN_TONES.length]})`}
              />
              <h3 class="r-h3 eds__title">{step.title}</h3>
              {step.body && <p class="eds__body">{step.body}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .eds {
    background: var(--color-paper);
    padding-block: clamp(4.5rem, 9vw, 8rem);
    overflow-x: clip;
  }
  .eds__list {
    position: relative;
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 2rem;
  }
  /* The thread, through the middle of the pins. */
  .eds__list::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.85rem;
    height: 1.5px;
    background: var(--color-chip-5);
    transform-origin: left center;
  }
  .eds__step {
    position: relative;
  }
  /* A paint-chip swatch pinned on the thread, with a paper collar so the
     thread reads as passing behind it. */
  .eds__pin {
    position: relative;
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 3px;
    background: var(--tone);
    box-shadow:
      0 0 0 5px var(--color-paper),
      0 6px 12px -4px rgb(35 30 27 / 0.35);
  }
  .eds__title {
    margin: 1.4rem 0 0.8rem;
    max-width: 14ch;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .eds__body {
    margin: 0;
    max-width: 32ch;
    color: var(--color-ink-2);
    line-height: 1.55;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .eds__list::before {
        animation: eds-thread linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
    }
  }
  @keyframes eds-thread {
    from {
      transform: scaleX(0.04);
    }
  }

  @media (max-width: 1023px) {
    .eds__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
      padding-left: 3.5rem;
    }
    .eds__list::before {
      left: 0.85rem;
      right: auto;
      top: 0.5rem;
      bottom: 0.5rem;
      width: 1.5px;
      height: auto;
      transform-origin: center top;
    }
    .eds__pin {
      position: absolute;
      left: -3.5rem;
      top: 0.1rem;
    }
    .eds__title {
      margin-top: 0;
      max-width: none;
    }
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .eds__list::before {
          animation-name: eds-thread-v;
        }
      }
    }
  }
  @keyframes eds-thread-v {
    from {
      transform: scaleY(0.04);
    }
  }
</style>
