---
// Safe to edit by hand (the look); the words come from the room's manifest
// =============================================================================
// RoomBrief: the card the annotated concept room opens on (2026-10-03)
// =============================================================================
// A page from the planning notebook, filled in like a form: "The brief" in
// Zodiak, the small line "an example" (it is never a real client, PRODUCT.md:
// copy never invents personal detail), then the three questions Staci asks
// on /process in General Sans 500, each answered in Zodiak italic sitting on
// a ruled line, the way a hand answers a printed question.
//
// The notebook page is a DIFFERENT object from the piece tags on purpose:
// paper, fine ruled lines, a short Warm Bronze rule over the title, no notch
// and no hole. The beat cards (RoomNotes.astro) share the `.npage` look,
// which is why it is global (scoped to `.room` by its name).
//
// Shown while the room is still empty (in the beat card's place on a laptop,
// in the tag's place on a phone).
// =============================================================================
import type { RoomBrief as Brief } from '@/lib/room-story';

interface Props {
  brief: Brief;
}

const { brief } = Astro.props as Props;
---

<div class="npage room__card room__brief" data-card="0">
  <p class="room__brief-title">
    <span>{brief.title}</span>
    <small>{brief.tag}</small>
  </p>
  <dl class="room__brief-rows">
    {
      brief.rows.map((r) => (
        <div class="room__brief-row">
          <dt>{r.question}</dt>
          <dd>{r.answer}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style is:global>
  /* ---- the notebook page (brief + beat cards) ---------------------------
     Paper with a soft shadow like a loose page. Its ruled lines are drawn
     on the writing itself (each line box carries one rule just under the
     baseline, see .room__beat-text and the brief's answers), so they always
     line up with the words. */
  .room .npage {
    --line: 1.6rem;
    position: relative;
    box-sizing: border-box;
    padding: 1.05rem 1.2rem 1.15rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow:
      0 0 0 1px rgb(35 30 27 / 0.06),
      0 1px 2px rgb(35 30 27 / 0.08),
      0 18px 30px -18px rgb(35 30 27 / 0.4);
  }
  /* A short Warm Bronze rule over the text: a mark, never a numeral. */
  .room .npage::before {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-bottom: 0.6rem;
    background: var(--color-chip-5);
  }

  .room__brief-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.35rem;
  }
  .room__brief-title span {
    font: 300 1.45rem/1.1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .room__brief-title small {
    font: 500 0.74rem/1.2 var(--font-body);
    color: var(--color-ink-2);
  }
  .room__brief-rows {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }
  .room__brief-row dt {
    font: 500 0.76rem/1.3 var(--font-body);
    color: var(--color-ink-2);
  }
  .room__brief-row dd {
    margin: 0.05rem 0 0;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid rgb(156 118 97 / 0.32);
    font: italic 400 1.08rem/1.3 var(--font-display);
    letter-spacing: -0.005em;
  }
  .room__brief-row:last-child dd {
    border-bottom: 0;
  }
</style>
