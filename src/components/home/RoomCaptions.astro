---
// Foundation, edit with care
// =============================================================================
// RoomCaptions: ONE concept room's captions (split out of RoomStage.astro on
// 2026-09-30 for the room tabs; the caption CARD of the scrub, 2026-10-02).
// The first room's list is rendered in place, the others inside <template>s,
// and the script swaps the whole <ol>.
// =============================================================================
// One <ol>, two looks:
//   - No script: a plain list of every caption under the finished room.
//   - With the scrub (`@media (scripting: enabled)`): a small paper caption
//     card, the `.r-tag` vocabulary (paper, a pointed top-left corner with a
//     punched-hole ring, a soft drop shadow). Every caption sits in the same
//     grid cell, so the card is always as tall as its longest caption and
//     never changes size; only the current beat (aria-current="step", set by
//     the RoomStage script from the scroll position) shows, and a beat change
//     cross-fades (no animation under reduced motion). Before the script has
//     read the scroll, the first caption shows. The card sits in the margin
//     left of the room on a wide laptop window, over the room's lower-left
//     corner (narrow) in a tall one, and below the room on a phone.
// Each caption is led by a short Warm Bronze rule: a mark, never a numeral.
// A visually hidden live region in RoomStage reads each new caption aloud;
// the hidden captions here are `visibility: hidden`, so they are not read.
// =============================================================================
interface Props {
  stages: string[];
}

const { stages } = Astro.props as Props;
---

<ol class="room__captions" id="room-captions">
  {
    stages.map((caption) => (
      <li class="room__step" data-room-step>
        <p>{caption}</p>
      </li>
    ))
  }
</ol>

<style>
  .room__captions {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    display: grid;
    gap: 1.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .room__step p {
    margin: 0;
    max-width: 34ch;
    font: 300 clamp(1.15rem, 1.6vw, 1.4rem) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .room__step p::before {
    content: '';
    display: block;
    width: 2.25rem;
    height: 2px;
    margin-bottom: 0.6rem;
    background: var(--color-chip-5);
  }

  /* ---- the caption card (the scrub) -------------------------------------- */
  @media (scripting: enabled) {
    .room__captions {
      position: relative;
      z-index: 3;
      /* Every caption in one cell: the card is as tall as the longest. */
      grid-template-areas: 'beat';
      gap: 0;
      margin: 0.75rem 0 0;
      padding: 0.8rem 1.1rem 0.9rem 2.1rem;
      background: var(--color-paper);
      color: var(--color-ink);
      /* A paper tag: pointed at the top-left, where its hole is punched. */
      clip-path: polygon(1.1rem 0, 100% 0, 100% 100%, 1.1rem 100%, 1.1rem 2.6rem, 0 1.3rem);
      filter: drop-shadow(0 10px 14px rgb(35 30 27 / 0.2));
    }
    .room__captions::before {
      content: '';
      position: absolute;
      left: 0.6rem;
      top: 1.3rem;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      translate: 0 -50%;
      box-shadow: inset 0 0 0 1.5px var(--color-chip-5);
    }
    .room__step {
      grid-area: beat;
      opacity: 0;
      visibility: hidden;
    }
    .room__step[aria-current='step'],
    .room__captions:not(:has([aria-current])) .room__step:first-child {
      opacity: 1;
      visibility: visible;
    }
    .room__step p {
      max-width: none;
      font-size: clamp(1rem, 1.15vw, 1.15rem);
      line-height: 1.32;
    }
    .room__step p::before {
      width: 1.75rem;
      margin-bottom: 0.45rem;
    }
  }
  @media (scripting: enabled) and (min-width: 1024px) {
    /* Laptop, tight fit (a tall window leaves the room no side margins): a
       narrow card over the room's lower-left corner, clear of the progress
       rule. It is narrow on purpose: the coffee table begins about half way
       across, and a wide card used to sit on it. */
    .room__captions {
      position: absolute;
      left: 1rem;
      bottom: calc(var(--room-rule, 1.25rem) + 1rem);
      width: min(14.5rem, 36%);
      margin: 0;
    }
  }
  @media (scripting: enabled) and (min-width: 1100px) and (min-aspect-ratio: 8/5) {
    /* Laptop, wide window (1280x800, 1366x768, 1440x900, 1920x1080): the room
       is height-limited, so it leaves side margins of about 260px or more
       (the card is 13.25rem, which keeps a gap to the screen edge at 1280). The
       card sits in the LEFT margin beside the room, bottom-aligned with it, so
       it never covers the furniture. The 8/5 test stands in for "the margin is
       wide enough"; a taller window falls back to the narrow overlay above. */
    .room__captions {
      left: auto;
      right: calc(100% + 1rem);
      bottom: calc(var(--room-rule, 1.25rem) + 1rem);
      width: 13.25rem;
    }
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .room__step {
      transition:
        opacity 320ms var(--ease),
        visibility 0s linear 320ms;
    }
    .room__step[aria-current='step'] {
      transition:
        opacity 320ms var(--ease),
        visibility 0s;
    }
  }
</style>
