---
// Safe to edit by hand
// Services as a PAINT STRIP (2026-09-29 rebuild; prototype
// docs/design/prototypes/a-sample-board.html). Each service is one chip on
// the bronze ramp, palest (first) to deepest (last), with a punched hole, the
// name, and the price printed on the colour face; the white label below
// carries the first three features and the link. The chips stand slightly
// out of line like a strip on the rack and lift on hover.
//
// Data: the same `service` documents the old grid used (showOnHomepage, in
// Staci's order). Prices are free text in Sanity ("$225", "starting at $995",
// "$100 per hour"); the amount is pulled out and printed big, the words
// around it become the small line. Anything without a $ amount prints as-is.
//
// Each chip face carries one of Staci's finished rooms, faded into the paint
// (RoomBackdrop, 2026-09-30 design pass), so the cards have depth and show
// her work. Which rooms: src/data/room-backdrops.ts.
//
// Phone and tablet: the strip scrolls sideways with snap, one chip centred.
// Contrast: ink on chips 1-4 >= 7:1, cream on chips 5-7 >= 3.9:1 and cream is
// only used there at >= 24px (name, price); small cream text sits on 6-7 only.
import CtaLink from '@/components/CtaLink.astro';
import RiseWords from '@/components/RiseWords.astro';
import RoomBackdrop from '@/components/RoomBackdrop.astro';
import type { CtaBlock } from '@/lib/cta';
import { splitPrice } from '@/lib/split-copy';

interface Service {
  _id?: string;
  name?: string;
  slug?: { current?: string };
  price?: string;
  features?: string[];
  badge?: string;
  ctaLabel?: string;
}

interface Props {
  headline?: string | null;
  scriptAccent?: string | null;
  subhead?: string | null;
  services?: Service[];
  cta?: CtaBlock | null;
  footnote?: string | null;
}

const {
  headline = 'Pick your starting point.',
  scriptAccent,
  subhead,
  services = [],
  cta,
  footnote,
} = Astro.props as Props;

// Spread the services across the seven-tone ramp: first = chip 1, last = 7.
const n = services.length;
// Chip 5 (Warm Bronze) is SKIPPED: no text colour passes AA at small sizes on
// it (ink 4.06:1, cream 3.5:1), and every chip face carries small text.
const RAMP = [1, 2, 3, 4, 6, 7];
const toneFor = (i: number) =>
  RAMP[n <= 1 ? 0 : Math.round((i * (RAMP.length - 1)) / (n - 1))] ?? 1;

// splitPrice (src/lib/split-copy.ts) parses the CLEAN price and returns the
// stega run separately, rendered once after the amount (preview only).
---

<section class="chips" aria-labelledby="services-heading">
  <div class="r-wrap">
    <div class="chips__head">
      <RiseWords
        as="h2"
        id="services-heading"
        text={headline ?? ''}
        accent={scriptAccent}
        class="r-h2"
      />
      {subhead && <p class="r-lede chips__sub">{subhead}</p>}
    </div>

    <ol class="chips__strip">
      {
        services.map((s, i) => {
          const tone = toneFor(i);
          const { label, amount, unit, run } = splitPrice(s.price);
          const href = s.slug?.current ? `/services#${s.slug.current}` : '/services';
          return (
            <li
              class="chip"
              style={`--i:${i}; --tone: var(--color-chip-${tone})`}
              data-on={tone >= 5 ? 'cream' : 'ink'}
            >
              <a class="chip__link" href={href}>
                {s.badge && <span class="chip__flag">{s.badge}</span>}
                <div class="chip__face r-backdrop-host">
                  <RoomBackdrop index={i} ratio={0.8} tone={tone >= 5 ? 'deep' : 'pale'} />
                  <h3 class="chip__name">{s.name}</h3>
                  <p class="chip__price">
                    <small>{label}</small>
                    {amount}
                    {run}
                    {unit && <span class="chip__unit">{unit}</span>}
                  </p>
                </div>
                <div class="chip__label">
                  {s.features && s.features.length > 0 && (
                    <ul>
                      {s.features.slice(0, 3).map((f) => (
                        <li>{f}</li>
                      ))}
                    </ul>
                  )}
                  <span class="chip__go">
                    {s.ctaLabel || 'See the details'}
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ol>

    <div class="chips__foot">
      {footnote && <p>{footnote}</p>}
      <CtaLink
        cta={cta}
        variant="secondary"
        fallbackHref="/services"
        fallbackLabel="Compare everything on the services page"
      />
    </div>
  </div>
</section>

<style>
  .chips {
    background: var(--color-paper);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .chips__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .chips__head :global(.r-h2) {
    grid-column: 1 / 8;
    margin: 0;
  }
  .chips__sub {
    grid-column: 9 / 13;
    margin: 0;
  }

  .chips__strip {
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    grid-auto-flow: column;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    align-items: start;
  }

  .chip {
    /* Out of line like a strip on the rack: every other chip drops a little. */
    transform: translateY(var(--y));
  }
  .chip:nth-child(even) {
    --y: 1.25rem;
  }
  .chip:nth-child(odd) {
    --y: 0rem;
  }
  .chip__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-paper);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 26px 40px -30px rgb(35 30 27 / 0.55);
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .chip__link:hover,
  .chip__link:focus-visible {
    transform: translateY(-0.9rem);
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 36px 50px -30px rgb(35 30 27 / 0.7);
  }
  .chip__link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .chip__face {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    aspect-ratio: 4 / 5;
    padding: 2.4rem 1.25rem 1.25rem;
    background: var(--tone);
    color: var(--color-ink);
  }
  .chip[data-on='cream'] .chip__face {
    color: var(--color-cream);
  }
  /* The punched hole the strip hangs from. */
  .chip__face::before {
    content: '';
    position: absolute;
    top: 0.85rem;
    left: 50%;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    translate: -50% 0;
    background: var(--color-paper);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.2);
  }
  .chip__name {
    margin: 0;
    font: 300 clamp(1.45rem, 1rem + 0.9vw, 1.95rem) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    color: inherit;
    text-wrap: balance;
  }
  .chip__price {
    margin: 0;
    font: 300 clamp(2rem, 1.3rem + 1.4vw, 2.9rem) / 1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .chip__price small {
    display: block;
    margin-bottom: 0.4rem;
    font: 500 0.78rem/1.2 var(--font-body);
    letter-spacing: 0;
  }
  .chip__unit {
    font-size: 0.5em;
  }
  .chip__label {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1.1rem 1.25rem 1.25rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .chip__label ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .chip__label li {
    display: flex;
    gap: 0.55rem;
  }
  .chip__label li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.5em;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: inset 0 0 0 1px rgb(35 30 27 / 0.25);
  }
  .chip__go {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    font-weight: 500;
    color: var(--color-ink);
  }
  .chip__flag {
    position: absolute;
    z-index: 1;
    top: -0.8rem;
    right: 1rem;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-cream);
    font: 500 0.75rem/1 var(--font-body);
  }

  .chips__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-ink-2);
  }
  .chips__foot p {
    margin: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip {
      animation: chip-in 900ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
  }
  @keyframes chip-in {
    from {
      transform: translateY(calc(var(--y) + 3rem)) rotate(3deg);
    }
  }

  @media (max-width: 1023px) {
    .chips__head {
      display: block;
    }
    .chips__sub {
      margin-top: 1rem;
    }
    .chips__strip {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: clamp(1rem, 4vw, 3.5rem);
      padding: 1.75rem clamp(1rem, 4vw, 3.5rem) 2.25rem;
      margin-inline: calc(clamp(1rem, 4vw, 3.5rem) * -1);
      scrollbar-width: none;
    }
    .chip {
      flex: 0 0 min(78%, 20rem);
      scroll-snap-align: center;
    }
  }
</style>
