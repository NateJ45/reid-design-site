---
// Safe to edit by hand
// Home process preview on a TAPE MEASURE (2026-09-29 rebuild). The steps
// hang off the tape like marks on a job site; the tape pulls out of its case
// as the section scrolls into view (scroll-driven, CSS only, with @supports
// so browsers without view timelines just show the full tape).
//
// Data: the same processStep documents and homePage.processPreview* fields
// the old ProcessPreview used. Each step's marker is its time estimate
// ("Single visit", "2 to 3 weeks") set in Zodiak italic, not a 01/02 numeral
// (2026-09-30, the no-decorative-numbering rule in DESIGN.md): the tape and
// the order already say which comes first. The inch figures printed on the
// tape itself are part of the drawing (aria-hidden) and stay.
//
// Phone: the tape turns vertical and runs down the left edge of the steps.
import CtaLink from '@/components/CtaLink.astro';
import RiseWords from '@/components/RiseWords.astro';
import type { CtaBlock } from '@/lib/cta';

interface Step {
  stepNumber?: number;
  title?: string;
  timeEstimate?: string;
  shortDescription?: string;
}

interface Props {
  headline?: string | null;
  subhead?: string | null;
  steps?: Step[];
  cta?: CtaBlock | null;
}

const {
  headline = 'What happens after you call.',
  subhead,
  steps = [],
  cta,
} = Astro.props as Props;
// Inch numbers printed along the tape (decorative).
const INCHES = Array.from({ length: 14 }, (_, i) => i);
---

<section class="tape" aria-labelledby="process-heading">
  <div class="r-wrap">
    <div class="tape__head">
      <RiseWords as="h2" id="process-heading" text={headline ?? ''} class="r-h2" />
      {subhead && <p class="r-lede">{subhead}</p>}
    </div>

    <div class="tape__rule" aria-hidden="true">
      <div class="tape__band">
        <div class="tape__nums">{INCHES.map((n) => <span>{n}</span>)}</div>
      </div>
      <div class="tape__case"></div>
    </div>

    <ol class="tape__steps">
      {
        steps.map((s) => (
          <li class="tape__step">
            {s.timeEstimate && <span class="tape__when">{s.timeEstimate}</span>}
            <h3 class="r-h3">{s.title}</h3>
            {s.shortDescription && <p>{s.shortDescription}</p>}
          </li>
        ))
      }
    </ol>

    {
      cta?.label && (
        <CtaLink cta={cta} variant="primary" fallbackHref="/process" class="tape__cta" />
      )
    }
  </div>
</section>

<style>
  .tape {
    padding-block: clamp(5rem, 10vw, 8.5rem);
    overflow-x: clip;
  }
  .tape__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
  }
  .tape__head :global(.r-h2) {
    grid-column: 1 / 8;
    margin: 0;
    max-width: 14ch;
  }
  .tape__head .r-lede {
    grid-column: 9 / 13;
    margin: 0;
  }

  .tape__rule {
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  /* The tape: three tick lengths (1/8, 1/2, inch) over the tape colour. */
  .tape__band {
    position: relative;
    height: 3.5rem;
    border-radius: 2px 0.5rem 0.5rem 2px;
    background:
      repeating-linear-gradient(90deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 / 0.75rem
        0.85rem repeat-x,
      repeating-linear-gradient(90deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 / 3.75rem
        1.5rem repeat-x,
      repeating-linear-gradient(90deg, var(--color-ink) 0 1.5px, transparent 1.5px 100%) 0 0 /
        7.5rem 2.1rem repeat-x,
      var(--color-chip-2);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.06);
    overflow: hidden;
  }
  .tape__nums {
    position: absolute;
    left: 0;
    bottom: 0.35rem;
    display: flex;
    font: 500 0.7rem/1 var(--font-body);
    color: var(--color-ink);
  }
  .tape__nums span {
    flex: none;
    width: 7.5rem;
    padding-left: 0.3rem;
  }
  .tape__case {
    position: absolute;
    left: -1.5rem;
    top: -1.4rem;
    display: grid;
    place-items: center;
    width: 6.25rem;
    height: 6.25rem;
    border-radius: 1.4rem;
    background: var(--color-ink);
    box-shadow: 0 20px 30px -18px rgb(0 0 0 / 0.6);
  }
  .tape__case::after {
    content: '';
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 2px solid rgb(245 237 227 / 0.3);
  }

  .tape__steps {
    list-style: none;
    margin: 0;
    padding: 0 0 0 7rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    grid-auto-flow: column;
    gap: 1.5rem;
  }
  .tape__step {
    position: relative;
    padding-top: 3.4rem;
  }
  /* Drop line from the tape to the step, with a pin at its foot. */
  .tape__step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1.5px;
    height: 2.5rem;
    background: var(--color-chip-5);
  }
  .tape__step::after {
    content: '';
    position: absolute;
    left: -4px;
    top: 2.4rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-chip-5);
  }
  .tape__when {
    display: block;
    font: 300 italic 1.4rem/1.1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-chip-7);
  }
  .tape__step :global(.r-h3) {
    margin: 0.75rem 0 0.8rem;
  }
  .tape__step p {
    margin: 0;
    max-width: 30ch;
    font-size: 0.97rem;
    color: var(--color-ink-2);
  }
  .tape :global(.tape__cta) {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tape__band {
        animation: tape-pull linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }
  @keyframes tape-pull {
    from {
      clip-path: inset(0 86% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Phone and tablet: a vertical ruler down the left of the steps. */
  @media (max-width: 1023px) {
    .tape__head {
      display: block;
    }
    .tape__head .r-lede {
      margin-top: 1rem;
    }
    .tape__rule {
      display: none;
    }
    .tape__steps {
      position: relative;
      display: grid;
      grid-auto-flow: row;
      grid-template-columns: 1fr;
      gap: 2.75rem;
      margin-top: 2.75rem;
      padding-left: 3.6rem;
    }
    .tape__steps::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1.9rem;
      border-radius: 2px 2px 0.5rem 0.5rem;
      background:
        repeating-linear-gradient(180deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 /
          0.75rem 0.75rem repeat-y,
        repeating-linear-gradient(180deg, var(--color-ink) 0 1px, transparent 1px 100%) 0 0 /
          1.25rem 3.75rem repeat-y,
        var(--color-chip-2);
    }
    .tape__step {
      padding-top: 0;
    }
    .tape__step::before {
      left: -1.75rem;
      top: 0.55rem;
      width: 1.5rem;
      height: 1.5px;
    }
    .tape__step::after {
      left: -0.35rem;
      top: 0.3rem;
    }
  }
</style>
