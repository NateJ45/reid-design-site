---
// Foundation, edit with care
// Home hero, "the fan deck" (2026-09-29 art-direction rebuild; prototype in
// docs/design/prototypes/b-fan-deck.html).
//
//   ┌────────────── Walnut bronze ground ──────────┬──── portrait ────┐
//   │  eyebrow line                                  │                  │
//   │                                                │   heroPortrait   │
//   │  HEADLINE in Zodiak, accent phrase italic oat  │   (or first hero │
//   │                                                │    image)        │
//   │  subhead            [primary CTA] secondary    │ ◢ fan deck opens │
//   └────────────────────────────────────────────────┴──────────────────┘
//
// Phone: the portrait sits on top (62svh), the bronze block with the
// headline below it, the fan deck pinned where the two meet.
//
// Content (all from the homePage singleton, nothing new to fill in except the
// optional heroPortrait): heroEyebrow, heroHeadline, heroScriptAccent (italic
// phrase), heroSubhead, heroPrimaryCta, heroSecondaryCta.
//
// LCP: the portrait is eager + fetchpriority high. The headline words rise
// into clip boxes (RiseWords) but are never transparent, so the LCP text is
// painted on the first frame (the Stone Steps lesson). The fan deck is pure
// CSS, decorative, aria-hidden. Reduced motion: everything is static.
//
// Contrast (measured 2026-09-29; the axe gate caught a wrong earlier note):
// NO text colour passes AA at body size on Warm Bronze #9c7661 (ink 4.06:1,
// cream 3.5:1). So the hero ground is WALNUT (chip 6, #80604f): cream on it
// is 4.9:1 for every line, and the accent phrase is Oat italic (3.7:1, used
// only at display size). Warm Bronze still leads in the fan deck beside it.
import SanityImage from '@/components/SanityImage.astro';
import RiseWords from '@/components/RiseWords.astro';
import { resolveCtaHref, ctaOpensNewTab, type CtaBlock } from '@/lib/cta';
// Google rating under the buttons (2026-09-30). Renders nothing until
// siteSettings has both a rating and a review count.
import RatingTag from '@/components/reviews/RatingTag.astro';
import { googleRatingFrom, type GoogleRatingSettings } from '@/lib/reviews';

interface SanityImageObject {
  asset?: { _ref?: string; _id?: string };
  alt?: string;
  hotspot?: { x: number; y: number; height: number; width: number };
  crop?: { top: number; bottom: number; left: number; right: number };
}

interface Props {
  eyebrow?: string | null;
  headline: string;
  accent?: string | null;
  subhead?: string | null;
  portrait?: SanityImageObject | null;
  fallbackImages?: (SanityImageObject | null)[] | null;
  fallbackImage?: SanityImageObject | null;
  primaryCta?: CtaBlock | null;
  secondaryCta?: CtaBlock | null;
  headingId?: string;
  /** siteSettings, for the Google rating tag (googleRating, googleReviewCount, googleBusinessUrl). */
  ratingSettings?: GoogleRatingSettings | null;
}

const {
  eyebrow,
  headline,
  accent,
  subhead,
  portrait,
  fallbackImages,
  fallbackImage,
  primaryCta,
  secondaryCta,
  headingId = 'hero-heading',
  ratingSettings,
} = Astro.props as Props;

const photo = portrait?.asset ? portrait : (fallbackImages?.find((i) => i?.asset) ?? fallbackImage);

// The seven tones of the paint strip, palest to deepest. The same names are
// the design's token names (--color-chip-1 ... -7) in src/styles/globals.css.
const CHIPS = [
  { name: 'Linen', on: 'ink' },
  { name: 'Oat', on: 'ink' },
  { name: 'Sandbar', on: 'ink' },
  { name: 'Saddle', on: 'ink' },
  { name: 'Warm Bronze', on: 'cream' },
  { name: 'Walnut', on: 'cream' },
  { name: 'Espresso', on: 'cream' },
];

const primaryHref = resolveCtaHref(primaryCta, '/services');
const secondaryHref = resolveCtaHref(secondaryCta, '/contact');
---

<section class="home-hero" aria-labelledby={headingId}>
  <div class="home-hero__copy">
    {eyebrow && <p class="home-hero__eyebrow">{eyebrow}</p>}
    <RiseWords as="h1" id={headingId} text={headline} accent={accent} class="home-hero__h1" />
    <div class="home-hero__foot">
      {subhead && <p class="home-hero__sub">{subhead}</p>}
      <div class="home-hero__ctas">
        {
          primaryCta?.label && (
            <a
              class="r-btn r-btn--ink"
              href={primaryHref}
              target={ctaOpensNewTab(primaryCta) ? '_blank' : undefined}
              rel={ctaOpensNewTab(primaryCta) ? 'noopener noreferrer' : undefined}
            >
              {primaryCta.label}
              <span class="r-arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
        {
          secondaryCta?.label && (
            <a
              class="r-link home-hero__secondary"
              href={secondaryHref}
              target={ctaOpensNewTab(secondaryCta) ? '_blank' : undefined}
              rel={ctaOpensNewTab(secondaryCta) ? 'noopener noreferrer' : undefined}
            >
              {secondaryCta.label}
            </a>
          )
        }
      </div>
      {
        googleRatingFrom(ratingSettings) && (
          <div class="home-hero__rating">
            <RatingTag settings={ratingSettings} />
          </div>
        )
      }
    </div>
  </div>

  <div class="home-hero__photo">
    {
      photo?.asset && (
        <SanityImage
          source={photo}
          width={1100}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={70}
          class="home-hero__img"
        />
      )
    }
  </div>

  <div class="home-hero__fan" aria-hidden="true">
    {
      CHIPS.map((c, n) => (
        <span
          class={`home-hero__chip is-${c.on}`}
          style={`--n:${n};--tone:var(--color-chip-${n + 1})`}
        >
          <b>{c.name}</b>
        </span>
      ))
    }
  </div>
</section>

<style>
  .home-hero {
    --gut: clamp(1rem, 4vw, 3.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    min-height: clamp(640px, calc(100svh - 88px), 1000px);
    background: var(--color-chip-6);
    color: var(--color-cream);
    overflow: clip;
    /* The accent phrase is Oat italic on Walnut. */
    --accent-color: var(--color-chip-2);
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    /* Extra top room (2026-09-30) so the header logo plate, which hangs below
       the header line, clears the eyebrow. */
    padding: clamp(3.5rem, 8vw, 6.5rem) var(--gut) clamp(2.75rem, 6vw, 5.5rem);
    /* Start the copy on the page container's left edge on wide screens. */
    padding-left: max(var(--gut), calc((100vw - 85rem) / 2 + var(--gut)));
  }

  .home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 auto;
    font: 500 0.95rem/1.35 var(--font-body);
    color: var(--color-cream);
    max-width: 40ch;
  }
  .home-hero__eyebrow::before {
    content: '';
    flex: none;
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  /* :global because the h1 is rendered inside RiseWords, outside this
     component's style scope. */
  :global(.home-hero__h1) {
    margin: 0;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 0.9rem + 5.6vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 13ch;
    text-wrap: balance;
  }

  .home-hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
  }
  .home-hero__sub {
    margin: 0;
    max-width: 34ch;
    font: 500 1.08rem/1.5 var(--font-body);
    color: var(--color-cream);
    text-wrap: pretty;
  }
  .home-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .home-hero__secondary {
    color: var(--color-cream);
  }
  /* The Google rating tag takes its own row under the buttons, hung a touch
     off the copy's left edge like a tag tied to the deck. */
  .home-hero__rating {
    flex-basis: 100%;
    margin-top: 0.25rem;
  }

  .home-hero__photo {
    position: relative;
    min-height: 100%;
    /* Clip the settle zoom (scale 1.1 -> 1) so it never spills into the copy. */
    overflow: clip;
  }
  .home-hero__photo :global(.home-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  /* A soft bronze edge so the photo melts into the ground, not a hard seam. */
  .home-hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-chip-6) 0, transparent 16%);
    pointer-events: none;
  }

  /* ---- The fan deck. Seven chips pinned at one rivet, opened like the deck
     in Staci's hand. Pivot sits on the seam between copy and photo. ---- */
  .home-hero__fan {
    position: absolute;
    z-index: 1;
    left: calc(58.33% + 1.25rem);
    bottom: -3.75rem;
    width: clamp(5.25rem, 7.5vw, 7rem);
    aspect-ratio: 1 / 3.6;
    pointer-events: none;
  }
  .home-hero__chip {
    position: absolute;
    inset: 0;
    border-radius: 0.6rem;
    background: var(--tone);
    transform-origin: 50% 92%;
    transform: rotate(calc(-6deg + var(--n) * 10deg));
    box-shadow:
      0 20px 40px -24px rgb(0 0 0 / 0.55),
      inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .home-hero__chip b {
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 18%;
    font: 500 0.66rem/1.25 var(--font-body);
    color: var(--color-ink);
    opacity: 0.85;
  }
  .home-hero__chip.is-cream b {
    color: var(--color-cream);
  }
  /* The rivet. */
  .home-hero__chip::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    translate: -50% 0;
    background: radial-gradient(circle, #d8c3a5 30%, #8a6a4f 72%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__chip {
      animation: home-fan 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(450ms + var(--n) * 70ms);
    }
    .home-hero__photo :global(.home-hero__img) {
      animation: home-settle 2.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes home-fan {
    from {
      transform: rotate(-6deg);
    }
  }
  @keyframes home-settle {
    from {
      transform: scale(1.1);
    }
  }

  /* ---- Tablet and phone: photo on top, bronze copy below. ---- */
  @media (max-width: 1023px) {
    .home-hero {
      display: flex;
      flex-direction: column-reverse;
      min-height: 0;
    }
    .home-hero__photo {
      height: min(62svh, 38rem);
      min-height: 22rem;
    }
    .home-hero__photo::after {
      background: linear-gradient(0deg, var(--color-chip-6) 0, transparent 28%);
    }
    .home-hero__copy {
      padding-top: 0.5rem;
      margin-top: -1.5rem;
    }
    .home-hero__eyebrow {
      margin-bottom: 0.5rem;
    }
    .home-hero__fan {
      left: auto;
      right: 18%;
      bottom: auto;
      top: calc(min(62svh, 38rem) - 15rem);
      width: 3.6rem;
    }
    .home-hero__chip b {
      display: none;
    }
  }
</style>
