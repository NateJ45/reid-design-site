---
// Foundation, edit with care
// Home hero (2026-09-29 art-direction rebuild; prototype in
// docs/design/prototypes/b-fan-deck.html). The decorative fan deck of paint
// chips at the seam was removed 2026-09-30 (Nathan: the decorative swatches
// read as repetitive; chips now appear only where they carry content).
//
//   ┌────────────── Walnut bronze ground ──────────┬──── portrait ────┐
//   │  eyebrow line                                  │                  │
//   │                                                │   heroPortrait   │
//   │  HEADLINE in Zodiak, accent phrase italic oat  │   (or first hero │
//   │                                                │    image)        │
//   │  subhead            [primary CTA] secondary    │                  │
//   └────────────────────────────────────────────────┴──────────────────┘
//
// Phone: the portrait sits on top (50svh since 2026-10-04), the bronze block with the
// headline below it.
//
// Content (all from the homePage singleton, nothing new to fill in except the
// optional heroPortrait): heroEyebrow, heroHeadline, heroScriptAccent (italic
// phrase), heroSubhead, heroPrimaryCta, heroSecondaryCta.
//
// LCP: the portrait is eager + fetchpriority high. The headline words rise
// into clip boxes (RiseWords) but are never transparent, so the LCP text is
// painted on the first frame (the Stone Steps lesson). Reduced motion:
// everything is static.
//
// Contrast (measured 2026-09-29; the axe gate caught a wrong earlier note):
// NO text colour passes AA at body size on Warm Bronze #9c7661 (ink 4.06:1,
// cream 3.5:1). So the hero ground is WALNUT (chip 6, #80604f): cream on it
// is 4.9:1 for every line, and the accent phrase is Oat italic (3.7:1, used
// only at display size).
import SanityImage from '@/components/SanityImage.astro';
import RiseWords from '@/components/RiseWords.astro';
// Vite fingerprints the hand face; ?url gives the hashed path for the preload below.
import waterfallUrl from '@/assets/fonts/Waterfall-400.woff2?url';
import { resolveCtaHref, ctaOpensNewTab, type CtaBlock } from '@/lib/cta';
// Google rating under the buttons (2026-09-30). Renders nothing until
// siteSettings has a Google rating (no review count since 2026-10-01).
import RatingTag from '@/components/reviews/RatingTag.astro';
import { googleRatingFrom, type GoogleRatingSettings } from '@/lib/reviews';

interface SanityImageObject {
  asset?: { _ref?: string; _id?: string };
  alt?: string;
  hotspot?: { x: number; y: number; height: number; width: number };
  crop?: { top: number; bottom: number; left: number; right: number };
}

interface Props {
  eyebrow?: string | null;
  headline: string;
  accent?: string | null;
  subhead?: string | null;
  portrait?: SanityImageObject | null;
  fallbackImages?: (SanityImageObject | null)[] | null;
  fallbackImage?: SanityImageObject | null;
  primaryCta?: CtaBlock | null;
  secondaryCta?: CtaBlock | null;
  headingId?: string;
  /** siteSettings, for the Google rating tag (googleRating, googleReviewCount, googleBusinessUrl). */
  ratingSettings?: GoogleRatingSettings | null;
}

const {
  eyebrow,
  headline,
  accent,
  subhead,
  portrait,
  fallbackImages,
  fallbackImage,
  primaryCta,
  secondaryCta,
  headingId = 'hero-heading',
  ratingSettings,
} = Astro.props as Props;

const photo = portrait?.asset ? portrait : (fallbackImages?.find((i) => i?.asset) ?? fallbackImage);

const primaryHref = resolveCtaHref(primaryCta, '/services');
const secondaryHref = resolveCtaHref(secondaryCta, '/contact');
---

{
  /* Preload the two faces the headline is set in (2026-10-03). On a phone the
     subhead and buttons now sit above the fold, so a late font swap that
     re-wraps the headline shifted them (Lighthouse CLS 0.15 to 0.20 on a Linux
     runner, gate 0.1). The site-wide "no font preload" rule (BaseLayout.astro)
     was measured on a text-heavy Cormorant page where it delayed the hero photo;
     here only these two small files (~25 KB + 36 KB) are preloaded, on the home
     page only, and LCP is re-measured in CI. Revert by deleting these two
     links if the home page's LCP regresses. */
}
<link rel="preload" href="/fonts/Zodiak-300.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href={waterfallUrl} as="font" type="font/woff2" crossorigin />

<section class="home-hero" aria-labelledby={headingId}>
  <div class="home-hero__copy">
    {
      /* The top line: the eyebrow on the left, the Google rating tag hung
        at the right (moved up from under the buttons, 2026-10-01: the top
        corner was empty and the tag was crowding the foot). */
    }
    <div class="home-hero__top">
      {eyebrow && <p class="home-hero__eyebrow">{eyebrow}</p>}
      {
        googleRatingFrom(ratingSettings) && (
          <div class="home-hero__rating">
            <RatingTag settings={ratingSettings} />
          </div>
        )
      }
    </div>
    <RiseWords
      as="h1"
      id={headingId}
      text={headline}
      accent={accent}
      class="home-hero__h1 r-hand"
    />
    <div class="home-hero__foot">
      {subhead && <p class="home-hero__sub">{subhead}</p>}
      <div class="home-hero__ctas">
        {
          primaryCta?.label && (
            <a
              class="r-btn r-btn--ink"
              href={primaryHref}
              target={ctaOpensNewTab(primaryCta) ? '_blank' : undefined}
              rel={ctaOpensNewTab(primaryCta) ? 'noopener noreferrer' : undefined}
            >
              {primaryCta.label}
              <span class="r-arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
        {
          secondaryCta?.label && (
            <a
              class="r-link home-hero__secondary"
              href={secondaryHref}
              target={ctaOpensNewTab(secondaryCta) ? '_blank' : undefined}
              rel={ctaOpensNewTab(secondaryCta) ? 'noopener noreferrer' : undefined}
            >
              {secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="home-hero__photo">
    {
      photo?.asset && (
        <SanityImage
          source={photo}
          width={1100}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={70}
          class="home-hero__img"
        />
      )
    }
  </div>
</section>

<style>
  .home-hero {
    --gut: clamp(1rem, 4vw, 3.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    min-height: clamp(640px, calc(100svh - 88px), 1000px);
    background: var(--color-chip-6);
    color: var(--color-cream);
    overflow: clip;
    /* The accent phrase is Oat italic on Walnut. */
    --accent-color: var(--color-chip-2);
  }

  .home-hero__copy {
    position: relative;
    /* Above the photo's fades (z-index 2). On phones the copy tucks 1.5rem
       up into the photo, and the photo comes later in the page, so at an
       equal z-index its bronze fade painted over the eyebrow's first line
       (2026-10-01). */
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    /* Generous top room: the eyebrow sits well clear of the header row. */
    padding: clamp(3.5rem, 8vw, 6.5rem) var(--gut) clamp(2.75rem, 6vw, 5.5rem);
    /* Start the copy on the page container's left edge on wide screens. */
    padding-left: max(var(--gut), calc((100vw - 85rem) / 2 + var(--gut)));
  }

  /* Eyebrow and rating share the top line; margin-bottom auto pushes the
     headline down to the foot of the hero, as the eyebrow alone used to. */
  .home-hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin: 0 0 auto;
  }
  .home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font: 500 0.95rem/1.35 var(--font-body);
    color: var(--color-cream);
    max-width: 40ch;
  }
  .home-hero__eyebrow::before {
    content: '';
    flex: none;
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  /* :global because the h1 is rendered inside RiseWords, outside this
     component's style scope. */
  :global(.home-hero__h1) {
    margin: 0;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 0.9rem + 5.6vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 13ch;
    text-wrap: balance;
  }

  .home-hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
  }
  .home-hero__sub {
    margin: 0;
    max-width: 34ch;
    font: 500 1.08rem/1.5 var(--font-body);
    color: var(--color-cream);
    text-wrap: pretty;
  }
  .home-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .home-hero__secondary {
    color: var(--color-cream);
  }
  /* The Google rating tag, top right of the copy, opposite the eyebrow. */
  .home-hero__rating {
    flex: none;
  }

  .home-hero__photo {
    position: relative;
    min-height: 100%;
    /* Clip the settle zoom (scale 1.1 -> 1) so it never spills into the copy. */
    overflow: clip;
  }
  .home-hero__photo :global(.home-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  /* The header sits on this hero in cream (Header.astro "On hero",
     2026-10-01): a soft ink shade along the top of the photo keeps the
     cream links, rating and booking tag readable over any part of it. */
  .home-hero__photo::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 11rem;
    /* Eased, so the shade is deepest right behind the header and fades out
       without a visible edge. */
    background: linear-gradient(rgb(35 30 27 / 0.62), rgb(35 30 27 / 0.38) 40%, rgb(35 30 27 / 0));
    pointer-events: none;
  }
  /* Desktop: the copy clears the header that now overlaps the top of the
     hero. (On a phone the photo comes first and takes the overlap.) */
  @media (min-width: 1024px) {
    :global(body:has(.hdr[data-over-hero])) .home-hero__copy {
      padding-top: calc(6.25rem + clamp(3.5rem, 8vw, 6.5rem));
    }
  }
  /* A soft bronze edge so the photo melts into the ground, not a hard seam. */
  .home-hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Above the header shade (::before), so the photo always melts into the
       flat Walnut beside it. With the shade on top, the faded edge came out
       darker than the Walnut near the header: a hard vertical seam
       (2026-10-01). */
    z-index: 2;
    background: linear-gradient(90deg, var(--color-chip-6) 0, transparent 16%);
    pointer-events: none;
  }

  /* The portrait settles from 110% to 100% on load (DESIGN.md "Motion"). */
  @media (prefers-reduced-motion: no-preference) {
    .home-hero__photo :global(.home-hero__img) {
      animation: home-settle 2.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes home-settle {
    from {
      transform: scale(1.1);
    }
  }

  /* ---- Tablet and phone: photo on top, bronze copy below. ---- */
  @media (max-width: 1023px) {
    .home-hero {
      display: flex;
      flex-direction: column-reverse;
      min-height: 0;
    }
    /* Phone photo height. 2026-10-03 (Impeccable audit P2): 62svh pushed both
       buttons below the fold, so it went to 40svh. 2026-10-04 (Nathan): that
       cropped Staci's head against the top of the screen. The headline lost its
       second clause (now just "Homes that feel completely yours", three short
       lines), which frees the room, so the photo is back up to 50svh and the
       crop is anchored higher (object-position below) to give her head air. */
    .home-hero__photo {
      height: min(50svh, 32rem);
      min-height: 15rem;
    }
    .home-hero__photo :global(.home-hero__img) {
      object-position: 50% 8%;
    }
    .home-hero__photo::after {
      background: linear-gradient(0deg, var(--color-chip-6) 0, transparent 28%);
    }
    /* The phone header sits over the brightest part of the photo (the
       window), so its shade is deeper and shorter. */
    .home-hero__photo::before {
      height: 8.5rem;
      background: linear-gradient(
        rgb(35 30 27 / 0.72),
        rgb(35 30 27 / 0.42) 45%,
        rgb(35 30 27 / 0)
      );
    }
    .home-hero__copy {
      padding-top: 0.5rem;
      margin-top: -1.5rem;
    }
    /* Phone order: eyebrow, headline, buttons, subhead, then the rating card
       last (it is also proof, but the offer comes first). display: contents
       lets the eyebrow and the card be ordered as siblings of the headline. */
    .home-hero__top {
      display: contents;
    }
    .home-hero__eyebrow {
      order: 0;
    }
    :global(.home-hero__h1) {
      order: 1;
    }
    .home-hero__foot {
      order: 2;
      flex-direction: column;
      align-items: flex-start;
    }
    .home-hero__ctas {
      order: -1;
    }
    .home-hero__rating {
      order: 3;
    }
  }

  /* From 1200px the header carries its own compact "5.0 Google" line
     (Header.astro), so the hero card would show the same proof twice. The
     header's is kept (it travels with every page); the hero card stays below
     1200px, where the header hides its own. To bring the hero card back on
     wide screens, delete this block (DECISIONS 2026-10-03). */
  @media (min-width: 1200px) {
    .home-hero__rating {
      display: none;
    }
  }
</style>
