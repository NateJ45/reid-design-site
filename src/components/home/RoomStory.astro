---
// Foundation, edit with care
// =============================================================================
// RoomStory: the home page's CONCEPT ROOMS (added 2026-09-30; the annotated
// room, 2026-10-03)
// =============================================================================
// Labelled, AI-generated sample rooms. Each starts EMPTY and fills up piece by
// piece as the visitor scrolls: every step of the build is ONE COMPLETE PHOTO
// of the room, and the new piece appears in place with a soft reveal (WebGL).
// Since 2026-10-03 the room is a job in progress marked up by the designer:
// it opens on an example BRIEF, every piece that arrives is tied to a sample
// TAG on a string that says why it is there (one of the five checks from
// Staci's notebook), and it closes on WHAT IS IN THE PLAN and the booking
// button. (The paint-colour deck went the same day: its wall masks kept
// leaving bad edges.) Tabs above the room switch between rooms, if there is
// more than one. It is openly a concept: a "Concept room" sample tag sits on
// the picture, every alt text opens "Concept image:" and the brief says "an
// example". It must never read as Staci's portfolio (no town or project
// names, no numbering).
//
// This file only LOADS and CHECKS the rooms; RoomStage.astro draws them (and
// carries the script), so when nothing valid is there the page gets no markup
// and no script at all.
//
//   src/assets/room/rooms.json            -> parseRoomIndex() (tab order, labels)
//   src/assets/room/<slug>/manifest.json  -> parseRoomManifest() (v4: frames plus
//                                            notes, pins, brief, plan, closing)
//   frame-N.jpg (every frame)             -> getImage(): avif + webp at 640/960/1440
//   change-N.png                          -> ?url (fetched by the painter only)
//
// A listed room whose manifest is invalid or whose files are missing is
// DROPPED with a build-time warning naming it; the others still render. No
// rooms.json, an invalid one, or no valid room: nothing. One valid room: no
// tabs at all.
//
// THE BOOKING BUTTON at the close is the header's: the same label and link
// (resolveChrome(siteSettings).headerCta, exactly what Header.astro prints)
// and the consultation price derived from content (getChromeFacts()
// consultPrice, the rule the footer and Contact use). Never a typed price: no
// price in Sanity, no price on the button.
//
// The files are made by tools/room-lab (room:publish). Notes, captions, the
// brief, the plan and alt text live in each manifest, NOT in Sanity; Sanity
// only holds the heading, its italic phrase, the intro and the Show switch
// (homePage.roomStory*). Placed by the `roomStory` Home marker (CLAUDE.md
// rule 13).
// =============================================================================
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RoomStage from './RoomStage.astro';
import type { CloseCta, RoomView, StageFrame } from './room-view';
import {
  ROOM_MOTIONS,
  checkInfo,
  parseRoomIndex,
  parseRoomManifest,
  roomAnnouncement,
  roomFiles,
  roomFolder,
  stageFrames,
  type RoomIndexEntry,
} from '@/lib/room-story';
import { resolveChrome } from '@/lib/siteSettings';
import { resolveChromeFacts } from '@/lib/chrome-facts';
import { getChromeFacts } from '@/lib/queries';

interface Props {
  headline?: string | null;
  scriptAccent?: string | null;
  intro?: string | null;
  /** Site settings, for the header button's label and link (the close's button). */
  siteSettings?: Parameters<typeof resolveChrome>[0];
}

const { headline, scriptAccent, intro, siteSettings } = Astro.props as Props;

// Globs, not imports: a missing folder is an empty object, never a build error.
const indexes = import.meta.glob<{ default: unknown }>('../../assets/room/rooms.json', {
  eager: true,
});
const manifests = import.meta.glob<{ default: unknown }>('../../assets/room/*/manifest.json', {
  eager: true,
});
// Frames go through the image pipeline; the change masks are served as they
// are, ALWAYS as files: `no-inline` stops Vite turning a small mask (a vase's
// change mask can be under its 4 KB limit) into a data: URL baked into the
// HTML of every room, template rooms included.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/room/*/*.{jpg,jpeg,webp}',
  { eager: true },
);
const pngUrls = import.meta.glob<string>('../../assets/room/*/*.png', {
  eager: true,
  query: '?url&no-inline',
  import: 'default',
});

const rawIndex = Object.values(indexes)[0]?.default;
const index = rawIndex === undefined ? null : parseRoomIndex(rawIndex);
if (rawIndex !== undefined && !index) {
  console.warn('[room-story] src/assets/room/rooms.json is invalid; the concept room is skipped.');
}

// The room is up to three quarters of a laptop screen (as wide as its height
// allows), full width on a phone.
const WIDTHS = [640, 960, 1440];
const SIZES = '(min-width: 1024px) 75vw, 100vw';
// Plan chips spread over the ramp, palest first, never chip 5 (Warm Bronze
// takes no text). Five chips get 1, 2, 3, 4, 6.
const PLAN_RAMP = [1, 2, 3, 4, 6];
const planTone = (i: number, n: number) =>
  PLAN_RAMP[n <= 1 ? 0 : Math.round((i * (PLAN_RAMP.length - 1)) / (n - 1))] ?? 1;

/** Load one listed room, or null (with a build-time warning) when it is not all there. */
async function loadRoom(entry: RoomIndexEntry): Promise<RoomView | null> {
  const folder = roomFolder(entry);
  const at = (name: string) => `../../assets/room/${folder}/${name}`;
  const drop = (why: string) => {
    console.warn(`[room-story] dropped room "${entry.slug}": ${why}`);
    return null;
  };
  const raw = manifests[at('manifest.json')]?.default;
  if (raw === undefined) return drop(`no ${folder}/manifest.json`);
  const manifest = parseRoomManifest(raw);
  if (!manifest) return drop(`${folder}/manifest.json is not a valid v5 manifest`);
  const missing = roomFiles(manifest).filter((f) =>
    f.toLowerCase().endsWith('.png') ? !pngUrls[at(f)] : !images[at(f)],
  );
  if (missing.length) return drop(`missing ${[...new Set(missing)].join(', ')}`);

  const { width: W, height: H } = manifest;
  const photo = async (file: string) => {
    const src = images[at(file)].default;
    const [avif, webp, fallback] = await Promise.all([
      getImage({ src, format: 'avif', widths: WIDTHS, sizes: SIZES }),
      getImage({ src, format: 'webp', widths: WIDTHS, sizes: SIZES }),
      getImage({ src, format: 'webp', width: 960 }),
    ]);
    return {
      avifSrcset: avif.srcSet.attribute,
      webpSrcset: webp.srcSet.attribute,
      src: fallback.src,
    };
  };
  const stageIndex = new Map(manifest.stages.map((s, i) => [s.id, i]));
  const round = (v: number) => Math.round(v * 1e5) / 1e5;
  const fracBox = ([x, y, w, h]: number[]) =>
    [round(x / W), round(y / H), round(w / W), round(h / H)] as [number, number, number, number];

  const frames: StageFrame[] = [
    {
      ...(await photo(manifest.empty.image)),
      change: null,
      box: null,
      motion: -1,
      stage: -1,
    },
    ...(await Promise.all(
      manifest.pieces.map(async (p) => ({
        ...(await photo(p.image)),
        change: pngUrls[at(p.change)],
        box: fracBox(p.box),
        motion: ROOM_MOTIONS.indexOf(p.motion),
        stage: stageIndex.get(p.stage) ?? 0,
      })),
    )),
  ];

  return {
    slug: entry.slug,
    label: entry.label,
    style: entry.style,
    announce: roomAnnouncement(entry),
    width: W,
    height: H,
    baseAlt: manifest.base.alt,
    finalAlt: manifest.final.alt,
    beats: manifest.stages.map((s) => ({ label: s.label, caption: s.caption })),
    ends: stageFrames(manifest),
    frames,
    notes: manifest.pieces.map((p) => {
      const c = checkInfo(p.note.check);
      return {
        id: p.id,
        check: c.id,
        checkLabel: c.label,
        tone: c.tone,
        text: p.note.text,
        pin: [round(p.pin[0] / W), round(p.pin[1] / H)],
        box: fracBox(p.box),
        side: p.side,
        stage: stageIndex.get(p.stage) ?? 0,
      };
    }),
    brief: manifest.brief,
    plan: manifest.plan.map((p, i) => ({
      label: p.label,
      stage: stageIndex.get(p.beat) ?? 0,
      tone: planTone(i, manifest.plan.length),
    })),
    closing: manifest.closing.line,
    wall: manifest.wall
      ? { url: pngUrls[at(manifest.wall.mask)], median: manifest.wall.median }
      : null,
  };
}

const rooms = index
  ? (await Promise.all(index.rooms.map(loadRoom))).filter((r): r is RoomView => r !== null)
  : [];

// The close's booking button: the header button's label and link, and the
// consultation price. A failed facts read fails a static build (CLAUDE.md
// rule 9, the same handling as Footer.astro); in a live preview the button
// simply drops its price.
let cta: CloseCta | null = null;
if (rooms.length) {
  const chrome = resolveChrome(siteSettings);
  const facts = resolveChromeFacts(
    await getChromeFacts().catch((err: unknown) => {
      if (Astro.isPrerendered) throw err;
      return null;
    }),
  );
  cta = { label: chrome.headerCta.label, href: chrome.headerCta.href, price: facts.consultPrice };
}
---

{
  rooms.length > 0 && cta && (
    <RoomStage
      rooms={rooms}
      cta={cta}
      headline={headline || 'Every piece is chosen for a reason.'}
      scriptAccent={headline ? scriptAccent : (scriptAccent ?? 'for a reason')}
      intro={intro || 'Watch one empty room get built, and see why each piece is there.'}
    />
  )
}
