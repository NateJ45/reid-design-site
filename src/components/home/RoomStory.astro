---
// Foundation, edit with care
// =============================================================================
// RoomStory: the home page's CONCEPT ROOMS (added 2026-09-30)
// =============================================================================
// Labelled, AI-generated sample rooms. Each starts EMPTY and the furniture
// fades and moves into place piece by piece as the visitor scrolls past short
// captions, while a deck of paint chips repaints the walls in WebGL. Tabs
// above the room switch between rooms (living room, family room, dining room,
// kitchen, bathroom, bedroom, each in one style); every room shares the same
// chips. It is openly a concept: a "Concept room" sample tag sits on the
// picture and every alt text opens "Concept image:". It must never read as
// Staci's portfolio (no town or project names, no numbering).
//
// This file only LOADS and CHECKS the rooms; RoomStage.astro draws them (and
// carries the script), so when nothing valid is there the page gets no markup
// and no script at all.
//
//   src/assets/room/rooms.json            -> parseRoomIndex() (tab order, labels)
//   src/assets/room/<slug>/manifest.json  -> parseRoomManifest() (v2, per room;
//                                            file names relative to its folder)
//   base image                            -> getImage(): avif + webp at 640/960/1440
//   layer + shade + light images                -> getImage(): webp at the same fractions
//                                            of their box, so a phone gets small pieces
//   base wall mask                        -> ?url (fetched by the painter only)
//
// A listed room whose manifest is invalid or whose files are missing is
// DROPPED with a build-time warning naming it; the others still render. No
// rooms.json, an invalid one, or no valid room: nothing. One valid room: no
// tabs at all (the single-room section as it was before the tabs).
//
// The files are made by tools/room-lab (room:publish). Captions and alt text
// live in each manifest, NOT in Sanity; Sanity only holds the heading, its
// italic phrase, the intro and the Show switch (homePage.roomStory*). Placed
// by the `roomStory` Home marker (CLAUDE.md rule 13).
// =============================================================================
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RoomStage from './RoomStage.astro';
import type { RoomView, StageLayer } from './room-view';
import {
  layerTimings,
  parseRoomIndex,
  parseRoomManifest,
  roomAnnouncement,
  roomFiles,
  roomFolder,
  type RoomIndexEntry,
} from '@/lib/room-story';

interface Props {
  headline?: string | null;
  scriptAccent?: string | null;
  intro?: string | null;
}

const { headline, scriptAccent, intro } = Astro.props as Props;

// Globs, not imports: a missing folder is an empty object, never a build error.
const indexes = import.meta.glob<{ default: unknown }>('../../assets/room/rooms.json', {
  eager: true,
});
const manifests = import.meta.glob<{ default: unknown }>('../../assets/room/*/manifest.json', {
  eager: true,
});
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/room/*/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const pngUrls = import.meta.glob<string>('../../assets/room/*/*.png', {
  eager: true,
  query: '?url',
  import: 'default',
});

const rawIndex = Object.values(indexes)[0]?.default;
const index = rawIndex === undefined ? null : parseRoomIndex(rawIndex);
if (rawIndex !== undefined && !index) {
  console.warn('[room-story] src/assets/room/rooms.json is invalid; the concept room is skipped.');
}

// The room is about half an 85rem page on a laptop, full width on a phone.
const WIDTHS = [640, 960, 1440];
const BASE_SIZES = '(min-width: 1024px) 50vw, 100vw';

/** Load one listed room, or null (with a build-time warning) when it is not all there. */
async function loadRoom(entry: RoomIndexEntry): Promise<RoomView | null> {
  const folder = roomFolder(entry);
  const at = (name: string) => `../../assets/room/${folder}/${name}`;
  const drop = (why: string) => {
    console.warn(`[room-story] dropped room "${entry.slug}": ${why}`);
    return null;
  };
  const raw = manifests[at('manifest.json')]?.default;
  if (raw === undefined) return drop(`no ${folder}/manifest.json`);
  const manifest = parseRoomManifest(raw);
  if (!manifest) return drop(`${folder}/manifest.json is not a valid v2 manifest`);
  const missing = roomFiles(manifest).filter((f) => !images[at(f)]);
  if (!pngUrls[at(manifest.base.mask)]) missing.push(manifest.base.mask);
  if (missing.length) return drop(`missing ${[...new Set(missing)].join(', ')}`);

  const { width: W, height: H } = manifest;
  const src = images[at(manifest.base.image)].default;
  const [avif, webp, fallback] = await Promise.all([
    getImage({ src, format: 'avif', widths: WIDTHS, sizes: BASE_SIZES }),
    getImage({ src, format: 'webp', widths: WIDTHS, sizes: BASE_SIZES }),
    getImage({ src, format: 'webp', width: 960 }),
  ]);

  // A piece's picture is `w / W` of the room's width, so it gets the same
  // fractions of the room's widths and a matching `sizes`.
  const piece = async (file: string, w: number) => {
    const img = images[at(file)].default;
    const f = w / W;
    const widths = [...new Set(WIDTHS.map((x) => Math.round(x * f)))].filter(
      (x) => x > 0 && x <= img.width,
    );
    const sizes = `(min-width: 1024px) calc(50vw * ${f.toFixed(4)}), calc(100vw * ${f.toFixed(4)})`;
    const [set, one] = await Promise.all([
      getImage({ src: img, format: 'webp', widths: widths.length ? widths : [img.width], sizes }),
      getImage({ src: img, format: 'webp', width: Math.min(img.width, Math.round(960 * f)) }),
    ]);
    return { srcset: set.srcSet.attribute, src: one.src, sizes };
  };

  const timings = layerTimings(manifest);
  const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(4)}%`;
  const layers: StageLayer[] = await Promise.all(
    manifest.layers.map(async (l, i) => {
      const [x, y, w, h] = l.box;
      return {
        id: l.id,
        motion: l.motion,
        stage: timings[i].stage,
        from: timings[i].from,
        to: timings[i].to,
        width: Math.round(w),
        height: Math.round(h),
        place: `left:${pct(x, W)};top:${pct(y, H)};width:${pct(w, W)};height:${pct(h, H)}`,
        image: await piece(l.image, w),
        shade: l.shade ? await piece(l.shade, w) : null,
        light: l.light ? await piece(l.light, w) : null,
      };
    }),
  );

  return {
    slug: entry.slug,
    label: entry.label,
    style: entry.style,
    announce: roomAnnouncement(entry),
    width: W,
    height: H,
    base: {
      avifSrcset: avif.srcSet.attribute,
      webpSrcset: webp.srcSet.attribute,
      src: fallback.src,
      alt: manifest.base.alt,
      maskUrl: pngUrls[at(manifest.base.mask)],
      median: manifest.base.wallMedianLinear,
    },
    finalAlt: manifest.final.alt,
    stages: manifest.stages.map((s) => s.caption),
    layers,
  };
}

const rooms = index
  ? (await Promise.all(index.rooms.map(loadRoom))).filter((r): r is RoomView => r !== null)
  : [];
---

{
  rooms.length > 0 && (
    <RoomStage
      rooms={rooms}
      headline={headline || 'Watch a room come together'}
      scriptAccent={headline ? scriptAccent : (scriptAccent ?? 'come together')}
      intro={
        intro ||
        'This is a concept room, not a client’s home. It fills up the way a project does, one piece at a time, and the paint chips try a colour on its walls.'
      }
    />
  )
}
