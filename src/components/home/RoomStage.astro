---
// Foundation, edit with care
// =============================================================================
// RoomStage: draws the concept rooms (added 2026-09-30; room tabs the same
// day). Only RoomStory.astro renders it, and only with at least one valid,
// complete room, so this markup and its script never reach a page that has
// no room.
// =============================================================================
// PARTS
//   - Heading and intro.
//   - Room tabs (only with two or more rooms): a real ARIA tablist above the
//     room, `hidden` in the markup and shown by the script, so without a
//     script the first room shows exactly as the single-room section did.
//     Manual activation: arrows / Home / End move focus, Enter or Space (or a
//     click) chooses, because choosing downloads a room's pictures and may
//     scroll the page. The chosen tab is a pulled paper sample tag.
//   - The first room's scene (RoomScene.astro) and captions
//     (RoomCaptions.astro), server-rendered in place.
//   - Every other room's scene and captions inside a <template>, with the
//     optimised srcsets baked in. Template content is inert, so none of those
//     pictures download until the tab is chosen.
//   - The "Concept room" sample tag, a visually hidden live region, and the
//     paint deck (shared by every room; `hidden` until the painter has drawn).
//
// SWITCHING (the script below): the chosen room's `.room__frames` and
// `.room__captions` replace the showing ones (the outgoing pair is kept,
// detached, so going back is instant); the painter's canvas MOVES into the
// new frames and reloads its textures (that room's frames and masks, and its
// wall median) in the SAME GL context, keeping the chosen chip colour; the
// build re-arms (the IntersectionObserver re-observes the new captions, and
// the new room's frames start decoding in build order); the live region says
// "Showing the kitchen, modern style."; and if the section's top has scrolled
// above the screen, the page scrolls back so the room's top sits just under
// the header (Lenis when it is running, native smooth scroll otherwise,
// instant under reduced motion), which also restarts the build. Rooms with
// different stage counts simply change the caption list's height; the sticky
// layout is pure CSS, so nothing needs recomputing by hand.
//
// THE BUILD (whole frames, 2026-09-30): each step is one COMPLETE photo of the
// room. An IntersectionObserver on the captions (no scroll listener: it works
// under Lenis and native scroll alike) picks the current caption k; the room
// then shows the last frame of stage k (data-ends on the frames box). With
// WebGL the painter plays every piece up to it, each appearing IN PLACE with a
// soft reveal limited to the region that changed plus a small settle, and
// crossfades straight back when the visitor scrolls up. Without WebGL (none,
// a failed shader, a lost context) the <img> stack crossfades whole frames
// (400ms, none under reduced motion) and the chips stay hidden. Without a
// script the finished room shows with every caption. Frames download only
// when the section is about a screen away, in build order.
//
// LAYOUT: desktop (1024px+) the room (with its tabs) is sticky on the left and
// the captions scroll past on the right; phone: the room pins under the header
// strip, the captions scroll beneath it, and the tabs and the paint deck each
// scroll sideways with scroll-snap.
// =============================================================================
import RiseWords from '@/components/RiseWords.astro';
import { ROOM_CHIPS, linearToHex } from '@/lib/room-story';
import RoomScene from './RoomScene.astro';
import RoomCaptions from './RoomCaptions.astro';
import type { RoomView } from './room-view';

interface Props {
  /** At least one room; the first shows on load. */
  rooms: RoomView[];
  headline: string;
  scriptAccent?: string | null;
  intro: string;
}

const { rooms, headline, scriptAccent, intro } = Astro.props as Props;
const [first, ...others] = rooms;
const tabbed = rooms.length > 1;
// "As it is" shows the first room's own wall colour as its swatch (the script
// updates it on a switch).
const asIsHex = linearToHex(first.median);
---

<section class="room" aria-labelledby="room-heading" data-room>
  <div class="r-wrap">
    <div class="room__head">
      <RiseWords as="h2" id="room-heading" text={headline} accent={scriptAccent} class="r-h2" />
      <p class="r-lede">{intro}</p>
    </div>

    <div class="room__body">
      <div class="room__stage">
        {
          tabbed && (
            <div class="room__tabs" role="tablist" aria-label="Concept rooms" data-room-tabs hidden>
              {rooms.map((r, i) => (
                <button
                  type="button"
                  role="tab"
                  class="room__tab"
                  id={`room-tab-${r.slug}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls="room-panel room-captions"
                  tabindex={i === 0 ? 0 : -1}
                  data-room-tab={r.slug}
                  data-announce={r.announce}
                >
                  <span class="room__tab-label">{r.label}</span>
                  <span class="room__tab-style">{r.style}</span>
                </button>
              ))}
            </div>
          )
        }
        {
          /* The tab panel is a plain div around the figure (a figure may not
            take role="tabpanel"); the script adds the role only with tabs. */
        }
        <div id="room-panel" data-room-panel>
          <figure class="room__figure">
            <RoomScene room={first} canvas />
            <figcaption class="room__tag r-tag"><strong>Concept room</strong></figcaption>
          </figure>
        </div>
        <p class="sr-only" aria-live="polite" data-room-live>{first.finalAlt}</p>

        <fieldset class="room__deck" data-room-chips hidden>
          <legend class="room__legend">Try a paint colour on the walls</legend>
          <div class="room__chips">
            {
              ROOM_CHIPS.map((c, i) => (
                <button
                  type="button"
                  class="room__chip"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-hex={c.hex ?? ''}
                >
                  <span
                    class="room__swatch"
                    data-as-is={c.hex ? undefined : ''}
                    style={`background:${c.hex ?? asIsHex}`}
                  />
                  <span>{c.name}</span>
                </button>
              ))
            }
          </div>
        </fieldset>
      </div>

      <RoomCaptions stages={first.stages} />
    </div>
  </div>

  {
    others.map((r) => (
      <template data-room-tpl={r.slug}>
        <RoomScene room={r} />
        <RoomCaptions stages={r.stages} />
      </template>
    ))
  }
</section>

<style>
  .room {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    /* Where the room pins on a phone: the header's sticky box is 4.5rem
       below 1024px (Header.astro, --hdr-h). That variable is scoped to the
       header, so it is mirrored here rather than read. */
    --room-pin: 4.5rem;
    /* The tab row's share of the pinned stage (0 without tabs). */
    --room-tabs: 0rem;
    background: var(--color-chip-1);
    /* Phone: a tighter band, the pinned room already gives it height. */
    padding-block: clamp(2.5rem, 10vw, 8.5rem);
  }
  .room[data-tabbed] {
    --room-tabs: 4.25rem;
  }
  .room [hidden] {
    display: none !important;
  }
  .room__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
  }
  .room__head :global(.r-h2) {
    grid-column: 1 / 8;
    margin: 0;
    max-width: 14ch;
  }
  .room__head .r-lede {
    grid-column: 9 / 13;
    margin: 0;
  }

  .room__body {
    display: grid;
    /* minmax(0, 1fr), not auto: the chip and tab rows are wider than a phone
       and must scroll inside their own boxes, never widen the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* ---- the room ---------------------------------------------------------- */
  .room__stage {
    min-width: 0;
    position: sticky;
    top: var(--room-pin);
    z-index: 2;
    padding-block: 0.5rem 0.75rem;
    background: var(--color-chip-1);
    /* Fill the sliver between the floating header strip and the pinned room,
       so the caption scrolling past does not peek through it. */
    box-shadow: 0 -1rem 0 var(--color-chip-1);
  }
  .room__figure {
    position: relative;
    margin: 0;
  }
  .room__tag {
    position: absolute;
    left: -0.4rem;
    bottom: 1rem;
    rotate: -2deg;
    /* Above the room's canvas: the honesty label must never be covered. */
    z-index: 3;
  }
  .room__tag strong {
    font-size: 1rem;
  }

  /* ---- the room tabs: a row of sample tags; the chosen one is pulled ----- */
  .room__tabs {
    display: flex;
    gap: 0.25rem;
    /* Room for the focus outline and the pulled tag's lift and shadow
       inside the scroll box. */
    padding: 0.45rem 0.3rem 0.5rem;
    margin: -0.45rem -0.3rem 0.4rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.3rem;
    scrollbar-width: none;
  }
  .room__tabs::-webkit-scrollbar {
    display: none;
  }
  .room__tab {
    position: relative;
    isolation: isolate;
    flex: none;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    min-height: 3rem;
    padding: 0.45rem 0.95rem 0.5rem 1.7rem;
    border: 0;
    background: none;
    color: var(--color-ink-2);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  /* The tag's body: a paper shape with a notched left edge (as .r-tag), drawn
     on ::before so the focus outline is never clipped. Empty until hover or
     choice. */
  .room__tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: transparent;
    clip-path: polygon(0.9rem 0, 100% 0, 100% 100%, 0.9rem 100%, 0 50%);
  }
  /* The tag's punched hole: a ring, Warm Bronze on the chosen tag. */
  .room__tab::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    top: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    translate: 0 -50%;
    box-shadow: inset 0 0 0 1.5px var(--color-rule);
  }
  .room__tab-label {
    font: 500 0.92rem/1.1 var(--font-body);
  }
  .room__tab-style {
    font: 400 0.74rem/1.1 var(--font-body);
    color: var(--color-ink-2);
  }
  .room__tab:hover::before {
    background: color-mix(in oklab, var(--color-paper) 55%, transparent);
  }
  .room__tab[aria-selected='true'] {
    color: var(--color-ink);
    rotate: -1.5deg;
    translate: 0 -2px;
    filter: drop-shadow(0 8px 10px rgb(35 30 27 / 0.18));
  }
  .room__tab[aria-selected='true']::before {
    background: var(--color-paper);
  }
  .room__tab[aria-selected='true']::after {
    box-shadow: inset 0 0 0 1.5px var(--color-chip-5);
  }
  .room__tab:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* ---- the paint deck ---------------------------------------------------- */
  .room__deck {
    min-width: 0; /* a fieldset is min-content wide by default; let the row scroll */
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
  }
  .room__legend {
    padding: 0;
    margin-bottom: 0.6rem;
    font: 500 0.92rem/1.3 var(--font-body);
    color: var(--color-ink);
  }
  .room__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .room__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.3rem 0.8rem 0.3rem 0.35rem;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 500 0.85rem/1 var(--font-body);
    white-space: nowrap;
    cursor: pointer;
  }
  .room__chip[aria-pressed='true'] {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .room__chip:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .room__swatch {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(35 30 27 / 0.14);
  }

  @media (max-width: 1023px) {
    .room__head :global(.r-h2),
    .room__head .r-lede {
      grid-column: 1 / -1;
    }
    /* Phone: one row of chips that scrolls sideways. */
    .room__chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0.25rem;
      padding: 0.25rem;
      margin: -0.25rem;
      scrollbar-width: none;
    }
    .room__chips::-webkit-scrollbar {
      display: none;
    }
    .room__chip {
      flex: none;
      scroll-snap-align: start;
    }
  }

  @media (min-width: 1024px) {
    .room__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: start;
    }
    .room__stage {
      grid-column: 1 / 8;
      top: 7rem;
      padding: 0;
      background: none;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .room__chip {
      transition: border-color 150ms ease;
    }
    .room__tab {
      transition:
        color 200ms var(--ease),
        rotate 400ms var(--ease),
        translate 400ms var(--ease);
    }
    .room__tab::before {
      transition: background-color 200ms var(--ease);
    }
  }
</style>

<script>
  import { hexToLinear, linearToHex } from '@/lib/room-story';
  import type { PainterRoom, RoomPainter } from '@/scripts/room-painter';

  const SIZES = '(min-width: 1024px) 50vw, 100vw';
  let teardown: (() => void) | null = null;

  /**
   * Give a frame's <img> its real sources (they wait in data attributes, so an
   * unarmed frame downloads nothing) and decode it. Memoised per element.
   */
  const loads = new WeakMap<HTMLImageElement, Promise<HTMLImageElement>>();
  function loadFrame(img: HTMLImageElement): Promise<HTMLImageElement> {
    let p = loads.get(img);
    if (p) return p;
    img.loading = 'eager';
    const { avif, webp, src } = img.dataset;
    if (src !== undefined) {
      const pic = img.parentElement;
      for (const [type, set] of [
        ['image/avif', avif],
        ['image/webp', webp],
      ]) {
        if (!set || !pic) continue;
        const s = document.createElement('source');
        s.type = type as string;
        s.srcset = set;
        s.sizes = SIZES;
        pic.insertBefore(s, img);
      }
      delete img.dataset.avif;
      delete img.dataset.webp;
      delete img.dataset.src;
      img.sizes = SIZES;
      img.src = src;
    }
    p = img.decode().then(() => img);
    loads.set(img, p);
    return p;
  }
  const imgsOf = (box: Element) => [...box.querySelectorAll<HTMLImageElement>('.room__frame img')];
  const numbers = (s: string | undefined) => (s ?? '').split(',').filter(Boolean).map(Number);

  /** The painter's view of a room's frames box, or null if it is malformed. */
  function roomOf(box: HTMLElement): PainterRoom | null {
    const median = numbers(box.dataset.median);
    const imgs = imgsOf(box);
    if (median.length !== 3 || median.some((n) => !(n > 0)) || imgs.length < 2) return null;
    const aspect = Number(imgs[0].getAttribute('width')) / Number(imgs[0].getAttribute('height'));
    return {
      median: median as [number, number, number],
      aspect: aspect > 0 ? aspect : 4 / 3,
      frames: imgs.map((img) => {
        const b = numbers(img.dataset.box);
        return {
          load: () => loadFrame(img),
          wall: img.dataset.wall ?? '',
          change: img.dataset.change ?? null,
          box: b.length === 4 ? (b as [number, number, number, number]) : null,
          motion: Number(img.dataset.motion ?? -1),
          stage: Number(img.dataset.stage ?? -1),
        };
      }),
    };
  }

  function init() {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-room]');
    if (!root) return;
    const canvas = root.querySelector<HTMLCanvasElement>('.room__canvas');
    const deck = root.querySelector<HTMLElement>('[data-room-chips]');
    const live = root.querySelector<HTMLElement>('[data-room-live]');
    const panel = root.querySelector<HTMLElement>('[data-room-panel]');
    const body = root.querySelector<HTMLElement>('.room__body');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.room__chip')];
    const asIs = root.querySelector<HTMLElement>('.room__swatch[data-as-is]');
    const tablist = root.querySelector<HTMLElement>('[data-room-tabs]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-room-tab]')];
    const frames = () => root.querySelector<HTMLElement>('.room__frames');
    const captions = () => root.querySelector<HTMLElement>('.room__captions');
    if (!canvas || !deck || !live || !panel || !body || !frames() || !captions()) return;
    if (captions()!.querySelectorAll('[data-room-step]').length < 2) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = matchMedia('(min-width: 1024px)');
    let painter: RoomPainter | null = null;
    let chip: [number, number, number] | null = null;
    let dead = false;
    root.dataset.enhanced = '';

    // ---- the <img> stack (the picture without WebGL, and under the canvas) --
    // Every frame up to the one to show is on (the ones under it are covered
    // by it), every frame above it off: forward fades the new frame in over
    // the old, back fades the ones above away, never a dip to the background.
    // Until frame 0 has loaded the markup's default (the finished room) stays.
    let target = 0;
    const syncStack = () => {
      const f = frames();
      if (!f) return;
      const imgs = imgsOf(f);
      const first = imgs[0];
      if (!first || first.dataset.src !== undefined || !first.complete || !first.naturalWidth) {
        return;
      }
      f.querySelectorAll<HTMLElement>('.room__frame').forEach((pic, i) =>
        pic.toggleAttribute('data-on', i <= target),
      );
    };
    /** Decode a room's frames one after another, in build order. */
    const preload = async (box: HTMLElement) => {
      for (const img of imgsOf(box)) {
        try {
          await loadFrame(img);
        } catch {
          /* a missing frame: the stack keeps what it shows */
        }
        if (dead || box !== frames()) return;
        syncStack();
      }
    };

    // ---- the build of whichever room is showing ----------------------------
    let steps: HTMLElement[] = [];
    let ends: number[] = [];
    let stage = -2; // -1 = before the first caption; -2 = not read yet
    // After a room is chosen, its "Showing the ..." line stands while the page
    // scrolls back to the room's top; stage lines resume after that.
    let quietUntil = 0;

    const show = (i: number) => {
      if (i === stage) return;
      const first = stage === -2;
      stage = i;
      steps.forEach((s, k) => {
        if (k === i) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      target = i < 0 ? 0 : (ends[i] ?? 0);
      syncStack();
      painter?.go(target);
      // Say what the room shows now; not on the first read, so loading the
      // page (or choosing a room) announces nothing extra.
      if (!first && performance.now() >= quietUntil) {
        live.textContent =
          i < 0 ? (frames()?.dataset.baseAlt ?? '') : (steps[i].textContent ?? '').trim();
      }
    };

    // The stage is the last caption whose top has passed the reading line
    // (mid screen on a laptop, 70% down on a phone), or -1 before the first.
    const line = () => innerHeight * (wide.matches ? 0.5 : 0.7);
    const pick = () => {
      const y = line();
      let i = -1;
      steps.forEach((s, k) => {
        if (s.getBoundingClientRect().top <= y) i = k;
      });
      show(i);
    };
    let band: IntersectionObserver | null = null;
    const watch = () => {
      band?.disconnect();
      const top = wide.matches ? 45 : 65;
      const bottom = wide.matches ? 45 : 25;
      band = new IntersectionObserver(pick, { rootMargin: `-${top}% 0px -${bottom}% 0px` });
      steps.forEach((s) => band?.observe(s));
    };
    /** (Re-)arm the build for the room now in the DOM. */
    const arm = () => {
      const c = captions();
      steps = c ? [...c.querySelectorAll<HTMLElement>('[data-room-step]')] : [];
      ends = numbers(frames()?.dataset.ends);
      stage = -2;
      watch();
      pick();
    };
    arm();
    wide.addEventListener('change', watch);

    // ---- paint chips ------------------------------------------------------
    const onChip = (e: Event) => {
      const btn = e.currentTarget as HTMLButtonElement;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === btn)));
      chip = btn.dataset.hex ? hexToLinear(btn.dataset.hex) : null;
      painter?.setChip(chip);
    };
    chips.forEach((c) => c.addEventListener('click', onChip));
    const paintAsIs = () => {
      const m = numbers(frames()?.dataset.median);
      if (asIs && m.length === 3)
        asIs.style.background = linearToHex(m as [number, number, number]);
    };

    // ---- frames and the painter, loaded about a screen early --------------
    const fallback = () => {
      painter = null;
      canvas.hidden = true;
      deck.hidden = true;
      delete root.dataset.painted;
      syncStack();
    };
    const near = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        void preload(frames() as HTMLElement);
        try {
          const { createRoomPainter } = await import('@/scripts/room-painter');
          const room = roomOf(frames() as HTMLElement);
          if (dead || !room) return fallback();
          painter = createRoomPainter(canvas, room, target, {
            reducedMotion: reduced,
            onReady: () => {
              if (dead) return;
              canvas.hidden = false;
              deck.hidden = false;
              root.dataset.painted = '';
            },
            onLost: fallback,
          });
          if (!painter) fallback();
          else if (chip) painter.setChip(chip);
        } catch {
          fallback();
        }
      },
      { rootMargin: '100% 0px' },
    );
    near.observe(root);

    // ---- room tabs (two or more rooms) -------------------------------------
    // Rooms already shown, kept detached so going back is instant.
    const kept = new Map<string, { frames: HTMLElement; captions: HTMLElement }>();
    let current = 0;
    const rem = () => parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

    const select = (k: number) => {
      if (k === current || !tabs[k]) return;
      const slug = tabs[k].dataset.roomTab ?? '';
      let next = kept.get(slug);
      if (!next) {
        const tpl = root.querySelector<HTMLTemplateElement>(`template[data-room-tpl="${slug}"]`);
        const frag = tpl?.content.cloneNode(true) as DocumentFragment | undefined;
        const f = frag?.querySelector<HTMLElement>('.room__frames');
        const c = frag?.querySelector<HTMLElement>('.room__captions');
        if (!f || !c) return;
        next = { frames: f, captions: c };
      }
      const outFrames = frames();
      const outCaptions = captions();
      if (!outFrames || !outCaptions) return;
      kept.set(tabs[current].dataset.roomTab ?? '', { frames: outFrames, captions: outCaptions });
      kept.delete(slug);

      // Swap. The canvas moves with the room (on top of its stack); it shows
      // the plain stack until the painter has the new room's textures.
      band?.disconnect();
      canvas.toggleAttribute('data-loading', !canvas.hidden);
      outFrames.replaceWith(next.frames);
      next.frames.append(canvas);
      outCaptions.replaceWith(next.captions);

      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === k));
        t.tabIndex = i === k ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tabs[k].id);
      current = k;
      arm();
      paintAsIs();
      live.textContent = tabs[k].dataset.announce ?? '';
      quietUntil = performance.now() + 1500;
      void preload(next.frames);

      const room = roomOf(next.frames);
      if (painter && room) {
        const mine = k;
        painter.setRoom(room, target).then((ok) => {
          // null: a later choice superseded this load.
          if (dead || ok === null || current !== mine) return;
          canvas.removeAttribute('data-loading');
          canvas.hidden = !ok;
          deck.hidden = !ok;
          root.toggleAttribute('data-painted', ok);
        });
      } else {
        canvas.removeAttribute('data-loading');
      }

      // If the room's story has scrolled away, bring its top back to just
      // under the header, which also starts the new room's build afresh.
      if (root.getBoundingClientRect().top < 0) {
        const offset = (wide.matches ? 7 : 4.5) * rem();
        const y = scrollY + body.getBoundingClientRect().top - offset;
        const lenis = (
          window as unknown as {
            lenis?: { scrollTo: (y: number, o?: { immediate?: boolean }) => void };
          }
        ).lenis;
        if (lenis) lenis.scrollTo(y, { immediate: reduced });
        else window.scrollTo({ top: y, behavior: reduced ? 'instant' : 'smooth' });
      }
    };

    const onTabClick = (e: Event) => select(tabs.indexOf(e.currentTarget as HTMLButtonElement));
    // Manual activation: the arrows, Home and End move focus along the row;
    // Enter or Space (the buttons' own click) chooses.
    const onTabKey = (e: KeyboardEvent) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const n = tabs.length;
      const to =
        e.key === 'ArrowRight'
          ? (i + 1) % n
          : e.key === 'ArrowLeft'
            ? (i - 1 + n) % n
            : e.key === 'Home'
              ? 0
              : e.key === 'End'
                ? n - 1
                : -1;
      if (to < 0) return;
      e.preventDefault();
      tabs[to].focus();
      tabs[to].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    if (tablist && tabs.length > 1) {
      tablist.hidden = false;
      root.dataset.tabbed = '';
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[0].id);
      tabs.forEach((t) => t.addEventListener('click', onTabClick));
      tablist.addEventListener('keydown', onTabKey);
    }

    teardown = () => {
      dead = true;
      band?.disconnect();
      near.disconnect();
      wide.removeEventListener('change', watch);
      chips.forEach((c) => c.removeEventListener('click', onChip));
      tabs.forEach((t) => t.removeEventListener('click', onTabClick));
      tablist?.removeEventListener('keydown', onTabKey);
      kept.clear();
      painter?.destroy();
      painter = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
