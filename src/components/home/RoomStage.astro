---
// Foundation, edit with care
// =============================================================================
// RoomStage: draws the concept rooms (added 2026-09-30; room tabs the same
// day; the scroll scrub and the pinned full-width room, 2026-10-02; THE
// ANNOTATED ROOM, 2026-10-03, docs/design/2026-10-03-annotated-room.md). Only
// RoomStory.astro renders it, and only with at least one valid, complete
// room, so this markup and its script never reach a page that has no room.
// =============================================================================
// THE IDEA: a job in progress, marked up by the designer. One empty room
// fills up piece by piece as the visitor scrolls (the scrub). Each piece that
// arrives is tied to a SAMPLE TAG ON A STRING that says why it is there, in
// one plain sentence, under one of the five checks from Staci's notebook. It
// opens on THE BRIEF (an example client's answers) and closes on WHAT IS IN
// THE PLAN and the booking button. The order answers the visitor's questions:
// what do you want for me, how do you think, what do I get, what next.
//
// THE SCRUB (Nathan, 2026-10-02): the build follows the visitor's scroll
// position in BOTH directions. About three screens of scroll carry it all.
//
// PARTS
//   - Heading and intro (scroll away normally).
//   - The TRACK: a tall box (--room-track, 300svh; the same number as
//     SCRUB_TRACK_SVH in src/lib/room-story.ts, a unit test holds them
//     together) with the STAGE pinned inside it (position: sticky, just under
//     the header). Its height is reserved in CSS, so nothing shifts when the
//     script starts. Only with scripting: `@media (scripting: enabled)`.
//   - In the stage:
//       * Room tabs (only with two or more rooms): a real ARIA tablist,
//         `hidden` in the markup and shown by the script. Manual activation.
//         Choosing keeps the visitor's place: the new room shows at the same
//         share of its build, with its own notes.
//       * The FIGURE (a size container, so cards can be placed against the
//         photo's height in CSS: --ph = 100cqw / aspect):
//           - the room (RoomScene.astro) with the "Concept room" sample tag
//             in its top corner (the honesty label, always on top);
//           - a hairline progress rule under it, a tick per beat (decorative);
//           - the STRING: one SVG over the figure with two slots (the tag
//             going and the tag coming, so they cross-fade), each a paper
//             halo under a fine ink thread, drawn by the script;
//           - the room's notes (RoomNotes.astro): pins, the brief, the beat
//             cards, the tags, the plan dock and the close.
//       * A visually hidden live region: each new tag ("Scale: ..."), the
//         beat's caption when a beat starts, and the closing line.
//   - Every other room's scene and notes inside a <template>, srcsets baked
//     in. Template content is inert, so nothing downloads until chosen.
//
// LAYOUT (scripted; every size is checked in tests/room-story.spec.ts)
//   - WIDE LAPTOP WINDOW (1100px+ and 8/5 or wider: 1280x800, 1440x900,
//     1920x1080): the room centred and height-limited. LEFT margin,
//     bottom-aligned with the photo: the brief while the room is empty, then
//     the current beat card. RIGHT margin: the current tag, vertically
//     centred on its pin (kept inside the photo's height), its string running
//     left into the photo to the pin. The plan dock under the room. At the
//     end the close takes the right margin at the dock's end.
//   - TALL LAPTOP WINDOW (no margins worth using, e.g. 1280x1024): the brief
//     and the beat card as one narrow column over the photo's lower-left; the
//     tag over the photo in the corner that covers least of its piece, never
//     its pin (computed from the pin and the piece's box, not hard-coded).
//     The close takes the dock's place.
//   - PHONE: the room full width with the pin on it; then ONE card: the tag
//     (its beat's short name as a small line on it; the brief takes this slot
//     at the start), its string running up into the photo; then the plan as
//     one sideways scroll-snap row. The close replaces the card and the row.
//     All of it inside one screen (375x667 and 375x812).
//   - NO SCRIPT (or a browser without the `scripting` media feature): no
//     track and no pinning; the finished room, then the plain list (the
//     brief, the beats with their tags, the plan, the line and the booking
//     tag). Nothing hidden.
//
// SCROLL INPUT: a passive scroll listener, coalesced to one
// requestAnimationFrame, attached ONLY while the track is near the screen (an
// IntersectionObserver turns it on and off). Native scrolling only: nothing
// here ever moves, snaps or hijacks the page (CLAUDE.md rule 5). Progress
// along the track becomes a build position (scrubPosition), which drives the
// painter (src/scripts/room-painter.ts) or, without WebGL, the <img> stack,
// and the annotations (noteAt, noteDraw, planLit, closeShown in
// room-story.ts). Reduced motion: the position snaps to whole frames, the
// string is shown whole (no draw), the chips do not lift and the cards swap
// without a fade.
// =============================================================================
import RiseWords from '@/components/RiseWords.astro';
import RoomScene from './RoomScene.astro';
import RoomNotes from './RoomNotes.astro';
import type { CloseCta, RoomView } from './room-view';

interface Props {
  /** At least one room; the first shows on load. */
  rooms: RoomView[];
  /** The close's booking button (the header's label and link, the consult price). */
  cta: CloseCta;
  headline: string;
  scriptAccent?: string | null;
  intro: string;
}

const { rooms, cta, headline, scriptAccent, intro } = Astro.props as Props;
const [first, ...others] = rooms;
const tabbed = rooms.length > 1;
const arn = Math.round((first.width / first.height) * 1e5) / 1e5;
---

<section
  class="room"
  aria-labelledby="room-heading"
  data-room
  style={`--room-ar:${first.width} / ${first.height};--room-arn:${arn}`}
>
  <div class="r-wrap room__head">
    <RiseWords as="h2" id="room-heading" text={headline} accent={scriptAccent} class="r-h2" />
    <p class="r-lede">{intro}</p>
  </div>

  <div class="room__track" data-room-track>
    <div class="r-wrap room__stage" data-room-stage>
      {
        tabbed && (
          <div class="room__tabs" role="tablist" aria-label="Concept rooms" data-room-tabs hidden>
            {rooms.map((r, i) => (
              <button
                type="button"
                role="tab"
                class="room__tab"
                id={`room-tab-${r.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="room-panel"
                tabindex={i === 0 ? 0 : -1}
                data-room-tab={r.slug}
                data-announce={r.announce}
              >
                <span class="room__tab-label">{r.label}</span>
                <span class="room__tab-style">{r.style}</span>
              </button>
            ))}
          </div>
        )
      }
      {
        /* The tab panel is a plain div around the figure (a figure may not
          take role="tabpanel"); the script adds the role only with tabs. */
      }
      <div class="room__col" id="room-panel" data-room-panel>
        <figure class="room__figure" data-room-figure>
          <RoomScene room={first} canvas />
          <div class="room__rule" aria-hidden="true" data-room-rule>
            <span class="room__rule-fill"></span>
          </div>
          <svg class="room__string" aria-hidden="true" focusable="false" data-room-string>
            {
              [0, 1].map((slot) => (
                <g data-slot={slot}>
                  <path class="room__string-halo" pathLength="1" d="" />
                  <path class="room__string-ink" pathLength="1" d="" />
                  <path class="room__string-knot" d="" />
                </g>
              ))
            }
          </svg>
          <RoomNotes room={first} cta={cta} />
          <figcaption class="room__tag r-tag"><strong>Concept room</strong></figcaption>
        </figure>
      </div>
      <p class="sr-only" aria-live="polite" data-room-live>{first.finalAlt}</p>
    </div>
  </div>

  {
    others.map((r) => (
      <template data-room-tpl={r.slug}>
        <RoomScene room={r} />
        <RoomNotes room={r} cta={cta} />
      </template>
    ))
  }
</section>

<style>
  .room {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    /* The pinned track's height: SCRUB_TRACK_SVH in room-story.ts (tested). */
    --room-track: 300svh;
    /* Where the stage pins: under the header strip. The header's sticky box
       is 4.5rem below 1024px (Header.astro, --hdr-h); on a laptop the room
       sits a little lower, under the condensed floating strip. That variable
       is scoped to the header, so it is mirrored here rather than read. */
    --room-pin: 4.5rem;
    /* The tab row's share of the pinned stage (0 without tabs). */
    --room-tabs: 0rem;
    /* The progress rule (its line plus the gap round it). */
    --room-rule: 1.25rem;
    /* Everything in the stage that is not the picture (laptop): rule, the
       plan dock and breathing room. The picture takes the rest. */
    --room-dock: 6.75rem;
    /* The gap between the photo and a card in its margin. */
    --room-gap: 1.75rem;
    background: var(--color-chip-1);
    /* Phone: a tighter band, the pinned room already gives it height. */
    padding-block: clamp(2.5rem, 10vw, 8.5rem);
  }
  .room[data-tabbed] {
    --room-tabs: 4.25rem;
  }
  .room [hidden] {
    display: none !important;
  }
  .room__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .room__head :global(.r-h2) {
    grid-column: 1 / 8;
    margin: 0;
    max-width: 14ch;
  }
  .room__head .r-lede {
    grid-column: 9 / 13;
    margin: 0;
  }

  /* ---- the stage --------------------------------------------------------- */
  .room__stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    /* A flex child is min-content wide by default; the chip and tab rows are
       wider than a phone and must scroll inside their own boxes. */
    min-width: 0;
  }
  .room__col {
    width: 100%;
    margin-inline: auto;
  }
  .room__figure {
    position: relative;
    margin: 0;
  }
  .room__tag {
    position: absolute;
    left: -0.4rem;
    top: 1rem;
    /* Above the canvas, the string, the pins and the cards: the honesty
       label must never be covered. */
    z-index: 7;
  }
  .room__tag strong {
    font-size: 1rem;
  }

  /* ---- the progress rule: a hairline that fills, a tick per beat --------- */
  .room__rule {
    position: relative;
    display: none; /* only with the scrub (below) */
    height: 1px;
    margin-block: calc((var(--room-rule) - 1px) / 2);
    background: var(--color-rule);
  }
  .room__rule-fill {
    position: absolute;
    inset: -0.5px 0;
    background: var(--color-chip-6);
    transform-origin: left center;
    transform: scaleX(var(--room-p, 0));
  }
  /* Ticks are added by the script, one at the end of each beat. */
  .room__rule :global(i) {
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    margin-left: -0.5px;
    background: var(--color-chip-6);
  }

  /* ---- the string: hidden without the script ---------------------------- */
  .room__string {
    display: none;
  }

  /* ---- the room tabs: a row of sample tags; the chosen one is pulled ----- */
  .room__tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.45rem 0.3rem 0.5rem;
    margin: -0.45rem -0.3rem 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.3rem;
    scrollbar-width: none;
  }
  .room__tabs::-webkit-scrollbar {
    display: none;
  }
  .room__tab {
    position: relative;
    isolation: isolate;
    flex: none;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    min-height: 3rem;
    padding: 0.45rem 0.95rem 0.5rem 1.7rem;
    border: 0;
    background: none;
    color: var(--color-ink-2);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  .room__tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: transparent;
    clip-path: polygon(0.9rem 0, 100% 0, 100% 100%, 0.9rem 100%, 0 50%);
  }
  .room__tab::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    top: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    translate: 0 -50%;
    box-shadow: inset 0 0 0 1.5px var(--color-rule);
  }
  .room__tab-label {
    font: 500 0.92rem/1.1 var(--font-body);
  }
  .room__tab-style {
    font: 400 0.74rem/1.1 var(--font-body);
    color: var(--color-ink-2);
  }
  .room__tab:hover::before {
    background: color-mix(in oklab, var(--color-paper) 55%, transparent);
  }
  .room__tab[aria-selected='true'] {
    color: var(--color-ink);
    rotate: -1.5deg;
    translate: 0 -2px;
    filter: drop-shadow(0 8px 10px rgb(35 30 27 / 0.18));
  }
  .room__tab[aria-selected='true']::before {
    background: var(--color-paper);
  }
  .room__tab[aria-selected='true']::after {
    box-shadow: inset 0 0 0 1.5px var(--color-chip-5);
  }
  .room__tab:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  @media (max-width: 1023px) {
    .room__head :global(.r-h2),
    .room__head .r-lede {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .room {
      --room-pin: 7rem;
    }
  }

  /* ==== THE SCRUB AND THE ANNOTATIONS: only where scripting runs ==========
     Without a script none of this applies: no track, no pin, and the notes
     are the plain list under the finished room (RoomNotes.astro). */
  @media (scripting: enabled) {
    .room {
      /* The track ends with the stage's own bottom; no extra padding under. */
      padding-bottom: clamp(2rem, 4vw, 3rem);
    }
    .room__track {
      height: var(--room-track);
    }
    .room__stage {
      position: sticky;
      top: var(--room-pin);
      height: calc(100svh - var(--room-pin));
      justify-content: center;
      padding-bottom: 1rem;
      gap: 0.6rem;
    }
    .room__rule {
      display: block;
    }
    /* The figure is a size container: its children place themselves
       against the photo's height, --ph (the frame's aspect is --room-arn). */
    .room__figure {
      container-type: inline-size;
    }
    .room :global(.room__board) {
      --ph: calc(100cqw / var(--room-arn));
      display: contents;
    }

    /* ---- the string ----------------------------------------------------- */
    /* Above the cards: the thread runs OVER the tag from its edge to the
       hole, the way a real one is threaded through. It never crosses a
       card's words (it leaves the hole outwards, away from the text). */
    .room__string {
      position: absolute;
      inset: 0;
      z-index: 6;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
    .room__string g {
      opacity: 0;
    }
    .room__string g[data-on] {
      opacity: 1;
    }
    .room__string path {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    /* A paper halo under the thread, so it shows on the linen, on a bright
       window and on dark walnut alike. */
    .room__string-halo,
    .room__string-ink {
      stroke-dasharray: 1 1.02;
      stroke-dashoffset: var(--off, 1);
    }
    .room__string-halo {
      stroke: rgb(255 253 250 / 0.7);
      stroke-width: 3.4;
    }
    .room__string-ink {
      stroke: rgb(35 30 27 / 0.88);
      stroke-width: 1.1;
    }
    /* The little curl where the thread is tied through the tag's hole. */
    .room__string-knot {
      stroke: rgb(35 30 27 / 0.88);
      stroke-width: 1.1;
      opacity: var(--knot, 0);
    }

    /* ---- the pins ------------------------------------------------------- */
    .room :global(.room__pin) {
      position: absolute;
      left: calc(var(--px) * 100%);
      top: calc(var(--py) * var(--ph));
      z-index: 4;
      translate: -50% -50%;
      opacity: 0;
      scale: 0.6;
    }
    .room :global(.room__pin[data-on]) {
      opacity: 1;
      scale: 1;
    }

    /* ---- the cards: only the current one of each kind shows ------------- */
    .room :global(.room__card) {
      z-index: 5;
      opacity: 0;
      visibility: hidden;
    }
    .room :global(.room__card[data-on]),
    /* Before the script has read the scroll, the brief shows. */
    .room:not([data-enhanced]) :global(.room__brief) {
      opacity: 1;
      visibility: visible;
    }
    .room :global([data-room-close]) {
      z-index: 5;
      opacity: 0;
      visibility: hidden;
    }
    .room[data-closed] :global([data-room-close]) {
      opacity: 1;
      visibility: visible;
    }
  }

  /* ---- laptop, both shapes (the TALL window's layout, then the wide
     window's overrides below) ---------------------------------------------
     TALL window (2026-10-03, a deliberate change from the brief): the beat
     card does NOT sit over the photo. Tried there first, its eight lines
     covered the chair and the rug as they arrived. It is a slim notebook
     strip above the photo instead (--room-band, taken from the photo's
     height), with the brief in the same strip at the start. Only the tag
     goes over the photo, in the corner that covers least of its piece. */
  @media (scripting: enabled) and (min-width: 1024px) {
    .room {
      --room-band: 6.5rem;
    }
    /* As wide as the height left over allows. */
    .room__col {
      width: min(
        100%,
        calc(
          (
              100svh - var(--room-pin) - var(--room-tabs) - var(--room-rule) - var(--room-dock) -
                var(--room-band)
            ) *
            var(--room-ar)
        )
      );
    }
    .room__figure {
      margin-top: var(--room-band);
    }
    .room :global(.room__card),
    .room :global([data-room-close]) {
      position: absolute;
    }
    /* TALL window: the strip above the photo, the label beside the words. */
    .room :global(.room__brief),
    .room :global(.room__beat) {
      left: 0;
      right: 0;
      bottom: calc(100% + 0.6rem);
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      align-items: start;
      column-gap: 1.25rem;
      padding: 0.7rem 1.1rem 0.75rem;
    }
    .room :global(.room__brief::before),
    .room :global(.room__beat::before) {
      grid-column: 1;
      grid-row: 1;
      margin: 0.15rem 0 0;
    }
    .room :global(.room__beat-label),
    .room :global(.room__brief-title) {
      grid-column: 1;
      grid-row: 1;
      margin: 0.75rem 0 0;
    }
    .room :global(.room__beat-text),
    .room :global(.room__brief-rows) {
      grid-column: 2;
      grid-row: 1;
    }
    /* Up to three lines in the strip, even in a 1024px window. */
    .room :global(.room__beat-text) {
      --line: 1.5rem;
      font-size: 1rem;
    }
    .room :global(.room__brief-title) {
      display: block;
    }
    .room :global(.room__brief-title small) {
      display: block;
      margin-top: 0.2rem;
    }
    .room :global(.room__brief-rows) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .room :global(.room__brief .room__brief-row dd) {
      border-bottom: 1px solid rgb(156 118 97 / 0.32);
      font-size: 1rem;
    }
    /* The tag: placed by the script (the corner that covers least of its
       piece and never its pin). */
    .room :global(.room__note) {
      left: 0;
      top: 0;
      width: min(17rem, 38%);
    }
    /* The close takes the dock's place, as one row. */
    .room :global([data-room-close]) {
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 2rem;
    }
    .room :global([data-room-close] .room__close-line) {
      margin: 0;
      max-width: none;
    }
    .room[data-closed] :global(.room__dock) {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* ---- WIDE laptop window: the cards live in the margins ------------------
     The room is height-limited, so it leaves side margins; the 8/5 test
     stands in for "the margin is wide enough". The room also gives up a
     little width so each margin is at least --room-side (the cards are the
     content here, and the booking tag at the close must fit beside the
     photo). --gw is the card width: the margin less a breathing gap. */
  @media (scripting: enabled) and (min-width: 1100px) and (min-aspect-ratio: 8/5) {
    .room {
      --room-gap: 1.5rem;
      --room-side: 19.5rem;
    }
    .room__col {
      width: min(
        100%,
        calc(100vw - 2 * var(--room-side)),
        calc(
          (100svh - var(--room-pin) - var(--room-tabs) - var(--room-rule) - var(--room-dock)) *
            var(--room-ar)
        )
      );
    }
    .room :global(.room__board) {
      --gw: clamp(13rem, calc((100vw - 100cqw) / 2 - var(--room-gap) - 2.25rem), 18.5rem);
    }
    .room {
      --room-band: 0rem;
    }
    .room :global(.room__brief),
    .room :global(.room__beat) {
      left: auto;
      right: calc(100% + var(--room-gap));
      bottom: calc(100% - var(--ph));
      display: block;
      width: var(--gw);
      padding: 1.05rem 1.2rem 1.15rem;
    }
    .room :global(.room__beat-label),
    .room :global(.room__brief-title) {
      margin: 0 0 0.3rem;
    }
    .room :global(.room__brief-title) {
      display: flex;
    }
    .room :global(.room__brief-title small) {
      display: inline;
      margin: 0;
    }
    .room :global(.room__brief::before),
    .room :global(.room__beat::before) {
      margin: 0 0 0.6rem;
    }
    .room :global(.room__brief-rows) {
      grid-template-columns: none;
      gap: 0.3rem;
    }
    /* The tag: in the right margin; the script sets its top so it is
       centred on its pin, inside the photo's height. */
    .room :global(.room__note) {
      left: calc(100% + var(--room-gap));
      width: var(--gw);
    }
    /* The close: the right margin, bottom-aligned with the photo (mirroring
       the beat card, and clear of the back-to-top button in the corner).
       The dock stays, every chip lit. */
    .room :global([data-room-close]) {
      left: calc(100% + var(--room-gap));
      right: auto;
      bottom: calc(100% - var(--ph));
      display: block;
      width: var(--gw);
    }
    .room :global([data-room-close] .room__close-line) {
      margin-bottom: 1.1rem;
      max-width: 17ch;
    }
    .room[data-closed] :global(.room__dock) {
      opacity: 1;
      visibility: visible;
    }
  }

  /* ---- phone: one card under the room, the plan row under that ----------- */
  @media (scripting: enabled) and (max-width: 1023px) {
    /* The room is full width, unless the screen is so short (a phone on its
       side) that it would push the card and the plan off it. */
    .room__col {
      width: max(
        min(100%, 14rem),
        min(100%, calc((100svh - var(--room-pin) - var(--room-tabs) - 18rem) * var(--room-ar)))
      );
    }
    .room :global(.room__board) {
      display: grid;
      grid-template-areas: 'slot' 'dock';
      grid-template-rows: auto auto;
      row-gap: 0.85rem;
      margin-top: 0.15rem;
    }
    .room :global(.room__brief),
    .room :global(.room__note) {
      grid-area: slot;
      align-self: start;
    }
    .room :global(.room__beat) {
      display: none;
    }
    /* The beat's short name rides on the tag, beside its check. */
    .room :global(.rtag__beat) {
      display: inline-block;
      margin: 0 0.6rem 0 0;
    }
    .room :global(.room__dock) {
      grid-area: dock;
    }
    .room :global([data-room-close]) {
      grid-row: 1 / 3;
      grid-column: 1;
      align-self: center;
    }
    .room[data-closed] :global(.room__dock) {
      opacity: 0;
      visibility: hidden;
    }
    /* A phone card is a touch smaller than a laptop one. */
    .room :global(.rtag__text) {
      max-width: none;
      font-size: 1.04rem;
    }
    /* The brief, compact: each question and its answer on one line. */
    .room :global(.room__brief) {
      padding: 0.75rem 1rem 0.7rem;
    }
    .room :global(.room__brief::before) {
      margin-bottom: 0.45rem;
    }
    .room :global(.room__brief-title) {
      margin-bottom: 0.2rem;
    }
    .room :global(.room__brief-title span) {
      font-size: 1.25rem;
    }
    .room :global(.room__brief-rows) {
      gap: 0;
    }
    .room :global(.room__brief-row) {
      display: grid;
      grid-template-columns: 6.6rem 1fr;
      align-items: baseline;
      gap: 0.6rem;
      padding: 0.3rem 0 0.25rem;
      border-bottom: 1px solid rgb(156 118 97 / 0.32);
    }
    .room :global(.room__brief-row:last-child) {
      border-bottom: 0;
    }
    .room :global(.room__brief-row dd) {
      margin: 0;
      padding: 0;
      border: 0;
      font-size: 1rem;
      line-height: 1.25;
    }
  }

  /* ---- motion ------------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .room__tab {
      transition:
        color 200ms var(--ease),
        rotate 400ms var(--ease),
        translate 400ms var(--ease);
    }
    .room__tab::before {
      transition: background-color 200ms var(--ease);
    }
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    /* The hand-over: the old card fades out as the new one comes. */
    .room :global(.room__card),
    .room :global([data-room-close]),
    .room :global(.room__dock) {
      transition:
        opacity 340ms var(--ease),
        visibility 0s linear 340ms;
    }
    .room :global(.room__card[data-on]),
    .room[data-closed] :global([data-room-close]),
    .room:not([data-closed]) :global(.room__dock) {
      transition:
        opacity 340ms var(--ease),
        visibility 0s;
    }
    /* A new tag swings on from its hole and lands square. */
    .room :global(.room__note[data-on]) {
      animation: room-swing 620ms var(--ease) both;
    }
    .room :global(.room__pin) {
      transition:
        opacity 260ms var(--ease),
        scale 420ms var(--ease);
    }
    .room__string g {
      transition: opacity 320ms var(--ease);
    }
  }
  @keyframes room-swing {
    from {
      transform: rotate(-4deg) translateY(-0.35rem);
    }
    to {
      transform: none;
    }
  }
  .room :global(.room__note) {
    transform-origin: 0.95rem 50%;
  }
</style>

<script>
  import {
    beatAt,
    beatTicks,
    closeShown,
    hexToLinear,
    noteAt,
    noteDraw,
    planLit,
    scrubPosition,
    snapPosition,
    stringPath,
    swatchesShown,
    trackProgress,
  } from '@/lib/room-story';
  import type { PainterRoom, RoomPainter } from '@/scripts/room-painter';

  const SIZES = '(min-width: 1024px) 75vw, 100vw';
  let teardown: (() => void) | null = null;

  /**
   * Give a frame's <img> its real sources (they wait in data attributes, so an
   * unarmed frame downloads nothing) and decode it. Memoised per element.
   */
  const loads = new WeakMap<HTMLImageElement, Promise<HTMLImageElement>>();
  function loadFrame(img: HTMLImageElement): Promise<HTMLImageElement> {
    let p = loads.get(img);
    if (p) return p;
    img.loading = 'eager';
    const { avif, webp, src } = img.dataset;
    if (src !== undefined) {
      const pic = img.parentElement;
      for (const [type, set] of [
        ['image/avif', avif],
        ['image/webp', webp],
      ]) {
        if (!set || !pic) continue;
        const s = document.createElement('source');
        s.type = type as string;
        s.srcset = set;
        s.sizes = SIZES;
        pic.insertBefore(s, img);
      }
      delete img.dataset.avif;
      delete img.dataset.webp;
      delete img.dataset.src;
      img.sizes = SIZES;
      img.src = src;
    }
    p = img.decode().then(() => img);
    loads.set(img, p);
    return p;
  }
  const imgsOf = (box: Element) => [...box.querySelectorAll<HTMLImageElement>('.room__frame img')];
  const numbers = (s: string | undefined) => (s ?? '').split(',').filter(Boolean).map(Number);
  /** Armed, fetched and decodable: safe to show. */
  const ready = (img: HTMLImageElement) =>
    img.dataset.src === undefined && img.complete && img.naturalWidth > 0;

  /** The painter's view of a room's frames box, or null if it is malformed. */
  function roomOf(box: HTMLElement): PainterRoom | null {
    const imgs = imgsOf(box);
    if (imgs.length < 2) return null;
    const aspect = Number(imgs[0].getAttribute('width')) / Number(imgs[0].getAttribute('height'));
    const med = numbers(box.dataset.wallMedian);
    return {
      wall:
        box.dataset.wall && med.length === 3
          ? { url: box.dataset.wall, median: med as [number, number, number] }
          : null,
      aspect: aspect > 0 ? aspect : 4 / 3,
      frames: imgs.map((img) => {
        const b = numbers(img.dataset.box);
        return {
          load: () => loadFrame(img),
          change: img.dataset.change ?? null,
          box: b.length === 4 ? (b as [number, number, number, number]) : null,
          motion: Number(img.dataset.motion ?? -1),
        };
      }),
    };
  }

  const toggle = (el: Element | undefined | null, on: boolean) =>
    el?.toggleAttribute('data-on', on);

  function init() {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-room]');
    if (!root) return;
    // A browser that cannot say whether scripting runs never got the pinned
    // track in CSS: leave it the plain, finished room with its list.
    if (!matchMedia('(scripting: enabled)').matches) return;
    const track = root.querySelector<HTMLElement>('[data-room-track]');
    const stage = root.querySelector<HTMLElement>('[data-room-stage]');
    const figure = root.querySelector<HTMLElement>('[data-room-figure]');
    const canvas = root.querySelector<HTMLCanvasElement>('.room__canvas');
    const live = root.querySelector<HTMLElement>('[data-room-live]');
    const panel = root.querySelector<HTMLElement>('[data-room-panel]');
    const rule = root.querySelector<HTMLElement>('[data-room-rule]');
    const svg = root.querySelector<SVGSVGElement>('[data-room-string]');
    const tablist = root.querySelector<HTMLElement>('[data-room-tabs]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-room-tab]')];
    const frames = () => root.querySelector<HTMLElement>('.room__frames');
    const notesBox = () => root.querySelector<HTMLElement>('.room__notes');
    if (!track || !stage || !figure || !canvas || !live || !panel || !rule || !svg) return;
    if (!frames() || !notesBox()) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = matchMedia('(min-width: 1100px) and (min-aspect-ratio: 8/5)');
    const laptop = matchMedia('(min-width: 1024px)');
    let painter: RoomPainter | null = null;
    let dead = false;
    root.dataset.enhanced = '';

    // ---- the string's two slots (the tag going, the tag coming) ------------
    const slots = [...svg.querySelectorAll<SVGGElement>('g[data-slot]')].map((g) => ({
      g,
      paths: [...g.querySelectorAll<SVGPathElement>('path')],
      note: -1,
    }));
    let slot = 0;

    // ---- where the visitor is ----------------------------------------------
    let progress = 0; // 0..1 along the track
    let pos = 0; // build position, 0..n
    let n = 0; // the showing room's last frame
    let ends: number[] = [];
    let current = -2; // the card showing: 0 brief, k tag, -1 close; -2 = not read yet
    let beat = -2;
    let closed = false;
    let pendingCaption = '';
    let lit: boolean[] = [];
    // After a room is chosen, its "Showing the ..." line stands a moment.
    let quietUntil = 0;

    // The showing room's annotation elements (re-read on a room switch).
    let notes: HTMLElement[] = []; // notes[k] = piece k's tag (index 0 unused)
    let pins: HTMLElement[] = [];
    let beats: HTMLElement[] = [];
    let brief: HTMLElement | null = null;
    let chips: HTMLElement[] = [];
    let chipBeats: number[] = [];
    let closeLine = '';
    // The paint swatches (finished frame only): shown once the painter has
    // drawn AND the wall mask is in, and only while the build has finished.
    let paintRow: HTMLElement | null = null;
    let wallOk = false;
    let paintShown = false;

    // ---- the <img> stack (the picture without WebGL) -------------------------
    // Frames up to floor(pos) are on (each covers the ones under it), the next
    // one fades in by the fraction, the rest are off. A frame that has not
    // decoded is left off, so the room holds on the last one that has.
    const syncStack = () => {
      const f = frames();
      if (!f || root.hasAttribute('data-painted')) return;
      const pics = [...f.querySelectorAll<HTMLElement>('.room__frame')];
      const imgs = imgsOf(f);
      if (!imgs[0] || !ready(imgs[0])) return;
      const a = Math.floor(pos);
      const t = pos - a;
      pics.forEach((pic, i) => {
        const ok = ready(imgs[i]);
        const partial = ok && i === a + 1 && t > 0;
        pic.toggleAttribute('data-on', ok && i <= a);
        pic.style.opacity = partial ? String(t) : '';
        pic.style.zIndex = partial ? '1' : '';
      });
    };

    // ---- placing a tag and its string ---------------------------------------
    /** The photo's size inside the figure (the figure's width, the frame's shape). */
    const photo = () => {
      const w = figure.clientWidth;
      const arn = Number(getComputedStyle(root).getPropertyValue('--room-arn')) || 4 / 3;
      return { w, h: w / arn };
    };

    /**
     * Put piece k's tag where it belongs (laptop; a phone's tag sits in the
     * grid). Wide window: in the right margin, centred on its pin and kept
     * inside the photo's height. Tall window: over the photo, in the corner
     * that covers least of its piece and never its pin.
     */
    const placeTag = (k: number) => {
      const tag = notes[k];
      if (!tag) return;
      const { w, h } = photo();
      const [px, py] = numbers(tag.dataset.pin);
      if (!laptop.matches) {
        // Phone: the tag sits in the grid under the photo and hangs from its
        // top edge; punch the hole under the pin (kept off the corners).
        tag.style.left = tag.style.top = '';
        tag.removeAttribute('data-flip');
        const x = Math.max(30, Math.min(tag.offsetWidth - 30, px * w - tag.offsetLeft));
        tag.style.setProperty('--hx', `${Math.round(x)}px`);
        return;
      }
      tag.style.removeProperty('--hx');
      tag.removeAttribute('data-flip');
      const th = tag.offsetHeight;
      const tw = tag.offsetWidth;
      if (wide.matches) {
        tag.style.left = '';
        tag.style.top = `${Math.round(Math.max(0, Math.min(h - th, py * h - th / 2)))}px`;
        return;
      }
      const [bx, by, bw, bh] = numbers(tag.dataset.box);
      const m = 16; // inset from the photo's edges
      const prefer = tag.dataset.side === 'left' ? 'left' : 'right';
      const pinX = px * w;
      const pinY = py * h;
      // Candidates: the right side top and bottom, the left side top (below
      // the "Concept room" tag). Lower-left belongs to the beat card.
      // A tag on the left side is MIRRORED (hole at its right end), so its
      // hole always faces into the room.
      const cands = [
        { x: w - tw - m, y: m, side: 'right', flip: false },
        { x: w - tw - m, y: h - th - m, side: 'right', flip: false },
        { x: m, y: Math.min(h - th - m, 64), side: 'left', flip: true },
      ];
      const area = (x: number, y: number) => {
        const ox = Math.max(0, Math.min(x + tw, (bx + bw) * w) - Math.max(x, bx * w));
        const oy = Math.max(0, Math.min(y + th, (by + bh) * h) - Math.max(y, by * h));
        return ox * oy;
      };
      let best = cands[0];
      let score = Infinity;
      // Score: how much of the piece it covers (a share of the tag), how far
      // the string has to run (a share of the photo's width), the piece's
      // preferred side as a tie-breaker. Ruled out: a corner whose string
      // would have to cross its own tag to reach the pin (the pin must lie
      // beyond the hole's end of the tag), which also keeps the tag off it.
      for (const c of cands) {
        const holeX = c.flip ? c.x + tw - 15 : c.x + 15;
        const crosses = c.flip ? pinX < c.x + tw + 12 : pinX > c.x - 12;
        const coversPin = crosses;
        const run = Math.hypot(pinX - holeX, pinY - (c.y + th / 2));
        const s =
          (2 * area(c.x, c.y)) / (tw * th) +
          run / w +
          (coversPin ? 1e9 : 0) +
          (c.side === prefer ? 0 : 0.12);
        if (s < score) {
          score = s;
          best = c;
        }
      }
      tag.style.left = `${Math.round(best.x)}px`;
      tag.style.top = `${Math.round(best.y)}px`;
      tag.toggleAttribute('data-flip', best.flip);
    };

    /** Point the slot's string from piece k's tag hole to its pin. */
    const aim = (s: (typeof slots)[number], k: number) => {
      const tag = notes[k];
      const hole = tag?.querySelector<HTMLElement>('.rtag__hole');
      if (!tag || !hole) return;
      const { w, h } = photo();
      const [px, py] = numbers(tag.dataset.pin);
      const hx = tag.offsetLeft + hole.offsetLeft;
      const hy = tag.offsetTop + hole.offsetTop;
      const d = stringPath(hx, hy, px * w, py * h, k);
      s.paths[0].setAttribute('d', d);
      s.paths[1].setAttribute('d', d);
      // The loop: a second strand from the hole round the tag's edge, so
      // the thread reads as tied through the hole, not stuck to it. It
      // leaves the hole the way the string does (toward the pin).
      const ang = Math.atan2(py * h - hy, px * w - hx);
      const ux = Math.cos(ang);
      const uy = Math.sin(ang);
      const L = 15;
      const ex = hx + ux * L - uy * 2.5;
      const ey = hy + uy * L + ux * 2.5;
      const cx = hx + ux * L * 0.35 - uy * 7.5;
      const cy = hy + uy * L * 0.35 + ux * 7.5;
      const r = (v: number) => Math.round(v * 10) / 10;
      s.paths[2].setAttribute('d', `M${r(hx)} ${r(hy)}Q${r(cx)} ${r(cy)} ${r(ex)} ${r(ey)}`);
      s.note = k;
    };

    /** How much of the current tag's string shows. */
    const drawString = () => {
      const s = slots[slot];
      if (s.note < 1) return;
      const d = reduced ? 1 : noteDraw(pos, s.note);
      s.g.style.setProperty('--off', String(1 - d));
      s.g.style.setProperty('--knot', d > 0.02 ? '1' : '0');
    };

    /** Say something in the live region (not on the first read, not just after a room switch). */
    const say = (text: string) => {
      if (performance.now() >= quietUntil) live.textContent = text;
    };

    /** Switch the cards, pins and string to card `k` (0 brief, k tag, -1 close). */
    const showCard = (k: number) => {
      if (k === current) return;
      const first = current === -2;
      current = k;
      toggle(brief, k === 0);
      notes.forEach((t, i) => toggle(t, i === k));
      pins.forEach((p, i) => toggle(p, i === k));
      // The string: the old slot fades with its tag, the new one draws in.
      slots[slot].g.toggleAttribute('data-on', false);
      if (k > 0) {
        slot = 1 - slot;
        placeTag(k);
        aim(slots[slot], k);
        slots[slot].g.toggleAttribute('data-on', true);
        drawString();
        if (!first) {
          const tag = notes[k];
          const label = tag.querySelector('.rtag__check')?.textContent?.trim() ?? '';
          const text = tag.querySelector('.rtag__text')?.textContent?.trim() ?? '';
          say(`${pendingCaption ? `${pendingCaption} ` : ''}${label}: ${text}`);
          pendingCaption = '';
        }
      } else {
        slots[slot].note = -1;
      }
    };

    /** The beat card on show (laptop's left margin): the brief before the first tag. */
    const showBeat = (k: number, card: number) => {
      const b = card === 0 ? -1 : k;
      if (b === beat) return;
      const was = beat;
      beat = b;
      beats.forEach((el, i) => toggle(el, i === b));
      // A new beat: its caption is read with the beat's first tag (which
      // arrives a moment later), so neither cuts the other off.
      if (was !== -2 && b >= 0 && beats[b]) {
        pendingCaption = beats[b].querySelector('.room__beat-text')?.textContent?.trim() ?? '';
      }
    };

    /** Light the plan chips whose beat has finished. */
    const showPlan = () => {
      const now = planLit(pos, chipBeats, ends);
      now.forEach((on, i) => {
        if (on === lit[i]) return;
        chips[i].toggleAttribute('data-lit', on);
        // On a phone the strip scrolls sideways: bring a newly lit chip
        // into view inside its own row (never the page).
        const row = chips[i].parentElement;
        if (on && lit.length && row && row.scrollWidth > row.clientWidth + 1) {
          const left = chips[i].offsetLeft - 4;
          if (
            left < row.scrollLeft ||
            left + chips[i].offsetWidth > row.scrollLeft + row.clientWidth
          )
            row.scrollTo({ left, behavior: reduced ? 'auto' : 'smooth' });
        }
      });
      lit = now;
    };

    /** Show or hide the swatch row; leaving the finished room puts the walls back. */
    const showPaint = () => {
      const on =
        Boolean(paintRow) && wallOk && root.hasAttribute('data-painted') && swatchesShown(pos, n);
      if (on === paintShown) return;
      paintShown = on;
      if (paintRow) paintRow.hidden = !on;
      if (!on) pickSwatch(null, false);
    };
    /** Choose a swatch (its button, or null for "As it is"). */
    const pickSwatch = (btn: HTMLButtonElement | null, speak: boolean) => {
      const btns = [...(paintRow?.querySelectorAll<HTMLButtonElement>('[data-swatch]') ?? [])];
      const chosen = btn ?? btns[0];
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b === chosen)));
      const hex = chosen?.dataset.swatch ?? '';
      void painter?.setChip(hex ? hexToLinear(hex) : null);
      if (speak && chosen)
        live.textContent = hex ? `Walls in ${chosen.textContent?.trim()}.` : 'Walls as they are.';
    };
    const onSwatch = (e: Event) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-swatch]');
      if (b) pickSwatch(b, true);
    };
    /** Fetch the showing room's wall mask (the painter answers whether it is in). */
    const loadWall = () => {
      wallOk = false;
      const mine = paintRow;
      if (!painter || !mine) return showPaint();
      void painter.setChip(null).then((ok) => {
        if (dead || mine !== paintRow) return;
        wallOk = ok;
        showPaint();
      });
    };

    /** Read the scroll, and draw the build there. */
    const apply = () => {
      if (dead) return;
      const r = track.getBoundingClientRect();
      const pin = parseFloat(getComputedStyle(stage).top) || 0;
      progress = trackProgress(r.top, r.height, stage.offsetHeight, pin);
      const raw = scrubPosition(progress, n, ends);
      pos = reduced ? snapPosition(raw) : raw;
      rule.style.setProperty('--room-p', String(n ? pos / n : 0));
      const wasFirst = current === -2;
      const card = noteAt(pos, n);
      showBeat(beatAt(pos, ends), card);
      showCard(card);
      drawString();
      showPlan();
      const c = closeShown(pos, n);
      if (c !== closed) {
        closed = c;
        root.toggleAttribute('data-closed', c);
        if (c && !wasFirst) say(closeLine);
      }
      painter?.setProgress(pos);
      syncStack();
      showPaint();
    };

    // One read per frame at most, and only while the track is near the screen.
    let queued = 0;
    const onScroll = () => {
      if (!queued) {
        queued = requestAnimationFrame(() => {
          queued = 0;
          apply();
        });
      }
    };
    /** A resize moves every card: re-place the tag and re-aim its string. */
    const onResize = () => {
      if (current > 0) {
        placeTag(current);
        aim(slots[slot], current);
      }
      onScroll();
    };
    let listening = false;
    const listen = (on: boolean) => {
      if (on === listening) return;
      listening = on;
      if (on) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize, { passive: true });
        apply();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
      }
    };
    const nearTrack = new IntersectionObserver((es) => listen(es.some((e) => e.isIntersecting)), {
      rootMargin: '50% 0px',
    });
    nearTrack.observe(track);
    // The fonts change every card's height: re-place once they are in.
    void document.fonts?.ready.then(() => !dead && onResize());

    /** (Re-)arm for the room now in the DOM: its beats, notes, ticks and frames. */
    const arm = () => {
      const box = notesBox();
      notes = [];
      box?.querySelectorAll<HTMLElement>('.room__note').forEach((t) => {
        notes[Number(t.dataset.card)] = t;
      });
      pins = [];
      box?.querySelectorAll<HTMLElement>('[data-pin-for]').forEach((p) => {
        pins[Number(p.dataset.pinFor)] = p;
      });
      beats = box ? [...box.querySelectorAll<HTMLElement>('.room__beat')] : [];
      brief = box?.querySelector<HTMLElement>('.room__brief') ?? null;
      chips = box ? [...box.querySelectorAll<HTMLElement>('[data-plan-beat]')] : [];
      chipBeats = chips.map((c) => Number(c.dataset.planBeat));
      closeLine = box?.querySelector('[data-room-close] .room__close-line')?.textContent ?? '';
      paintRow?.removeEventListener('click', onSwatch);
      if (paintRow) paintRow.hidden = true;
      paintRow = box?.querySelector<HTMLElement>('[data-room-paint]') ?? null;
      paintRow?.addEventListener('click', onSwatch);
      wallOk = false;
      paintShown = false;
      ends = numbers(frames()?.dataset.ends);
      n = Math.max(0, imgsOf(frames() as HTMLElement).length - 1);
      current = beat = -2;
      pendingCaption = '';
      lit = [];
      closed = false;
      root.removeAttribute('data-closed');
      slots.forEach((s) => {
        s.g.removeAttribute('data-on');
        s.note = -1;
      });
      rule.querySelectorAll('i').forEach((i) => i.remove());
      for (const t of beatTicks(ends, n)) {
        const tick = document.createElement('i');
        tick.style.left = `${t * 100}%`;
        rule.append(tick);
      }
      apply();
    };
    arm();

    /** Decode a room's frames one after another, in build order. */
    const preload = async (box: HTMLElement) => {
      for (const img of imgsOf(box)) {
        try {
          await loadFrame(img);
        } catch {
          /* a missing frame: the stack keeps what it shows */
        }
        if (dead || box !== frames()) return;
        syncStack();
      }
    };

    // ---- frames and the painter, loaded about a screen early --------------
    const fallback = () => {
      painter = null;
      wallOk = false;
      if (paintRow) paintRow.hidden = true;
      paintShown = false;
      canvas.hidden = true;
      root.dataset.nogl = '';
      delete root.dataset.painted;
      syncStack();
    };
    const near = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        void preload(frames() as HTMLElement);
        try {
          const { createRoomPainter } = await import('@/scripts/room-painter');
          const room = roomOf(frames() as HTMLElement);
          if (dead || !room) return fallback();
          painter = createRoomPainter(canvas, room, pos, {
            reducedMotion: reduced,
            onReady: () => {
              if (dead) return;
              canvas.hidden = false;
              root.dataset.painted = '';
              loadWall();
            },
            onLost: fallback,
          });
          if (!painter) fallback();
        } catch {
          fallback();
        }
      },
      { rootMargin: '100% 0px' },
    );
    near.observe(root);

    // ---- room tabs (two or more rooms) -------------------------------------
    // Rooms already shown, kept detached so going back is instant.
    const kept = new Map<string, { frames: HTMLElement; notes: HTMLElement }>();
    let chosen = 0;

    const select = (k: number) => {
      if (k === chosen || !tabs[k]) return;
      const slug = tabs[k].dataset.roomTab ?? '';
      let next = kept.get(slug);
      if (!next) {
        const tpl = root.querySelector<HTMLTemplateElement>(`template[data-room-tpl="${slug}"]`);
        const frag = tpl?.content.cloneNode(true) as DocumentFragment | undefined;
        const f = frag?.querySelector<HTMLElement>('.room__frames');
        const c = frag?.querySelector<HTMLElement>('.room__notes');
        if (!f || !c) return;
        next = { frames: f, notes: c };
      }
      const outFrames = frames();
      const outNotes = notesBox();
      if (!outFrames || !outNotes) return;
      kept.set(tabs[chosen].dataset.roomTab ?? '', { frames: outFrames, notes: outNotes });
      kept.delete(slug);

      // Swap. The canvas moves with the room (on top of its stack); it shows
      // the plain stack until the painter has the new room's textures.
      canvas.toggleAttribute('data-loading', !canvas.hidden);
      outFrames.replaceWith(next.frames);
      next.frames.append(canvas);
      outNotes.replaceWith(next.notes);
      const ar = next.frames.style.getPropertyValue('--ar');
      if (ar) {
        root.style.setProperty('--room-ar', ar);
        const [a, b] = ar.split('/').map(Number);
        if (a > 0 && b > 0) root.style.setProperty('--room-arn', String(a / b));
      }

      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === k));
        t.tabIndex = i === k ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tabs[k].id);
      chosen = k;
      // The visitor keeps their place: the same share of the new room's build.
      live.textContent = tabs[k].dataset.announce ?? '';
      quietUntil = performance.now() + 1500;
      arm();
      void preload(next.frames);

      const room = roomOf(next.frames);
      if (painter && room) {
        const mine = k;
        painter.setRoom(room, pos).then((ok) => {
          // null: a later choice superseded this load.
          if (dead || ok === null || chosen !== mine) return;
          canvas.removeAttribute('data-loading');
          canvas.hidden = !ok;
          root.toggleAttribute('data-painted', ok);
          if (!ok) syncStack();
          else loadWall();
        });
      } else {
        canvas.removeAttribute('data-loading');
      }
    };

    const onTabClick = (e: Event) => select(tabs.indexOf(e.currentTarget as HTMLButtonElement));
    // Manual activation: the arrows, Home and End move focus along the row;
    // Enter or Space (the buttons' own click) chooses.
    const onTabKey = (e: KeyboardEvent) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const count = tabs.length;
      const to =
        e.key === 'ArrowRight'
          ? (i + 1) % count
          : e.key === 'ArrowLeft'
            ? (i - 1 + count) % count
            : e.key === 'Home'
              ? 0
              : e.key === 'End'
                ? count - 1
                : -1;
      if (to < 0) return;
      e.preventDefault();
      tabs[to].focus();
      tabs[to].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    if (tablist && tabs.length > 1) {
      tablist.hidden = false;
      root.dataset.tabbed = '';
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[0].id);
      tabs.forEach((t) => t.addEventListener('click', onTabClick));
      tablist.addEventListener('keydown', onTabKey);
    }

    teardown = () => {
      dead = true;
      listen(false);
      if (queued) cancelAnimationFrame(queued);
      nearTrack.disconnect();
      near.disconnect();
      tabs.forEach((t) => t.removeEventListener('click', onTabClick));
      tablist?.removeEventListener('keydown', onTabKey);
      kept.clear();
      paintRow?.removeEventListener('click', onSwatch);
      painter?.destroy();
      painter = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
