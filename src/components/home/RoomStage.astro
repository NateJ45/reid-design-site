---
// Foundation, edit with care
// =============================================================================
// RoomStage: draws the concept rooms (added 2026-09-30; room tabs the same
// day; the scroll scrub and the pinned full-width room, 2026-10-02). Only
// RoomStory.astro renders it, and only with at least one valid, complete
// room, so this markup and its script never reach a page that has no room.
// =============================================================================
// THE SCRUB (Nathan, 2026-10-02): the build follows the visitor's scroll
// position in BOTH directions. Scroll slowly and a piece slides in as you go;
// stop and it stops part-way; scroll back and it slides out. About three
// screens of scroll carry the whole story (three beats).
//
// PARTS
//   - Heading and intro (scroll away normally).
//   - The TRACK: a tall box (--room-track, 300svh; the same number as
//     SCRUB_TRACK_SVH in src/lib/room-story.ts, a unit test holds them
//     together) with the STAGE pinned inside it (position: sticky, just under
//     the header). Its height is reserved in CSS, so nothing shifts when the
//     script starts. Only with scripting: `@media (scripting: enabled)`.
//   - In the stage, top to bottom:
//       * Room tabs (only with two or more rooms): a real ARIA tablist,
//         `hidden` in the markup and shown by the script. Manual activation:
//         arrows / Home / End move focus, Enter or Space (or a click) chooses,
//         because choosing downloads a room's pictures. The chosen tab is a
//         pulled paper sample tag. Choosing keeps the visitor's place: the new
//         room shows at the same share of its build.
//       * The room (RoomScene.astro), as wide as the screen's height allows,
//         with the "Concept room" sample tag in its top corner (the honesty
//         label, always above the canvas).
//       * A hairline progress rule under it with a tick at the end of each
//         beat. Decorative (aria-hidden), no numbers.
//       * The caption card (RoomCaptions.astro): a small paper card in the
//         margin left of the room on a wide laptop window (over its lower-left
//         corner, narrow, in a tall one), BELOW the room on a phone.
//         It shows the current beat's caption and cross-fades on a beat
//         change; a visually hidden live region reads each new caption.
//       * The paint deck, a slim dock under the room, ALWAYS there once the
//         painter has drawn (you can repaint the empty room too).
//   - Every other room's scene and captions inside a <template>, srcsets
//     baked in. Template content is inert, so nothing downloads until chosen.
//
// SCROLL INPUT: a passive scroll listener, coalesced to one
// requestAnimationFrame, attached ONLY while the track is near the screen (an
// IntersectionObserver turns it on and off). Native scrolling only: nothing
// here ever moves, snaps or hijacks the page (no smooth-scroll library; see
// CLAUDE.md rule 5). Progress along the track (0..1) becomes a build position
// (scrubPosition in room-story.ts: rests at both ends and after each beat),
// which drives the painter (src/scripts/room-painter.ts) or, without WebGL,
// the <img> stack (whole frames crossfaded by the same position). Reduced
// motion: the position snaps to whole frames, and the card does not animate.
//
// FALLBACKS
//   - No script (or a browser without the `scripting` media feature): no
//     track, no pinning. The finished room with its tag, and the three
//     captions as a plain list under it. No other frame downloads.
//   - Script but no WebGL (none, a failed shader, a lost context): the <img>
//     frames crossfade by scroll position; the chips go away.
//
// LAYOUT
//   - Laptop (1024px+): stage pinned 7rem down (under the condensed header
//     strip); the room centred, its width min(100%, height left * aspect);
//     the card in its left margin (see RoomCaptions.astro); chips in one row under it.
//   - Phone: pinned under the 4.5rem header strip; room full width, then the
//     card, then the chips as a sideways scroll-snap row; ALL of it inside one
//     375x667 screen (tests/room-story.spec.ts measures it).
// =============================================================================
import RiseWords from '@/components/RiseWords.astro';
import { ROOM_CHIPS, linearToHex } from '@/lib/room-story';
import RoomScene from './RoomScene.astro';
import RoomCaptions from './RoomCaptions.astro';
import type { RoomView } from './room-view';

interface Props {
  /** At least one room; the first shows on load. */
  rooms: RoomView[];
  headline: string;
  scriptAccent?: string | null;
  intro: string;
}

const { rooms, headline, scriptAccent, intro } = Astro.props as Props;
const [first, ...others] = rooms;
const tabbed = rooms.length > 1;
// "As it is" shows the first room's own wall colour as its swatch (the script
// updates it on a switch).
const asIsHex = linearToHex(first.median);
---

<section
  class="room"
  aria-labelledby="room-heading"
  data-room
  style={`--room-ar:${first.width} / ${first.height}`}
>
  <div class="r-wrap room__head">
    <RiseWords as="h2" id="room-heading" text={headline} accent={scriptAccent} class="r-h2" />
    <p class="r-lede">{intro}</p>
  </div>

  <div class="room__track" data-room-track>
    <div class="r-wrap room__stage" data-room-stage>
      {
        tabbed && (
          <div class="room__tabs" role="tablist" aria-label="Concept rooms" data-room-tabs hidden>
            {rooms.map((r, i) => (
              <button
                type="button"
                role="tab"
                class="room__tab"
                id={`room-tab-${r.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="room-panel room-captions"
                tabindex={i === 0 ? 0 : -1}
                data-room-tab={r.slug}
                data-announce={r.announce}
              >
                <span class="room__tab-label">{r.label}</span>
                <span class="room__tab-style">{r.style}</span>
              </button>
            ))}
          </div>
        )
      }
      {
        /* The tab panel is a plain div around the figure (a figure may not
          take role="tabpanel"); the script adds the role only with tabs. */
      }
      <div class="room__col" id="room-panel" data-room-panel>
        <figure class="room__figure">
          <RoomScene room={first} canvas />
          <div class="room__rule" aria-hidden="true" data-room-rule>
            <span class="room__rule-fill"></span>
          </div>
          <figcaption class="room__tag r-tag"><strong>Concept room</strong></figcaption>
          <RoomCaptions stages={first.stages} />
        </figure>
      </div>
      <p class="sr-only" aria-live="polite" data-room-live>{first.finalAlt}</p>

      <fieldset class="room__deck" data-room-chips hidden>
        <legend class="room__legend">Try a paint colour on the walls</legend>
        <div class="room__chips">
          {
            ROOM_CHIPS.map((c, i) => (
              <button
                type="button"
                class="room__chip"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-hex={c.hex ?? ''}
              >
                <span
                  class="room__swatch"
                  data-as-is={c.hex ? undefined : ''}
                  style={`background:${c.hex ?? asIsHex}`}
                />
                <span>{c.name}</span>
              </button>
            ))
          }
        </div>
      </fieldset>
    </div>
  </div>

  {
    others.map((r) => (
      <template data-room-tpl={r.slug}>
        <RoomScene room={r} />
        <RoomCaptions stages={r.stages} />
      </template>
    ))
  }
</section>

<style>
  .room {
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    /* The pinned track's height: SCRUB_TRACK_SVH in room-story.ts (tested). */
    --room-track: 300svh;
    /* Where the stage pins: under the header strip. The header's sticky box
       is 4.5rem below 1024px (Header.astro, --hdr-h); on a laptop the room
       sits a little lower, under the condensed floating strip. That variable
       is scoped to the header, so it is mirrored here rather than read. */
    --room-pin: 4.5rem;
    /* The tab row's share of the pinned stage (0 without tabs). */
    --room-tabs: 0rem;
    /* The progress rule (its line plus the gap round it). */
    --room-rule: 1.25rem;
    /* Everything in the stage that is not the picture (laptop): rule, the
       chip dock and breathing room. The picture takes the rest. */
    --room-dock: 6.25rem;
    background: var(--color-chip-1);
    padding-block: clamp(5rem, 10vw, 8.5rem);
  }
  .room[data-tabbed] {
    --room-tabs: 4.25rem;
  }
  .room [hidden] {
    display: none !important;
  }
  .room__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .room__head :global(.r-h2) {
    grid-column: 1 / 8;
    margin: 0;
    max-width: 14ch;
  }
  .room__head .r-lede {
    grid-column: 9 / 13;
    margin: 0;
  }

  /* ---- the stage --------------------------------------------------------- */
  .room__stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    /* A flex child is min-content wide by default; the chip and tab rows are
       wider than a phone and must scroll inside their own boxes. */
    min-width: 0;
  }
  .room__col {
    width: 100%;
    margin-inline: auto;
  }
  .room__figure {
    position: relative;
    margin: 0;
  }
  .room__tag {
    position: absolute;
    left: -0.4rem;
    top: 1rem;
    rotate: -2deg;
    /* Above the room's canvas: the honesty label must never be covered. */
    z-index: 3;
  }
  .room__tag strong {
    font-size: 1rem;
  }

  /* ---- the progress rule: a hairline that fills, a tick per beat --------- */
  .room__rule {
    position: relative;
    display: none; /* only with the scrub (below) */
    height: 1px;
    margin-block: calc((var(--room-rule) - 1px) / 2);
    background: var(--color-rule);
  }
  .room__rule-fill {
    position: absolute;
    inset: -0.5px 0;
    background: var(--color-chip-6);
    transform-origin: left center;
    transform: scaleX(var(--room-p, 0));
  }
  /* Ticks are added by the script, one at the end of each beat. */
  .room__rule :global(i) {
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    margin-left: -0.5px;
    background: var(--color-chip-6);
  }

  /* ---- the room tabs: a row of sample tags; the chosen one is pulled ----- */
  .room__tabs {
    display: flex;
    gap: 0.25rem;
    /* Room for the focus outline and the pulled tag's lift and shadow
       inside the scroll box. */
    padding: 0.45rem 0.3rem 0.5rem;
    margin: -0.45rem -0.3rem 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.3rem;
    scrollbar-width: none;
  }
  .room__tabs::-webkit-scrollbar {
    display: none;
  }
  .room__tab {
    position: relative;
    isolation: isolate;
    flex: none;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    min-height: 3rem;
    padding: 0.45rem 0.95rem 0.5rem 1.7rem;
    border: 0;
    background: none;
    color: var(--color-ink-2);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  /* The tag's body: a paper shape with a notched left edge (as .r-tag), drawn
     on ::before so the focus outline is never clipped. Empty until hover or
     choice. */
  .room__tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: transparent;
    clip-path: polygon(0.9rem 0, 100% 0, 100% 100%, 0.9rem 100%, 0 50%);
  }
  /* The tag's punched hole: a ring, Warm Bronze on the chosen tag. */
  .room__tab::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    top: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    translate: 0 -50%;
    box-shadow: inset 0 0 0 1.5px var(--color-rule);
  }
  .room__tab-label {
    font: 500 0.92rem/1.1 var(--font-body);
  }
  .room__tab-style {
    font: 400 0.74rem/1.1 var(--font-body);
    color: var(--color-ink-2);
  }
  .room__tab:hover::before {
    background: color-mix(in oklab, var(--color-paper) 55%, transparent);
  }
  .room__tab[aria-selected='true'] {
    color: var(--color-ink);
    rotate: -1.5deg;
    translate: 0 -2px;
    filter: drop-shadow(0 8px 10px rgb(35 30 27 / 0.18));
  }
  .room__tab[aria-selected='true']::before {
    background: var(--color-paper);
  }
  .room__tab[aria-selected='true']::after {
    box-shadow: inset 0 0 0 1.5px var(--color-chip-5);
  }
  .room__tab:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* ---- the paint deck: one slim row under the room ------------------------ */
  .room__deck {
    min-width: 0; /* a fieldset is min-content wide by default; let the row scroll */
    margin: 0;
    padding: 0;
    border: 0;
  }
  .room__legend {
    padding: 0;
    margin-bottom: 0.4rem;
    font: 500 0.85rem/1.3 var(--font-body);
    color: var(--color-ink);
  }
  .room__chips {
    display: flex;
    gap: 0.4rem;
    /* One row, scrolling sideways when it is wider than the stage. Padding
       inside the scroll box keeps the focus outline unclipped. */
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    padding: 0.25rem;
    margin: -0.25rem;
    scrollbar-width: none;
  }
  .room__chips::-webkit-scrollbar {
    display: none;
  }
  .room__chip {
    flex: none;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.3rem 0.7rem 0.3rem 0.35rem;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 500 0.82rem/1 var(--font-body);
    white-space: nowrap;
    cursor: pointer;
  }
  .room__chip[aria-pressed='true'] {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .room__chip:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .room__swatch {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(35 30 27 / 0.14);
  }

  @media (max-width: 1023px) {
    .room__head :global(.r-h2),
    .room__head .r-lede {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .room {
      --room-pin: 7rem;
    }
    /* Centre the dock's single row under the room when it fits. */
    .room__deck {
      align-self: center;
      max-width: 100%;
    }
    .room__legend {
      margin-inline: auto;
    }
  }

  /* ---- the scrub: only where scripting runs ------------------------------
     Without a script none of this applies: no track, no pin, and the
     captions are a plain list under the finished room. */
  @media (scripting: enabled) {
    .room {
      /* The track ends with the stage's own bottom; no extra padding under. */
      padding-bottom: clamp(2rem, 4vw, 3rem);
    }
    .room__track {
      height: var(--room-track);
    }
    .room__stage {
      position: sticky;
      top: var(--room-pin);
      height: calc(100svh - var(--room-pin));
      justify-content: center;
      padding-bottom: 1rem;
      gap: 0.6rem;
    }
    .room__rule {
      display: block;
    }
    /* The deck keeps its space while the painter loads (so nothing moves when
       it appears); without WebGL it goes for good. */
    .room__deck[hidden] {
      display: block !important;
      visibility: hidden;
    }
    .room[data-nogl] .room__deck {
      display: none !important;
    }
  }
  @media (scripting: enabled) and (max-width: 1023px) {
    /* Let the last chip scroll clear of the floating back-to-top button in
       the bottom corner. */
    .room__chips {
      padding-inline-end: 4.5rem;
    }
    /* Phone: the room is full width, unless the screen is so short (a phone
       on its side) that it would push the card and chips off it. */
    .room__col {
      width: max(
        min(100%, 14rem),
        min(100%, calc((100svh - var(--room-pin) - var(--room-tabs) - 17rem) * var(--room-ar)))
      );
    }
  }
  @media (min-width: 1024px) {
    /* Laptop: as wide as the height left over allows (pinned or not, so the
       no-script picture also fits a screen). */
    .room__col {
      width: min(
        100%,
        calc(
          (100svh - var(--room-pin) - var(--room-tabs) - var(--room-rule) - var(--room-dock)) *
            var(--room-ar)
        )
      );
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .room__chip {
      transition: border-color 150ms ease;
    }
    .room__tab {
      transition:
        color 200ms var(--ease),
        rotate 400ms var(--ease),
        translate 400ms var(--ease);
    }
    .room__tab::before {
      transition: background-color 200ms var(--ease);
    }
  }
</style>

<script>
  import {
    beatAt,
    beatTicks,
    hexToLinear,
    linearToHex,
    scrubPosition,
    snapPosition,
    trackProgress,
  } from '@/lib/room-story';
  import type { PainterRoom, RoomPainter } from '@/scripts/room-painter';

  const SIZES = '(min-width: 1024px) 75vw, 100vw';
  let teardown: (() => void) | null = null;

  /**
   * Give a frame's <img> its real sources (they wait in data attributes, so an
   * unarmed frame downloads nothing) and decode it. Memoised per element.
   */
  const loads = new WeakMap<HTMLImageElement, Promise<HTMLImageElement>>();
  function loadFrame(img: HTMLImageElement): Promise<HTMLImageElement> {
    let p = loads.get(img);
    if (p) return p;
    img.loading = 'eager';
    const { avif, webp, src } = img.dataset;
    if (src !== undefined) {
      const pic = img.parentElement;
      for (const [type, set] of [
        ['image/avif', avif],
        ['image/webp', webp],
      ]) {
        if (!set || !pic) continue;
        const s = document.createElement('source');
        s.type = type as string;
        s.srcset = set;
        s.sizes = SIZES;
        pic.insertBefore(s, img);
      }
      delete img.dataset.avif;
      delete img.dataset.webp;
      delete img.dataset.src;
      img.sizes = SIZES;
      img.src = src;
    }
    p = img.decode().then(() => img);
    loads.set(img, p);
    return p;
  }
  const imgsOf = (box: Element) => [...box.querySelectorAll<HTMLImageElement>('.room__frame img')];
  const numbers = (s: string | undefined) => (s ?? '').split(',').filter(Boolean).map(Number);
  /** Armed, fetched and decodable: safe to show. */
  const ready = (img: HTMLImageElement) =>
    img.dataset.src === undefined && img.complete && img.naturalWidth > 0;

  /** The painter's view of a room's frames box, or null if it is malformed. */
  function roomOf(box: HTMLElement): PainterRoom | null {
    const median = numbers(box.dataset.median);
    const imgs = imgsOf(box);
    if (median.length !== 3 || median.some((n) => !(n > 0)) || imgs.length < 2) return null;
    const aspect = Number(imgs[0].getAttribute('width')) / Number(imgs[0].getAttribute('height'));
    return {
      median: median as [number, number, number],
      aspect: aspect > 0 ? aspect : 4 / 3,
      frames: imgs.map((img) => {
        const b = numbers(img.dataset.box);
        return {
          load: () => loadFrame(img),
          wall: img.dataset.wall ?? '',
          change: img.dataset.change ?? null,
          box: b.length === 4 ? (b as [number, number, number, number]) : null,
          motion: Number(img.dataset.motion ?? -1),
        };
      }),
    };
  }

  function init() {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-room]');
    if (!root) return;
    // A browser that cannot say whether scripting runs never got the pinned
    // track in CSS: leave it the plain, finished room with its caption list.
    if (!matchMedia('(scripting: enabled)').matches) return;
    const track = root.querySelector<HTMLElement>('[data-room-track]');
    const stage = root.querySelector<HTMLElement>('[data-room-stage]');
    const canvas = root.querySelector<HTMLCanvasElement>('.room__canvas');
    const deck = root.querySelector<HTMLElement>('[data-room-chips]');
    const live = root.querySelector<HTMLElement>('[data-room-live]');
    const panel = root.querySelector<HTMLElement>('[data-room-panel]');
    const rule = root.querySelector<HTMLElement>('[data-room-rule]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.room__chip')];
    const asIs = root.querySelector<HTMLElement>('.room__swatch[data-as-is]');
    const tablist = root.querySelector<HTMLElement>('[data-room-tabs]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-room-tab]')];
    const frames = () => root.querySelector<HTMLElement>('.room__frames');
    const captions = () => root.querySelector<HTMLElement>('.room__captions');
    if (!track || !stage || !canvas || !deck || !live || !panel || !rule) return;
    if (!frames() || !captions()) return;
    if (captions()!.querySelectorAll('[data-room-step]').length < 2) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let painter: RoomPainter | null = null;
    let chip: [number, number, number] | null = null;
    let dead = false;
    root.dataset.enhanced = '';

    // ---- where the visitor is ----------------------------------------------
    let progress = 0; // 0..1 along the track
    let pos = 0; // build position, 0..n
    let n = 0; // the showing room's last frame
    let ends: number[] = [];
    let steps: HTMLElement[] = [];
    let beat = -2; // -2 = not read yet
    // After a room is chosen, its "Showing the ..." line stands a moment;
    // beat lines resume after that.
    let quietUntil = 0;

    // ---- the <img> stack (the picture without WebGL) -------------------------
    // Frames up to floor(pos) are on (each covers the ones under it), the next
    // one fades in by the fraction, the rest are off. A frame that has not
    // decoded is left off, so the room holds on the last one that has, never
    // an empty box. The finished frame is the permanent underlay (and the
    // no-script picture); it comes to the top only when it is being shown.
    const syncStack = () => {
      const f = frames();
      if (!f || root.hasAttribute('data-painted')) return;
      const pics = [...f.querySelectorAll<HTMLElement>('.room__frame')];
      const imgs = imgsOf(f);
      // Until the empty room has loaded the markup's default (finished) stays.
      if (!imgs[0] || !ready(imgs[0])) return;
      const a = Math.floor(pos);
      const t = pos - a;
      pics.forEach((pic, i) => {
        const ok = ready(imgs[i]);
        const partial = ok && i === a + 1 && t > 0;
        pic.toggleAttribute('data-on', ok && i <= a);
        pic.style.opacity = partial ? String(t) : '';
        pic.style.zIndex = partial ? '1' : '';
      });
    };

    /** Which beat is current, and say so (not on the first read). */
    const showBeat = (k: number) => {
      if (k === beat) return;
      const first = beat === -2;
      beat = k;
      steps.forEach((s, i) => {
        if (i === k) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      if (!first && k >= 0 && performance.now() >= quietUntil) {
        live.textContent = (steps[k].textContent ?? '').trim();
      }
    };

    /** Read the scroll, and draw the build there. */
    const apply = () => {
      if (dead) return;
      const r = track.getBoundingClientRect();
      const pin = parseFloat(getComputedStyle(stage).top) || 0;
      progress = trackProgress(r.top, r.height, stage.offsetHeight, pin);
      const raw = scrubPosition(progress, n, ends);
      pos = reduced ? snapPosition(raw) : raw;
      rule.style.setProperty('--room-p', String(n ? pos / n : 0));
      showBeat(beatAt(pos, ends));
      painter?.setProgress(pos);
      syncStack();
    };

    // One read per frame at most, and only while the track is near the screen.
    let queued = 0;
    const onScroll = () => {
      if (!queued) {
        queued = requestAnimationFrame(() => {
          queued = 0;
          apply();
        });
      }
    };
    let listening = false;
    const listen = (on: boolean) => {
      if (on === listening) return;
      listening = on;
      if (on) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        apply();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      }
    };
    const nearTrack = new IntersectionObserver((es) => listen(es.some((e) => e.isIntersecting)), {
      rootMargin: '50% 0px',
    });
    nearTrack.observe(track);

    /** (Re-)arm for the room now in the DOM: its beats, ticks and frames. */
    const arm = () => {
      const c = captions();
      steps = c ? [...c.querySelectorAll<HTMLElement>('[data-room-step]')] : [];
      ends = numbers(frames()?.dataset.ends);
      n = Math.max(0, imgsOf(frames() as HTMLElement).length - 1);
      beat = -2;
      rule.querySelectorAll('i').forEach((i) => i.remove());
      for (const t of beatTicks(ends, n)) {
        const tick = document.createElement('i');
        tick.style.left = `${t * 100}%`;
        rule.append(tick);
      }
      apply();
    };
    arm();

    /** Decode a room's frames one after another, in build order. */
    const preload = async (box: HTMLElement) => {
      for (const img of imgsOf(box)) {
        try {
          await loadFrame(img);
        } catch {
          /* a missing frame: the stack keeps what it shows */
        }
        if (dead || box !== frames()) return;
        syncStack();
      }
    };

    // ---- paint chips ------------------------------------------------------
    const onChip = (e: Event) => {
      const btn = e.currentTarget as HTMLButtonElement;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === btn)));
      chip = btn.dataset.hex ? hexToLinear(btn.dataset.hex) : null;
      painter?.setChip(chip);
    };
    chips.forEach((c) => c.addEventListener('click', onChip));
    const paintAsIs = () => {
      const m = numbers(frames()?.dataset.median);
      if (asIs && m.length === 3)
        asIs.style.background = linearToHex(m as [number, number, number]);
    };

    // ---- frames and the painter, loaded about a screen early --------------
    const fallback = () => {
      painter = null;
      canvas.hidden = true;
      deck.hidden = true;
      root.dataset.nogl = '';
      delete root.dataset.painted;
      syncStack();
    };
    const near = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        void preload(frames() as HTMLElement);
        try {
          const { createRoomPainter } = await import('@/scripts/room-painter');
          const room = roomOf(frames() as HTMLElement);
          if (dead || !room) return fallback();
          painter = createRoomPainter(canvas, room, pos, {
            reducedMotion: reduced,
            onReady: () => {
              if (dead) return;
              canvas.hidden = false;
              deck.hidden = false;
              root.dataset.painted = '';
            },
            onLost: fallback,
          });
          if (!painter) fallback();
          else if (chip) painter.setChip(chip);
        } catch {
          fallback();
        }
      },
      { rootMargin: '100% 0px' },
    );
    near.observe(root);

    // ---- room tabs (two or more rooms) -------------------------------------
    // Rooms already shown, kept detached so going back is instant.
    const kept = new Map<string, { frames: HTMLElement; captions: HTMLElement }>();
    let current = 0;

    const select = (k: number) => {
      if (k === current || !tabs[k]) return;
      const slug = tabs[k].dataset.roomTab ?? '';
      let next = kept.get(slug);
      if (!next) {
        const tpl = root.querySelector<HTMLTemplateElement>(`template[data-room-tpl="${slug}"]`);
        const frag = tpl?.content.cloneNode(true) as DocumentFragment | undefined;
        const f = frag?.querySelector<HTMLElement>('.room__frames');
        const c = frag?.querySelector<HTMLElement>('.room__captions');
        if (!f || !c) return;
        next = { frames: f, captions: c };
      }
      const outFrames = frames();
      const outCaptions = captions();
      if (!outFrames || !outCaptions) return;
      kept.set(tabs[current].dataset.roomTab ?? '', { frames: outFrames, captions: outCaptions });
      kept.delete(slug);

      // Swap. The canvas moves with the room (on top of its stack); it shows
      // the plain stack until the painter has the new room's textures.
      canvas.toggleAttribute('data-loading', !canvas.hidden);
      outFrames.replaceWith(next.frames);
      next.frames.append(canvas);
      outCaptions.replaceWith(next.captions);
      const ar = next.frames.style.getPropertyValue('--ar');
      if (ar) root.style.setProperty('--room-ar', ar);

      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === k));
        t.tabIndex = i === k ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tabs[k].id);
      current = k;
      // The visitor keeps their place: the same share of the new room's build.
      arm();
      paintAsIs();
      live.textContent = tabs[k].dataset.announce ?? '';
      quietUntil = performance.now() + 1500;
      void preload(next.frames);

      const room = roomOf(next.frames);
      if (painter && room) {
        const mine = k;
        painter.setRoom(room, pos).then((ok) => {
          // null: a later choice superseded this load.
          if (dead || ok === null || current !== mine) return;
          canvas.removeAttribute('data-loading');
          canvas.hidden = !ok;
          deck.hidden = !ok;
          root.toggleAttribute('data-painted', ok);
          if (!ok) syncStack();
        });
      } else {
        canvas.removeAttribute('data-loading');
      }
    };

    const onTabClick = (e: Event) => select(tabs.indexOf(e.currentTarget as HTMLButtonElement));
    // Manual activation: the arrows, Home and End move focus along the row;
    // Enter or Space (the buttons' own click) chooses.
    const onTabKey = (e: KeyboardEvent) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const count = tabs.length;
      const to =
        e.key === 'ArrowRight'
          ? (i + 1) % count
          : e.key === 'ArrowLeft'
            ? (i - 1 + count) % count
            : e.key === 'Home'
              ? 0
              : e.key === 'End'
                ? count - 1
                : -1;
      if (to < 0) return;
      e.preventDefault();
      tabs[to].focus();
      tabs[to].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    if (tablist && tabs.length > 1) {
      tablist.hidden = false;
      root.dataset.tabbed = '';
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[0].id);
      tabs.forEach((t) => t.addEventListener('click', onTabClick));
      tablist.addEventListener('keydown', onTabKey);
    }

    teardown = () => {
      dead = true;
      listen(false);
      if (queued) cancelAnimationFrame(queued);
      nearTrack.disconnect();
      near.disconnect();
      chips.forEach((c) => c.removeEventListener('click', onChip));
      tabs.forEach((t) => t.removeEventListener('click', onTabClick));
      tablist?.removeEventListener('keydown', onTabKey);
      kept.clear();
      painter?.destroy();
      painter = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
