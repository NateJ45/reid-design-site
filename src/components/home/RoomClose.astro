---
// Safe to edit by hand (the look); the line comes from the room's manifest,
// the button from the header (RoomStory.astro)
// =============================================================================
// RoomClose: the end of the annotated concept room (2026-10-03)
// =============================================================================
// Shows once the build has finished: the closing line in Zodiak ("You see
// everything before a single item is purchased.", Staci's own words from
// /process), the house booking tag (`.r-pricetag`, ink on linen) carrying the
// SAME label and link as the header button and the consultation price derived
// from content (never typed; no price, no price part), and a quiet link to
// /process.
//
// It sits straight on the linen ground, not on a card: it is the house tag,
// a different object from the paper tags and notebook pages. RoomStage places
// it: the right margin at the dock's end on a wide laptop window, over the
// dock on a tall one, and in place of the tag and the dock on a phone. The
// same markup also ends the plain list without a script (`plain`).
//
// THE PAINT SWATCHES (2026-10-03, `paint`): under the booking tag, a quiet row
// of four wall colours (ROOM_SWATCHES: Sage, Clay, Lake, Espresso) plus "As it
// is", labelled with the plan's "Color and finish guidance" chip so it reads
// as a taste of that deliverable. Small round paint dabs with their names in
// small ink type: they must never outrank the booking tag. Real buttons with
// aria-pressed. The row ships `hidden`; RoomStage's script shows it only once
// the painter has drawn the finished room AND loaded its wall mask, and only
// while the build has finished, so without a script, without WebGL or on any
// failure the close looks exactly as it did before.
// =============================================================================
import type { CloseCta } from './room-view';
import { ROOM_SWATCHES } from '@/lib/room-story';

interface Props {
  line: string;
  cta: CloseCta;
  /** The no-script list's copy (not a card, never hidden by the script). */
  plain?: boolean;
  /** The room has a finished-frame wall mask: draw the (hidden) swatch row. */
  paint?: boolean;
}

const { line, cta, plain = false, paint = false } = Astro.props as Props;
---

<div
  class:list={['room__close', plain && 'room__close--plain']}
  data-room-close={!plain || undefined}
>
  <p class="room__close-line">{line}</p>
  <div class="room__close-acts">
    <a href={cta.href} class="r-pricetag room__close-cta">
      <span>{cta.label}</span>
      {cta.price && <span class="r-pricetag__price">{cta.price}</span>}
    </a>
    <a href="/process" class="r-link room__close-more">See the full process</a>
  </div>
  {
    paint && !plain && (
      <div
        class="room__paint"
        role="group"
        aria-label="Color and finish guidance: try a wall color"
        data-room-paint
        hidden
      >
        <p class="room__paint-label" aria-hidden="true">
          <span>Color and finish guidance</span> try a wall color
        </p>
        <div class="room__paint-row">
          <button type="button" class="room__swatch" data-swatch="" aria-pressed="true">
            <span class="room__dab room__dab--as" aria-hidden="true" />
            <span class="room__swatch-name">As it is</span>
          </button>
          {ROOM_SWATCHES.map((sw) => (
            <button type="button" class="room__swatch" data-swatch={sw.hex} aria-pressed="false">
              <span class="room__dab" style={`--dab:${sw.hex}`} aria-hidden="true" />
              <span class="room__swatch-name">{sw.name}</span>
            </button>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  .room__close {
    color: var(--color-ink);
  }
  .room__close-line {
    margin: 0 0 1rem;
    max-width: 19ch;
    font: 300 clamp(1.35rem, 1.05rem + 0.75vw, 1.7rem) / 1.18 var(--font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .room__close-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
  }
  /* The swatches: a quiet row under the booking tag (never louder than it). */
  .room__paint {
    margin-top: 0.9rem;
  }
  .room__paint[hidden] {
    display: none;
  }
  .room__paint-label {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .room__paint-label span {
    font-weight: 500;
  }
  .room__paint-label span::after {
    content: ':';
  }
  /* Each swatch is a little paint chip: a colour block over a Paper label
     strip, square-cornered like the home page chips. */
  .room__paint-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  /* Phone: keep the row clear of the back-to-top button in the corner. */
  @media (max-width: 767px) {
    .room__paint-row {
      padding-right: 3.25rem;
    }
  }
  .room__swatch {
    display: flex;
    flex-direction: column;
    width: 4.6rem;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 400 0.75rem/1.2 var(--font-sans);
    text-align: left;
    cursor: pointer;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.12),
      0 2px 5px rgb(60 40 30 / 0.12);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }
  .room__swatch:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .room__dab {
    display: block;
    height: 1.9rem;
    background: var(--dab);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.12);
  }
  .room__dab--as {
    background: linear-gradient(135deg, #c9b07a 50%, #f1e7dc 50%);
  }
  .room__swatch-name {
    display: block;
    padding: 0.4rem 0.45rem 0.45rem;
  }
  .room__swatch[aria-pressed='true'] {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 2px var(--color-ink),
      0 5px 9px rgb(60 40 30 / 0.2);
  }
  .room__swatch[aria-pressed='true'] .room__swatch-name {
    font-weight: 500;
  }
  @media (hover: hover) {
    .room__swatch:hover {
      transform: translateY(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .room__swatch {
      transition: none;
    }
    .room__swatch[aria-pressed='true'],
    .room__swatch:hover {
      transform: none;
    }
  }
  .room__close-more {
    font-size: 0.92rem;
    color: var(--color-ink);
  }
</style>
