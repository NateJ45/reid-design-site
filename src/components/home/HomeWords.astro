---
// Safe to edit by hand
// Home testimonials on ink (2026-09-29 rebuild). One quote very large, then
// up to three more set loose in uneven columns, no cards. Same Sanity data
// the old HomeTestimonials used (featuredTestimonial, testimonialsToShow,
// testimonialsHeadline/ScriptAccent/Subhead/Attribution, reviewsNote,
// googleBusinessUrl).
//
// The ink band is the page's one dark moment before the closing bronze CTA,
// which gives the home its rhythm: bronze, linen, paper, linen, INK, linen,
// bronze-deep.
//
// GOOGLE REVIEWS (2026-09-30). The Google rating sits in the heading as a
// stamp (RatingTag, self-hides without data). Google reviews are collected
// automatically (getHomePage().googleReviews) and come first, newest first;
// Staci's featured pick stays the big lead quote. A Google quote carries its
// stars, the reviewer's name as Google shows it, its age ("3 weeks ago",
// worded at build and refreshed in the browser by the script at the bottom)
// and "Read on Google". Non-Google testimonials render exactly as before.
// Ordering rules: orderReviews() in src/lib/reviews.ts (unit tested).
//
// The closing line links to Google AND, when Site settings has a Facebook
// URL, to her Facebook reviews tab (2026-10-01; same helper as About's Kind
// words, facebookReviewsUrl in src/lib/kind-words.ts).
import { splitScriptAccent } from '@/lib/scriptAccent';
import { splitStega } from '@/lib/preview-stega';
import { facebookReviewsUrl } from '@/lib/kind-words';
import RatingTag from '@/components/reviews/RatingTag.astro';
import Stars from '@/components/reviews/Stars.astro';
import GoogleCite from '@/components/reviews/GoogleCite.astro';
import {
  googleRatingFrom,
  isRatedGoogleReview,
  orderReviews,
  reviewStars,
  type GoogleRatingSettings,
  type ReviewLike,
} from '@/lib/reviews';

type Testimonial = ReviewLike;

interface Props {
  headline?: string | null;
  scriptAccent?: string | null;
  subhead?: string | null;
  attribution?: string | null;
  featuredQuote?: Testimonial | null;
  gridQuotes?: Testimonial[];
  reviewsNote?: string | null;
  googleBusinessUrl?: string | null;
  /** Site settings -> Facebook URL; linked as her Facebook reviews tab. */
  facebookUrl?: string | null;
  /** Google reviews collected by the home query, newest first. */
  googleReviews?: Testimonial[];
  /** siteSettings, for the rating stamp. */
  ratingSettings?: GoogleRatingSettings | null;
}

const {
  headline = 'What clients say',
  scriptAccent,
  featuredQuote,
  gridQuotes = [],
  attribution,
  reviewsNote,
  googleBusinessUrl,
  facebookUrl,
  googleReviews = [],
  ratingSettings,
} = Astro.props as Props;

// PREVIEW (stega): split and slice CLEAN text only, then reattach each run
// once and whole, or the overlay cannot decode it (2026-09-30). No-op live.
const head = splitStega(headline ?? '');
const h = splitScriptAccent(head.cleaned, splitStega(scriptAccent ?? '').cleaned || undefined);

// Lead + up to three loose quotes. Google reviews first, newest first; with
// no Google reviews this is exactly the old rule (featured, else the first
// picked, then the rest of the picks in Staci's order).
const { lead, more, hasGoogle } = orderReviews(featuredQuote, googleReviews, gridQuotes, 3);
const allGoogle = [lead, ...more].every((t) => !t || isRatedGoogleReview(t));
const hasRating = Boolean(googleRatingFrom(ratingSettings));

// Where "Read on Google" goes: the review itself, else the profile.
const http = (u?: string | null) => {
  const c = splitStega(u ?? '').cleaned.trim();
  return /^https?:\/\//i.test(c) ? c : null;
};
const fbReviews = facebookReviewsUrl(facebookUrl);
const googleHref = (t?: Testimonial | null) => http(t?.reviewUrl) ?? http(googleBusinessUrl);

// "April 2026" from "2026-04-01". Built by hand so it never shifts a day in
// a timezone west of UTC.
const MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];
const monthYear = (d?: string | null) => {
  const m = d?.match(/^(\d{4})-(\d{2})/);
  return m ? `${MONTHS[Number(m[2]) - 1]} ${m[1]}` : '';
};
const cite = (t?: Testimonial | null) =>
  [t?.attribution, monthYear(t?.date), t?.source && `on ${t.source}`].filter(Boolean).join(' · ');

// Short quotes read best in the loose columns: cap at ~180 chars on a word.
const trim = (input = '') => {
  const { cleaned: s, encoded } = splitStega(input);
  return (s.length > 180 ? s.slice(0, s.lastIndexOf(' ', 176)) + '…' : s) + encoded;
};
---

<section class="words" aria-labelledby="words-heading">
  <div class="r-wrap">
    <div class:list={['words__head', { 'has-stamp': hasRating }]}>
      <h2 id="words-heading" class="words__h">
        {
          h.found ? (
            <>
              {h.before}
              <span class="r-accent">{h.word}</span>
              {h.after}
              {head.encoded}
            </>
          ) : (
            headline
          )
        }
      </h2>
      {
        hasGoogle && (
          <p class="words__note">
            {allGoogle ? 'Reviews from Google, newest first' : 'Google reviews first, newest first'}
          </p>
        )
      }
      {hasRating && <RatingTag variant="stamp" settings={ratingSettings} class="words__stamp" />}
    </div>

    {
      lead?.quote && (
        <figure class="words__lead">
          {isRatedGoogleReview(lead) && (
            <p class="words__stars">
              <Stars rating={reviewStars(lead) ?? 0} />
              <span class="sr-only">{reviewStars(lead)} out of 5 stars on Google</span>
            </p>
          )}
          <blockquote>
            <p>{lead.quote}</p>
          </blockquote>
          {isRatedGoogleReview(lead) ? (
            <GoogleCite review={lead} href={googleHref(lead)} />
          ) : (
            <figcaption>{cite(lead)}</figcaption>
          )}
        </figure>
      )
    }

    {
      more.length > 0 && (
        <div class="words__more">
          {more.map((q) => (
            <figure>
              {isRatedGoogleReview(q) && (
                <p class="words__stars">
                  <Stars rating={reviewStars(q) ?? 0} />
                  <span class="sr-only">{reviewStars(q)} out of 5 stars on Google</span>
                </p>
              )}
              <blockquote>
                <p>“{trim(q.quote ?? '')}”</p>
              </blockquote>
              {isRatedGoogleReview(q) ? (
                <GoogleCite review={q} href={googleHref(q)} />
              ) : (
                <figcaption>{q.attribution}</figcaption>
              )}
            </figure>
          ))}
        </div>
      )
    }

    <p class="words__src">
      {attribution || reviewsNote}
      {
        googleBusinessUrl && (
          <a class="r-link" href={googleBusinessUrl} target="_blank" rel="noopener noreferrer">
            Read more reviews on Google
            <span class="sr-only">, opens in a new tab</span>
          </a>
        )
      }
      {
        fbReviews && (
          <a class="r-link" href={fbReviews} target="_blank" rel="noopener noreferrer">
            Read more reviews on Facebook
            <span class="sr-only">, opens in a new tab</span>
          </a>
        )
      }
    </p>
  </div>
</section>

<style>
  .words {
    --accent-color: var(--color-chip-3);
    background: var(--color-ink);
    color: var(--color-cream);
    padding-block: clamp(5rem, 10vw, 8.5rem);
  }
  /* Heading row: the heading and the source note on the left, the rating
     stamp hanging on the right (below the heading on phones). */
  .words__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 2.5rem;
    align-items: start;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  }
  .words__head.has-stamp {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .words__head :global(.words__stamp) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }
  .words__note {
    margin: 0.6rem 0 0;
    font: 500 0.92rem/1.4 var(--font-body);
    color: rgb(245 237 227 / 0.75);
  }
  .words__h {
    margin: 0;
    font: 300 clamp(1.3rem, 1rem + 0.8vw, 1.7rem) / 1.2 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-cream);
  }
  .words__lead {
    position: relative;
    margin: 0;
    max-width: 58rem;
    padding-left: clamp(0rem, 5vw, 4.5rem);
  }
  .words__lead blockquote {
    margin: 0;
  }
  .words__lead p {
    margin: 0;
    font: 300 italic clamp(2rem, 1.1rem + 3vw, 4rem) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* The hung open-quote, in bronze, outside the text block. */
  .words__lead::before {
    content: '\201C';
    position: absolute;
    left: -0.1em;
    top: -0.2em;
    font: 300 clamp(4.5rem, 3rem + 5vw, 9rem) / 1 var(--font-display);
    color: var(--color-chip-5);
  }
  .words__lead :global(figcaption),
  .words__more :global(figcaption) {
    margin-top: 1.5rem;
    font: 500 0.92rem/1.4 var(--font-body);
    color: rgb(245 237 227 / 0.75);
  }
  .words__more {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.1fr;
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 6vw, 5rem);
    padding-top: 2.5rem;
    border-top: 1px solid rgb(245 237 227 / 0.16);
  }
  .words__more figure {
    margin: 0;
  }
  .words__more figure:nth-child(2) {
    margin-top: 2.25rem;
  }
  .words__more blockquote {
    margin: 0;
  }
  .words__more p {
    margin: 0;
    font: 300 1.3rem/1.4 var(--font-display);
    color: rgb(245 237 227 / 0.94);
  }
  .words__more :global(figcaption) {
    margin-top: 0.9rem;
  }
  /* Google quotes: Sandbar stars (a fill on ink), then name, age and the link
     on one wrapping line, split by small Saddle dots. */
  .words__stars {
    --star-on: var(--color-chip-3);
    --star-off: rgb(245 237 227 / 0.2);
    --star-h: 0.9rem;
    margin: 0 0 1rem;
  }
  .words__lead .words__stars {
    --star-h: clamp(1rem, 0.8rem + 0.5vw, 1.3rem);
    margin-bottom: 1.4rem;
  }
  .words {
    --gcite-strong: var(--color-cream);
  }
  .words__src {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    font-size: 0.92rem;
    color: rgb(245 237 227 / 0.75);
  }
  .words__src .r-link {
    color: var(--color-cream);
  }

  @media (max-width: 1023px) {
    .words__head.has-stamp {
      grid-template-columns: minmax(0, 1fr);
    }
    .words__head :global(.words__stamp) {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 1.75rem;
    }
    .words__more {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .words__more figure:nth-child(2) {
      margin-top: 0;
    }
    .words__lead {
      padding-top: 2.75rem;
    }
    .words__lead::before {
      top: -0.1em;
    }
  }
</style>

<script>
  // Keep "3 weeks ago" true between builds: the site only rebuilds when
  // something is published, so the build-time wording can go stale. Re-word
  // every review age from its datetime on each page load (ClientRouter fires
  // astro:page-load on the first load too). The helper has no imports, so
  // this is a few hundred bytes. With scripts off, the build wording stays.
  import { relativeDay } from '@/lib/relative-date';
  const reword = () => {
    for (const t of document.querySelectorAll<HTMLTimeElement>('.words time[data-rel]')) {
      const w = relativeDay(t.dateTime);
      if (w && t.textContent !== w) t.textContent = w;
    }
  };
  document.addEventListener('astro:page-load', reword);
</script>
