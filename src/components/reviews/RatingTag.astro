---
// Foundation, edit with care
// =============================================================================
// RatingTag: the Google star rating as a printed card (added 2026-09-30)
// =============================================================================
// "5.0" in Zodiak, five drawn stars (partial fill for decimals), and
// "on Google", on a flat paper card with a fine double rule, like a
// printed label. Links to the Google Business Profile in a new tab.
//
// Not a tag since 2026-10-01: the notched tag is the site's ONE button
// shape (DESIGN.md "Primitives"), and a badge in the same shape read as a
// "book now" button. The card is flat (no shadow, no hole) so it reads as
// a credential, not something to press.
//
// Data: siteSettings.googleRating + googleBusinessUrl (no review count since
// 2026-10-01: it was typed by hand and went stale; see googleRatingFrom),
// through googleRatingFrom() in src/lib/reviews.ts. Pass `settings` (the
// getSiteSettings() result). **Renders nothing at all** when the rating is
// missing, so every placement collapses with no gap until Staci fills it in
// (Site Settings, Reviews tab).
//
// Variants:
//   inline   the default: home hero (under the buttons), Contact, Services
//   stamp    larger, for the heading of the home reviews band
//   compact  one short line with no tag shape, for the header. Takes
//            currentColor, so it reads on any ground; stars via --star-on /
//            --star-off (see Stars.astro). Links to the profile, like the rest.
//
// Accessible name, built from visible text plus visually hidden words so the
// visible words appear in it in order (WCAG 2.5.3):
//   "Rated 5.0 out of 5 on Google, opens Google in a new tab"
// Without a profile link it is plain text, not a link, and drops the
// "opens Google" part.
//
// Contrast: ink and ink 2 on paper (13+ and 7+). The Warm Bronze stars are a
// fill, never text (DESIGN.md, "Warm Bronze takes no body-size text").
// =============================================================================
import Stars from './Stars.astro';
import {
  formatRating,
  googleRatingFrom,
  RATING_SOURCE,
  type GoogleRatingSettings,
} from '@/lib/reviews';

interface Props {
  settings?: GoogleRatingSettings | null;
  variant?: 'inline' | 'stamp' | 'compact';
  class?: string;
}

const { settings, variant = 'inline', class: cls } = Astro.props as Props;
const summary = googleRatingFrom(settings);
// Every placement, the header's compact line included, links to the business profile
// (googleBusinessUrl), where the reviews are listed. The header briefly pointed at the
// write-a-review page; Nathan reverted that the same day (2026-10-03).
const href = summary?.profileUrl;
const Tag = href ? 'a' : 'div';
const linkAttrs = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  summary &&
    (variant === 'compact' ? (
      <Tag class:list={['rt', 'rt--compact', cls]} {...linkAttrs}>
        <Stars rating={summary.rating} class="rt__stars" />
        <span class="rt__num">
          <span class="sr-only">Rated </span>
          {formatRating(summary.rating)}
          <span class="sr-only">{' out of 5 on '}</span>
        </span>
        <span class="rt__src">
          Google
          {href && <span class="sr-only">, opens Google in a new tab</span>}
        </span>
      </Tag>
    ) : (
      <Tag class:list={['rt', `rt--${variant}`, cls]} {...linkAttrs}>
        <span class="rt__tag">
          <span class="rt__num">
            <span class="sr-only">Rated </span>
            {formatRating(summary.rating)}
            <span class="sr-only">{' out of 5 '}</span>
          </span>
          <span class="rt__body">
            <Stars rating={summary.rating} class="rt__stars" />
            <span class="rt__count">
              {RATING_SOURCE}
              {summary.profileUrl && <span class="sr-only">, opens Google in a new tab</span>}
              {summary.profileUrl && (
                <span class="rt__arrow" aria-hidden="true">
                  ↗
                </span>
              )}
            </span>
          </span>
        </span>
      </Tag>
    ))
}

<style>
  .rt {
    color: var(--color-ink);
    text-decoration: none;
  }
  a.rt:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ---- The card (inline + stamp). Drawn on an inner span, so the link's
     focus outline sits outside it. ---- */
  .rt--inline,
  .rt--stamp {
    display: inline-block;
    max-width: 100%;
    /* Square at rest since the 2026-09-30 quiet pass; --rt-tilt stays as a
       hook for a placement that wants one. */
    rotate: var(--rt-tilt, 0deg);
  }
  .rt__tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.15rem 0.65rem;
    /* Paper by default; a paper band sets --rt-face to Linen so the card
       still reads as an object (ink on Linen 13.5:1). */
    background: var(--rt-face, var(--color-paper));
    color: var(--color-ink);
  }
  /* The fine inner rule, 3px in: the printed-label double line. */
  .rt__tag::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid color-mix(in oklab, var(--color-chip-5) 55%, transparent);
    pointer-events: none;
  }
  /* A hairline between the number and the stars, as on the booking tag's
     price. */
  .rt__body {
    padding-left: 0.8rem;
    border-left: 1px solid color-mix(in oklab, var(--color-ink) 18%, transparent);
  }
  .rt__num {
    font: 300 2rem/1 var(--font-display);
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums;
  }
  .rt__body {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }
  .rt :global(.rt__stars) {
    --star-h: 0.95rem;
  }
  .rt__count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font: 500 0.85rem/1.2 var(--font-body);
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .rt__arrow {
    display: inline-block;
    color: var(--color-ink);
  }
  a.rt:hover .rt__count {
    color: var(--color-ink);
  }

  /* ---- Stamp: the reviews band heading. Bigger number, bigger stars. ---- */
  .rt--stamp .rt__tag {
    gap: 1.1rem;
    padding: 0.85rem 1.5rem 0.9rem;
  }
  .rt--stamp .rt__tag::before {
    inset: 4px;
  }
  .rt--stamp .rt__body {
    padding-left: 1.1rem;
  }
  .rt--stamp .rt__num {
    font-size: clamp(2.6rem, 2rem + 1.6vw, 3.4rem);
  }
  .rt--stamp :global(.rt__stars) {
    --star-h: 1.2rem;
  }
  .rt--stamp .rt__count {
    font-size: 0.9rem;
  }

  /* ---- Compact: one line for the header, no tag shape. ---- */
  .rt--compact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    font: 500 0.85rem/1 var(--font-body);
    white-space: nowrap;
  }
  .rt--compact :global(.rt__stars) {
    --star-h: 0.75rem;
  }
  .rt--compact .rt__num {
    font: 600 0.85rem/1 var(--font-body);
    letter-spacing: 0;
  }
  /* Invisible hit area for the header line, which is only 14px tall
     (2026-10-03, Impeccable audit P2). Reaches 0.9rem above and below. */
  a.rt--compact {
    position: relative;
  }
  a.rt--compact::after {
    content: '';
    position: absolute;
    inset: -0.9rem -0.25rem;
  }
  a.rt--compact:hover .rt__src {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The card straightens and the arrow nudges on hover, only when motion is
     welcome (DESIGN.md easing for interaction). */
  @media (prefers-reduced-motion: no-preference) {
    a.rt--inline,
    a.rt--stamp {
      transition: rotate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    a.rt--inline:hover,
    a.rt--stamp:hover,
    a.rt--inline:focus-visible,
    a.rt--stamp:focus-visible {
      rotate: 0deg;
    }
    .rt__arrow {
      transition: translate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    a.rt:hover .rt__arrow {
      translate: 2px -2px;
    }
  }
</style>
