---
// Safe to edit by hand
// The Portfolio gallery (2026-11-04): every photo in `portfolioPage.gallery`, in
// Staci's order, at its TRUE shape. Nothing is cropped, so she never has to set a
// hotspot.
//
// Captions (2026-11-05): the words Staci types on a photo (the `alt` field) show
// under it and in the viewer. A photo without any shows no caption. The link's
// label already says the same words, so the visible line is hidden from screen
// readers to stop them hearing it twice.
//
// The rows are plain CSS, no script: each photo's flex-grow and flex-basis are
// its width-to-height ratio, so a row of mixed shapes fills the width at one
// height (captions sit below and do not change a photo's shape). On a phone each
// photo gets its own row, so a caption is not squeezed into a narrow tile. The
// empty ::after soaks up the spare room on the last row, so a lone photo there
// keeps its shape instead of stretching across the page.
//
// Each photo opens in the site's photo viewer (LightboxLink + Lightbox), and with
// JavaScript off it is a link to the full-size picture.
import SanityImage from '@/components/SanityImage.astro';
import Lightbox from '@/components/Lightbox.astro';
import LightboxLink from '@/components/LightboxLink.astro';
import lightboxCss from '@/styles/lightbox.css?url';
import { firstOnPage } from '@/lib/once-per-page';
import { parseSanityAssetDimensions } from '@/lib/sanity';
import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  photos?: Array<{ _key?: string; asset?: { _ref?: string; _id?: string }; alt?: string }> | null;
}

const { photos } = Astro.props as Props;

const tiles = (photos ?? [])
  .filter((p) => p?.asset)
  .map((p, i) => {
    const dims = parseSanityAssetDimensions(p);
    const ratio = dims?.width && dims?.height ? dims.width / dims.height : 1.5;
    return {
      key: p._key ?? String(i),
      ratio: ratio.toFixed(3),
      caption: p.alt?.trim() || null,
      // The caption is optional in the Studio, so a photo without one still gets
      // words a screen reader can say.
      source: { ...p, alt: p.alt?.trim() || `Reid Design room, photo ${i + 1}` },
    };
  });

const linkViewerCss = tiles.length > 0 && firstOnPage(Astro.request, 'lightbox');
---

{tiles.length > 0 && (
  <div class="wall" data-lightbox-group>
    {tiles.map(({ key, ratio, caption, source }, i) => (
      <figure class="wall__photo" style={`--ratio:${ratio}`} data-key={key}>
        <LightboxLink source={source as SanityImageObject} caption={caption}>
          <SanityImage
            source={source}
            width={1400}
            sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 90vw"
            quality={75}
            loading={i < 3 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            class="wall__img"
          />
        </LightboxLink>
        {caption && (
          <figcaption class="wall__caption" aria-hidden="true">
            {caption}
          </figcaption>
        )}
      </figure>
    ))}
    <Lightbox />
  </div>
)}
{linkViewerCss && <link rel="stylesheet" href={lightboxCss} />}

<style>
  .wall {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .wall::after {
    content: '';
    flex-grow: 999;
  }
  .wall__photo {
    flex: 1 1 100%;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .wall__photo :global(.lightbox-link) {
    display: block;
    aspect-ratio: var(--ratio);
    overflow: clip;
    background: var(--color-chip-1);
  }
  .wall__photo :global(.wall__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wall__caption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  @media (min-width: 640px) {
    .wall {
      --row: 14rem;
      gap: 1.5rem 0.75rem;
    }
    .wall__photo {
      flex: var(--ratio) 1 calc(var(--ratio) * var(--row));
    }
  }
  @media (min-width: 1024px) {
    .wall {
      --row: 19rem;
      gap: 1.75rem 0.875rem;
    }
  }
</style>
