---
// Safe to edit by hand
// The Portfolio gallery (2026-11-04): every photo in `portfolioPage.gallery`, in
// Staci's order, at its TRUE shape, with her captions (2026-11-05). Nothing is
// cropped, so she never has to set a hotspot.
//
// The rows are plain CSS, no script: each tile's flex-grow and flex-basis are its
// width-to-height ratio, so a row of mixed shapes fills the width at one height.
// On a phone each photo gets its own row, so a caption is not squeezed.
//
// Pacing (2026-11-05): so the page has high points, some landscape photos become a
// feature, larger with the caption beside them. Chosen here from the photo's own
// facts, so Staci has nothing to set: see `isFeature`. The photos between features
// are a `run`, its own row container. A feature only lands where the desktop row
// before it is mostly full (`rowFill`), so it never strands one photo above it.
//
// The default slot is the closing card. It joins the last run and takes whatever
// room the last row has left, so the gallery never ends on a stranded photo.
//
// Each photo opens in the site's photo viewer (LightboxLink + Lightbox), and with
// JavaScript off it is a link to the full-size picture.
import Lightbox from '@/components/Lightbox.astro';
import PhotoTile from '@/components/portfolio/PhotoTile.astro';
import lightboxCss from '@/styles/lightbox.css?url';
import { firstOnPage } from '@/lib/once-per-page';
import { parseSanityAssetDimensions } from '@/lib/sanity';
import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  photos?: Array<{ _key?: string; asset?: { _ref?: string; _id?: string }; alt?: string }> | null;
}

const { photos } = Astro.props as Props;

/** Photos between features, and how few may follow the last one. */
const MIN_RUN = 6;
const MIN_AFTER = 3;
/** Desktop row width in row heights: about 1150px of container over a 19rem row. */
const ROW_UNITS = 3.8;
const TILE_GAP = 0.05;
const MIN_ROW_FILL = 0.7;

const tiles = (photos ?? [])
  .filter((p) => p?.asset)
  .map((p, i) => {
    const dims = parseSanityAssetDimensions(p);
    const ratio = dims?.width && dims?.height ? dims.width / dims.height : 1.5;
    return {
      key: p._key ?? String(i),
      ratio: ratio.toFixed(3),
      width: dims?.width ?? 0,
      caption: p.alt?.trim() || null,
      // The caption is optional in the Studio, so a photo without one still gets
      // words a screen reader can say.
      source: {
        ...p,
        alt: p.alt?.trim() || `Reid Design room, photo ${i + 1}`,
      } as SanityImageObject,
      index: i,
    };
  });

type Tile = (typeof tiles)[number];

// Wide enough to look right large, sharp enough to hold it, and with words to sit
// beside it.
const isFeature = (t: Tile) => Number(t.ratio) >= 1.25 && t.width >= 1000 && Boolean(t.caption);

const blocks: Array<{ run: Tile[] } | { feature: Tile; flip: boolean }> = [];
let run: Tile[] = [];
let flip = false;
let rowUsed = 0;
const rowFill = () => rowUsed / ROW_UNITS;
tiles.forEach((t, i) => {
  if (
    run.length >= MIN_RUN &&
    tiles.length - i - 1 >= MIN_AFTER &&
    isFeature(t) &&
    rowFill() >= MIN_ROW_FILL
  ) {
    blocks.push({ run }, { feature: t, flip });
    run = [];
    rowUsed = 0;
    flip = !flip;
  } else {
    run.push(t);
    const r = Number(t.ratio);
    rowUsed = rowUsed + TILE_GAP + r > ROW_UNITS ? r : rowUsed + (rowUsed ? TILE_GAP : 0) + r;
  }
});
if (run.length > 0) blocks.push({ run });

const linkViewerCss = tiles.length > 0 && firstOnPage(Astro.request, 'lightbox');
const hasEnd = Astro.slots.has('default');
---

{tiles.length > 0 && (
  <div class="wall" data-lightbox-group>
    {blocks.map((block, b) =>
      'feature' in block ? (
        <PhotoTile tile={block.feature} feature flip={block.flip} />
      ) : (
        <div class:list={['wall__run', { 'wall__run--end': hasEnd && b === blocks.length - 1 }]}>
          {block.run.map((tile) => (
            <PhotoTile tile={tile} />
          ))}
          {b === blocks.length - 1 && <slot />}
        </div>
      ),
    )}
    <Lightbox />
  </div>
)}
{linkViewerCss && <link rel="stylesheet" href={lightboxCss} />}

<style>
  .wall {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 5vw, 4rem);
    --row: 14rem;
  }
  .wall__run {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  /* Soaks up most of the spare room on a run's last row. */
  .wall__run::after {
    content: '';
    flex-grow: 3;
  }
  .wall__run--end::after {
    content: none;
  }
  @media (min-width: 640px) {
    .wall__run {
      gap: 1.5rem 0.75rem;
    }
  }
  @media (min-width: 1024px) {
    .wall {
      --row: 19rem;
    }
    .wall__run {
      gap: 1.75rem 0.875rem;
    }
  }
</style>
