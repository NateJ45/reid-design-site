---
// Safe to edit by hand
// Large pull-quote at the top of the testimonials section. Renders the testimonial
// with the "featured" flag (or whatever the homepage's featuredTestimonial reference
// points at). Editorial scale, Cormorant Garamond, generous breathing room.

interface Props {
  testimonial?: {
    quote?: string;
    attribution?: string;
    date?: string;
    source?: string;
  } | null;
}

const { testimonial } = Astro.props as Props;

if (!testimonial?.quote) return null;

function formatDate(d?: string): string {
  if (!d) return '';
  const date = new Date(d);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

const dateLabel = formatDate(testimonial.date);
const sourceLabel = testimonial.source && testimonial.source !== 'Other' ? testimonial.source : '';
const attributionMeta = [dateLabel, sourceLabel].filter(Boolean).join(' · ');
---

<figure class="mx-auto max-w-3xl text-center">
  <span
    aria-hidden="true"
    class="block font-display text-[clamp(4rem,8vw,7rem)] leading-none text-primary-dark/30 select-none mb-[-1rem]"
  >
    “
  </span>
  <blockquote class="font-display text-[clamp(1.5rem,2.5vw,2.25rem)] leading-snug text-foreground">
    {testimonial.quote}
  </blockquote>
  <figcaption class="mt-l">
    <p class="font-display text-h4 text-foreground">{testimonial.attribution}</p>
    {attributionMeta && (
      <p class="mt-xs text-xs uppercase tracking-widest text-secondary">{attributionMeta}</p>
    )}
  </figcaption>
</figure>
