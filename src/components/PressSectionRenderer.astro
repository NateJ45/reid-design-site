---
// Foundation, edit with care
// Renders the Press page from its `pageBuilder` layout array of pressSectionMarker
// blocks. Inserted general blocks delegate to SectionRenderer. Falls back to the
// default order when empty.
import Hero from '@/components/Hero.astro';
import PressStrip from '@/components/PressStrip.astro';
import PressIntro from '@/components/sections/PressIntro.astro';
import PressList from '@/components/sections/PressList.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  sections?: any[];
  page: any;
  pressItems?: any[];
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, pressItems = [], editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};

const DEFAULT_ORDER = ['hero', 'pressStrip', 'intro', 'list'].map((section) => ({
  _type: 'pressSectionMarker',
  section,
}));

const list = (sections ?? []).filter((s) => s && s._type);
const rows = list.length > 0 ? list : DEFAULT_ORDER;
---

{rows.map((s: any, i: number) => (
  <Wrap {...wrapAttrs(s._key)}>
  {
  s._type === 'pressSectionMarker' ? (
    s.section === 'hero' ? (
      <Hero
        eyebrow={page?.heroEyebrow ?? 'In the Press.'}
        headline={page?.heroHeadline ?? "Where Reid Design's work has been featured."}
        subhead={page?.heroSubhead ?? ''}
        backgroundImage={page?.heroImage}
        headingId="press-hero-heading"
        size="short"
        scriptAccent={page?.heroScriptAccent}
      />
    ) : s.section === 'pressStrip' ? (
      <PressStrip items={pressItems} />
    ) : s.section === 'intro' ? (
      <PressIntro intro={page?.intro} />
    ) : s.section === 'list' ? (
      <PressList items={pressItems} />
    ) : null
  ) : (
    <SectionRenderer sections={[s]} idPrefix={`press-extra-${i}`} />
  )}
  </Wrap>
))}
