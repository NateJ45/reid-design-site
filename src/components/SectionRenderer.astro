---
// Foundation, edit with care
// Renders a page-builder section array. Maps each block _type to its component
// and OWNS the alternating background cadence for content blocks, so reordering
// can never break the page rhythm (that is why blocks have no color field).
// Self-contained blocks (hero, CTA band, stats, spacer) manage their own surface.
//
// Used by custom pages (src/pages/[...slug].astro) and, after the retrofit, by
// the core pages. The GROQ query that loads `sections` must project images with
// the image projection and ctaBlocks with the CTA projection (see queries.ts
// PAGE_BUILDER_PROJECTION).
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import StatsRow from '@/components/StatsRow.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import RichTextSection from '@/components/sections/RichTextSection.astro';
import ImageText from '@/components/sections/ImageText.astro';
import GalleryGrid from '@/components/sections/GalleryGrid.astro';
import QuoteBlock from '@/components/sections/QuoteBlock.astro';
import VideoEmbed from '@/components/sections/VideoEmbed.astro';
import { sectionEditAttr, sectionFieldEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import { handleFieldFor, layoutApplies } from '@/lib/section-fields';

interface Props {
  sections?: any[];
  /** Prefix for generated heading ids, so two renderers on a page don't collide. */
  idPrefix?: string;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document AND the array field these sections came from,
   * every section is wrapped in a real block box carrying a `data-sanity`
   * attribute, which is what gives the Presentation overlay its in-canvas
   * insert / duplicate / remove / drag-to-reorder controls.
   *
   * Note `field`: this renderer serves BOTH `pageBuilder` (custom pages) and
   * `additionalSections` (the Extra sections zone on the bespoke pages), so the
   * caller has to say which one it is passing.
   *
   * The live pages never pass it, and with it absent the wrapper is a
   * `<Fragment>`, which renders NOTHING at all. That is why the static build's
   * markup stays byte-identical with this feature installed, and
   * `npm run parity compare` is the standing gate on that promise.
   */
  editDoc?: EditDoc;
}

const { sections = [], idPrefix = 'section', editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. The wrapper must
// NOT be `display: contents`: the overlay outlines the element's rect, and a
// contents element has none. A plain block-level div around a full-width
// <section> changes no layout.
//
// `position: relative` in preview is what the in-canvas layout handle below
// hangs off. It is set on the wrapper rather than on the section, so no
// component's own positioning changes, and it only exists on the preview route.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key
    ? { 'data-sanity': sectionEditAttr(editDoc, key), style: 'position:relative' }
    : {};

// -------------------------------------------------------------------------
// The in-canvas layout handle (2026-08-28, card 28)
// -------------------------------------------------------------------------
// The layout card needs a node the Studio schema resolves to a FIELD. The
// wrapper above names a bare array item, which resolves to none, so a custom
// overlay component can never mount on it (learned in a deployed Studio; see
// `sectionFieldEditAttr`). This little square is that node: it points at the
// section's own first layout field, so clicking it selects that field and the
// overlay answers with the card.
//
// Exactly one per section, and only for sections that HAVE a layout choice:
// `handleFieldFor` refuses the four types with no radio (quote, stats, video,
// the CTA band), and `layoutApplies` refuses any instance that renders nothing
// at all, which today means a gallery with no pictures.
//
// TOP-RIGHT, INSIDE the section. A section is often taller than the viewport,
// so its bottom-right corner is below the fold exactly when the editor is
// looking at the section; its top-right is on screen the moment the section is.
// It renders after the content so it paints above it, and it carries its styles
// inline because the preview loads no preview-only stylesheet.
//
// KNOWN GAP, recorded rather than half-closed: the eight *SectionRenderer.astro
// files wrap each item themselves and hand a one-element array to this renderer
// with no `editDoc`, so a library block inserted into a marker page keeps its
// array controls and gets no layout handle. Closing that means giving all eight
// the same handle, which is its own change to eight files.
const handleAttr = (section: any) => {
  const field = handleFieldFor(section?._type);
  return editDoc && section?._key && field && layoutApplies(section._type, section)
    ? sectionFieldEditAttr(editDoc, section._key, field)
    : undefined;
};
const HANDLE_STYLE =
  'position:absolute;top:12px;right:12px;z-index:5;width:28px;height:28px;border-radius:999px;background:#ffffff;border:1px solid rgba(61,61,61,0.18);box-shadow:0 2px 8px rgba(61,61,61,0.22);display:flex;align-items:center;justify-content:center;font-size:14px;line-height:1;';

// Content blocks take an alternating surface (background / muted) from the
// renderer. Everything else owns its own surface.
const CONTENT_TYPES = new Set([
  'richTextSection',
  'imageTextSection',
  'gallerySection',
  'quoteSection',
  'videoSection',
]);

const list = (sections ?? []).filter((s) => s && s._type);

// If the page opens with a text hero (no background image, so it renders on the
// light bg-background surface), start the content cadence on muted so the first
// section contrasts instead of blending into the hero. An image hero is dark,
// so a light first section already contrasts.
const first = list[0];
const opensWithTextHero = first?._type === 'heroSection' && !first?.backgroundImage?.asset;
let contentIdx = opensWithTextHero ? 1 : 0;
const rows = list.map((s, i) => {
  let surface: 'background' | 'muted' | null = null;
  if (CONTENT_TYPES.has(s._type)) {
    surface = contentIdx % 2 === 0 ? 'background' : 'muted';
    contentIdx += 1;
  }
  return { s, surface, headingId: `${idPrefix}-${i}`, handle: handleAttr(s) };
});
---

{
  rows.map(({ s, surface, headingId, handle }) => (
    <Wrap {...wrapAttrs(s._key)}>
      {s._type === 'heroSection' ? (
        <Hero
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          backgroundImage={s.backgroundImage}
          primaryCta={s.primaryCta}
          secondaryCta={s.secondaryCta}
          scriptAccent={s.scriptAccent}
          size={s.size ?? 'short'}
          headingId={headingId}
        />
      ) : s._type === 'ctaBandSection' ? (
        <FinalCta
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          cta={s.cta}
          scriptAccent={s.scriptAccent}
          backgroundImage={s.backgroundImage}
          headingId={headingId}
        />
      ) : s._type === 'statSection' ? (
        <StatsRow stats={(s.stats ?? []).filter((x: any) => typeof x?.number === 'number')} />
      ) : s._type === 'spacerSection' ? (
        s.variant === 'space' ? (
          <div class="py-section-md" aria-hidden="true" />
        ) : (
          <SectionDivider variant={s.variant === 'line' ? 'line' : 'ornament'} />
        )
      ) : s._type === 'richTextSection' ? (
        <RichTextSection {...s} surface={surface} headingId={headingId} />
      ) : s._type === 'imageTextSection' ? (
        <ImageText {...s} surface={surface} headingId={headingId} />
      ) : s._type === 'gallerySection' ? (
        <GalleryGrid {...s} surface={surface} headingId={headingId} />
      ) : s._type === 'quoteSection' ? (
        <QuoteBlock {...s} surface={surface} />
      ) : s._type === 'videoSection' ? (
        <VideoEmbed {...s} surface={surface} headingId={headingId} />
      ) : null}
      {handle && (
        <div
          data-sanity={handle}
          data-layout-handle
          title="Layout"
          aria-hidden="true"
          style={HANDLE_STYLE}
        >
          &#9776;
        </div>
      )}
    </Wrap>
  ))
}
