---
// Foundation, edit with care
// Renders a page-builder section array. Maps each block _type to its component
// and OWNS the alternating background cadence for content blocks, so reordering
// can never break the page rhythm (that is why blocks have no color field).
// Self-contained blocks (hero, CTA band, stats, spacer, and since 2026-09-30
// the Instagram feed on its Linen chip ground) manage their own surface.
//
// Used by custom pages (src/pages/[...slug].astro) and, after the retrofit, by
// the core pages. The GROQ query that loads `sections` must project images with
// the image projection and ctaBlocks with the CTA projection (see queries.ts
// PAGE_BUILDER_PROJECTION).
//
// THE STARTER'S FOUNDATIONS (refoundation phase A, 2026-10-27). The renderer
// now runs the starter's layer before it draws, with Reid's own rules, so the
// page builder can take the starter's blocks later without a second renderer:
//   - the cadence lives in src/lib/sectionCadence.ts (a Reid fit, unit-tested),
//     not inline here; it decides exactly what this file used to decide;
//   - named anchors (src/lib/section-anchors.ts, starter card 158): since
//     phase A2 a section with a heading takes an id made from it (`anchors`,
//     default 'named'); a section without one keeps its numbered id;
//   - the accent budget (src/lib/cta-budget.ts, cards 158 and 187): since
//     phase A2 only the first library hero or CTA band keeps the filled button,
//     and one that goes where the header's button goes draws the quiet link
//     (`budget`, default on). Marker rows (the built-in sections of the five
//     marker pages) are never demoted and never counted;
//   - `context` (phase A2): a marker page hands this renderer one row at a
//     time, plus its whole layout, so the cadence, the anchors and the budget
//     see the neighbours instead of a list of one.
//   - looks and the builder kit (phase B, 2026-10-28): a content block's
//     `look` (Standard, Quiet, Feature) is resolved by the cadence into
//     linen, paper or the ink band and handed down as `surface`; the twelve
//     builder-kit blocks go to BuilderBlock.astro in ONE branch (it is the only
//     file that imports their stylesheet, so a page without one gains no CSS).
//     A steps-on-a-path closing button and the contact card's big Call button
//     take part in the accent budget like a hero or a CTA band.
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import StatsRow from '@/components/StatsRow.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import RichTextSection from '@/components/sections/RichTextSection.astro';
import ImageText from '@/components/sections/ImageText.astro';
import GalleryGrid from '@/components/sections/GalleryGrid.astro';
import QuoteBlock from '@/components/sections/QuoteBlock.astro';
import VideoEmbed from '@/components/sections/VideoEmbed.astro';
import InstagramFeed from '@/components/InstagramFeed.astro';
import PressMentions from '@/components/sections/PressMentions.astro';
import BuilderBlock from '@/components/builder-blocks/BuilderBlock.astro';
import { isBuilderBlock } from '@/lib/builderBlocks.types';
import { getPressMentions, getSiteSettings } from '@/lib/queries';
import { expandSyncedSections } from '@/lib/authoring';
import { SECTION_DRAG_FLOW, sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import LayoutHandle from '@/components/preview/LayoutHandle.astro';
import SectionCoach from '@/components/SectionCoach.astro';
import { sectionCoach } from '@/lib/section-coach';
import { classifySections, isMarkerRow } from '@/lib/sectionCadence';
import { sectionAnchors, sectionHeadingText } from '@/lib/section-anchors';
import { primaryBudget, repeatsHeaderCta, type CtaVariant } from '@/lib/cta-budget';
import { resolveCtaHref } from '@/lib/cta';
import { resolveChrome } from '@/lib/siteSettings';

interface Props {
  sections?: any[];
  /** Prefix for generated heading ids, so two renderers on a page don't collide. */
  idPrefix?: string;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document AND the array field these sections came from,
   * every section is wrapped in a real block box carrying a `data-sanity`
   * attribute, which is what gives the Presentation overlay its in-canvas
   * insert / duplicate / remove / drag-to-reorder controls.
   *
   * Note `field`: this renderer serves BOTH `pageBuilder` (custom pages) and
   * `additionalSections` (the Extra sections zone on the bespoke pages), so the
   * caller has to say which one it is passing.
   *
   * The live pages never pass it, and with it absent the wrapper is a
   * `<Fragment>`, which renders NOTHING at all. That is why the static build's
   * markup stays byte-identical with this feature installed, and
   * `npm run parity compare` is the standing gate on that promise.
   */
  editDoc?: EditDoc;
  /**
   * PREVIEW ONLY (2026-09-29). Show the empty-section coaching note without
   * the edit wrapper. MarkerPage.astro (the five marker pages) draws its own
   * `data-sanity` wrapper and hands this renderer one section at a time with no
   * `editDoc`, so it passes `coach={Boolean(editDoc)}` instead. `editDoc` on
   * its own also switches coaching on. Neither is ever set on the live site.
   */
  coach?: boolean;
  /**
   * 'numbered' (the default for now): every heading id is `${idPrefix}-${i}`,
   * exactly as before. 'named': a section with a heading takes an id made from
   * it, so /services/#how-we-work links to it (starter card 158); a section
   * with no heading keeps its numbered id.
   */
  anchors?: 'named' | 'numbered';
  /**
   * Marker pages only (phase A2). The page's WHOLE layout (markers and library
   * blocks) and the index of the row in `sections`, so the classification runs
   * over the page instead of a list of one. Numbered fallback ids stay
   * `${idPrefix}-${i}` over `sections`, as before.
   */
  context?: { list: any[]; index: number };
  /**
   * Off (the default for now): every hero and CTA band draws its filled button.
   * On: only the first row with a filled main button keeps it; later ones draw
   * the quieter variant (starter cards 158 and 187).
   */
  budget?: boolean;
}

const {
  sections: given = [],
  idPrefix = 'section',
  editDoc,
  coach = false,
  anchors = 'named',
  budget = true,
  context,
} = Astro.props as Props;

// Synced sections (the authoring kit, PORTS.md card 109) become the saved
// section's own blocks HERE, before the cadence below, so the background rhythm
// runs across them exactly as if they were typed in. Each expanded block keeps
// `_editKey`, the synced block's key, so preview controls act on the synced
// block (one unit) rather than on blocks that do not exist in this page.
const sections = expandSyncedSections(given ?? []);

// The Instagram block's shared words live on siteSettings (2026-09-30). Read
// only when a section list actually has one, and through the memoized build
// read, so no other page makes an extra request.
const igSettings = (sections ?? []).some((s: any) => s?._type === 'instagramSection')
  ? await getSiteSettings()
  : null;
// Press mentions (2026-10-18), fetched once per build and only when a page has the section.
const press = (sections ?? []).some((s: any) => s?._type === 'pressSection')
  ? await getPressMentions()
  : [];

// -------------------------------------------------------------------------
// Empty-section coaching (PREVIEW ONLY, 2026-09-29)
// -------------------------------------------------------------------------
// A section just added from the "+ Add section" menu, with nothing typed in it
// yet, renders a dashed "Nothing here yet: add a photo..." note in its place
// instead of an empty band. The note sits INSIDE the edit wrapper, so the
// overlay still outlines it and clicking it still opens that section. The
// registry, and the argument for why this never reaches the static build, is
// src/lib/section-coach.ts. `npm run parity compare` is the standing proof.
const previewSignal = Boolean(editDoc) || coach;

// A real element in preview, nothing at all on the live site. The wrapper must
// NOT be `display: contents`: the overlay outlines the element's rect, and a
// contents element has none. A plain block-level div around a full-width
// <section> changes no layout.
//
// `position: relative` in preview is what the in-canvas layout handle below
// hangs off. It is set on the wrapper rather than on the section, so no
// component's own positioning changes, and it only exists on the preview route.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key
    ? {
        'data-sanity': sectionEditAttr(editDoc, key),
        style: 'position:relative',
        ...SECTION_DRAG_FLOW,
      }
    : {};

// -------------------------------------------------------------------------
// The in-canvas layout handle (2026-08-28, card 28)
// -------------------------------------------------------------------------
// PREVIEW ONLY: the square the layout card hangs on, drawn after each section
// so it paints above it. Its rules and its style have ONE home,
// src/components/preview/LayoutHandle.astro, which MarkerPage.astro draws too
// for a library block on a marker page (refoundation phase C).

// -------------------------------------------------------------------------
// The background cadence (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; moved to src/lib/sectionCadence.ts in refoundation phase A)
// -------------------------------------------------------------------------
// Content blocks alternate linen (`background`) and paper (`muted`); a quote
// takes the ink band unless it would touch another dark band or the footer; a
// spacer or divider takes the ground of the row above it; a page that opens
// with a hero starts its content on paper. The rules and their tests live in
// sectionCadence.ts, so reordering can never break the rhythm.
// On a marker page, classify the whole layout and keep this row's slice.
const before = context ? expandSyncedSections(context.list.slice(0, context.index)) : [];
const after = context ? expandSyncedSections(context.list.slice(context.index + 1)) : [];
const whole = classifySections<any>([...before, ...sections, ...after], idPrefix);
const own = classifySections<any>(sections, idPrefix);
// Where this renderer's own rows start in the whole page.
const lo = classifySections(before).length;
// Library rows of the whole page (markers draw their own headings and buttons).
const library = whole.map((r, i) => ({ r, i })).filter(({ r }) => !isMarkerRow(r.block));

// Heading ids: named from the heading (starter card 158) unless asked for numbers.
// Over the whole page, so two library sections on a marker page never share a name.
const namedIds = new Map<number, string>();
if (anchors === 'named') {
  const lowFallback = (i: number) =>
    i >= lo && i < lo + own.length ? own[i - lo].headingId : `${idPrefix}-p${i}`;
  const names = sectionAnchors(
    library.map(({ r, i }) => ({
      key: r.block._key,
      heading: sectionHeadingText(r.block),
      fallback: lowFallback(i),
    })),
  );
  library.forEach(({ i }, n) => namedIds.set(i, names[n]));
}

// The accent budget (cards 158 and 187): the first library hero or CTA band with
// a filled button keeps it; later ones, and any whose button goes where the
// header's button goes, draw the quiet link. Read only when a row could draw one.
const MAY_DRAW = new Set([
  'heroSection',
  'ctaBandSection',
  'stepsRailSection',
  'contactCardSection',
]);
const header =
  budget && library.some(({ r }) => MAY_DRAW.has(r.block._type))
    ? resolveChrome(await getSiteSettings()).headerCta
    : null;
const mainCta = (blk: any) =>
  blk?._type === 'heroSection'
    ? blk.primaryCta
    : blk?._type === 'stepsRailSection'
      ? blk.link
      : blk?.cta;
const drawsPrimary = (blk: any) => {
  // The contact card's big Call button is a tel: link, never a repeat of the header's.
  if (blk?._type === 'contactCardSection') return blk.callButtons === true;
  const draws =
    (blk?._type === 'heroSection' && Boolean(blk.primaryCta)) ||
    blk?._type === 'ctaBandSection' ||
    (blk?._type === 'stepsRailSection' && Boolean(blk.link?.label));
  return draws && !repeatsHeaderCta(resolveCtaHref(mainCta(blk)), header);
};
const libraryVariant = budget
  ? primaryBudget(
      library.map(({ r }) => r.block),
      drawsPrimary,
    )
  : () => 'primary' as CtaVariant;
const variantAt = new Map<number, CtaVariant>();
library.forEach(({ i }, n) => variantAt.set(i, libraryVariant(n)));

const rows = own.map((o, k) => {
  const i = lo + k;
  const w = whole[i];
  const s = o.block;
  return {
    s,
    surface: w.surface,
    ground: w.ground,
    headingId: namedIds.get(i) ?? o.headingId,
    primaryVariant: variantAt.get(i) ?? ('primary' as CtaVariant),
    // The first row of the whole page: a builder block's photo there loads first.
    isFirst: i === 0,
    coachInfo: previewSignal ? sectionCoach(s) : null,
  };
});
const GROUND_CLASS = { linen: 'bg-bg', paper: 'bg-paper', ink: 'bg-ink' } as const;
---

{rows.map(({ s, surface, ground, headingId, primaryVariant, coachInfo, isFirst }) => (
  <Wrap {...wrapAttrs(s._editKey ?? s._key)}>
    {coachInfo ? (
      <SectionCoach name={coachInfo.name} hint={coachInfo.hint} />
    ) : s._type === 'heroSection' ? (
      <Hero
        eyebrow={s.eyebrow}
        headline={s.headline}
        subhead={s.subhead}
        backgroundImage={s.backgroundImage}
        primaryCta={s.primaryCta}
        secondaryCta={s.secondaryCta}
        scriptAccent={s.scriptAccent}
        size={s.size ?? 'short'}
        headingId={headingId}
        heroStyle={s.heroStyle}
        glance={s.glance}
        backgroundVideo={s.backgroundVideo}
        backgroundVideoPhone={s.backgroundVideoPhone}
        primaryVariant={primaryVariant}
      />
    ) : s._type === 'ctaBandSection' ? (
      <FinalCta
        eyebrow={s.eyebrow}
        headline={s.headline}
        subhead={s.subhead}
        cta={s.cta}
        scriptAccent={s.scriptAccent}
        backgroundImage={s.backgroundImage}
        headingId={headingId}
        primaryVariant={primaryVariant}
      />
    ) : s._type === 'statSection' ? (
      <StatsRow stats={(s.stats ?? []).filter((x: any) => typeof x?.number === 'number')} />
    ) : s._type === 'spacerSection' ? (
      s.variant === 'space' ? (
        <div class:list={['py-section-md', GROUND_CLASS[ground]]} aria-hidden="true" />
      ) : (
        <SectionDivider variant={s.variant === 'line' ? 'line' : 'ornament'} tone={ground} />
      )
    ) : isBuilderBlock(s) ? (
      <BuilderBlock
        block={s}
        surface={surface ?? undefined}
        headingId={headingId}
        primaryVariant={primaryVariant}
        isFirst={isFirst}
      />
    ) : s._type === 'richTextSection' ? (
      <RichTextSection {...s} surface={surface} headingId={headingId} />
    ) : s._type === 'imageTextSection' ? (
      <ImageText {...s} surface={surface} headingId={headingId} />
    ) : s._type === 'gallerySection' ? (
      <GalleryGrid {...s} surface={surface} headingId={headingId} />
    ) : s._type === 'quoteSection' ? (
      <QuoteBlock {...s} surface={surface ?? 'background'} />
    ) : s._type === 'videoSection' ? (
      <VideoEmbed {...s} surface={surface} headingId={headingId} />
    ) : s._type === 'pressSection' ? (
      <PressMentions
        mentions={(Array.isArray(s.mentions) ? s.mentions : press).slice(
          0,
          typeof s.count === 'number' ? s.count : 6,
        )}
        heading={s.heading}
        headingId={headingId}
      />
    ) : s._type === 'instagramSection' ? (
      <InstagramFeed
        settings={igSettings}
        heading={s.heading}
        subhead={s.subhead}
        headingId={headingId}
      />
    ) : null}
    <LayoutHandle editDoc={editDoc} section={s} />
  </Wrap>
))}
