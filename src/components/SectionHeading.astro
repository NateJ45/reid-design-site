---
// Foundation, edit with care
// Section head used across the interior pages (rebuilt 2026-09-30, phase 2 of
// the art-direction rebuild; see DESIGN.md).
//
//   Wide container:   HEADLINE (Zodiak, left)        subhead (right column)
//   Narrow container: HEADLINE
//                     subhead
//
// The split is a CONTAINER query, not a viewport one, so a heading dropped in a
// sidebar or a card stays stacked while a full-width one splits.
//
// What changed from the old head, on purpose (DESIGN.md "Type"):
//   - No tracked small-caps eyebrow + rule above every section. The `eyebrow`
//     prop is still accepted (every caller passes Staci's field) but is not
//     printed: repeated eyebrows were the single loudest template tell. The
//     page Hero still prints its eyebrow once, as a sentence-case line.
//   - `align="center"` is accepted and ignored: centred bands were the other
//     half of the old grammar. Everything sets from the left edge.
//   - The accent phrase (scriptAccent) is Zodiak italic via .r-accent, split
//     stega-safely (src/lib/split-copy.ts) so preview click-to-edit keeps
//     working.
// Pass `headingId` so the parent <section> can use aria-labelledby.
import { splitAccent } from '@/lib/split-copy';

interface Props {
  /** Accepted for compatibility; not rendered (see header). */
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  headingId: string;
  level?: 'h1' | 'h2' | 'h3';
  /** Accepted for compatibility; everything is left-set now. */
  align?: 'left' | 'center';
  /** "inverse" for ink / Walnut grounds: cream headline, Oat accent. */
  tone?: 'default' | 'inverse';
  /** A word or phrase from the headline to set in italic. */
  scriptAccent?: string;
  class?: string;
}

const {
  headline,
  subhead,
  headingId,
  level = 'h2',
  tone = 'default',
  scriptAccent,
  class: extraClass = '',
} = Astro.props as Props;

const h = splitAccent(headline ?? '', scriptAccent);
const Tag = level;
const sizeClass = level === 'h1' ? 'sh__h--h1' : level === 'h2' ? 'r-h2' : 'r-h3';
---

<div class:list={['sh', tone === 'inverse' && 'sh--inverse', extraClass]}>
  <div class:list={['sh__grid', subhead && 'sh__grid--split']}>
    {
      headline && (
        <Tag id={headingId} class:list={['sh__h', sizeClass]}>
          {h.found ? (
            <>
              {h.before}
              <span class="r-accent">{h.word}</span>
              {h.after}
              {h.run}
            </>
          ) : (
            headline
          )}
        </Tag>
      )
    }
    {subhead && <p class="sh__sub r-lede">{subhead}</p>}
  </div>
</div>

<style>
  .sh {
    container-type: inline-size;
    width: 100%;
  }
  .sh__grid {
    display: grid;
    gap: 1.25rem;
  }
  .sh__h {
    margin: 0;
    color: var(--color-ink);
    max-width: 18ch;
  }
  .sh__h--h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-h1);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .sh__sub {
    margin: 0;
    max-width: 40ch;
  }
  @container (min-width: 56rem) {
    .sh__grid--split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(2rem, 6cqi, 6rem);
      align-items: end;
    }
  }
  .sh--inverse {
    --accent-color: var(--color-chip-2);
  }
  .sh--inverse .sh__h {
    color: var(--color-cream);
  }
  .sh--inverse .sh__sub {
    color: var(--color-cream);
  }
</style>
