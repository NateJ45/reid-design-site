---
// Foundation, edit with care
// Site footer: the back cover of the swatch book (rebuilt 2026-09-30 from the
// approved prototype docs/design/prototypes/chrome-a-swatch-book.html;
// DESIGN.md "Chrome").
//
// Top to bottom, on ink. (The seven-tone paint strip that used to run across
// the top was removed 2026-09-30: Nathan found the decorative swatches
// repetitive; chips now appear only where they carry content.)
//   1. Three columns:
//      - "The studio": a page index. Each line is a tone swatch, the page, a
//        dotted leader, and a REAL fact on the right ("from $225",
//        "19 answers"), all derived from content by src/lib/chrome-facts.ts.
//        A fact that cannot be derived is left out, never typed.
//      - "Get in touch": email, phone and socials as paper sample tags.
//      - "Based in <city>": the service towns, from Business info.
//   2. Staci's logo, large, beside the site tagline (Site settings).
//   3. The base row: copyright, Privacy (or Staci's small-print links),
//      Search, and the site credit.
//
// Site settings still steer it (src/lib/siteSettings.ts): "Footer link
// columns" replace the page index with Staci's own columns, "Footer small-print
// links" replace Privacy, and "Show socials in the footer" hides the social
// tags. Custom pages flagged "Add to footer" join the index.
//
// No .dark subtree any more: every colour here is set explicitly for the ink
// ground (cream 14.2:1, cream at 75% 8:1+, Oat headings 10:1+).

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import logoDarkAsset from '@/assets/logo-dark.png';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { telHref } from '@/lib/phone';
import { resolveChrome, type RawFooterColumn } from '@/lib/siteSettings';
import { isExternalHref, type RawNavLink } from '@/lib/nav-href';
import { getChromeFacts } from '@/lib/queries';
import { resolveChromeFacts } from '@/lib/chrome-facts';

// Her logo, large, in cream: shown up to 240px tall (about 227px wide).
const logo1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 228 });
const logo2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 456 });

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    serviceAreas?: string[];
    city?: string;
    state?: string;
    serviceRegion?: string;
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    /** Chrome options (see src/lib/siteSettings.ts). Empty keeps the built-ins. */
    footerColumns?: RawFooterColumn[] | null;
    legalNav?: (RawNavLink | null)[] | null;
    showFooterSocials?: boolean | null;
    sectionVisibility?: {
      showPortfolio?: boolean | null;
      showEDesign?: boolean | null;
    } | null;
  } | null;
  navPages?: NavPage[];
}

interface NavPage {
  title?: string;
  slug?: string;
  navLabel?: string;
  addToFooter?: boolean;
}

const { siteSettings, navPages } = Astro.props as Props;

const visible = getSectionVisibility(siteSettings?.sectionVisibility);
const chrome = resolveChrome(siteSettings);

// Failure handling (PORTS.md card 56). The Footer renders in two places: every
// static page at build time, and the live /preview/** route at request time.
// In the static build a failed read must fail the build, so the catch
// rethrows when the page is prerendered; in a live preview an index without
// facts beats a 500 in the editor's canvas.
const facts = resolveChromeFacts(
  await getChromeFacts().catch((err: unknown) => {
    if (Astro.isPrerendered) throw err;
    return null;
  }),
);

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';
const ig = chrome.showFooterSocials ? (siteSettings?.socialInstagram ?? '') : '';
const fb = chrome.showFooterSocials ? (siteSettings?.socialFacebook ?? '') : '';
// "@reiddesignin" from the Instagram URL, for the tag's face.
const igHandle = ig ? `@${ig.replace(/\/+$/, '').split('/').pop()}` : '';

// Home-base locality from businessInfo (via getSiteSettings), with the stable
// Plainfield, IN fallback.
const city = siteSettings?.city ?? 'Plainfield';
const state = siteSettings?.state ?? 'IN';
const serviceRegion = siteSettings?.serviceRegion ?? 'Greater Indianapolis';
// The towns beyond home base, from Business info. "Surrounding areas" style
// catch-alls are dropped; the sentence ends "and the towns between" itself.
const towns = (siteSettings?.serviceAreas ?? []).filter(
  (t) => t && t !== city && !/surrounding|nearby|area/i.test(t),
);
const townsLine = towns.length > 0 ? towns.join(', ') : serviceRegion;

// The tagline beside the logo (Site settings -> Tagline). Its last two words
// take the Sandbar italic, the site's accent grammar.
const tagline = siteSettings?.tagline?.trim() || 'Homes that feel collected, cozy, and yours.';
const tagWords = tagline.split(/\s+/);
const tagLead = tagWords.slice(0, -2).join(' ');
const tagAccent = tagWords.slice(-2).join(' ');

const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// ---- The page index ------------------------------------------------------
// Tone swatches walk the ramp, palest first (chips 1, 2, 3, 4, 6, 7). Facts
// come from chrome-facts; null means the line simply has no fact.
const SWATCHES = [1, 2, 3, 4, 6, 7];
const swatch = (i: number) => `var(--color-chip-${SWATCHES[i % SWATCHES.length]})`;

interface IndexLine {
  label: string;
  href: string;
  fact?: string | null;
}
const footerPages = (navPages ?? []).filter((p) => p.addToFooter && p.slug);
const builtInIndex: IndexLine[] = [
  ...(visible.portfolio
    ? [{ label: 'Portfolio', href: '/portfolio', fact: facts.portfolioFact }]
    : []),
  { label: 'Services', href: '/services', fact: facts.servicesFact },
  { label: 'Process', href: '/process', fact: facts.processFact },
  ...(visible.eDesign ? [{ label: 'E-Design', href: '/e-design', fact: facts.eDesignFact }] : []),
  { label: 'About Staci', href: '/about' },
  { label: 'FAQ', href: '/faq', fact: facts.faqFact },
  { label: 'Contact', href: '/contact' },
  ...footerPages.map((p) => ({ label: p.navLabel || p.title || 'Page', href: `/${p.slug}` })),
];

// Site settings -> Footer link columns, when set, stand in for the index.
const columns: { title: string; lines: IndexLine[] }[] = chrome.footerColumns
  ? chrome.footerColumns.map((c) => ({ title: c.title, lines: c.links }))
  : [{ title: 'The studio', lines: builtInIndex }];
---

<footer class="ftr">
  <div class="r-wrap ftr__grid">
    {
      columns.map((col, ci) => (
        <nav class="ftr__col" aria-labelledby={`ftr-col-${ci}`}>
          <h2 class="ftr__h" id={`ftr-col-${ci}`}>
            {col.title}
          </h2>
          <ul class="ftr__idx" role="list">
            {col.lines.map((line, i) => (
              <li>
                <a
                  href={line.href}
                  target={isExternalHref(line.href) ? '_blank' : undefined}
                  rel={isExternalHref(line.href) ? 'noopener noreferrer' : undefined}
                >
                  <i style={`--tone:${swatch(i)}`} aria-hidden="true" />
                  <span class="ftr__page">{line.label}</span>
                  <em aria-hidden="true" />
                  {line.fact && <span class="ftr__fact">{line.fact}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="ftr__col">
      <h2 class="ftr__h">Get in touch</h2>
      <ul class="ftr__tags" role="list">
        {
          email && (
            <li>
              <a class="ftr__tag" href={`mailto:${email}`}>
                <small>Email</small>
                <b>{email}</b>
              </a>
            </li>
          )
        }
        {
          phone && (
            <li>
              <a class="ftr__tag" href={telHref(phone)}>
                <small>Call or text</small>
                <b>{phone}</b>
              </a>
            </li>
          )
        }
        {
          ig && (
            <li>
              <a class="ftr__tag" href={ig} target="_blank" rel="noopener noreferrer">
                <small>Instagram</small>
                <b>{igHandle}</b>
              </a>
            </li>
          )
        }
        {
          fb && (
            <li>
              <a class="ftr__tag" href={fb} target="_blank" rel="noopener noreferrer">
                <small>Facebook</small>
                <b>{brandName}</b>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div class="ftr__col">
      <h2 class="ftr__h">Based in {city}</h2>
      <p class="ftr__area">
        Serving {townsLine} and the towns between.
        {
          visible.eDesign && (
            <>
              {' '}
              Farther out, <a href="/e-design">E-Design</a> works anywhere.
            </>
          )
        }
      </p>
    </div>
  </div>

  <div class="r-wrap ftr__mark">
    <a href="/" class="ftr__logo" aria-label={`${brandName} home`}>
      <img
        src={logo1x.src}
        srcset={`${logo1x.src} 1x, ${logo2x.src} 2x`}
        alt={brandName}
        width={228}
        height={241}
        loading="lazy"
        decoding="async"
      />
    </a>
    <p class="ftr__tagline">
      {tagLead}
      {tagLead && ' '}<em>{tagAccent}</em>
    </p>
  </div>

  <div class="r-wrap ftr__base">
    <p>© {currentYear} {brandName} · {city}, {state}</p>
    <p class="ftr__small">
      {
        chrome.legalNav ? (
          chrome.legalNav.map((link) => (
            <a
              href={link.href}
              target={isExternalHref(link.href) ? '_blank' : undefined}
              rel={isExternalHref(link.href) ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))
        ) : (
          <a href="/privacy">Privacy</a>
        )
      }
      <a href="/search">Search</a>
      {
        siteCredit &&
          (siteCreditUrl ? (
            <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer">
              {siteCredit}
            </a>
          ) : (
            <span>{siteCredit}</span>
          ))
      }
    </p>
  </div>
</footer>

<style>
  .ftr {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --muted: rgb(245 237 227 / 0.75);
    --hair: rgb(245 237 227 / 0.14);
    position: relative;
    margin-top: -1px;
    background: var(--color-ink);
    color: var(--color-cream);
  }
  /* ---- Columns ---- */
  .ftr__grid {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3.25rem, 7vw, 4.75rem) clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .ftr__grid {
      grid-template-columns: 1.3fr 1fr 0.9fr;
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }
  .ftr__h {
    margin: 0 0 1.1rem;
    font: 300 1.35rem/1.1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-chip-2);
  }

  /* The page index: swatch, page, dotted leader, fact. */
  .ftr__idx {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ftr__idx a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--hair);
    color: var(--color-cream);
    text-decoration: none;
    transition:
      padding 450ms var(--ease),
      color 300ms;
  }
  .ftr__idx li:last-child a {
    border-bottom: 1px solid var(--hair);
  }
  .ftr__idx i {
    flex: none;
    align-self: center;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 2px;
    background: var(--tone);
  }
  .ftr__page {
    font: 300 clamp(1.35rem, 1.1rem + 0.6vw, 1.6rem) / 1.1 var(--font-display);
    letter-spacing: -0.015em;
  }
  .ftr__idx em {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted rgb(245 237 227 / 0.3);
    transform: translateY(-0.3em);
  }
  .ftr__fact {
    flex: none;
    font: 400 0.95rem/1 var(--font-body);
    color: var(--muted);
    white-space: nowrap;
  }
  .ftr__idx a:hover {
    color: var(--color-chip-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ftr__idx a:hover {
      padding-left: 0.6rem;
    }
  }
  .ftr__idx a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }

  /* Contact details as paper sample tags, square to the page. */
  .ftr__tags {
    list-style: none;
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }
  .ftr__tags li {
    max-width: 100%;
  }
  .ftr__tag {
    position: relative;
    isolation: isolate;
    display: block;
    max-width: 100%;
    padding: 0.7rem 1.15rem 0.8rem 2.15rem;
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 450ms var(--ease);
  }
  /* The tag shape on ::before so the focus outline is not clipped away. */
  .ftr__tag::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-paper);
    clip-path: polygon(1rem 0, 100% 0, 100% 100%, 1rem 100%, 0 50%);
  }
  .ftr__tag::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    translate: 0 -50%;
    box-shadow: inset 0 0 0 1.5px var(--color-chip-5);
  }
  .ftr__tag small {
    display: block;
    font: 500 0.72rem/1.3 var(--font-body);
    color: var(--color-ink-2);
  }
  .ftr__tag b {
    display: block;
    font: 400 1.05rem/1.25 var(--font-display);
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ftr__tag:hover {
      transform: translateX(4px);
    }
  }
  .ftr__tag:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }

  .ftr__area {
    margin: 0;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .ftr__area a {
    color: var(--color-cream);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(245 237 227 / 0.4);
  }
  .ftr__area a:hover {
    text-decoration-color: currentColor;
  }
  .ftr__area a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }

  /* ---- Her logo beside the tagline ---- */
  .ftr__mark {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: 0.5rem clamp(2.5rem, 5vw, 3.5rem);
  }
  .ftr__logo {
    flex: none;
    display: block;
    border-radius: 2px;
  }
  .ftr__logo img {
    display: block;
    width: clamp(9.5rem, 16vw, 14.25rem);
    height: auto;
  }
  .ftr__logo:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 4px;
  }
  .ftr__tagline {
    margin: 0;
    max-width: 18ch;
    font: 300 clamp(1.9rem, 1rem + 2.6vw, 3.6rem) / 1.05 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-wrap: balance;
  }
  .ftr__tagline em {
    font-style: italic;
    color: var(--color-chip-3);
  }
  @media (max-width: 699px) {
    .ftr__mark {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ---- Base row ---- */
  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.1rem 1.4rem;
    border-top: 1px solid var(--hair);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ftr__base p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .ftr__small a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ftr__small a:hover {
    color: var(--color-cream);
  }
  .ftr__small a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }
</style>
