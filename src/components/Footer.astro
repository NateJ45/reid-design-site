---
// Foundation, edit with care
// Site footer. Mostly editable through Sanity siteSettings; this file renders
// the structure and falls back to static defaults when the document isn't loaded.

import { site } from '@/data/site';
import CopyEmailButton from '@/components/CopyEmailButton';

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    serviceAreas?: string[];
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
  } | null;
}

const { siteSettings } = Astro.props as Props;

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const socials = [
  siteSettings?.socialInstagram ? { platform: 'Instagram', url: siteSettings.socialInstagram } : null,
  siteSettings?.socialFacebook  ? { platform: 'Facebook',  url: siteSettings.socialFacebook  } : null,
].filter((s): s is { platform: string; url: string } => s !== null);
const areas = siteSettings?.serviceAreas ?? ['Plainfield', 'Indianapolis', 'Greater Indianapolis suburbs'];
const tagline = siteSettings?.tagline ?? 'Interior design for homes that feel genuinely yours.';
const credit = siteSettings?.footerCredit ?? `© ${new Date().getFullYear()} ${brandName}`;
const creditUrl = siteSettings?.footerCreditUrl;
---

<footer class="bg-accent-dark text-bg">
  <div class="mx-auto max-w-content px-m py-xl grid gap-l md:grid-cols-3">
    <div>
      <p class="font-display text-h3 text-bg">{brandName}</p>
      <p class="mt-s text-sm opacity-80">{tagline}</p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest opacity-70">Service area</p>
      <ul class="mt-xs text-sm space-y-1">
        {areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest opacity-70">Get in touch</p>
      {email && (
        <p class="mt-xs text-sm">
          <CopyEmailButton client:visible email={email} variant="link" />
        </p>
      )}
      {socials.length > 0 && (
        <ul class="mt-s flex gap-m text-sm">
          {socials.map((s) => (
            <li>
              <a href={s.url} class="underline hover:text-primary" target="_blank" rel="noopener">
                {s.platform}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="border-t border-bg/10">
    <div class="mx-auto max-w-content px-m py-m text-xs opacity-60">
      {creditUrl ? (
        <a
          href={creditUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 hover:opacity-100 hover:text-primary transition-colors"
        >
          {credit}
        </a>
      ) : (
        credit
      )}
    </div>
  </div>
</footer>
