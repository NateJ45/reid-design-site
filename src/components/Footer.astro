---
// Foundation, edit with care
// Site footer. Expanded brand-anchored layout that intentionally reads as a
// SEPARATE zone from the FinalCta section that sits above it on most pages.
//
// Color decoupling: the footer uses bg-muted (Cream in light, dark warm in
// dark) so it doesn't visually merge with the Charcoal Dark FinalCta. The
// 4px Warm Bronze accent stripe at the top is the same brand signature
// used in the header and mobile menu drawer.
//
// Structure (top to bottom):
//   1. Bronze accent stripe
//   2. Brand block: logo + tagline + short personal blurb + Meet me link
//   3. Four-column link grid: Studio / Work / Latest projects / Get in touch
//      The Get in touch column ends with an auto-year copyright line plus the
//      optional "Site by..." credit from siteSettings — tucked under the social
//      icons so there's no standalone credit bar at the page bottom.
//
// Latest projects pull from Sanity. Gracefully degrades to a "see portfolio"
// message when nothing is published yet.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { IconBrandInstagram, IconBrandFacebook } from '@tabler/icons-react';
import { Mail } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getAllProjects } from '@/lib/queries';
import logoLightAsset from '@/assets/logo-light.png';
import logoDarkAsset from '@/assets/logo-dark.png';

// Pre-render the four footer-logo variants (1x + 2x for each theme) so we
// can ship ONE img tag with data-attribute URLs and let the BaseLayout
// anti-FOUC script pick the right variant — same trick as the header.
// Footer logo displays at h-24 (96 px tall), so 96w/192w covers retina.
const footerLogoLight1x = await getImage({ src: logoLightAsset, format: 'webp', width: 96 });
const footerLogoLight2x = await getImage({ src: logoLightAsset, format: 'webp', width: 192 });
const footerLogoDark1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 96 });
const footerLogoDark2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 192 });
const footerLogoLightSrcset = `${footerLogoLight1x.src} 1x, ${footerLogoLight2x.src} 2x`;
const footerLogoDarkSrcset = `${footerLogoDark1x.src} 1x, ${footerLogoDark2x.src} 2x`;

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    serviceAreas?: string[];
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    newsletter?: NewsletterConfig | null;
  } | null;
}

const { siteSettings } = Astro.props as Props;

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const ig = siteSettings?.socialInstagram ?? '';
const fb = siteSettings?.socialFacebook ?? '';
const tagline =
  siteSettings?.tagline ??
  'Plainfield interior design for homes that feel genuinely yours.';
// Copyright auto-updates every build via new Date(). The "Site by..." line
// (siteCredit + siteCreditUrl) is a SEPARATE concept that lives next to the
// copyright in the Get in touch column.
const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// Pull the three most recent projects for the Latest Projects column.
// Falls back to an empty array when Sanity isn't reachable (build won't fail).
const allProjects: any[] = (await getAllProjects().catch(() => [])) ?? [];
const latestProjects = allProjects.slice(0, 3);
---

<footer class="bg-muted text-foreground">
  {/* Brand accent stripe — matches header + mobile drawer. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {/* 1. Brand block — logo + tagline + personal blurb. Centered.
       Logo wraps in an anchor that returns to home (mirrors the header logo's
       behavior). The two img tags swap via Tailwind dark: modifier — only one
       renders at a time, so the anchor still has a single visible image. */}
  <div class="mx-auto max-w-content px-m pt-section-md pb-l text-center">
    <a
      href="/"
      aria-label={`${brandName} home`}
      class="inline-block hover:opacity-80 transition-opacity"
    >
      {/*
        Single theme-aware footer logo. Same pattern as the header — no
        src in the HTML, BaseLayout's anti-FOUC script picks the right
        variant via data attributes based on the active theme. Lazy
        because the footer is below the fold on every page; one fetch
        per session no matter the theme. Keeps Lighthouse from flagging
        the inactive variant as "image larger than displayed."
      */}
      <img
        alt={brandName}
        width={96}
        height={102}
        class="mx-auto h-24 w-auto"
        loading="lazy"
        decoding="async"
        data-theme-logo
        data-logo-light-src={footerLogoLight1x.src}
        data-logo-light-srcset={footerLogoLightSrcset}
        data-logo-dark-src={footerLogoDark1x.src}
        data-logo-dark-srcset={footerLogoDarkSrcset}
      />
    </a>

    <p class="mt-l mx-auto max-w-2xl font-display italic text-h4 text-foreground/90 leading-snug">
      {tagline}
    </p>

    <p class="mt-m mx-auto max-w-2xl text-sm text-foreground/75 leading-relaxed">
      Reid Design is a one-person studio led by Staci Perkins. Based in Plainfield,
      working with homeowners across Greater Indianapolis.
    </p>

    <p class="mt-m">
      <a
        href="/about"
        class="inline-flex items-center gap-xs text-xs uppercase tracking-eyebrow font-semibold text-link hover:text-primary-dark transition-colors"
      >
        Meet Staci <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>

  {/* 1b. Newsletter signup — renders only when siteSettings.newsletter.enabled is true
         and a form-action or Web3Forms key exists. Island hydrates when scrolled into view
         so it doesn't add JS cost for visitors who never reach the footer. */}
  {siteSettings?.newsletter?.enabled && (
    <div class="mx-auto max-w-content px-m pb-l">
      <div class="max-w-md mx-auto">
        <NewsletterSignup
          client:visible
          newsletter={siteSettings.newsletter}
          source="footer"
        />
      </div>
    </div>
  )}

  {/* 2. Four-column links grid. */}
  <div class="border-t border-border">
    <div class="mx-auto max-w-content px-m py-section-md grid gap-l md:grid-cols-4 text-center">
      {/* STUDIO */}
      <nav aria-labelledby="footer-studio">
        <p id="footer-studio" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
          Studio
        </p>
        <ul class="text-sm space-y-2 list-none p-0">
          <li><a href="/about" class="text-foreground/85 hover:text-link transition-colors">About Staci</a></li>
          <li><a href="/process" class="text-foreground/85 hover:text-link transition-colors">Process</a></li>
          <li><a href="/services" class="text-foreground/85 hover:text-link transition-colors">Services & Pricing</a></li>
          <li><a href="/faq" class="text-foreground/85 hover:text-link transition-colors">FAQ</a></li>
        </ul>
      </nav>

      {/* WORK */}
      <nav aria-labelledby="footer-work">
        <p id="footer-work" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
          Work
        </p>
        <ul class="text-sm space-y-2 list-none p-0">
          <li><a href="/portfolio" class="text-foreground/85 hover:text-link transition-colors">Portfolio</a></li>
          <li><a href="/journal" class="text-foreground/85 hover:text-link transition-colors">Journal</a></li>
          <li><a href={`mailto:${email}`} class="text-foreground/85 hover:text-link transition-colors">Press inquiries</a></li>
        </ul>
      </nav>

      {/* LATEST PROJECTS — dynamic from Sanity, falls back gracefully when empty. */}
      <nav aria-labelledby="footer-latest">
        <p id="footer-latest" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
          Latest projects
        </p>
        {latestProjects.length > 0 ? (
          <ul class="text-sm space-y-2 list-none p-0">
            {latestProjects.map((p: any) => (
              <li>
                <a
                  href={`/portfolio/${p.slug?.current ?? ''}`}
                  class="text-foreground/85 hover:text-link transition-colors"
                >
                  {p.title}
                  {p.location && <span class="text-foreground/80"> · {p.location}</span>}
                </a>
              </li>
            ))}
            <li class="pt-xs">
              <a
                href="/portfolio"
                class="inline-flex items-center gap-xs text-xs uppercase tracking-eyebrow font-semibold text-link hover:text-primary-dark transition-colors"
              >
                View all <span aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        ) : (
          <p class="text-sm text-foreground/85 italic">
            Case studies are coming soon. <a href="/portfolio" class="text-link hover:text-primary-dark underline underline-offset-2">See the portfolio →</a>
          </p>
        )}
      </nav>

      {/* GET IN TOUCH */}
      <div>
        <p class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
          Get in touch
        </p>
        {email && (
          <p class="text-sm">
            <CopyEmailButton client:visible email={email} variant="link" />
          </p>
        )}
        <p class="mt-s text-sm text-foreground/85">
          Plainfield, IN<br />
          Serving Greater Indianapolis
        </p>
        {(ig || fb) && (
          <ul class="mt-m flex justify-center gap-s text-sm list-none p-0">
            {ig && (
              <li>
                <a
                  href={ig}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary-dark hover:border-primary-dark hover:text-white transition-colors"
                >
                  <IconBrandInstagram size={20} stroke={1.5} />
                </a>
              </li>
            )}
            {fb && (
              <li>
                <a
                  href={fb}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary-dark hover:border-primary-dark hover:text-white transition-colors"
                >
                  <IconBrandFacebook size={20} stroke={1.5} />
                </a>
              </li>
            )}
          </ul>
        )}

        {/* Auto-year copyright + optional "Site by..." link from Sanity.
            Stacked tight under the socials so the column reads top-to-bottom:
            email · location · socials · credit. No more standalone bar at the
            page bottom. */}
        <div class="mt-l space-y-1 text-xs text-foreground/80">
          <p>© {currentYear} {brandName}</p>
          {siteCredit && (
            siteCreditUrl ? (
              <p>
                <a
                  href={siteCreditUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-2 hover:text-link transition-colors"
                >
                  {siteCredit}
                </a>
              </p>
            ) : (
              <p>{siteCredit}</p>
            )
          )}
        </div>
      </div>
    </div>
  </div>
</footer>
