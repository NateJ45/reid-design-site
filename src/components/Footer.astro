---
// Foundation, edit with care
// Site footer: the back cover of the swatch book (rebuilt 2026-09-30 from the
// approved prototype docs/design/prototypes/chrome-a-swatch-book.html;
// DESIGN.md "Chrome"), refined the same day in the design pass: Nathan wanted
// it "truly classy and refined", so the craft props (paper contact tags,
// multicoloured swatches) gave way to stationery: a fine double-rule frame on
// the ink, Staci's logo centred on its top rule like a seal, her tagline
// centred under it, then three quiet columns.
//
// Top to bottom, on ink:
//   1. The frame. Her logo breaks its top rule; the tagline (Site settings ->
//      Tagline) sits under it, its last two words in Sandbar italic, then the
//      cream "Book a consultation" tag (same label/link as the header button,
//      2026-10-01) and a small rule-dot-rule ornament.
//   2. Three columns inside the frame:
//      - "The studio": a page index. Each line is the page, a dotted leader,
//        and a REAL fact on the right ("from $225", "19 answers"), all
//        derived from content by src/lib/chrome-facts.ts. A fact that cannot
//        be derived is left out, never typed.
//      - "Get in touch": email, phone and socials as label + value rows.
//      - "Based in <city>": the service towns, from Business info.
//   3. The base row under the frame: copyright, Privacy (or Staci's
//      small-print links), Search, and the site credit.
//
// Site settings still steer it (src/lib/siteSettings.ts): "Footer link
// columns" replace the page index with Staci's own columns, "Footer small-print
// links" replace Privacy, and "Show socials in the footer" hides the social
// rows. Custom pages flagged "Add to footer" join the index.
//
// No .dark subtree: every colour here is set explicitly for the ink ground
// (cream 14.2:1, cream at 75% 8:1+, Oat labels 10:1+, Sandbar 7:1+).

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import lockupMaskAsset from '@/assets/logo-lockup-mask.png';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { telHref } from '@/lib/phone';
import { resolveChrome, type RawFooterColumn } from '@/lib/siteSettings';
import { isExternalHref, type RawNavLink } from '@/lib/nav-href';
import { getChromeFacts } from '@/lib/queries';
import { resolveChromeFacts } from '@/lib/chrome-facts';

// Her logo, centred on the frame's top rule, up to ~150px wide. It is the
// CLEAN line-only lockup (src/assets/logo-lockup-mask.png: white ink on
// transparent, cut from the same source as the share-card masks in
// scripts/og-assets/) used as a CSS mask and painted cream, because the
// everyday logo's grey watercolour wash reads as a muddy smudge on ink.
const logoMask = await getImage({ src: lockupMaskAsset, format: 'webp', width: 456 });

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    serviceAreas?: string[];
    city?: string;
    state?: string;
    serviceRegion?: string;
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    /** Chrome options (see src/lib/siteSettings.ts). Empty keeps the built-ins. */
    footerColumns?: RawFooterColumn[] | null;
    legalNav?: (RawNavLink | null)[] | null;
    showFooterSocials?: boolean | null;
    sectionVisibility?: {
      showPortfolio?: boolean | null;
      showEDesign?: boolean | null;
    } | null;
  } | null;
  navPages?: NavPage[];
}

interface NavPage {
  title?: string;
  slug?: string;
  navLabel?: string;
  addToFooter?: boolean;
}

const { siteSettings, navPages } = Astro.props as Props;

const visible = getSectionVisibility(siteSettings?.sectionVisibility);
const chrome = resolveChrome(siteSettings);

// Failure handling (PORTS.md card 56). The Footer renders in two places: every
// static page at build time, and the live /preview/** route at request time.
// In the static build a failed read must fail the build, so the catch
// rethrows when the page is prerendered; in a live preview an index without
// facts beats a 500 in the editor's canvas.
const facts = resolveChromeFacts(
  await getChromeFacts().catch((err: unknown) => {
    if (Astro.isPrerendered) throw err;
    return null;
  }),
);

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';
const ig = chrome.showFooterSocials ? (siteSettings?.socialInstagram ?? '') : '';
const fb = chrome.showFooterSocials ? (siteSettings?.socialFacebook ?? '') : '';
// "@reiddesignin" from the Instagram URL, for the tag's face.
const igHandle = ig ? `@${ig.replace(/\/+$/, '').split('/').pop()}` : '';

// Home-base locality from businessInfo (via getSiteSettings), with the stable
// Plainfield, IN fallback.
const city = siteSettings?.city ?? 'Plainfield';
const state = siteSettings?.state ?? 'IN';
const serviceRegion = siteSettings?.serviceRegion ?? 'Greater Indianapolis';
// The towns beyond home base, from Business info. "Surrounding areas" style
// catch-alls are dropped; the sentence ends "and the towns between" itself.
const towns = (siteSettings?.serviceAreas ?? []).filter(
  (t) => t && t !== city && !/surrounding|nearby|area/i.test(t),
);
const townsLine = towns.length > 0 ? towns.join(', ') : serviceRegion;

// The tagline beside the logo (Site settings -> Tagline). Its last two words
// take the Sandbar italic, the site's accent grammar.
// The one brand line is "completely yours" (the hero's script phrase; Nathan,
// 2026-10-01): keep this fallback and Site settings -> Tagline saying the same.
const tagline =
  siteSettings?.tagline?.trim() ||
  'Plainfield interior design for homes that feel completely yours.';
const tagWords = tagline.split(/\s+/);
const tagLead = tagWords.slice(0, -2).join(' ');
const tagAccent = tagWords.slice(-2).join(' ');

const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// ---- The page index ------------------------------------------------------
// Facts come from chrome-facts; null means the line simply has no fact.

interface IndexLine {
  label: string;
  href: string;
  fact?: string | null;
}
const footerPages = (navPages ?? []).filter((p) => p.addToFooter && p.slug);
const builtInIndex: IndexLine[] = [
  ...(visible.portfolio
    ? [{ label: 'Portfolio', href: '/portfolio', fact: facts.portfolioFact }]
    : []),
  { label: 'Services', href: '/services', fact: facts.servicesFact },
  { label: 'Process', href: '/process', fact: facts.processFact },
  ...(visible.eDesign ? [{ label: 'E-Design', href: '/e-design', fact: facts.eDesignFact }] : []),
  { label: 'About Staci', href: '/about' },
  { label: 'FAQ', href: '/faq', fact: facts.faqFact },
  { label: 'Contact', href: '/contact' },
  ...footerPages.map((p) => ({ label: p.navLabel || p.title || 'Page', href: `/${p.slug}` })),
];

// Site settings -> Footer link columns, when set, stand in for the index.
const columns: { title: string; lines: IndexLine[] }[] = chrome.footerColumns
  ? chrome.footerColumns.map((c) => ({ title: c.title, lines: c.links }))
  : [{ title: 'The studio', lines: builtInIndex }];
---

<footer class="ftr">
  <div class="r-wrap">
    <div class="ftr__frame">
      <div class="ftr__crest">
        <a href="/" class="ftr__logo" aria-label={`${brandName} home`}>
          <span class="ftr__logo-mark" style={`--mark: url(${logoMask.src})`} aria-hidden="true"
          ></span>
        </a>
        <p class="ftr__tagline">
          {tagLead}
          {tagLead && ' '}<em>{tagAccent}</em>
        </p>
        {
          /* The booking button (2026-10-01): the same label and link as the
            header's button (Site settings -> Header button), as a cream tag
            on the ink, so the last thing on every page is a way to book. */
        }
        <a href={chrome.headerCta.href} class="r-pricetag r-pricetag--cream ftr__cta">
          <span>{chrome.headerCta.label}</span>
        </a>
        <span class="ftr__orn" aria-hidden="true"></span>
      </div>

      <div class="ftr__grid">
        {
          columns.map((col, ci) => (
            <nav class="ftr__col" aria-labelledby={`ftr-col-${ci}`}>
              <h2 class="ftr__h" id={`ftr-col-${ci}`}>
                {col.title}
              </h2>
              <ul class="ftr__idx" role="list">
                {col.lines.map((line) => (
                  <li>
                    <a
                      href={line.href}
                      target={isExternalHref(line.href) ? '_blank' : undefined}
                      rel={isExternalHref(line.href) ? 'noopener noreferrer' : undefined}
                    >
                      <span class="ftr__page">{line.label}</span>
                      <em aria-hidden="true" />
                      {line.fact && <span class="ftr__fact">{line.fact}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }

        <div class="ftr__col">
          <h2 class="ftr__h">Get in touch</h2>
          <ul class="ftr__contact" role="list">
            {
              email && (
                <li>
                  <small>Email</small>
                  <a href={`mailto:${email}`}>{email}</a>
                </li>
              )
            }
            {
              phone && (
                <li>
                  <small>Call or text</small>
                  <a href={telHref(phone)}>{phone}</a>
                </li>
              )
            }
            {
              ig && (
                <li>
                  <small>Instagram</small>
                  <a href={ig} target="_blank" rel="noopener noreferrer">
                    {igHandle}
                  </a>
                </li>
              )
            }
            {
              fb && (
                <li>
                  <small>Facebook</small>
                  <a href={fb} target="_blank" rel="noopener noreferrer">
                    {brandName}
                  </a>
                </li>
              )
            }
          </ul>
        </div>

        <div class="ftr__col">
          <h2 class="ftr__h">Based in {city}</h2>
          <p class="ftr__area">
            Serving {townsLine} and the towns between.
            {
              visible.eDesign && (
                <>
                  {' '}
                  Farther out, <a href="/e-design">E-Design</a> works anywhere.
                </>
              )
            }
          </p>
        </div>
      </div>
    </div>

    <div class="ftr__base">
      <p>© {currentYear} {brandName} · {city}, {state}</p>
      <p class="ftr__small">
        {
          chrome.legalNav ? (
            chrome.legalNav.map((link) => (
              <a
                href={link.href}
                target={isExternalHref(link.href) ? '_blank' : undefined}
                rel={isExternalHref(link.href) ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))
          ) : (
            <a href="/privacy">Privacy</a>
          )
        }
        <a href="/search">Search</a>
        {
          siteCredit &&
            (siteCreditUrl ? (
              <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer">
                {siteCredit}
              </a>
            ) : (
              <span>{siteCredit}</span>
            ))
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --muted: rgb(245 237 227 / 0.75);
    --hair: rgb(245 237 227 / 0.12);
    /* The frame's rule: Sandbar, quiet on the ink. */
    --rule: rgb(205 176 154 / 0.38);
    position: relative;
    margin-top: -1px;
    padding-top: clamp(5.5rem, 10vw, 7.5rem);
    background: var(--color-ink);
    color: var(--color-cream);
  }

  /* ---- The frame: a double rule, like the border of a letterpress card. ---- */
  .ftr__frame {
    position: relative;
    padding: 0 clamp(1.25rem, 4vw, 4rem) clamp(2.75rem, 5vw, 4rem);
    border: 1px solid var(--rule);
  }
  .ftr__frame::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgb(205 176 154 / 0.16);
    pointer-events: none;
  }

  /* ---- The crest: logo on the top rule, tagline, ornament. ---- */
  .ftr__crest {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .ftr__logo {
    --logo-w: clamp(7.5rem, 11vw, 9.5rem);
    display: block;
    /* Sits ON the top rule, centred on it (the lockup is 456:473, so half its
       height is 0.52 of its width); the ink behind it breaks both lines. */
    margin-top: calc(var(--logo-w) * -0.52);
    padding-inline: 1.5rem;
    background: var(--color-ink);
    border-radius: 2px;
  }
  .ftr__logo-mark {
    display: block;
    width: var(--logo-w);
    aspect-ratio: 456 / 473;
    background: var(--color-cream);
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }
  .ftr__logo:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 4px;
  }
  .ftr__tagline {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    max-width: 22ch;
    font: 300 clamp(1.7rem, 1rem + 2.1vw, 3rem) / 1.08 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--color-cream);
    text-wrap: balance;
  }
  .ftr__tagline em {
    font-style: italic;
    color: var(--color-chip-3);
  }
  .ftr__cta {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    min-height: 3rem;
    font-size: 1rem;
  }
  /* A short rule, a dot, a short rule. */
  .ftr__orn {
    display: block;
    width: 7.5rem;
    height: 7px;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    background:
      radial-gradient(circle, var(--color-chip-3) 0 2.5px, transparent 3px) center / 7px 7px
        no-repeat,
      linear-gradient(var(--rule), var(--rule)) left center / calc(50% - 0.9rem) 1px no-repeat,
      linear-gradient(var(--rule), var(--rule)) right center / calc(50% - 0.9rem) 1px no-repeat;
  }

  /* ---- Columns ---- */
  .ftr__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.75rem;
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
  }
  @media (min-width: 900px) {
    .ftr__grid {
      grid-template-columns: 1.25fr 1fr 0.9fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }
  .ftr__h {
    margin: 0 0 1.1rem;
    font: 500 0.82rem/1.2 var(--font-body);
    letter-spacing: 0.02em;
    color: var(--color-chip-2);
  }

  /* The page index: page, dotted leader, fact. */
  .ftr__idx {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ftr__idx a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0;
    color: var(--color-cream);
    text-decoration: none;
    transition: color 300ms;
  }
  .ftr__page {
    font: 300 clamp(1.25rem, 1.05rem + 0.5vw, 1.45rem) / 1.15 var(--font-display);
    letter-spacing: -0.012em;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 450ms var(--ease);
  }
  .ftr__idx em {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted rgb(245 237 227 / 0.25);
    transform: translateY(-0.3em);
  }
  .ftr__fact {
    flex: none;
    font: 300 italic 1rem/1 var(--font-display);
    color: var(--color-chip-3);
    white-space: nowrap;
  }
  .ftr__idx a:hover {
    color: var(--color-chip-2);
  }
  .ftr__idx a:hover .ftr__page {
    background-size: 100% 1px;
  }
  .ftr__idx a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }

  /* Contact: a small Oat label over each value. */
  .ftr__contact {
    list-style: none;
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
  }
  .ftr__contact small {
    display: block;
    margin-bottom: 0.2rem;
    font: 500 0.75rem/1.3 var(--font-body);
    color: var(--muted);
  }
  .ftr__contact a {
    font: 300 1.2rem/1.3 var(--font-display);
    color: var(--color-cream);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
    transition: text-decoration-color 300ms;
  }
  .ftr__contact a:hover {
    text-decoration-color: var(--color-chip-3);
  }
  .ftr__contact a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }

  .ftr__area {
    margin: 0;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--muted);
  }
  .ftr__area a {
    color: var(--color-cream);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(245 237 227 / 0.4);
  }
  .ftr__area a:hover {
    text-decoration-color: currentColor;
  }
  .ftr__area a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }

  /* ---- Base row, under the frame ---- */
  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.4rem 1.6rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ftr__base p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .ftr__small a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ftr__small a:hover {
    color: var(--color-cream);
  }
  .ftr__small a:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }
</style>
