---
// Foundation, edit with care
// Site footer. Compact layout that reads as a SEPARATE zone from the FinalCta
// section that sits above it on most pages.
//
// Color decoupling: the footer uses bg-muted (Cream in light, dark warm in
// dark) so it doesn't visually merge with the Charcoal Dark FinalCta. The
// 4px Warm Bronze accent stripe at the top is the same brand signature
// used in the header and mobile menu drawer.
//
// Structure (top to bottom):
//   1. Bronze accent stripe
//   2. Optional newsletter signup (only when siteSettings.newsletter.enabled)
//   3. Compact brand bar: logo + tagline side by side (one short row, not a
//      tall stacked block) so the footer stays roughly half its old height.
//   4. Five-column link grid: Studio / Work / Free tools / Latest projects /
//      Get in touch (email, phone, location, socials).
//   5. Thin bottom bar: auto-year copyright, privacy link, optional "Site
//      by..." credit, all on one line.
//
// Tailwind v4 gotcha: max-w-xs/s/m/l are shadowed by this project's custom
// --spacing-* tokens (they resolve to a few px, not the container scale). Use
// max-w-md / max-w-2xl / arbitrary values like max-w-[28rem] for text widths.
//
// Latest projects pull from Sanity. Gracefully degrades to a "see portfolio"
// message when nothing is published yet.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { IconBrandInstagram, IconBrandFacebook } from '@tabler/icons-react';
import { Mail, Phone } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton';
import NewsletterSignup from '@/components/NewsletterSignup';
import FooterBrand from '@/components/FooterBrand.astro';
import { getAllProjects } from '@/lib/queries';
import logoLightAsset from '@/assets/logo-light.png';
import logoDarkAsset from '@/assets/logo-dark.png';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { telHref } from '@/lib/phone';
import { resolveChrome, type RawFooterColumn } from '@/lib/siteSettings';
import { isExternalHref, type RawNavLink } from '@/lib/nav-href';

// Pre-render the four footer-logo variants (1x + 2x for each theme) so we
// can ship ONE img tag with data-attribute URLs and let the BaseLayout
// anti-FOUC script pick the right variant — same trick as the header.
// Footer logo displays at h-16 (64 px tall); the 96w/192w pair still covers retina.
const footerLogoLight1x = await getImage({ src: logoLightAsset, format: 'webp', width: 96 });
const footerLogoLight2x = await getImage({ src: logoLightAsset, format: 'webp', width: 192 });
const footerLogoDark1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 96 });
const footerLogoDark2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 192 });
const footerLogoLightSrcset = `${footerLogoLight1x.src} 1x, ${footerLogoLight2x.src} 2x`;
const footerLogoDarkSrcset = `${footerLogoDark1x.src} 1x, ${footerLogoDark2x.src} 2x`;

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    serviceAreas?: string[];
    city?: string;
    state?: string;
    serviceRegion?: string;
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    newsletter?: NewsletterConfig | null;
    /** Chrome options (see src/lib/siteSettings.ts). Empty keeps the built-ins. */
    footerColumns?: RawFooterColumn[] | null;
    legalNav?: (RawNavLink | null)[] | null;
    showFooterSocials?: boolean | null;
    sectionVisibility?: {
      showPortfolio?: boolean | null;
      showJournal?: boolean | null;
      showShop?: boolean | null;
      showEDesign?: boolean | null;
      showGiftCertificates?: boolean | null;
      showPress?: boolean | null;
      showResources?: boolean | null;
      showGuides?: boolean | null;
      showStyleQuiz?: boolean | null;
      showBudgetCalculator?: boolean | null;
    } | null;
  } | null;
  navPages?: NavPage[];
}

interface NavPage {
  title?: string;
  slug?: string;
  navLabel?: string;
  addToFooter?: boolean;
}

const { siteSettings, navPages } = Astro.props as Props;

// Custom pages Staci flagged to appear in the footer.
const footerPages = (navPages ?? []).filter((p) => p.addToFooter && p.slug);

// Normalize section visibility. Unset => visible (safe default for live site).
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

// Per-column "has any visible link" flags. A column whose every link is toggled
// off should drop out entirely (heading included) rather than leave a dangling
// title with nothing under it. Studio and Get-in-touch always have content
// (core pages / contact details), so only Work, Free tools, and Latest projects
// are conditional.
// Editor-managed chrome. `footerColumns` is opt-in: when Staci has filled it
// in, HER columns replace the four built-in link columns wholesale (Get in
// touch always stays, it is contact details rather than a menu). Empty — the
// default — leaves every line below exactly as it was.
const chrome = resolveChrome(siteSettings);
const editorColumns = chrome.footerColumns;

const showWork =
  !editorColumns &&
  (visible.portfolio || visible.journal || visible.shop || visible.giftCertificates);
const showTools =
  !editorColumns &&
  (visible.styleQuiz || visible.budgetCalculator || visible.guides || visible.resources);
const showLatest = !editorColumns && visible.portfolio;

// Count the columns that actually render so the grid balances at lg and the
// Get-in-touch column stays at the right edge instead of stranding empty tracks.
// (Tailwind needs the full class strings present in source, hence the literal map.)
const colCount = editorColumns
  ? editorColumns.length + 1
  : 2 + (showWork ? 1 : 0) + (showTools ? 1 : 0) + (showLatest ? 1 : 0);
const lgColsClass =
  { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5' }[
    colCount
  ] ?? 'lg:grid-cols-5';

// When only a couple of columns survive the visibility toggles, an even grid
// strands them with a big empty gap. In that case lay the row out as a balanced
// "nav | brand | contact" flex row (the logo moves up from its own line into
// the row) so the footer stays full and intentional. With 4+ columns the grid
// already fills nicely, so the logo keeps its own centered row below.
const brandInline = colCount <= 3;

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';
const ig = siteSettings?.socialInstagram ?? '';
const fb = siteSettings?.socialFacebook ?? '';
// Home-base locality from businessInfo (via getSiteSettings), with the stable
// Plainfield, IN fallback so the footer reads the same until Staci changes it.
const city = siteSettings?.city ?? 'Plainfield';
const state = siteSettings?.state ?? 'IN';
const serviceRegion = siteSettings?.serviceRegion ?? 'Greater Indianapolis';
// Copyright auto-updates every build via new Date(). The "Site by..." line
// (siteCredit + siteCreditUrl) is a SEPARATE concept that sits next to the
// auto-year copyright in the thin bottom bar.
const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// Pull the three most recent projects for the Latest Projects column.
// Falls back to an empty array when Sanity isn't reachable (build won't fail).
const allProjects: any[] = (await getAllProjects().catch(() => [])) ?? [];
const latestProjects = allProjects.slice(0, 3);
---

<footer class="bg-muted text-foreground">
  {/* Brand accent stripe — matches header + mobile drawer. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {
    /* Newsletter signup — renders only when siteSettings.newsletter.enabled is
       true. Island hydrates when scrolled into view. */
  }
  {
    siteSettings?.newsletter?.enabled && (
      <div class="mx-auto max-w-content border-b border-border px-m pt-l pb-m">
        <NewsletterSignup
          client:visible
          newsletter={siteSettings.newsletter}
          source="footer"
          compact
        />
      </div>
    )
  }

  {
    /* Link columns. Up to five: Studio / Work / Free tools / Latest projects /
       Get in touch (contact details). Single centered column on mobile.
       With 4+ visible columns this is an even grid; when toggles leave only a
       couple of columns it becomes a balanced "nav | brand | contact" flex row
       (see brandInline) so it never strands two columns with a big gap. */
  }
  <div
    class:list={[
      'mx-auto max-w-content gap-l px-m pt-l pb-m text-center md:text-left',
      brandInline
        ? 'flex flex-col items-center md:flex-row md:items-start md:justify-between'
        : ['grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3', lgColsClass],
    ]}
  >
    {
      /* EDITOR COLUMNS — Site settings -> Footer link columns. When Staci has
        set any, they stand in for the four built-in link columns below. */
    }
    {
      editorColumns?.map((col, i) => (
        <nav aria-labelledby={`footer-col-${i}`}>
          <p
            id={`footer-col-${i}`}
            class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
          >
            {col.title}
          </p>
          <ul class="list-none space-y-2 p-0 text-sm">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={isExternalHref(link.href) ? '_blank' : undefined}
                  rel={isExternalHref(link.href) ? 'noopener noreferrer' : undefined}
                  class="text-foreground/85 transition-colors hover:text-link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    {/* STUDIO */}
    {
      !editorColumns && (
        <nav aria-labelledby="footer-studio">
          <p id="footer-studio" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
            Studio
          </p>
          <ul class="list-none space-y-2 p-0 text-sm">
            <li>
              <a href="/about" class="text-foreground/85 transition-colors hover:text-link">
                About Staci
              </a>
            </li>
            <li>
              <a href="/process" class="text-foreground/85 transition-colors hover:text-link">
                Process
              </a>
            </li>
            <li>
              <a href="/services" class="text-foreground/85 transition-colors hover:text-link">
                Services &amp; Pricing
              </a>
            </li>
            <li>
              <a href="/faq" class="text-foreground/85 transition-colors hover:text-link">
                FAQ
              </a>
            </li>
            {visible.press && (
              <li>
                <a href="/press" class="text-foreground/85 transition-colors hover:text-link">
                  Press
                </a>
              </li>
            )}
            {footerPages.map((p) => (
              <li>
                <a href={`/${p.slug}`} class="text-foreground/85 transition-colors hover:text-link">
                  {p.navLabel || p.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {/* WORK — only when at least one of its links is visible. */}
    {
      showWork && (
        <nav aria-labelledby="footer-work">
          <p id="footer-work" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
            Work
          </p>
          <ul class="list-none space-y-2 p-0 text-sm">
            {visible.portfolio && (
              <li>
                <a href="/portfolio" class="text-foreground/85 transition-colors hover:text-link">
                  Portfolio
                </a>
              </li>
            )}
            {visible.portfolio && (
              <li>
                <a
                  href="/portfolio/before-after"
                  class="text-foreground/85 transition-colors hover:text-link"
                >
                  Before &amp; After
                </a>
              </li>
            )}
            {visible.journal && (
              <li>
                <a href="/journal" class="text-foreground/85 transition-colors hover:text-link">
                  Journal
                </a>
              </li>
            )}
            {visible.shop && (
              <li>
                <a href="/shop" class="text-foreground/85 transition-colors hover:text-link">
                  Shop
                </a>
              </li>
            )}
            {visible.giftCertificates && (
              <li>
                <a
                  href="/gift-certificates"
                  class="text-foreground/85 transition-colors hover:text-link"
                >
                  Gift Certificates
                </a>
              </li>
            )}
          </ul>
        </nav>
      )
    }

    {/* FREE TOOLS & GUIDES — only when at least one of its links is visible. */}
    {
      showTools && (
        <nav aria-labelledby="footer-tools">
          <p id="footer-tools" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
            Free tools &amp; guides
          </p>
          <ul class="list-none space-y-2 p-0 text-sm">
            {visible.styleQuiz && (
              <li>
                <a href="/quiz" class="text-foreground/85 transition-colors hover:text-link">
                  Style Quiz
                </a>
              </li>
            )}
            {visible.budgetCalculator && (
              <li>
                <a href="/calculator" class="text-foreground/85 transition-colors hover:text-link">
                  Cost Calculator
                </a>
              </li>
            )}
            {visible.guides && (
              <li>
                <a href="/guides" class="text-foreground/85 transition-colors hover:text-link">
                  Guides
                </a>
              </li>
            )}
            {visible.resources && (
              <li>
                <a href="/resources" class="text-foreground/85 transition-colors hover:text-link">
                  Resources
                </a>
              </li>
            )}
          </ul>
        </nav>
      )
    }

    {/* LATEST PROJECTS — only when portfolio is visible. */}
    {
      showLatest && (
        <nav aria-labelledby="footer-latest">
          <p id="footer-latest" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
            Latest projects
          </p>
          {latestProjects.length > 0 ? (
            <ul class="list-none space-y-2 p-0 text-sm">
              {latestProjects.map((p: any) => (
                <li>
                  <a
                    href={`/portfolio/${p.slug?.current ?? ''}`}
                    class="text-foreground/85 transition-colors hover:text-link"
                  >
                    {p.title}
                  </a>
                </li>
              ))}
              <li class="pt-xs">
                <a
                  href="/portfolio"
                  class="inline-flex items-center gap-xs text-xs font-semibold tracking-eyebrow text-link uppercase transition-colors hover:text-primary-dark"
                >
                  View all <span aria-hidden="true">→</span>
                </a>
              </li>
            </ul>
          ) : (
            <p class="text-sm text-foreground/85 italic">
              Case studies are coming soon.{' '}
              <a
                href="/portfolio"
                class="text-link underline underline-offset-2 hover:text-primary-dark"
              >
                See the portfolio →
              </a>
            </p>
          )}
        </nav>
      )
    }

    {
      /* Brand signature, pulled into the row when the footer is sparse so it
        reads as nav | brand | contact instead of two stranded columns. */
    }
    {
      brandInline && (
        <FooterBrand
          brandName={brandName}
          tagline={siteSettings?.tagline}
          logoLightSrc={footerLogoLight1x.src}
          logoLightSrcset={footerLogoLightSrcset}
          logoDarkSrc={footerLogoDark1x.src}
          logoDarkSrcset={footerLogoDarkSrcset}
          class="md:max-w-[22rem]"
        />
      )
    }

    {/* GET IN TOUCH — email, phone, location, socials. */}
    <div>
      <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">Get in touch</p>
      <div class="space-y-1 text-sm">
        {
          email && (
            <p>
              <CopyEmailButton client:visible email={email} variant="link" />
            </p>
          )
        }
        {
          phone && (
            <p>
              <a
                href={telHref(phone)}
                class="inline-flex items-center gap-xs text-link transition-colors hover:text-primary-dark"
              >
                <Phone size={14} aria-hidden="true" />
                {phone}
              </a>
            </p>
          )
        }
      </div>
      <p class="mt-s text-sm text-foreground/75">
        {city}, {state}<br />
        Serving {serviceRegion}
      </p>
      {
        chrome.showFooterSocials && (ig || fb) && (
          <ul class="mt-m flex list-none justify-center gap-s p-0 text-sm md:justify-start">
            {ig && (
              <li>
                <a
                  href={ig}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary-dark hover:bg-primary-dark hover:text-white"
                >
                  <IconBrandInstagram size={20} stroke={1.5} />
                </a>
              </li>
            )}
            {fb && (
              <li>
                <a
                  href={fb}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary-dark hover:bg-primary-dark hover:text-white"
                >
                  <IconBrandFacebook size={20} stroke={1.5} />
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>
  </div>

  {
    /* Logo + tagline — its own centered row below the columns when the footer is
       full. When sparse it moves up into the row above instead (see brandInline). */
  }
  {
    !brandInline && (
      <div class="mx-auto max-w-content px-m pb-l">
        <FooterBrand
          brandName={brandName}
          tagline={siteSettings?.tagline}
          logoLightSrc={footerLogoLight1x.src}
          logoLightSrcset={footerLogoLightSrcset}
          logoDarkSrc={footerLogoDark1x.src}
          logoDarkSrcset={footerLogoDarkSrcset}
        />
      </div>
    )
  }

  {
    /* Thin bottom bar — copyright, privacy, optional "Site by..." credit on one
       line so they don't add a tall block to a footer column. */
  }
  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-content flex-col items-center justify-center gap-xs px-m py-m text-center text-xs text-foreground/80 sm:flex-row sm:justify-between"
    >
      <p>© {currentYear} {brandName}</p>
      <div class="flex items-center gap-m">
        {
          /* Site settings -> Footer small-print links replaces this single
            built-in Privacy link when Staci sets any. */
        }
        {
          chrome.legalNav ? (
            chrome.legalNav.map((link) => (
              <a
                href={link.href}
                target={isExternalHref(link.href) ? '_blank' : undefined}
                rel={isExternalHref(link.href) ? 'noopener noreferrer' : undefined}
                class="underline underline-offset-2 transition-colors hover:text-link"
              >
                {link.label}
              </a>
            ))
          ) : (
            <a
              href="/privacy"
              class="underline underline-offset-2 transition-colors hover:text-link"
            >
              Privacy policy
            </a>
          )
        }
        {
          siteCredit &&
            (siteCreditUrl ? (
              <a
                href={siteCreditUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 transition-colors hover:text-link"
              >
                {siteCredit}
              </a>
            ) : (
              <span>{siteCredit}</span>
            ))
        }
      </div>
    </div>
  </div>
</footer>
