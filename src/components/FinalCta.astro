---
// Safe to edit by hand
// The full-bleed call-to-action section that closes every interior page (and the home page).
// Charcoal Dark panel with editorial headline, optional subhead, and a Bronze CTA pill.
// This is intentionally the only section on the page that uses the dark brand panel:
// it punctuates the read and pushes toward booking a consultation.
//
// scriptAccent: optional single word/phrase from the headline to render in handwritten
// Pinyon Script via the `.font-script` utility. Inherits the heading color (text-bg) so
// it reads correctly on the Charcoal Dark surface in both light and dark theme.
// Falls back silently when undefined, blank, or not found. No existing CTA is affected.

import CtaLink from '@/components/CtaLink.astro';
import SanityImage from '@/components/SanityImage.astro';
import { splitScriptAccent } from '@/lib/scriptAccent';

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

interface Props {
  /** Optional eyebrow label above the headline (e.g., "Ready to Begin?"). */
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  cta?: CtaBlock | null;
  /** Optional secondary CTA rendered as an outlined inverse button next to the primary. */
  secondaryCta?: CtaBlock | null;
  /** Override the default heading id (defaults to "final-cta"). */
  headingId?: string;
  /** Fallback CTA label when cta.label isn't set. */
  fallbackCtaLabel?: string;
  /**
   * Optional single word/phrase from the headline to render in handwritten
   * Pinyon Script. Must match the headline text exactly (case-sensitive). Leave
   * blank to skip. Use sparingly, one accent per heading. The script word
   * inherits the heading color (text-bg / cream) so contrast is correct on
   * the Charcoal Dark surface in both themes.
   */
  scriptAccent?: string;
  /**
   * Optional decorative background photo. When set, it fills the panel behind a
   * fixed charcoal scrim that keeps the cream headline and bronze button
   * readable. When absent, the panel renders as the solid Charcoal Dark surface,
   * exactly as before. The shape matches what SanityImage accepts.
   */
  backgroundImage?: {
    asset?: { _ref?: string; _id?: string };
    alt?: string;
    hotspot?: { x: number; y: number; height: number; width: number };
    crop?: { top: number; bottom: number; left: number; right: number };
  } | null;
}

const {
  eyebrow,
  headline = 'Ready to Love Your Space?',
  subhead = "Let's start with a conversation.",
  cta,
  secondaryCta,
  headingId = 'final-cta',
  fallbackCtaLabel = 'Book a Consultation',
  scriptAccent,
  backgroundImage,
} = Astro.props as Props;

// Only treat the background as present when a real asset is attached, so an
// empty image object never flips on the overlay path.
const hasBackground = !!backgroundImage?.asset;

// Split the headline around the script-accent word when provided.
const {
  found: scriptFound,
  before: scriptBefore,
  word: scriptWord,
  after: scriptAfter,
} = splitScriptAccent(headline, scriptAccent);
---

{
  /* Rebuilt 2026-09-29 (art-direction rebuild). The close of every page: a
    Walnut bronze ground (chip 6; cream on it is 5.1:1), the headline very
    large on the left, the subhead and the button on the right, and the
    logo's leaf sprig drawn faint and huge behind. Same props as before, so
    every page that ends with FinalCta changes together. An optional
    background photo still works: it sits behind a Walnut scrim. */
}
<section class:list={['final', hasBackground && 'final--photo']} aria-labelledby={headingId}>
  {
    hasBackground && (
      <div class="final__bg" aria-hidden="true">
        <SanityImage
          source={backgroundImage}
          width={1920}
          sizes="100vw"
          loading="lazy"
          alt=""
          class="final__bg-img"
        />
      </div>
    )
  }
  <svg class="final__sprig" viewBox="0 0 300 90" aria-hidden="true" focusable="false">
    <path d="M4 78 C70 62 150 50 296 20"></path>
    <path d="M60 66 C52 48 58 34 74 28 C78 44 72 58 60 66Z"></path>
    <path d="M60 66 C44 72 30 70 20 60 C34 52 50 56 60 66Z"></path>
    <path d="M118 56 C110 38 116 24 132 18 C136 34 130 48 118 56Z"></path>
    <path d="M118 56 C104 64 88 64 76 54 C90 46 106 48 118 56Z"></path>
    <path d="M178 44 C172 28 178 14 194 8 C198 24 192 38 178 44Z"></path>
    <path d="M178 44 C164 52 148 52 136 44 C150 36 166 36 178 44Z"></path>
    <path d="M236 32 C232 18 238 6 252 2 C256 16 250 28 236 32Z"></path>
    <path d="M236 32 C224 40 210 40 200 32 C212 24 226 26 236 32Z"></path>
  </svg>
  <div class="r-wrap final__grid">
    <div class="final__main">
      {eyebrow && <p class="final__eyebrow">{eyebrow}</p>}
      <h2 id={headingId} class="final__h">
        {
          scriptFound ? (
            <>
              {scriptBefore}
              <span class="r-accent">{scriptWord}</span>
              {scriptAfter}
            </>
          ) : (
            headline
          )
        }
      </h2>
    </div>
    <div class="final__side">
      {subhead && <p class="final__sub">{subhead}</p>}
      <div class="final__ctas">
        <CtaLink
          cta={cta}
          variant="primary"
          onDark
          fallbackHref="/contact"
          fallbackLabel={fallbackCtaLabel}
        />
        {secondaryCta && <CtaLink cta={secondaryCta} variant="secondary" onDark />}
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    --accent-color: var(--color-chip-2);
    position: relative;
    overflow: clip;
    background: var(--color-chip-6);
    color: var(--color-cream);
    padding-block: clamp(5.5rem, 11vw, 10rem);
  }
  .final__bg {
    position: absolute;
    inset: 0;
  }
  .final__bg :global(.final__bg-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .final--photo .final__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(95 70 57 / 0.82);
  }
  .final__sprig {
    position: absolute;
    right: -6%;
    bottom: -14%;
    width: min(64vw, 50rem);
    color: rgb(245 237 227 / 0.14);
    pointer-events: none;
  }
  .final__sprig path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .final__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
  }
  .final__main {
    grid-column: 1 / 9;
  }
  .final__eyebrow {
    margin: 0 0 1.25rem;
    font: 500 0.95rem/1.3 var(--font-body);
    color: var(--color-cream);
  }
  .final__h {
    margin: 0;
    font: 300 clamp(2.8rem, 1.3rem + 4.8vw, 6.25rem) / 0.97 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--color-cream);
    text-wrap: balance;
  }
  .final__side {
    grid-column: 9 / 13;
  }
  .final__sub {
    margin: 0 0 1.75rem;
    color: var(--color-cream);
    text-wrap: pretty;
  }
  .final__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .final__sprig path {
      stroke-dasharray: 600;
      stroke-dashoffset: 600;
      animation: final-draw linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 55%;
    }
  }
  @supports not (animation-timeline: view()) {
    .final__sprig path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  @keyframes final-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 1023px) {
    .final__grid {
      display: block;
    }
    .final__side {
      margin-top: 2rem;
      max-width: 36rem;
    }
  }
</style>
