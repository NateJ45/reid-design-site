---
// Foundation, edit with care
// Renders the About page from its `pageBuilder` layout array. Each
// `aboutSectionMarker` maps to the existing About section component, reading the
// unchanged aboutPage fields (so no content migration). Any general library
// block inserted between sections is delegated to the main SectionRenderer, so
// the block-to-component mapping isn't duplicated. Falls back to the default
// section order when the layout array is empty (pre-migration safety).
//
// Retired marker (2026-09-30): 'press' can still be stored on the About
// layout (its option value stays in the schema so the row does not fail
// validation and block publishing), but press was removed, so it falls
// through to the final `null` below and renders nothing.
//
// Kind words (2026-09-30): the wall of every review. The layouts stored before
// its marker existed do not have it, so placeMarker() puts it just before the
// closing CTA; aboutPage.kindWordsShow === false removes it. Staci's own row,
// once she drags one in, is left where she put it.
import Hero from '@/components/Hero.astro';
import AboutStory from '@/components/sections/AboutStory.astro';
import AboutPhilosophy from '@/components/sections/AboutPhilosophy.astro';
import AboutPersonal from '@/components/AboutPersonal.astro';
import StatsRow from '@/components/StatsRow.astro';
import FinalCta from '@/components/FinalCta.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import KindWords from '@/components/about/KindWords.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import { placeMarker } from '@/lib/auto-marker';

interface Props {
  sections?: any[];
  page: any;
  philosophyPoints?: any[];
  /** getSiteSettings(): the Kind words rating tag and review links. */
  siteSettings?: any;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, philosophyPoints = [], siteSettings, editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};

// Default order, matching the current About page. Used when the layout array
// hasn't been set on the doc yet.
const DEFAULT_ORDER = [
  'hero',
  'story',
  'philosophy',
  'personal',
  'stats',
  'kindWords',
  'finalCta',
].map((section) => ({ _type: 'aboutSectionMarker', section }));

const list = (sections ?? []).filter((s) => s && s._type);
const rows = placeMarker(list.length > 0 ? list : DEFAULT_ORDER, {
  markerType: 'aboutSectionMarker',
  value: 'kindWords',
  show: page?.kindWordsShow,
  before: ['finalCta'],
});

const stats = (page?.stats ?? [])
  .filter((s: any) => typeof s?.number === 'number' && typeof s?.label === 'string')
  .map(({ number, suffix, label }: any) => ({ number, suffix, label }));
---

{
  rows.map((s: any, i: number) => (
    <Wrap {...wrapAttrs(s._key)}>
      {s._type === 'aboutSectionMarker' ? (
        s.section === 'hero' ? (
          <Hero
            eyebrow={page?.heroEyebrow ?? 'The Designer.'}
            headline={page?.heroHeadline ?? 'The designer who comes to your home.'}
            subhead={page?.heroSubhead ?? "Here's who you'd be working with."}
            backgroundImage={page?.heroImage}
            headingId="about-hero-heading"
            size="short"
            scriptAccent={page?.heroScriptAccent}
          />
        ) : s.section === 'story' ? (
          <AboutStory
            eyebrow={page?.storyEyebrow}
            headline={page?.storyHeadline}
            content={page?.storyContent}
            photo={page?.staciPhoto}
            attribution={page?.staciAttribution}
            backgroundLine={page?.backgroundLine}
            serviceAreaMention={page?.serviceAreaMention}
          />
        ) : s.section === 'philosophy' ? (
          <AboutPhilosophy
            eyebrow={page?.philosophyEyebrow}
            headline={page?.philosophyHeadline}
            points={philosophyPoints}
          />
        ) : s.section === 'personal' ? (
          <AboutPersonal
            eyebrow={page?.personalEyebrow}
            headline={page?.personalHeadline}
            intro={page?.personalIntro}
            currentlyList={page?.currentlyList}
            rapidFire={page?.rapidFire}
            localSpots={page?.localSpots}
            beyondDesign={page?.beyondDesign}
            candidPhoto={page?.candidPhoto}
          />
        ) : s.section === 'stats' ? (
          <StatsRow stats={stats} />
        ) : s.section === 'kindWords' ? (
          <KindWords
            eyebrow={page?.kindWordsEyebrow}
            headline={page?.kindWordsHeadline}
            scriptAccent={page?.kindWordsScriptAccent}
            subhead={page?.kindWordsSubhead}
            reviews={page?.kindWords}
            siteSettings={siteSettings}
          />
        ) : s.section === 'finalCta' ? (
          <FinalCta
            eyebrow={page?.finalCtaEyebrow}
            headline={page?.finalCtaHeadline}
            subhead={page?.finalCtaSubhead}
            cta={page?.finalCta}
            scriptAccent={page?.finalCtaScriptAccent}
            backgroundImage={page?.finalCtaBackgroundImage}
          />
        ) : null
      ) : (
        <SectionRenderer sections={[s]} idPrefix={`about-extra-${i}`} coach={Boolean(editDoc)} />
      )}
    </Wrap>
  ))
}
