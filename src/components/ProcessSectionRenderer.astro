---
// Foundation, edit with care
// Renders the Process page from its `pageBuilder` layout array of
// processSectionMarker blocks. Each marker maps to the existing section reading
// the unchanged processPage fields + collections. Inserted general blocks
// delegate to SectionRenderer. Falls back to the default order when empty.
import Hero from '@/components/Hero.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import ProcessFaq from '@/components/sections/ProcessFaq.astro';
import FinalCta from '@/components/FinalCta.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  sections?: any[];
  page: any;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};

const DEFAULT_ORDER = ['hero', 'steps', 'faq', 'finalCta'].map((section) => ({
  _type: 'processSectionMarker',
  section,
}));

const list = (sections ?? []).filter((s) => s && s._type);
const rows = list.length > 0 ? list : DEFAULT_ORDER;
---

{rows.map((s: any, i: number) => (
  <Wrap {...wrapAttrs(s._key)}>
  {
  s._type === 'processSectionMarker' ? (
    s.section === 'hero' ? (
      <Hero
        eyebrow={page?.heroEyebrow ?? 'The Process.'}
        headline={page?.heroHeadline ?? 'From First Call to Final Reveal.'}
        subhead={page?.heroSubhead ?? ''}
        backgroundImage={page?.heroImage}
        headingId="process-hero-heading"
        size="short"
        scriptAccent={page?.heroScriptAccent}
      />
    ) : s.section === 'steps' ? (
      <ProcessSteps processSteps={page?.processSteps ?? []} />
    ) : s.section === 'faq' ? (
      <ProcessFaq
        eyebrow={page?.faqSectionEyebrow}
        headline={page?.faqSectionHeadline}
        faqs={page?.faqs ?? []}
      />
    ) : s.section === 'finalCta' ? (
      <FinalCta
        eyebrow={page?.finalCtaEyebrow}
        headline={page?.finalCtaHeadline}
        subhead={page?.finalCtaSubhead}
        cta={page?.finalCta}
        scriptAccent={page?.finalCtaScriptAccent}
        backgroundImage={page?.finalCtaBackgroundImage}
      />
    ) : null
  ) : (
    <SectionRenderer sections={[s]} idPrefix={`process-extra-${i}`} />
  )}
  </Wrap>
))}
