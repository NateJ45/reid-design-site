---
// Foundation, edit with care
// =============================================================================
// <Doodle>: a small ink drawing that draws itself in (2026-09-30)
// =============================================================================
// The drawings are generated by `npm run doodles` (scripts/doodles.config.mjs)
// into src/assets/doodles/ and inlined here so CSS can animate every stroke
// (src/styles/doodle.css). Decorative only: aria-hidden, no words.
//
//   draw="scroll"  (default) the pen strokes go down one after another as the
//                  doodle scrolls into view, then the colour washes in
//   draw="load"    the same, on page load
//   draw="none"    just the finished drawing
// Reduced motion, or a browser without scroll timelines: finished drawing.
//
// Size and position it from the parent with `class`. The ink is currentColor,
// so set `color` there too (Espresso on light grounds, Oat or cream on dark).
//
// Usage: <Doodle name="olive-sprig" class="my-corner" />
// =============================================================================
import { doodleMarkup } from '@/lib/doodles';
import type { DoodleName } from '@/lib/doodle-map';

interface Props {
  name: DoodleName;
  draw?: 'scroll' | 'load' | 'none';
  class?: string;
}

const { name, draw = 'scroll', class: className } = Astro.props as Props;
const svg = doodleMarkup(name);
---

{
  svg && (
    <span
      class:list={['dd', `dd--${draw}`, className]}
      aria-hidden="true"
      data-doodle={name}
      set:html={svg}
    />
  )
}
