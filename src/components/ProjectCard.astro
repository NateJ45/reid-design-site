---
// Safe to edit by hand
// Project card for the /portfolio grid. Hero image with gentle hover scale,
// title, location · year meta, brief summary.

import SanityImage from '@/components/SanityImage.astro';

interface Props {
  project: {
    title?: string;
    slug?: { current?: string };
    location?: string;
    year?: number;
    briefSummary?: string;
    heroImage?: any;
  };
}

const { project } = Astro.props as Props;
const href = project.slug?.current ? `/portfolio/${project.slug.current}` : '#';
---

<a
  href={href}
  class="group block rounded-md overflow-hidden bg-card border border-border-soft hover:border-primary/40 transition-colors"
>
  <div class="aspect-[4/3] overflow-hidden bg-muted">
    {project.heroImage?.asset ? (
      <SanityImage
        source={project.heroImage}
        width={800}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      />
    ) : (
      <div class="w-full h-full" aria-hidden="true"></div>
    )}
  </div>
  <div class="p-m">
    <h3 class="font-display text-h4 text-foreground group-hover:text-primary-dark transition-colors">
      {project.title}
    </h3>
    <p class="mt-xs text-xs uppercase tracking-widest text-secondary">
      {project.location}{project.location && project.year ? ' · ' : ''}{project.year}
    </p>
    {project.briefSummary && (
      <p class="mt-s text-sm text-foreground/80">{project.briefSummary}</p>
    )}
  </div>
</a>
