---
// Safe to edit by hand
// Project card for the /portfolio grid (rebuilt 2026-09-30, phase 2 of the
// art-direction rebuild; see DESIGN.md "Blocks and Portfolio").
//
// Image-led and quiet: the photo does the work, cropped around its Sanity
// hotspot, with the room tied on as a sample tag. Under it, the title in
// Zodiak and one plain line of location and year. No border, no shadow, no
// stripe: the grid around it (portfolio/index.astro) varies the sizes so the
// page reads as a board, not a catalogue.
//
// The photo's shape is the parent's call: the grid sets `--pcard-ratio` per
// slot (default 4:5, the shape of a phone photo held upright).
import SanityImage from '@/components/SanityImage.astro';
import { humanizeEnum } from '@/components/portfolio/labels';

interface Props {
  project: {
    title?: string;
    slug?: { current?: string };
    location?: string;
    year?: number;
    roomType?: string;
    briefSummary?: string;
    heroImage?: any;
  };
  /** Heading level for the title. The index uses h3 under its h2. */
  level?: 'h2' | 'h3';
  /** The `sizes` hint for the photo, when the grid knows better. */
  sizes?: string;
}

const {
  project,
  level = 'h3',
  sizes = '(min-width: 1024px) 50vw, (min-width: 640px) 50vw, 100vw',
} = Astro.props as Props;
const href = project.slug?.current ? `/portfolio/${project.slug.current}/` : '#';
const Title = level;

const roomLabel = humanizeEnum(project.roomType);
const line = [project.location, project.year].filter(Boolean).join(' · ');
const spot = project.heroImage?.hotspot;
const focus = spot
  ? `--fx:${Math.round(spot.x * 100)}%;--fy:${Math.round(spot.y * 100)}%`
  : undefined;
---

<a href={href} class="pcard">
  <div class="pcard__media" style={focus}>
    {
      project.heroImage?.asset ? (
        <SanityImage source={project.heroImage} width={1100} {sizes} class="pcard__img" />
      ) : (
        <div class="pcard__blank" aria-hidden="true" />
      )
    }
    {
      roomLabel && (
        <span class="r-tag pcard__tag">
          <strong>{roomLabel}</strong>
        </span>
      )
    }
  </div>
  <div class="pcard__meta">
    <Title class="pcard__title"><span>{project.title}</span></Title>
    {line && <p class="pcard__line">{line}</p>}
    {project.briefSummary && <p class="pcard__brief">{project.briefSummary}</p>}
  </div>
</a>

<style>
  .pcard {
    display: block;
    color: var(--color-ink);
    text-decoration: none;
  }
  .pcard:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 6px;
  }
  .pcard__media {
    position: relative;
    overflow: clip;
    aspect-ratio: var(--pcard-ratio, 4 / 5);
    background: var(--color-chip-1);
  }
  .pcard__media :global(.pcard__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) var(--fy, 50%);
    transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pcard:hover .pcard__media :global(.pcard__img),
  .pcard:focus-visible .pcard__media :global(.pcard__img) {
    transform: scale(1.04);
  }
  .pcard__blank {
    width: 100%;
    height: 100%;
  }
  .pcard__tag {
    position: absolute;
    left: 0.9rem;
    bottom: 1rem;
  }
  .pcard__tag strong {
    font-size: 0.98rem;
  }

  .pcard__meta {
    padding-top: 1.1rem;
  }
  .pcard__title {
    margin: 0;
    font: 300 clamp(1.45rem, 1.1rem + 1vw, 2rem) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* The title underline draws in on hover, like .r-link in reverse. */
  .pcard__title span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pcard:hover .pcard__title span,
  .pcard:focus-visible .pcard__title span {
    background-size: 100% 1px;
  }
  .pcard__line {
    margin: 0.5rem 0 0;
    font: 500 0.92rem/1.4 var(--font-body);
    color: var(--color-chip-7);
  }
  .pcard__brief {
    margin: 0.6rem 0 0;
    max-width: 44ch;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
</style>
