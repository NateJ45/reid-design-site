---
// Safe to edit by hand
// Guide (lead magnet) body: hero + cover and summary + the gated download form
// (or a "nearly ready" note when no file is attached) + final CTA.
//
// ONE BODY, TWO CALLERS (2026-09-29). This markup used to live inline in
// src/pages/guides/[slug].astro. It moved here, unchanged, so the Studio's
// draft preview (src/pages/preview/[...slug].astro) draws the SAME detail page
// the live site builds, and a "Copy share link" on this document opens a real
// page instead of a 404. The live page keeps the SEO, the JSON-LD, the share
// card and BaseLayout; this component is only what sits inside the layout.
// Proven render-neutral with scripts/page-parity.mjs (see the changelog).

import Hero from '@/components/Hero.astro';
import SanityImage from '@/components/SanityImage.astro';
import LeadMagnetForm from '@/components/LeadMagnetForm';
import FinalCta from '@/components/FinalCta.astro';

interface Props {
  /** The getLeadMagnet() result. */
  magnet: any;
  /** The guide's slug, passed to the form for the ESP tag. */
  slug: string;
  /** The newsletter form action from siteSettings, shared by every form. */
  formActionUrl: string | null;
}

const { magnet, slug, formActionUrl } = Astro.props;

// Resolve the download URL from the Sanity file asset.
// The getLeadMagnet query projects: file{ asset->{ url } }
const fileUrl: string = magnet.file?.asset?.url ?? '';
---

{/* ------- 1. Hero --------------------------------------------------------- */}
<Hero
  eyebrow="Free Guide"
  headline={magnet.title ?? 'A free guide from Reid Design.'}
  subhead={magnet.summary ?? 'Practical advice for your home. Download it free.'}
  headingId="guide-hero-heading"
  size="short"
/>

{/* ------- 2. Two-column layout: cover + gate form ------------------------- */}
<section class="bg-background" aria-labelledby="guide-content-heading">
  <div class="mx-auto max-w-content px-m py-section-md">
    <h2 id="guide-content-heading" class="sr-only">About this guide</h2>

    <div class="grid grid-cols-1 items-start gap-section-md lg:grid-cols-2">
      {/* Left column — cover image + summary copy */}
      <div>
        {
          magnet.coverImage?.asset && (
            <div class="overflow-hidden rounded-md border border-border-soft shadow-[0_4px_18px_-14px_rgba(61,61,61,0.18)]">
              {/* Brand accent stripe on the cover image block. */}
              <div class="h-0.5 bg-primary" aria-hidden="true" />
              <SanityImage
                source={magnet.coverImage}
                width={900}
                sizes="(min-width: 1024px) 45vw, 100vw"
                class="w-full object-cover"
                loading="eager"
              />
            </div>
          )
        }

        {
          magnet.summary && (
            <div class="mt-l space-y-s">
              <p class="text-xs tracking-eyebrow text-foreground/80 uppercase">What you'll get</p>
              <div class="h-px w-12 bg-primary/60" aria-hidden="true" />
              <p class="leading-relaxed text-foreground/85">{magnet.summary}</p>
            </div>
          )
        }

        {/* Back to all guides link */}
        <p class="mt-l">
          <a
            href="/guides"
            class="inline-flex items-center gap-xs text-xs font-semibold tracking-eyebrow text-link uppercase transition-colors hover:text-primary-dark"
          >
            <span aria-hidden="true">←</span> All guides
          </a>
        </p>
      </div>

      {/* Right column — gated email form (or no-download notice when file isn't set) */}
      <div>
        {
          fileUrl ? (
            <LeadMagnetForm
              client:visible
              fileUrl={fileUrl}
              gateHeading={magnet.gateHeading}
              gateBlurb={magnet.gateBlurb}
              buttonLabel={magnet.buttonLabel}
              successMessage={magnet.successMessage}
              espTag={magnet.espTag}
              formActionUrl={formActionUrl}
              slug={slug}
            />
          ) : (
            <div class="rounded-md border border-border bg-card p-l">
              <div class="mb-l h-0.5 bg-primary" aria-hidden="true" />
              <p class="font-display text-h4 text-foreground">This guide is almost ready.</p>
              <p class="mt-s text-sm leading-relaxed text-foreground/80">
                Staci is finishing it up. Check back soon, or
                <a href="/contact" class="ml-[0.25ch] text-link underline underline-offset-2">
                  reach out
                </a>
                and she'll send it directly when it's done.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

{/* ------- 3. Final CTA ---------------------------------------------------- */}
<FinalCta
  eyebrow="Ready to Go Further?"
  headline="Let's talk about your space."
  subhead="A guide is a start. A consultation is where things actually move."
/>
