---
// Safe to edit by hand
// One step of Staci's process (rebuilt 2026-09-30, phase 2 of the
// art-direction rebuild; see DESIGN.md "Process and FAQ").
//
//   "full" (the Process page, inside sections/ProcessSteps.astro): a big
//   moment per step. A large Zodiak numeral and the step's line drawing, the
//   time estimate on a sample tag, the title, the short description as a
//   Zodiak lede, the full description, and the "Quick bullets" (features) on
//   a paint chip whose tone steps down the strip with the step (chips 1 to 4,
//   never Warm Bronze, so ink text passes AA on every one). The tier note
//   sits under the chip.
//
//   "preview": the compact form the retired sections/ProcessPreview.astro
//   used (title, time, shortDescription). The home page now uses
//   home/TapeProcess.astro instead; this is kept so that file still builds.
//
// The number is real sequence here, so it is shown. It is decorative to a
// screen reader (aria-hidden) because the heading carries "Step 1:" itself.
//
// PortableText renders on the SERVER (no client directive): the description
// is static text and needs no hydration.

import PortableText from '@/components/PortableText';
import ProcessStepIllustration from '@/components/ProcessStepIllustration.astro';
// The same block type PortableText.tsx accepts, so the prop passes through
// without a cast (a looser local shape used to fail astro check here).
import type { PortableTextBlock } from '@portabletext/types';

interface Props {
  step: {
    stepNumber?: number;
    title?: string;
    timeEstimate?: string;
    shortDescription?: string;
    fullDescription?: PortableTextBlock[];
    features?: string[];
    tierNote?: string;
  };
  /** "preview" shows just shortDescription. "full" (Process page) shows everything. */
  variant?: 'preview' | 'full';
  /** Accepted for compatibility (the old connector line); unused. */
  isLast?: boolean;
  /** Position in the sequence (0-based); picks the paint-chip tone. */
  index?: number;
  /** Anchor id for the step (the Process page rail links to it). */
  id?: string;
  /** Scroll-timeline name the rail listens to (Process page only). */
  timeline?: string;
}

const { step, variant = 'preview', index = 0, id, timeline } = Astro.props as Props;
const n = typeof step.stepNumber === 'number' ? step.stepNumber : index + 1;
const padNum = String(n).padStart(2, '0');
// Paint-chip tone for the "Quick bullets" card: chips 1 to 4, cycling.
const tone = (index % 4) + 1;
const features = (step.features ?? []).filter(Boolean);
---

{
  variant === 'full' ? (
    <article
      class="pstep"
      id={id}
      aria-labelledby={id ? `${id}-title` : undefined}
      style={timeline ? `view-timeline-name: ${timeline}` : undefined}
    >
      <div class="pstep__top">
        <span class="pstep__num" aria-hidden="true">
          {padNum}
        </span>
        <ProcessStepIllustration stepNumber={step.stepNumber} size={64} class="pstep__ill" />
        {step.timeEstimate && (
          <p class="pstep__when r-tag">
            <small>How long</small>
            <strong>{step.timeEstimate}</strong>
          </p>
        )}
      </div>

      <h2 class="pstep__title" id={id ? `${id}-title` : undefined}>
        <span class="sr-only">Step {n}: </span>
        {step.title}
      </h2>

      <div class:list={['pstep__cols', features.length > 0 && 'pstep__cols--chip']}>
        <div class="pstep__copy">
          {step.shortDescription && <p class="pstep__lede">{step.shortDescription}</p>}
          {step.fullDescription && (
            <div class="pstep__body">
              <PortableText value={step.fullDescription} />
            </div>
          )}
        </div>

        {(features.length > 0 || step.tierNote) && (
          <aside class="pstep__side" aria-label={`${step.title ?? 'Step'} at a glance`}>
            {features.length > 0 && (
              <div class="pstep__chip" style={`--chip: var(--color-chip-${tone})`}>
                <p class="pstep__chip-h">At a glance</p>
                <ul class="pstep__feats" role="list">
                  {features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            )}
            {step.tierNote && <p class="pstep__tier">{step.tierNote}</p>}
          </aside>
        )}
      </div>
    </article>
  ) : (
    <article class="pstep-mini">
      <h3 class="r-h3">{step.title}</h3>
      {step.timeEstimate && <p class="pstep-mini__when">{step.timeEstimate}</p>}
      {step.shortDescription && <p class="pstep-mini__desc">{step.shortDescription}</p>}
      {step.tierNote && <p class="pstep-mini__desc">{step.tierNote}</p>}
    </article>
  )
}

<style>
  /* ---- Full step ---- */
  .pstep {
    position: relative;
    scroll-margin-top: 7rem;
  }
  .pstep__top {
    display: flex;
    align-items: flex-end;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  .pstep__num {
    font: 300 clamp(4.75rem, 3rem + 7vw, 9.5rem) / 0.8 var(--font-display);
    letter-spacing: -0.05em;
    /* Warm Bronze as DISPLAY type only (DESIGN.md): no body text on it. */
    color: var(--color-chip-5);
    font-variant-numeric: lining-nums;
  }
  .pstep :global(.pstep__ill) {
    flex: none;
    color: var(--color-chip-6);
    margin-bottom: 0.2rem;
  }
  .pstep__when {
    margin: 0 0 0.35rem auto;
    flex: none;
  }
  .pstep__title {
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    max-width: 16ch;
    font: 300 clamp(2.2rem, 1.5rem + 2.6vw, 3.9rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .pstep__cols {
    display: grid;
    gap: 2rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .pstep__lede {
    margin: 0;
    max-width: 30ch;
    font: 300 clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem) / 1.3 var(--font-display);
    letter-spacing: -0.012em;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .pstep__body {
    max-width: 60ch;
    margin-top: 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .pstep__body :global(p) {
    margin: 0;
  }
  .pstep__body :global(p + p),
  .pstep__body :global(ul),
  .pstep__body :global(ol) {
    margin-top: 0.9em;
  }
  .pstep__body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* "At a glance": a paint chip with a punched hole, tone set per step. */
  .pstep__chip {
    position: relative;
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--chip, var(--color-chip-1));
    color: var(--color-ink);
    border-radius: 3px;
    box-shadow: 0 18px 30px -24px rgb(35 30 27 / 0.55);
  }
  .pstep__chip::before {
    content: '';
    position: absolute;
    right: 1.1rem;
    top: 1.1rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: inset 0 1px 2px rgb(35 30 27 / 0.3);
  }
  .pstep__chip-h {
    margin: 0 0 0.8rem;
    font: 500 0.85rem/1.3 var(--font-body);
    color: var(--color-ink);
  }
  .pstep__feats {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pstep__feats li {
    padding: 0.55rem 0;
    border-top: 1px solid rgb(35 30 27 / 0.16);
    font: 400 1.08rem/1.35 var(--font-display);
    letter-spacing: -0.005em;
  }
  .pstep__tier {
    margin: 1rem 0 0;
    /* Plain italic note; the copy starts with its own asterisk. No side stripe. */
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  @media (min-width: 768px) {
    .pstep__cols--chip {
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem);
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
  }
  @media (max-width: 479px) {
    .pstep__top {
      flex-wrap: wrap;
    }
    .pstep :global(.pstep__ill) {
      width: 48px;
      height: 48px;
    }
  }

  /* The line drawing draws itself as the step scrolls in (CSS only). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pstep :global(.pstep__ill) :global(:is(path, rect)) {
        stroke-dasharray: 1;
        animation: pstep-draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 40%;
      }
      .pstep__num {
        animation: pstep-num linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
  }
  @keyframes pstep-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pstep-num {
    from {
      transform: translateY(0.18em);
    }
  }

  /* ---- Compact (legacy preview) ---- */
  .pstep-mini__when {
    margin: 0.4rem 0 0;
    font: 500 0.85rem/1.3 var(--font-body);
    color: var(--color-chip-7);
  }
  .pstep-mini__desc {
    margin: 0.6rem 0 0;
    max-width: 40ch;
    color: var(--color-ink-2);
  }
</style>
