---
// Safe to edit by hand
// One service on the Services page (rebuilt 2026-09-30, phase 2 of the
// art-direction rebuild; see DESIGN.md "Services and E-Design").
//
// Each service is one CHIP of a single paint strip that runs down the left of
// the list, palest first, deepest last (ServicesList.astro stacks the rows so
// the chips touch). The chip carries the name and the price, big (no "No. 01"
// label: the strip order carries the sequence).
// To its right: the short description, the features, "best for" as a sample
// tag, and the button.
//
//   Desktop: [ chip | details ], chips continuous down the page.
//   Phone:   chip on top (name + price), details below.
//
// ANCHORS: the article keeps id={slug} so /services#in-home-consultation (the
// home paint chips, the JSON-LD, the deck index) lands on it. Keep it.
//
// Data: the `service` document fields as before (name, slug, price,
// shortDescription, features, bestFor, ctaLabel, badge). featuredImage is
// accepted but not drawn: the chip is the image. Since the 2026-09-30 design
// pass the chip carries one of Staci's finished rooms faded into its paint
// (RoomBackdrop; src/data/room-backdrops.ts says which).
//
// Prices are free text in Sanity ("$225", "starting at $995", "$100 per
// hour", "Custom"). chipPrice() splits them stega-safely (split-copy.ts).
import { chipPrice, toneFor } from '@/components/services/tones';
import RoomBackdrop from '@/components/RoomBackdrop.astro';

interface SanityImageObject {
  asset?: { _ref?: string; _id?: string };
  alt?: string;
}

interface Props {
  service: {
    name?: string;
    slug?: { current?: string };
    price?: string;
    shortDescription?: string;
    features?: string[];
    bestFor?: string;
    ctaLabel?: string;
    badge?: string;
    featuredImage?: SanityImageObject | null;
  };
  /** When true, render an anchor id from the slug so /services#slug deep-links. */
  withAnchor?: boolean;
  /** Condensed: first four features, no "best for". */
  compact?: boolean;
  /** Position in the strip and its length, for the tone. */
  index?: number;
  total?: number;
  /** Where the button goes. */
  href?: string;
  /** Optional quieter link beside the button (the E-Design overview). */
  secondary?: { href: string; label: string } | null;
}

const {
  service,
  withAnchor = false,
  compact = false,
  index = 0,
  total = 1,
  href = '/contact/',
  secondary = null,
} = Astro.props as Props;

const id = withAnchor && service.slug?.current ? service.slug.current : undefined;
const features = service.features ?? [];
const visibleFeatures = compact ? features.slice(0, 4) : features;
const ctaLabel = service.ctaLabel ?? 'Start a conversation';
const badge = service.badge?.trim();
const tone = toneFor(index, total);
const price = chipPrice(service.price);
const headingId = id ? `${id}-name` : undefined;
---

<article
  id={id}
  class:list={['svc', badge && 'svc--featured']}
  style={`--tone:${tone.bg}`}
  data-on={tone.on}
  aria-labelledby={headingId}
>
  <div class="svc__chip r-backdrop-host">
    <RoomBackdrop
      index={index}
      start={2}
      ratio={0.75}
      tone={tone.on === 'cream' ? 'deep' : 'pale'}
    />
    {
      /* No "No. 01" label (2026-09-30): the strip's order and the tone ramp
         already carry the sequence. The top row now only holds the badge. */
    }
    <div class="svc__top">{badge && <span class="svc__flag">{badge}</span>}</div>
    <h3 class="svc__name" id={headingId}>{service.name}</h3>
    {
      service.price && (
        <p class="svc__price">
          {price.label && <small>{price.label}</small>}
          <span class="svc__amount">
            {price.amount}
            {price.run}
            {price.unit && <span class="svc__unit">{price.unit}</span>}
          </span>
        </p>
      )
    }
  </div>

  <div class="svc__body">
    {service.shortDescription && <p class="svc__desc">{service.shortDescription}</p>}

    {
      visibleFeatures.length > 0 && (
        <ul class="svc__features" aria-label={`What ${service.name ?? 'this'} includes`}>
          {visibleFeatures.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      )
    }

    <div class="svc__foot">
      {
        !compact && service.bestFor && (
          <p class="r-tag svc__tag">
            <small>Best for</small>
            <strong>{service.bestFor}</strong>
          </p>
        )
      }
      <div class="svc__ctas">
        <a class="r-btn r-btn--ink" href={href}>
          {ctaLabel}
          <span class="r-arrow" aria-hidden="true"> → </span>
        </a>
        {
          secondary && (
            <a class="r-link" href={secondary.href}>
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .svc {
    display: grid;
    grid-template-columns: minmax(17rem, 25rem) minmax(0, 1fr);
    scroll-margin-top: 6rem;
  }

  /* ---- The chip: one tone of the strip. ---- */
  .svc__chip {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.6rem 1.75rem 1.75rem;
    background: var(--tone);
    color: var(--color-ink);
    /* The thin paper line between two chips on a real strip. */
    box-shadow: inset 0 -1px 0 rgb(255 253 250 / 0.55);
  }
  .svc[data-on='cream'] .svc__chip {
    color: var(--color-cream);
  }
  .svc__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 1.6rem;
  }
  .svc__flag {
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-cream);
    font: 500 0.75rem/1 var(--font-body);
  }
  .svc[data-on='cream'] .svc__flag {
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .svc__name {
    margin: 0;
    max-width: 14ch;
    font: 300 clamp(1.75rem, 1.2rem + 1.3vw, 2.55rem) / 1.02 var(--font-display);
    letter-spacing: -0.025em;
    color: inherit;
    text-wrap: balance;
  }
  .svc__price {
    margin: auto 0 0;
    padding-top: 1.5rem;
  }
  .svc__price small {
    display: block;
    margin-bottom: 0.45rem;
    font: 500 0.82rem/1.2 var(--font-body);
  }
  .svc__amount {
    display: block;
    font: 300 clamp(3rem, 2rem + 3vw, 5.25rem) / 0.9 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
  }
  .svc__unit {
    font-size: 0.42em;
    letter-spacing: -0.01em;
  }

  /* ---- The details beside it. ---- */
  .svc__body {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding: 2.4rem 0 2.6rem clamp(2rem, 4.5vw, 4.5rem);
    border-bottom: 1px solid var(--color-rule);
  }
  .svc__desc {
    margin: 0;
    max-width: 48ch;
    font: 300 clamp(1.25rem, 1.05rem + 0.55vw, 1.6rem) / 1.35 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .svc__features {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 16rem;
    column-gap: 2.5rem;
    color: var(--color-ink-2);
    font-size: 0.97rem;
    line-height: 1.45;
  }
  .svc__features li {
    display: flex;
    gap: 0.7rem;
    padding-block: 0.3rem;
    break-inside: avoid;
  }
  /* A swatch of the row's own tone as the bullet, so each list is keyed to
     its chip. The ring keeps the pale tones visible on paper. */
  .svc__features li::before {
    content: '';
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.42em;
    background: var(--tone);
    box-shadow: inset 0 0 0 1px rgb(35 30 27 / 0.28);
  }
  .svc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: auto;
  }
  .svc__tag {
    max-width: 30rem;
    margin: 0;
  }
  .svc__tag strong {
    font-size: 1rem;
    line-height: 1.3;
  }
  .svc__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  /* The badged service is pulled a little out of the deck, like the chip
     someone is holding up to the wall. Desktop only. */
  @media (min-width: 900px) {
    .svc--featured .svc__chip {
      z-index: 1;
      margin-left: -1.25rem;
      box-shadow: 0 30px 44px -30px rgb(35 30 27 / 0.65);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Arriving from the deck index or a home chip: the chip slides out of the
       strip and back, so the eye lands on the right one. */
    .svc:target .svc__chip {
      animation: svc-pull 1.4s cubic-bezier(0.23, 1, 0.32, 1) 0.2s;
    }
  }
  @keyframes svc-pull {
    40% {
      transform: translateX(-1.1rem);
      box-shadow: 0 30px 44px -26px rgb(35 30 27 / 0.7);
    }
  }

  /* ---- Phone and small tablet: chip on top, details below. ---- */
  @media (max-width: 899px) {
    .svc {
      grid-template-columns: minmax(0, 1fr);
    }
    .svc__chip {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'top top'
        'name price';
      align-items: end;
      gap: 1rem 1.25rem;
      padding: 1.25rem 1.25rem 1.4rem;
      box-shadow: none;
    }
    .svc__top {
      grid-area: top;
    }
    .svc__name {
      grid-area: name;
      font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.1rem);
    }
    .svc__price {
      grid-area: price;
      padding-top: 0;
      text-align: right;
    }
    .svc__price small {
      font-size: 0.78rem;
    }
    .svc__amount {
      font-size: clamp(2.3rem, 1.6rem + 3vw, 3.2rem);
    }
    .svc__body {
      padding: 1.6rem 0 3rem;
      border-bottom: 0;
    }
    .svc__features {
      columns: 1;
    }
  }
</style>
