---
// Safe to edit by hand
// Line drawings for the Process steps (restyled 2026-09-30, phase 2): quiet
// single-stroke objects from the job, drawn in the current text colour so
// the caller picks the tone (the Process page sets Walnut). Four variants
// keyed by stepNumber (1-4); any other step number renders nothing, and the
// layout simply goes without.
//
// Inline SVG, no external deps, zero cost on the performance budget, easy to
// swap if Staci ever commissions hand-drawn ones. Decorative: aria-hidden.
//
// Every stroke carries pathLength="1" so a caller can animate a stroke-dash
// "draw" on scroll (the Process page does, reduced-motion safe). Without that
// CSS the drawing is simply fully drawn.

interface Props {
  stepNumber?: number;
  /** Optional decorative class override. */
  class?: string;
  /** Rendered size in px (square). */
  size?: number;
}

const { stepNumber, class: className = '', size = 48 } = Astro.props as Props;
const svgProps = {
  xmlns: 'http://www.w3.org/2000/svg',
  viewBox: '0 0 48 48',
  width: size,
  height: size,
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.25,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  focusable: 'false',
} as const;
---

{
  stepNumber === 1 && (
    <svg {...svgProps} class:list={['block', className]}>
      {/* Step 1, the consultation: a notebook with a coffee cup beside it. */}
      <rect x="6" y="16" width="22" height="22" rx="2" pathLength="1" />
      <path d="M10 22 H24" pathLength="1" />
      <path d="M10 28 H24" pathLength="1" />
      <path d="M10 34 H20" pathLength="1" />
      <path d="M32 22 H42 V32 a3 3 0 0 1 -3 3 H35 a3 3 0 0 1 -3 -3 V22Z" pathLength="1" />
      <path d="M42 24 H44 a2 2 0 0 1 2 2 v3 a2 2 0 0 1 -2 2 H42" pathLength="1" />
      <path d="M36 12 c 0 2 -2 2 -2 4 s 2 2 2 4" pathLength="1" />
      <path d="M40 11 c 0 2 -2 2 -2 4 s 2 2 2 4" pathLength="1" />
    </svg>
  )
}

{
  stepNumber === 2 && (
    <svg {...svgProps} class:list={['block', className]}>
      {/* Step 2, the plan: a sample board with tiles and a swatch. */}
      <rect x="5" y="8" width="38" height="32" rx="1.5" pathLength="1" />
      <rect x="9" y="12" width="12" height="10" rx="1" pathLength="1" />
      <rect x="23" y="12" width="16" height="14" rx="1" pathLength="1" />
      <rect x="9" y="26" width="10" height="10" rx="1" pathLength="1" />
      <rect x="23" y="30" width="16" height="6" rx="1" pathLength="1" />
      <path d="M30 14 L37 14" pathLength="1" />
      <path d="M30 18 L37 18" pathLength="1" />
    </svg>
  )
}

{
  stepNumber === 3 && (
    <svg {...svgProps} class:list={['block', className]}>
      {/* Step 3, shopping: a bag with a hang tag. */}
      <path d="M11 18 H37 V40 a2 2 0 0 1 -2 2 H13 a2 2 0 0 1 -2 -2 V18Z" pathLength="1" />
      <path d="M17 18 V14 a7 7 0 0 1 14 0 V18" pathLength="1" />
      <path d="M22 24 L26 28 L34 28 L34 34 L26 34 L22 30 Z" pathLength="1" />
      <circle cx="24" cy="26" r="0.9" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  stepNumber === 4 && (
    <svg {...svgProps} class:list={['block', className]}>
      {/* Step 4, the reveal: a room with a sofa and a lamp. */}
      <path d="M6 14 L24 6 L42 14" pathLength="1" />
      <path d="M9 14 V40 H39 V14" pathLength="1" />
      <path d="M14 32 H34 V38 H14 Z" pathLength="1" />
      <path d="M14 32 V28 a2 2 0 0 1 2 -2 H32 a2 2 0 0 1 2 2 V32" pathLength="1" />
      <path d="M38 16 L36 22 L40 22 Z" pathLength="1" />
      <path d="M38 22 V32" pathLength="1" />
    </svg>
  )
}
