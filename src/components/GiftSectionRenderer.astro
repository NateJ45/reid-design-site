---
// Foundation, edit with care
// Renders the Gift Certificates page's reorderable content sections from its
// `pageBuilder` layout array of giftSectionMarker blocks. Markup is verbatim from
// the original gift-certificates.astro. Hero, the coming-soon state, and the
// closing CTA stay in gift-certificates.astro. Inserted general blocks delegate
// to SectionRenderer.
import SectionHeading from '@/components/SectionHeading.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  sections?: any[];
  page: any;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};
const CONTACT_HREF = '/contact?type=gift-certificate';
const ctaLabel = page?.ctaLabel ?? 'Inquire about a Gift Certificate';

const DEFAULT_ORDER = ['intro', 'options', 'howItWorks', 'finePrint'].map((section) => ({
  _type: 'giftSectionMarker',
  section,
}));

const list = (sections ?? []).filter((s) => s && s._type);
const rows = list.length > 0 ? list : DEFAULT_ORDER;
---

{
  rows.map((s: any, i: number) => (
    <Wrap {...wrapAttrs(s._key)}>
      {s._type === 'giftSectionMarker' ? (
        s.section === 'intro' ? (
          page.intro ? (
            <section class="bg-background" aria-labelledby="gift-intro-heading">
              <div class="mx-auto max-w-content px-m py-section-lg">
                <div class="mx-auto max-w-3xl">
                  <SectionHeading
                    eyebrow="The Gift."
                    headline="Give Something That Changes a Room."
                    headingId="gift-intro-heading"
                  />
                  <p class="mt-l text-lg leading-relaxed text-foreground/85">{page.intro}</p>
                </div>
              </div>
            </section>
          ) : null
        ) : s.section === 'options' ? (
          page.options && page.options.length > 0 ? (
            <section class="surface-warm bg-muted" aria-labelledby="gift-options-heading">
              <div class="mx-auto max-w-content px-m py-section-lg">
                <SectionHeading
                  eyebrow="The Options."
                  headline="Certificate Amounts."
                  headingId="gift-options-heading"
                  align="center"
                  class="mx-auto"
                />
                <div class="mt-section-lg grid grid-cols-1 gap-l sm:grid-cols-2 lg:grid-cols-3">
                  {page.options.map((option: any) => (
                    <article class="card-lift relative flex flex-col overflow-hidden rounded-md border border-border-soft bg-card text-card-foreground shadow-[0_4px_18px_-14px_rgba(61,61,61,0.18)] transition-colors hover:border-primary/40">
                      <div class="h-0.5 bg-primary" aria-hidden="true" />
                      <div class="flex flex-1 flex-col p-l">
                        <p class="font-mono text-sm tracking-eyebrow text-link uppercase">
                          {option.amount}
                        </p>
                        <h3 class="mt-xs font-display text-h3 text-foreground">{option.label}</h3>
                        {option.blurb && (
                          <p class="mt-m text-base leading-relaxed text-foreground/80">
                            {option.blurb}
                          </p>
                        )}
                        <div class="mt-l flex flex-1 items-end pt-m">
                          <a
                            href={CONTACT_HREF}
                            class="inline-flex min-h-[44px] items-center py-s text-xs font-semibold tracking-eyebrow text-link uppercase transition-colors hover:text-primary-dark"
                          >
                            {ctaLabel}{' '}
                            <span aria-hidden="true" class="ml-xs">
                              →
                            </span>
                          </a>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          ) : null
        ) : s.section === 'howItWorks' ? (
          page.howItWorks && page.howItWorks.length > 0 ? (
            <section class="bg-background" aria-labelledby="gift-how-heading">
              <div class="mx-auto max-w-content px-m py-section-lg">
                <div class="mx-auto max-w-3xl">
                  <SectionHeading
                    eyebrow="The Process."
                    headline="How It Works."
                    headingId="gift-how-heading"
                  />
                  <ol class="mt-l list-none space-y-l p-0">
                    {page.howItWorks.map((step: any) => (
                      <li class="flex items-start gap-l">
                        <span
                          class="w-10 shrink-0 text-right font-mono text-3xl leading-none font-bold text-primary-dark"
                          aria-hidden="true"
                        >
                          {String(step.stepNumber).padStart(2, '0')}
                        </span>
                        <div>
                          <h3 class="font-display text-h3 text-foreground">{step.title}</h3>
                          {step.body && (
                            <p class="mt-xs leading-relaxed text-foreground/80">{step.body}</p>
                          )}
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            </section>
          ) : null
        ) : s.section === 'finePrint' ? (
          page.finePrint ? (
            <section class="bg-muted" aria-label="Terms and conditions">
              <div class="mx-auto max-w-content px-m py-m">
                <p class="mx-auto max-w-3xl text-center text-xs leading-relaxed text-muted-foreground">
                  {page.finePrint}
                </p>
              </div>
            </section>
          ) : null
        ) : null
      ) : (
        <SectionRenderer sections={[s]} idPrefix={`gift-extra-${i}`} />
      )}
    </Wrap>
  ))
}
