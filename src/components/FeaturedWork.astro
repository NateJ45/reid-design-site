---
// Safe to edit by hand
// Home page "recent work" (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; see DESIGN.md "Blocks and Portfolio"). Hidden today: it renders
// nothing until the first `project` document exists, and the portfolio itself
// is switched off in Sanity until then.
//
// Layout, in the home page's grammar (PaintChips / HomeStaci):
//   - The head: the headline rising in Zodiak on the left, the subhead right.
//   - The lead project large on the left: a framed crop with the room tied on
//     as a sample tag, then the title, one plain line, the brief summary.
//   - Up to three more on the right as a ruled list, a small square crop
//     beside each title.
//   - Phone: everything stacks, lead first.
// No dark gradient over photos, no stripes, no card chrome.
//
// Data is auto-populated by the home page query: featured-then-newest, capped
// at 4. Staci pins one via the `featured` boolean on the project doc.
import SanityImage from '@/components/SanityImage.astro';
import RiseWords from '@/components/RiseWords.astro';
import CtaLink from '@/components/CtaLink.astro';
import { humanizeEnum } from '@/components/portfolio/labels';

interface ProjectLite {
  _id?: string;
  title?: string;
  slug?: { current?: string };
  location?: string;
  year?: number;
  roomType?: string;
  briefSummary?: string;
  heroImage?: any;
  featured?: boolean;
}

interface Props {
  projects?: ProjectLite[];
  /** Accepted for compatibility; the rebuild prints no eyebrow above sections. */
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  cta?: any;
  headingId?: string;
}

const {
  projects = [],
  headline = 'Recent work',
  subhead,
  cta,
  headingId = 'featured-work-heading',
} = Astro.props as Props;

const list = Array.isArray(projects) ? projects.filter((p) => p?.title) : [];
const [lead, ...rest] = list;
const more = rest.slice(0, 3);
const hrefFor = (p?: ProjectLite) => (p?.slug?.current ? `/portfolio/${p.slug.current}/` : '#');
const lineFor = (p?: ProjectLite) => [p?.location, p?.year].filter(Boolean).join(' · ');
const leadRoom = humanizeEnum(lead?.roomType);
---

{
  lead && (
    <section class="fw" aria-labelledby={headingId}>
      <div class="r-wrap">
        <div class="fw__head">
          <RiseWords as="h2" id={headingId} text={headline ?? ''} class="r-h2" />
          {subhead && <p class="r-lede fw__sub">{subhead}</p>}
        </div>

        <div class:list={['fw__grid', more.length > 0 && 'fw__grid--split']}>
          <a href={hrefFor(lead)} class="fw__lead">
            <div class="fw__frame">
              {lead.heroImage?.asset ? (
                <SanityImage
                  source={lead.heroImage}
                  width={1100}
                  height={1375}
                  sizes="(min-width: 1024px) 55vw, 100vw"
                  class="fw__img"
                />
              ) : (
                <div class="fw__blank" aria-hidden="true" />
              )}
              {leadRoom && (
                <span class="r-tag fw__tag">
                  {lead.featured && <small>Featured</small>}
                  <strong>{leadRoom}</strong>
                </span>
              )}
            </div>
            <h3 class="fw__title">
              <span>{lead.title}</span>
            </h3>
            {lineFor(lead) && <p class="fw__line">{lineFor(lead)}</p>}
            {lead.briefSummary && <p class="fw__brief">{lead.briefSummary}</p>}
          </a>

          {more.length > 0 && (
            <ul class="fw__more">
              {more.map((p) => (
                <li>
                  <a href={hrefFor(p)} class="fw__row">
                    <div class="fw__thumb">
                      {p.heroImage?.asset && (
                        <SanityImage
                          source={p.heroImage}
                          width={400}
                          height={400}
                          sizes="(min-width: 1024px) 9rem, 7rem"
                          class="fw__img"
                        />
                      )}
                    </div>
                    <div class="fw__row-copy">
                      {p.roomType && <p class="fw__room">{humanizeEnum(p.roomType)}</p>}
                      <h3 class="fw__row-title">
                        <span>{p.title}</span>
                      </h3>
                      {lineFor(p) && <p class="fw__line">{lineFor(p)}</p>}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="fw__foot">
          <CtaLink
            cta={cta}
            variant="secondary"
            fallbackHref="/portfolio/"
            fallbackLabel="See all the work"
          />
        </div>
      </div>
    </section>
  )
}

<style>
  .fw {
    background: var(--color-bg);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .fw__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .fw__head :global(.r-h2) {
    grid-column: 1 / 8;
    margin: 0;
  }
  .fw__sub {
    grid-column: 9 / 13;
    margin: 0;
  }

  .fw__grid {
    display: grid;
    gap: 3rem;
  }
  .fw__lead,
  .fw__row {
    display: block;
    color: var(--color-ink);
    text-decoration: none;
  }
  .fw__lead:focus-visible,
  .fw__row:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 6px;
  }
  .fw__frame {
    position: relative;
    overflow: clip;
    background: var(--color-chip-1);
  }
  .fw__frame :global(.fw__img),
  .fw__thumb :global(.fw__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .fw__frame :global(.fw__img) {
    aspect-ratio: 4 / 5;
  }
  .fw__lead:hover :global(.fw__img),
  .fw__row:hover :global(.fw__img) {
    transform: scale(1.04);
  }
  .fw__blank {
    aspect-ratio: 4 / 5;
  }
  .fw__tag {
    position: absolute;
    left: 1rem;
    bottom: 1.25rem;
  }
  .fw__title {
    margin: 1.25rem 0 0;
    font: 300 clamp(1.8rem, 1.2rem + 1.9vw, 3rem) / 1.05 var(--font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .fw__title span,
  .fw__row-title span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .fw__lead:hover .fw__title span,
  .fw__row:hover .fw__row-title span {
    background-size: 100% 1px;
  }
  .fw__line {
    margin: 0.5rem 0 0;
    font: 500 0.92rem/1.4 var(--font-body);
    color: var(--color-chip-7);
  }
  .fw__brief {
    margin: 0.75rem 0 0;
    max-width: 46ch;
    color: var(--color-ink-2);
  }

  .fw__more {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }
  .fw__more li {
    border-bottom: 1px solid var(--color-rule);
  }
  .fw__row {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.25rem;
  }
  .fw__thumb {
    flex: none;
    width: 7rem;
    aspect-ratio: 1;
    overflow: clip;
    background: var(--color-chip-1);
  }
  .fw__row-copy {
    min-width: 0;
  }
  .fw__room {
    margin: 0 0 0.35rem;
    font: 500 0.88rem/1.3 var(--font-body);
    color: var(--color-chip-7);
  }
  .fw__row-title {
    margin: 0;
    font: 300 clamp(1.3rem, 1.1rem + 0.6vw, 1.65rem) / 1.12 var(--font-display);
    letter-spacing: -0.02em;
  }
  .fw__foot {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  @media (min-width: 1024px) {
    .fw__grid--split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
    .fw__grid:not(.fw__grid--split) .fw__lead {
      max-width: 40rem;
    }
    .fw__grid--split .fw__more {
      margin-top: 0;
    }
    .fw__thumb {
      width: 9rem;
    }
  }
  @media (max-width: 1023px) {
    .fw__head {
      display: block;
    }
    .fw__sub {
      margin-top: 1rem;
    }
  }
</style>
