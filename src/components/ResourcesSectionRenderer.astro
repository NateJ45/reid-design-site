---
// Foundation, edit with care
// Renders the Resources page from its `pageBuilder` layout array of
// resourcesSectionMarker blocks. Inserted general blocks delegate to
// SectionRenderer. Falls back to the default order when empty.
import Hero from '@/components/Hero.astro';
import ResourcesIntro from '@/components/sections/ResourcesIntro.astro';
import ResourcesCards from '@/components/sections/ResourcesCards.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  sections?: any[];
  page: any;
  visible: any;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, visible, editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};

const DEFAULT_ORDER = ['hero', 'intro', 'cards'].map((section) => ({
  _type: 'resourcesSectionMarker',
  section,
}));

const list = (sections ?? []).filter((s) => s && s._type);
const rows = list.length > 0 ? list : DEFAULT_ORDER;
---

{
  rows.map((s: any, i: number) => (
    <Wrap {...wrapAttrs(s._key)}>
      {s._type === 'resourcesSectionMarker' ? (
        s.section === 'hero' ? (
          <Hero
            eyebrow={page?.heroEyebrow ?? 'Free tools + guides'}
            headline={page?.heroHeadline ?? 'Start here before you call'}
            subhead={
              page?.heroSubhead ??
              'Everything you need to walk into that first conversation knowing what you want and what to expect.'
            }
            backgroundImage={page?.heroImage ?? null}
            headingId="resources-hero-heading"
            size="short"
            scriptAccent={page?.heroScriptAccent ?? undefined}
          />
        ) : s.section === 'intro' ? (
          <ResourcesIntro intro={page?.intro} />
        ) : s.section === 'cards' ? (
          <ResourcesCards sanityCards={page?.cards} visible={visible} />
        ) : null
      ) : (
        <SectionRenderer sections={[s]} idPrefix={`resources-extra-${i}`} />
      )}
    </Wrap>
  ))
}
