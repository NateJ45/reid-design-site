---
// Safe to edit by hand
// Page hero. Two shapes:
//   1) "image" hero (home, optionally Process/Services if Staci ever adds a hero photo)
//      — full-bleed Sanity background image with a dark scrim, h1 + subhead + CTAs overlay.
//   2) "text" hero (About, Contact, FAQ, Process by default)
//      — clean editorial heading on Soft Linen with eyebrow + headline + subhead.
//
// The image hero is the LCP element on the homepage. SanityImage is set to loading="eager"
// in that case and the headline uses font-display (Cormorant Garamond), which BaseLayout
// preloads inline. Don't add layout-shift animations to this section.

import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

interface SanityImageObject {
  asset?: { _ref?: string; _id?: string };
  alt?: string;
  hotspot?: { x: number; y: number; height: number; width: number };
  crop?: { top: number; bottom: number; left: number; right: number };
}

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  backgroundImage?: SanityImageObject | null;
  primaryCta?: CtaBlock | null;
  secondaryCta?: CtaBlock | null;
  headingId: string;
  /** "tall" = ~85vh on desktop (homepage), "short" = generous but not full screen (interior pages). */
  size?: 'tall' | 'short';
}

const {
  eyebrow,
  headline,
  subhead,
  backgroundImage,
  primaryCta,
  secondaryCta,
  headingId,
  size = 'short',
} = Astro.props as Props;

const hasImage = !!backgroundImage?.asset;

const wrapperHeight =
  size === 'tall'
    ? 'min-h-[78svh] md:min-h-[85svh]'
    : 'min-h-[42svh] md:min-h-[52svh]';
---

{hasImage ? (
  <section
    class:list={['relative overflow-hidden bg-accent-dark text-bg', wrapperHeight]}
    aria-labelledby={headingId}
  >
    {/* Background image — eager loaded; the dark scrim ensures contrast on any photo. */}
    <SanityImage
      source={backgroundImage}
      width={2400}
      sizes="100vw"
      loading="eager"
      quality={70}
      class="absolute inset-0 w-full h-full object-cover"
    />
    {/* Scrim: bottom-weighted vertical gradient so text in the lower-half reads on any image. */}
    <div
      class="absolute inset-0 bg-gradient-to-t from-accent-dark/85 via-accent-dark/35 to-accent-dark/15"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-content px-m h-full flex items-end pb-section-lg pt-section-md">
      <div class="max-w-3xl">
        {eyebrow && (
          <p class="text-xs uppercase tracking-eyebrow text-bg/80 mb-s">{eyebrow}</p>
        )}
        <h1 id={headingId} class="font-display text-h1 leading-headline-tight tracking-[-0.02em] text-bg">
          {headline}
        </h1>
        {subhead && (
          <p class="mt-m max-w-2xl text-lg text-bg/85">{subhead}</p>
        )}
        {(primaryCta || secondaryCta) && (
          <div class="mt-l flex flex-wrap gap-s">
            {primaryCta && <CtaLink cta={primaryCta} variant="primary" />}
            {secondaryCta && (
              <CtaLink
                cta={secondaryCta}
                variant="secondary"
                class="text-bg border-bg/70 hover:bg-bg/10"
              />
            )}
          </div>
        )}
      </div>
    </div>
  </section>
) : (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class:list={['mx-auto max-w-content px-m py-section-lg flex items-end', wrapperHeight]}>
      <SectionHeading
        eyebrow={eyebrow}
        headline={headline}
        subhead={subhead}
        headingId={headingId}
        level="h1"
      />
    </div>
  </section>
)}
