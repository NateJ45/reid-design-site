---
// Foundation, edit with care
// Interior page hero (rebuilt 2026-09-30, phase 2 of the art-direction
// rebuild; see DESIGN.md). The HOME hero is home/HomeHero.astro, not this.
//
//   No image:   eyebrow line / HEADLINE (word rise) / subhead + CTAs, on linen.
//   With image: the same copy on the left, the photo on the right as a framed
//               crop (4:5), never full-bleed under a dark scrim. Wide phone
//               shots of rooms read far better cropped tight than stretched.
//
// Props are unchanged from the old hero so no page had to change. Dropped on
// purpose: the rotating first word and the full-viewport "tall" size (both
// home-only, and the home no longer uses this component); `backgroundImages`
// uses its FIRST image only (no slideshow on interior pages).
//
// Subhead: Staci can italicise a phrase with _underscores_ in Sanity; that
// still works and renders in Zodiak italic.
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import RiseWords from '@/components/RiseWords.astro';
import type { CtaBlock } from '@/lib/cta';

interface SanityImageObject {
  asset?: { _ref?: string; _id?: string };
  alt?: string;
  hotspot?: { x: number; y: number; height: number; width: number };
  crop?: { top: number; bottom: number; left: number; right: number };
}

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  backgroundImage?: SanityImageObject | null;
  backgroundImages?: SanityImageObject[] | null;
  primaryCta?: CtaBlock | null;
  secondaryCta?: CtaBlock | null;
  headingId: string;
  /** Page-builder hero block Height: tall fills the screen under the header. */
  size?: 'tall' | 'short';
  /** Accepted for compatibility; not used (home-only feature, retired). */
  rotatingWords?: string[];
  scriptAccent?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  backgroundImage,
  backgroundImages,
  primaryCta,
  secondaryCta,
  headingId,
  scriptAccent,
  size = 'short',
} = Astro.props as Props;

// The Studio layout card swaps these two classes in preview, so they are also
// listed in src/lib/section-fields.ts (LAYOUT_FIELDS.heroSection); the drift
// gate in section-fields.test.ts reads this exact line.
const wrapperHeight = size === 'tall' ? 'phero--tall' : 'phero--short';

const image =
  (Array.isArray(backgroundImages) ? backgroundImages : []).find((i) => i?.asset) ??
  (backgroundImage?.asset ? backgroundImage : null);

// _word_ markers -> italic spans. A stega run (preview) has no underscores, so
// it stays whole at the end of the last text part.
function parseSubhead(s?: string): Array<{ type: 'text' | 'em'; value: string }> {
  if (!s) return [];
  return s
    .split(/(_[^_]+_)/g)
    .map((part) =>
      part.startsWith('_') && part.endsWith('_') && part.length > 2
        ? { type: 'em' as const, value: part.slice(1, -1) }
        : { type: 'text' as const, value: part },
    );
}
const subheadParts = parseSubhead(subhead);
---

<section class:list={['phero', wrapperHeight, image && 'phero--image']} aria-labelledby={headingId}>
  <div class="r-wrap phero__grid">
    <div class="phero__copy">
      {eyebrow && <p class="phero__eyebrow">{eyebrow}</p>}
      <RiseWords as="h1" id={headingId} text={headline} accent={scriptAccent} class="phero__h1" />
      {
        subhead && (
          <p class="phero__sub r-lede">
            {subheadParts.map((part) =>
              part.type === 'em' ? <em class="phero__em">{part.value}</em> : part.value,
            )}
          </p>
        )
      }
      {
        (primaryCta || secondaryCta) && (
          <div class="phero__ctas">
            {primaryCta && <CtaLink cta={primaryCta} variant="primary" />}
            {secondaryCta && <CtaLink cta={secondaryCta} variant="secondary" />}
          </div>
        )
      }
    </div>
    {
      image && (
        <figure class="phero__photo r-frame">
          <div class="phero__clip">
            <SanityImage
              source={image}
              width={900}
              height={1125}
              sizes="(min-width: 1024px) 38vw, 100vw"
              loading="eager"
              fetchpriority="high"
              quality={70}
              class="phero__img"
            />
          </div>
        </figure>
      )
    }
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--color-rule);
  }
  /* Tall: fill the first screen under the sticky header, copy at the foot. */
  .phero--tall {
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - 5.5rem);
  }
  .phero--tall > .r-wrap {
    width: 100%;
  }
  .phero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  .phero--image .phero__grid {
    align-items: center;
  }
  .phero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.75rem;
    font: 500 0.95rem/1.35 var(--font-body);
    color: var(--color-chip-7);
  }
  .phero__eyebrow::before {
    content: '';
    flex: none;
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  :global(.phero__h1) {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-h1);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .phero__sub {
    margin: 1.75rem 0 0;
    max-width: 44ch;
  }
  .phero__em {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-chip-6);
  }
  .phero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }
  /* The photo hangs in the house frame (.r-frame: paper mat, bronze
     keyline, soft shadow; 2026-09-30 design pass). The inner clip keeps the
     settle zoom inside the mat. */
  .phero__photo {
    position: relative;
    margin: 0;
  }
  .phero__clip {
    overflow: clip;
  }
  .phero__photo :global(.phero__img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .phero__photo :global(.phero__img) {
      animation: phero-settle 2.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
  @keyframes phero-settle {
    from {
      transform: scale(1.08);
    }
  }
  @media (min-width: 1024px) {
    .phero--image .phero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
    .phero__photo :global(.phero__img) {
      max-height: 34rem;
    }
  }
  /* Phone and tablet: the SAME 4:5 shape the CDN cut around Staci's
     hotspot. It used to switch to 5:4 here, which re-cropped the 4:5 picture
     from its centre and kept barely a third of it (Nathan, 2026-09-30:
     "some barely show anything of value"). Capped so it never towers. */
  @media (max-width: 1023px) {
    .phero__photo {
      max-width: min(100%, 24rem);
    }
  }
</style>
