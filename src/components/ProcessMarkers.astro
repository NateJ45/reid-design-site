---
// Foundation, edit with care
// Process's marker map and the page's entry (refoundation phase C, 2026-10-28).
// Rendered WITHOUT `section` (as process.astro does) it draws the whole layout
// through MarkerPage.astro, handing itself over as the marker map; rendered
// WITH `section` (by MarkerPage) it draws that one built-in section, reading
// the unchanged processPage fields and collections. The order, the retired values and
// the auto-placed markers are MARKER_PAGES.process in src/lib/marker-pages.ts.
//
// STYLESHEET ORDER. Astro orders a page's stylesheets by walking the import
// graph (importers in path order, import positions summed), so three things
// keep every marker page's stylesheets exactly where the old ProcessSectionRenderer
// put them (`npm run parity compare`, phase C): this file sits in
// src/components/ beside where that renderer sat, its imports keep that
// renderer's order, and it imports SectionRenderer itself and hands it to
// MarkerPage as `renderer` (MarkerPage imports no component with CSS).
import Hero from '@/components/Hero.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import ProcessFaq from '@/components/sections/ProcessFaq.astro';
import FinalCta from '@/components/FinalCta.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import MarkerPage from '@/components/MarkerPage.astro';
import type { EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  /** Unset: the whole layout (via MarkerPage). Set: that one built-in section. */
  section?: string;
  /** The page's `pageBuilder` layout array (whole-layout mode). */
  sections?: any[];
  /** PREVIEW ONLY: the document the layout belongs to (MarkerPage). */
  editDoc?: EditDoc;
  page: any;
}

const { section, page } = Astro.props as Props;
---

{section === undefined ? (
  <MarkerPage kind="process" markers={Astro.self} renderer={SectionRenderer} {...Astro.props} />
) : section === 'hero' ? (
  <Hero
    eyebrow={page?.heroEyebrow ?? 'The Process.'}
    headline={page?.heroHeadline ?? 'From First Call to Final Reveal.'}
    subhead={page?.heroSubhead ?? ''}
    backgroundImage={page?.heroImage}
    headingId="process-hero-heading"
    size="short"
    scriptAccent={page?.heroScriptAccent}
  />
) : section === 'steps' ? (
  <ProcessSteps processSteps={page?.processSteps ?? []} />
) : section === 'faq' ? (
  <ProcessFaq
    eyebrow={page?.faqSectionEyebrow}
    headline={page?.faqSectionHeadline}
    faqs={page?.faqs ?? []}
  />
) : section === 'finalCta' ? (
  <FinalCta
    eyebrow={page?.finalCtaEyebrow}
    headline={page?.finalCtaHeadline}
    subhead={page?.finalCtaSubhead}
    cta={page?.finalCta}
    scriptAccent={page?.finalCtaScriptAccent}
    backgroundImage={page?.finalCtaBackgroundImage}
  />
) : null}
