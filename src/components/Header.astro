---
// Foundation, edit with care
// Site header: the "swatch book" chrome (rebuilt 2026-09-30 from the approved
// prototype docs/design/prototypes/chrome-a-swatch-book.html; DESIGN.md
// "Chrome").
//
//   At rest    no bar at all. Staci's logo sits straight on the page at the
//              left of the row (84px tall on desktop; the paper plate it
//              used to hang from was dropped in the 2026-09-30 design pass).
//              Nav on the right: hover, keyboard focus or the current
//              page raise a paint chip behind the label
//              (tones from the ramp, chips 1 to 3, ink text on every one).
//              Then the ink tag button: "Book a consultation" (no price on
//              it since 2026-10-01; the price lives on Services and Contact).
//   On hero    (2026-10-01, the home page only: Nathan's pick of
//              docs/design/prototypes/header-e-on-hero.html) at the top of
//              the page there is no bar at all. The header sits straight on
//              the Walnut home hero in cream: her cream logo, cream links, a
//              cream booking tag. The hero slides up under it (negative
//              margin), and HomeHero shades the top of the photo so the
//              cream reads. Scrolled, it becomes the paper strip below.
//              Off when Staci uploads her own logo (it cannot be recoloured)
//              or when the hero is not the first home section.
//   Her hand   a fine pen stroke draws itself under a link on hover/focus and
//              stays drawn under the page you are on (replaced the paint
//              chip that rose behind the label).
//   Ink in     on the first page of a visit the logo is revealed left to
//              right, like a pen going over it (~1.5s). Once per session
//              (sessionStorage), never under reduced motion.
//   Scrolled   the same row condenses into a floating paper strip with a
//              shadow. BaseLayout's scroll listener sets data-scrolled.
//              In the strip the full logo (too small to read at strip
//              height) gives way to the plain "REID DESIGN" wordmark
//              (2026-10-01, Nathan's ask): the logo shrinks and fades as
//              the wordmark is drawn in left to right, the same pen
//              reveal as the ink-in. Scrolling back to the top reverses it.
//   Phone      logo left (58px), the ink "Menu" price tag right,
//              which opens MobileNav's full-screen Walnut contents page.
//
// The availability pill and the search icon that used to sit here were
// removed with this rebuild (search is linked from the footer; the /search
// page is unchanged).
//
// SERVER-RENDERED on purpose (CLAUDE.md rule 4): real <a> tags and native
// <details> groups in the static HTML, crawlable, keyboard-usable, no CLS.
// The small script at the bottom only adds hover-open and outside-click /
// Escape close to the groups.
//
// The header's in-flow height never changes. The strip condenses INSIDE a
// fixed-height sticky box, so scrolling never reflows the page (no CLS).
//
// siteSettings is optional. Defaults render cleanly so the header works
// even before Sanity content is wired up.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import MobileNav from './MobileNav';
import SanityImage from './SanityImage.astro';
import RatingTag from '@/components/reviews/RatingTag.astro';
import { formatRating, googleRatingFrom, RATING_SOURCE } from '@/lib/reviews';
import { ChevronDown } from 'lucide-react';
import logoLightAsset from '@/assets/logo-light.png';
import logoDarkAsset from '@/assets/logo-dark.png';
import { getSectionVisibility, type SectionVisibility } from '@/lib/sectionVisibility';
import {
  resolveChrome,
  DEFAULT_CTA_HREF,
  DEFAULT_CTA_LABEL,
  type RawNavItem,
} from '@/lib/siteSettings';
import type { RawNavLink } from '@/lib/nav-href';

// Logo renditions. The source is 378x400. The header shows it 84px tall at
// rest (about 80px wide), so 122w/244w cover 1x/2x with room to spare; the scrolled strip and
// the phone header draw the same files smaller. The phone menu shows the
// cream logo 108px tall on ink (102w/204w).
const logo1x = await getImage({ src: logoLightAsset, format: 'webp', width: 122 });
const logo2x = await getImage({ src: logoLightAsset, format: 'webp', width: 244 });
const logoSrcset = `${logo1x.src} 1x, ${logo2x.src} 2x`;
const menuLogo1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 102 });
const menuLogo2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 204 });

interface Props {
  siteSettings?: {
    /** Google rating summary (Site settings > Reviews), for the header RatingTag. */
    googleRating?: number | null;
    googleReviewCount?: number | null;
    googleBusinessUrl?: string | null;
    googleWriteReviewUrl?: string | null;
    siteName?: string;
    title?: string;
    tagline?: string;
    primaryCtaLabel?: string;
    headerTagline?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    availabilityStatus?: string;
    /** Editor-supplied logo. When set it replaces the built-in logo. */
    logo?: { asset?: { _ref?: string; _id?: string }; alt?: string } | null;
    /** Chrome options (see src/lib/siteSettings.ts). All optional; empty keeps the built-ins. */
    navItems?: RawNavItem[] | null;
    headerCta?: {
      show?: boolean | null;
      label?: string | null;
      link?: RawNavLink | null;
    } | null;
    showEmail?: boolean | null;
    showSocials?: boolean | null;
    sectionVisibility?: {
      showPortfolio?: boolean | null;
      showEDesign?: boolean | null;
    } | null;
  } | null;
  navPages?: NavPage[];
  /**
   * Sit on the page's opening hero in cream, with no bar, until the page
   * scrolls (the home page passes this when its Walnut hero comes first).
   */
  overHero?: boolean;
}

interface NavPage {
  title?: string;
  slug?: string;
  navLabel?: string;
  addToMainNav?: boolean;
  navGroup?: 'top' | 'services' | 'resources';
  addToFooter?: boolean;
}

const { siteSettings, navPages, overHero = false } = Astro.props as Props;

// Normalize section visibility from siteSettings. Unset => visible.
const visible: SectionVisibility = getSectionVisibility(siteSettings?.sectionVisibility);
const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;

// Editor-managed chrome: the top menu, the header button, and the show/hide
// switches for the contact details. Every one of them is opt-in: an untouched
// Site settings document resolves to exactly the built-ins below.
const chrome = resolveChrome(siteSettings);

// The header button carries its label only. The consultation price used to
// ride on the tag ("Book a consult | $225"); Nathan took it off on 2026-10-01,
// so the header no longer reads the chrome facts at all. Staci's own label
// (Site settings) is used as written.
const ctaLabel = chrome.headerCta.label;
const ctaHref = chrome.headerCta.href;

// An editor-supplied logo replaces the built-in one.
const customLogo = siteSettings?.logo?.asset ? siteSettings.logo : null;
// The wordmark the scrolled strip shows in place of the logo: the brand name
// without a trailing "LLC" ("Reid Design"), set in capitals by CSS.
const wordmark = brandName.replace(/,?\s*LLC\.?$/i, '').trim();
// On the hero the logo is drawn in cream; an uploaded logo cannot be
// recoloured, so it keeps today's bar instead.
const onHero = overHero && !customLogo;
// The cream logo for the hero (same art as the phone menu's), same box size.
const heroLogo1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 122 });
const heroLogo2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 244 });

// Subset of siteSettings the phone menu needs. A plain object so the island
// doesn't serialize the whole Sanity document graph into its props.
const mobileNavSettings = siteSettings
  ? {
      email: siteSettings.email,
      phone: siteSettings.phone,
      primaryCtaLabel: siteSettings.primaryCtaLabel,
    }
  : null;

// MobileNav is a hydrated island (client:idle), so every prop it receives is
// serialized into the HTML. Pass only what differs from its own defaults.
const mobileCtaIsDefault =
  chrome.headerCta.show &&
  chrome.headerCta.href === DEFAULT_CTA_HREF &&
  chrome.headerCta.label === (siteSettings?.primaryCtaLabel ?? DEFAULT_CTA_LABEL);
// The Google rating line at the foot of the phone menu (2026-10-01), from the
// same Site settings fields as RatingTag; nothing when they are unset.
const ratingSummary = googleRatingFrom(siteSettings);
const mobileChrome = {
  ...(mobileCtaIsDefault ? {} : { cta: chrome.headerCta }),
  ...(chrome.showEmail ? {} : { showEmail: false }),
  ...(ratingSummary
    ? {
        rating: {
          value: formatRating(ratingSummary.rating),
          label: RATING_SOURCE,
        },
      }
    : {}),
};

// ---- The menu ---------------------------------------------------------------
// Flat items render as plain links; dropdown items as native <details> groups
// (desktop) and as rows in the phone menu's contents page.
//
// Built-in menu (2026-09-30, the swatch book): the logo is home, so there is
// no "Home" item, and the core pages are flat, in the prototype's order:
// Portfolio (when switched on), Services, Process, E-Design (when switched
// on), Staci's own top-level pages, About, then FAQ (or a Resources group).
// "Contact" is the price-tag button, not a menu item.
//
// Custom pages Staci placed "Under Services" turn Services back into a
// dropdown (Services, Process, E-Design and hers) so they have a home.
const customNav = (navPages ?? []).filter((p) => p.addToMainNav && p.slug);
const toNavItem = (p: NavPage) => ({ label: p.navLabel || p.title || 'Page', href: `/${p.slug}` });
const customTopItems = customNav.filter((p) => (p.navGroup ?? 'top') === 'top').map(toNavItem);
const customServicesItems = customNav.filter((p) => p.navGroup === 'services').map(toNavItem);
const customResourcesItems = customNav.filter((p) => p.navGroup === 'resources').map(toNavItem);

const coreServiceItems = [
  { label: 'Services', href: '/services' },
  { label: 'Process', href: '/process' },
  ...(visible.eDesign ? [{ label: 'E-Design', href: '/e-design' }] : []),
];
const servicesNavItems =
  customServicesItems.length > 0
    ? [
        {
          kind: 'dropdown' as const,
          label: 'Services',
          items: [...coreServiceItems, ...customServicesItems],
        },
      ]
    : coreServiceItems.map((it) => ({ kind: 'flat' as const, ...it }));

// Resources: FAQ, Before & After (follows the portfolio switch), and custom
// pages placed "Under Resources". A one-link group is a plain FAQ link.
const resourcesDropdownItems = [
  { label: 'FAQ', href: '/faq' },
  ...(visible.portfolio ? [{ label: 'Before & After', href: '/portfolio/before-after' }] : []),
  ...customResourcesItems,
];
const resourcesNavItems =
  resourcesDropdownItems.length > 1
    ? [{ kind: 'dropdown' as const, label: 'Resources', items: resourcesDropdownItems }]
    : resourcesDropdownItems.map((it) => ({ kind: 'flat' as const, ...it }));

const BUILT_IN_NAV_ITEMS = [
  ...(visible.portfolio ? [{ kind: 'flat' as const, label: 'Portfolio', href: '/portfolio' }] : []),
  ...servicesNavItems,
  ...customTopItems.map((it) => ({ kind: 'flat' as const, label: it.label, href: it.href })),
  { kind: 'flat' as const, label: 'About', href: '/about' },
  ...resourcesNavItems,
];

// Site settings -> Top menu links, when Staci has filled it in, replaces the
// whole computed menu above. Empty (the default) keeps the built-in one.
const NAV_ITEMS = chrome.navItems ?? BUILT_IN_NAV_ITEMS;

// Chip tone per item, alternating Oat and Sandbar (chips 2 and 3). Linen
// (chip 1) is too close to the linen page to read as a raised chip at rest,
// so it is kept for the dropdown's hover. Ink text passes AA on both (10.9 / 8.1).
const TONES = [2, 3];
const toneOf = (i: number) => `var(--color-chip-${TONES[i % TONES.length]})`;

// Her hand (2026-10-01): the fine pen stroke drawn under a link, the same
// hairline as the hero's script. One path, pathLength=1, so CSS draws it.
const PEN =
  '<svg class="hdr__pen" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M2 6.5C20 4.8 45 4.2 68 5.2S92 6.4 98 3.2" /></svg>';

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href.endsWith('/') ? href : `${href}/`);
}
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<header class="site-header hdr" data-over-hero={onHero || undefined}>
  <div class="hdr__bar">
    <a href="/" class="hdr__logo" aria-label={`${brandName} home`}>
      {
        customLogo ? (
          /* Editor-supplied logo (Site settings -> Logo). */
          <SanityImage
            source={customLogo}
            width={244}
            alt={customLogo.alt || brandName}
            loading="eager"
            class="hdr__logo-img"
          />
        ) : (
          /* 122x129 matches the source's 378:400, so the box is reserved
             before the file arrives (no CLS). Light only since 2026-09-29. */
          <>
            <img
              src={logo1x.src}
              srcset={logoSrcset}
              alt={brandName}
              width={122}
              height={129}
              class="hdr__logo-img hdr__logo-img--ink"
              loading="eager"
              decoding="async"
            />
            {/* The cream logo, shown only while the header sits on the
                hero (it is the same art the phone menu uses). Decorative:
                the ink logo above carries the alt text. */}
            {onHero && (
              <img
                src={heroLogo1x.src}
                srcset={`${heroLogo1x.src} 1x, ${heroLogo2x.src} 2x`}
                alt=""
                width={122}
                height={129}
                class="hdr__logo-img hdr__logo-img--cream"
                loading="eager"
                decoding="async"
              />
            )}
          </>
        )
      }
      {
        /* Scrolled-strip wordmark. Hidden from assistive tech: the link's
          aria-label already names it. */
      }
      <span class="hdr__word" aria-hidden="true">{wordmark}</span>
    </a>
    {
      /* The logo inks in on the first page of a visit. Inline and right
         after the logo, so the class lands before the first paint (no flash
         of a finished logo). Once per session; sessionStorage can throw in a
         private window, which just means no animation. */
    }
    <script is:inline>
      try {
        if (!sessionStorage.getItem('rd-inked')) {
          sessionStorage.setItem('rd-inked', '1');
          document.currentScript?.closest('.hdr')?.classList.add('hdr--ink');
        }
      } catch {}
    </script>

    <nav class="site-nav hdr__nav" aria-label="Primary">
      {
        NAV_ITEMS.map((item, i) =>
          item.kind === 'flat' ? (
            <a
              href={item.href}
              class="hdr__link"
              style={`--tone:${toneOf(i)}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="hdr__label">
                {item.label}
                <Fragment set:html={PEN} />
              </span>
            </a>
          ) : (
            <details class="site-nav__group hdr__group" style={`--tone:${toneOf(i)}`}>
              <summary
                class="hdr__link hdr__summary"
                aria-current={isGroupActive(item.items) ? 'page' : undefined}
              >
                <span class="hdr__label">
                  {item.label}
                  <ChevronDown size={14} className="site-nav__chevron" aria-hidden="true" />
                  <Fragment set:html={PEN} />
                </span>
              </summary>
              <div class="site-nav__menu hdr__menu">
                {item.items.map((sub, j) => (
                  <a
                    href={sub.href}
                    class="hdr__menu-link"
                    style={`--tone:${toneOf(i + j + 1)}`}
                    aria-current={isActive(sub.href) ? 'page' : undefined}
                  >
                    <span class="hdr__sw" aria-hidden="true" />
                    {sub.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )
      }
    </nav>

    {
      /* Google rating beside the price tag (2026-09-30). RatingTag renders
         nothing until Staci has entered BOTH the rating and the count in
         Site settings > Reviews, so the header is unchanged before then.
         Shown from 1200px up only: narrower, the nav would crowd it, and the
         phone menu and the pages carry the rating instead. */
    }
    <RatingTag variant="compact" settings={siteSettings} class="hdr__rating" />

    {
      chrome.headerCta.show && (
        <a href={ctaHref} class="r-pricetag hdr__cta">
          <span>{ctaLabel}</span>
        </a>
      )
    }

    {
      /* client:idle: the closed dialog server-renders its trigger, so the
         "Menu" tag is in the HTML before React loads. See MobileNav.tsx. */
    }
    <div class="hdr__burger">
      <MobileNav
        client:idle
        links={NAV_ITEMS}
        siteSettings={mobileNavSettings}
        {...mobileChrome}
        logoUrl={menuLogo1x.src}
        logoSrcset={`${menuLogo1x.src} 1x, ${menuLogo2x.src} 2x`}
        currentPath={pathname}
      />
    </div>
  </div>
</header>

<style>
  /* The sticky box. Its height is FIXED in both states, so the strip can
     condense inside it without moving the page. It paints nothing and lets
     clicks through; only the strip's own pieces take the pointer. */
  .hdr {
    --hdr-h: 6.25rem;
    --logo-h: 5.25rem;
    --logo-h-scrolled: 3.25rem;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    height: var(--hdr-h);
    pointer-events: none;
  }
  .hdr__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    width: 100%;
    max-width: 85rem;
    height: 100%;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3.5rem);
    border-radius: 4px;
    transition:
      max-width 600ms var(--ease),
      height 600ms var(--ease),
      margin 600ms var(--ease),
      padding 600ms var(--ease),
      background-color 400ms,
      box-shadow 600ms var(--ease),
      color 300ms;
  }
  .hdr__bar > * {
    pointer-events: auto;
  }

  /* ---- The logo (2026-09-30 design pass): set straight on the page, no
     paper plate. Nathan found the boxed "hanging sign" read as a sticker
     rather than a signature, so the logo now sits inside the header row at
     a size the row holds (84px at rest on desktop), vertically centred, with
     nothing behind it. It never overlaps the section below, so it can never
     sit on the Walnut home hero (where the ink logo would not read). ---- */
  .hdr__logo {
    position: relative;
    z-index: 2;
    /* The logo and the scrolled wordmark stack in one grid cell. */
    display: grid;
    align-items: center;
    justify-items: start;
    flex: none;
    border-radius: 2px;
    transition: opacity 300ms;
  }
  .hdr__logo :global(.hdr__logo-img),
  .hdr__logo-img {
    display: block;
    grid-area: 1 / 1;
    height: var(--logo-h);
    width: auto;
    transform-origin: left center;
    transition:
      height 600ms var(--ease),
      opacity 300ms 200ms,
      transform 600ms var(--ease);
  }
  /* The wordmark for the scrolled strip. At rest it is clipped away to
     nothing on its left edge; scrolled, the clip opens left to right. */
  .hdr__word {
    grid-area: 1 / 1;
    font: 500 0.92rem/1 var(--font-body);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink);
    clip-path: inset(0 100% 0 0);
    opacity: 0;
    pointer-events: none;
    transition:
      clip-path 300ms var(--ease),
      opacity 200ms;
  }
  .hdr__logo:hover {
    opacity: 0.8;
  }
  .hdr__logo:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  /* ---- Nav: a paint chip rises behind the label ---- */
  .hdr__nav {
    display: none;
    align-items: stretch;
    gap: 0.3rem;
    margin-left: auto;
    height: 3.5rem;
  }
  .hdr__link {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 0 0.95rem 0.75rem;
    font: 500 0.95rem/1 var(--font-body);
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .hdr__label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }
  /* ---- Her hand (2026-10-01): a fine pen stroke under the word, drawn on
     hover or keyboard focus, drawn already under the page you are on and
     under an open group. pathLength=1 makes it one unit long, so the dash
     rules draw it from the left. It replaced the paint chip that rose
     behind the label. Under reduced motion it simply appears. ---- */
  .hdr__label :global(.hdr__pen) {
    position: absolute;
    left: -6%;
    bottom: -0.55rem;
    width: 112%;
    height: 0.7rem;
    overflow: visible;
    pointer-events: none;
  }
  .hdr__label :global(.hdr__pen path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1.05;
    stroke-dashoffset: 1.02;
    transition: stroke-dashoffset 600ms cubic-bezier(0.45, 0.05, 0.3, 1);
  }
  .hdr__link:hover :global(.hdr__pen path),
  .hdr__link:focus-visible :global(.hdr__pen path),
  .hdr__link[aria-current='page'] :global(.hdr__pen path),
  .hdr__group[open] > .hdr__link :global(.hdr__pen path) {
    stroke-dashoffset: 0;
  }
  .hdr__link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }

  .hdr__group {
    position: relative;
    height: 100%;
  }
  .hdr__summary {
    list-style: none;
  }
  .hdr__summary::-webkit-details-marker,
  .hdr__summary::marker {
    display: none;
    content: '';
  }
  .hdr :global(.site-nav__chevron) {
    transition: transform 200ms;
  }
  .hdr__group[open] :global(.site-nav__chevron) {
    transform: rotate(180deg);
  }
  /* The open group: a paper card of swatch-led links under its chip. */
  .hdr__menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0.1rem;
    z-index: 50;
    min-width: 13rem;
    padding: 0.45rem;
    background: var(--color-paper);
    border-radius: 0 3px 3px 3px;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 24px 40px -24px rgb(35 30 27 / 0.45);
  }
  .hdr__group[open] > .hdr__menu {
    display: block;
  }
  .hdr__menu-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.75rem;
    border-radius: 2px;
    font: 500 0.95rem/1.2 var(--font-body);
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 200ms;
  }
  .hdr__sw {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    background: var(--tone);
    box-shadow: inset 0 0 0 1px rgb(35 30 27 / 0.15);
  }
  .hdr__menu-link:hover,
  .hdr__menu-link:focus-visible,
  .hdr__menu-link[aria-current='page'] {
    background: var(--color-chip-1);
  }
  .hdr__menu-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }

  .hdr__cta {
    display: none;
    flex: none;
  }
  .hdr__burger {
    margin-left: auto;
  }

  /* ---- Scrolled: a floating paper strip ---- */
  .hdr[data-scrolled] .hdr__bar {
    max-width: min(78rem, calc(100% - 2 * clamp(1rem, 4vw, 3.5rem)));
    height: 3.9rem;
    margin-top: 0.6rem;
    padding-inline: 1.25rem 0.5rem;
    background: var(--color-paper);
    box-shadow:
      0 1px 0 var(--color-rule),
      0 22px 40px -28px rgb(35 30 27 / 0.55);
  }
  .hdr[data-scrolled] .hdr__logo :global(.hdr__logo-img),
  .hdr[data-scrolled] .hdr__logo-img {
    height: var(--logo-h-scrolled);
    opacity: 0;
    transform: scale(0.7);
    transition:
      height 600ms var(--ease),
      opacity 250ms,
      transform 600ms var(--ease);
  }
  /* The wordmark draws in once the logo has mostly gone. */
  .hdr[data-scrolled] .hdr__word {
    clip-path: inset(0 0 0 0);
    opacity: 1;
    transition:
      clip-path 700ms cubic-bezier(0.45, 0.05, 0.3, 1) 180ms,
      opacity 200ms 180ms;
  }
  /* In the strip the labels sit on its middle line. */
  .hdr[data-scrolled] .hdr__nav {
    height: 3.9rem;
  }
  .hdr[data-scrolled] .hdr__link {
    padding-bottom: 1.45rem;
  }

  @media (min-width: 1024px) {
    .hdr__nav {
      display: flex;
    }
    .hdr__cta {
      display: inline-flex;
    }
    .hdr__burger {
      display: none;
    }
  }
  /* A narrow laptop: tighten the nav so the tag keeps its room. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .hdr__bar {
      gap: 1.25rem;
    }
    .hdr__link {
      padding-inline: 0.7rem;
    }
  }
  @media (max-width: 1023px) {
    .hdr {
      --hdr-h: 4.5rem;
      --logo-h: 3.6rem;
      --logo-h-scrolled: 2.75rem;
    }
    .hdr[data-scrolled] .hdr__bar {
      height: 3.4rem;
      margin-top: 0.5rem;
      max-width: calc(100% - 1rem);
      padding-inline: 0.75rem 0.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr__bar,
    .hdr__logo,
    .hdr__logo-img,
    .hdr__logo :global(.hdr__logo-img),
    .hdr__label :global(.hdr__pen path) {
      transition: none;
    }
    /* Reduced motion: a plain swap, no clip wipe and no shrink. */
    .hdr__word,
    .hdr[data-scrolled] .hdr__word,
    .hdr[data-scrolled] .hdr__logo-img,
    .hdr[data-scrolled] .hdr__logo :global(.hdr__logo-img) {
      transition: none;
      transform: none;
    }
  }
  /* ---- On the hero (2026-10-01, home only; see the header comment) ----
     The header box keeps its height, and the hero slides up beneath it by
     the same amount, so the first screen is one picture. Everything on the
     bar turns cream until the page scrolls; the scrolled strip is unchanged.
     Contrast: cream on Walnut is 4.9:1, and HomeHero shades the top of the
     photo where the links and the tag sit over it. */
  .hdr[data-over-hero] {
    margin-bottom: calc(-1 * var(--hdr-h));
  }
  .hdr__logo-img--cream {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    transition:
      height 600ms var(--ease),
      opacity 300ms,
      transform 600ms var(--ease);
  }
  .hdr__logo-img--ink {
    transition:
      height 600ms var(--ease),
      opacity 300ms,
      transform 600ms var(--ease);
  }
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__logo-img--cream {
    opacity: 1;
  }
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__logo-img--ink {
    opacity: 0;
  }
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__bar {
    color: var(--color-cream);
  }
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__link {
    color: var(--color-cream);
    /* A whisper of shadow so cream holds on any part of her photo. */
    text-shadow: 0 1px 10px rgb(35 30 27 / 0.45);
  }
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__logo-img--cream {
    filter: drop-shadow(0 1px 6px rgb(35 30 27 / 0.5));
  }
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__logo:focus-visible,
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__link:focus-visible {
    outline-color: var(--color-cream);
  }
  /* The rating's stars: Sandbar fills on the Walnut (Warm Bronze would
     vanish into it), as on the ink reviews band. */
  .hdr[data-over-hero]:not([data-scrolled]) :global(.hdr__rating) {
    --star-on: var(--color-chip-3);
    --star-off: rgb(245 237 227 / 0.3);
  }
  /* The booking tag and the phone's Menu tag: cream with ink words. */
  .hdr[data-over-hero]:not([data-scrolled]) .hdr__cta,
  .hdr[data-over-hero]:not([data-scrolled]) :global(.mnav-trigger) {
    --tag-bg: var(--color-cream);
    --tag-bg-hover: var(--color-paper);
    --tag-fg: var(--color-ink);
    --tag-ring: var(--color-cream);
  }
  .hdr__link {
    transition: color 300ms;
  }

  /* ---- Ink in: the logo revealed left to right on the first page of a
     visit (the inline script adds .hdr--ink). ---- */
  @media (prefers-reduced-motion: no-preference) {
    .hdr--ink .hdr__logo {
      animation: hdr-ink 1.3s cubic-bezier(0.45, 0.05, 0.3, 1) 0.25s both;
    }
  }
  @keyframes hdr-ink {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Google rating in the header: wide screens only (see the slot comment). */
  .hdr :global(.hdr__rating) {
    display: none;
  }
  @media (min-width: 1200px) {
    .hdr :global(.hdr__rating) {
      display: inline-flex;
    }
  }
</style>

{
  /* Progressive enhancement for the desktop dropdown nav. Everything still
    works without this (native <details> toggles on click/Enter/Space, links
    are real <a> tags). This adds: open-on-hover with a small close delay,
    close-on-outside-click, close-on-Escape, and close-when-a-link-is-followed.
    Re-binds on astro:page-load so it survives View Transitions navigations. */
}
<script>
  // Query groups fresh each call — the nav DOM is replaced on every View
  // Transitions navigation, so a captured list would go stale.
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;

    const closeAll = closeAllGroups;

    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // Hover intent: open immediately on enter, close after a short delay on
      // leave so a diagonal mouse path to the menu doesn't snap it shut. Only
      // engages on pointers that can actually hover (skips touch).
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeAll(group);
        group.open = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
        }, 140);
      });

      // When opened via keyboard/click, make sure the others close.
      summary?.addEventListener('click', () => {
        // <details> toggles AFTER this handler, so the post-toggle state is the
        // inverse of the current one. If it's about to open, close the rest.
        if (!group.open) closeAll(group);
      });

      // Following a link inside the menu should close the group (so it isn't
      // left open behind the next page during a View Transitions swap).
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // Document-level listeners bind ONCE (guarded by a window flag), so they
  // don't stack up across View Transitions navigations. They query the nav
  // groups fresh each time they fire, so the swapped-in DOM is always covered.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;

    // Close any open group when clicking outside the nav.
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });

    // Escape closes the open group and returns focus to its summary.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);
</script>
