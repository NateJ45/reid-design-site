---
// Foundation, edit with care
// Site header. Two structural rows on desktop, one on mobile:
//   ┌─────────────────────────────────────── 4px Warm Bronze accent stripe
//   │ ─────────────────────────────────────── eyebrow strip (desktop-only)
//   │   Plainfield Interior Design · ...    staci@…  · IG · FB · theme
//   ├─────────────────────────────────────── main row
//   │   [logo]                  [nav]  │  [Book a consultation CTA]
//   └───────────────────────────────────────
// On mobile the eyebrow strip is hidden (its info lives in the redesigned
// MobileNav drawer) and the main row centers the logo with the hamburger
// pinned absolute to the right.
//
// siteSettings is optional. Defaults render cleanly so the header works
// even before Sanity content is wired up.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { Search } from 'lucide-react';
import MobileNav from './MobileNav';
import SanityImage from './SanityImage.astro';
import { ChevronDown } from 'lucide-react';
import logoLightAsset from '@/assets/logo-light.png';
import logoDarkAsset from '@/assets/logo-dark.png';
import { getSectionVisibility, type SectionVisibility } from '@/lib/sectionVisibility';
import {
  resolveChrome,
  DEFAULT_CTA_HREF,
  DEFAULT_CTA_LABEL,
  type RawNavItem,
} from '@/lib/siteSettings';
import type { RawNavLink } from '@/lib/nav-href';

// Pre-render every logo variant we'll need via Astro's image pipeline so we
// have the hashed WebP URLs available at build time. The header displays at
// h-[6.25rem] (≈95×100 px) with w-auto, so a 100w/200w pair covers 1×/2×
// retina. The mobile drawer displays at h-16 (≈61×64 px), so 128w is plenty.
// Pre-computing all four URLs means we can render ONE <img> with no src in
// the HTML and let an inline script pick the right variant based on the
// current theme — that's the only way to keep Lighthouse from flagging the
// inactive logo as "image larger than displayed" (because Lighthouse
// analyses the DOM, not the network log).
const logoLight1x = await getImage({ src: logoLightAsset, format: 'webp', width: 100 });
const logoLight2x = await getImage({ src: logoLightAsset, format: 'webp', width: 200 });
const logoDark1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 100 });
const logoDark2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 200 });
const logoLightSrcset = `${logoLight1x.src} 1x, ${logoLight2x.src} 2x`;
const logoDarkSrcset = `${logoDark1x.src} 1x, ${logoDark2x.src} 2x`;

// Mobile drawer logos — separate getImage() calls at the smaller size the
// drawer displays at. Their URLs are passed into MobileNav as plain
// strings (the React island can't import assets directly).
const logoLightWebpMobile = await getImage({ src: logoLightAsset, format: 'webp', width: 128 });
const logoDarkWebpMobile = await getImage({ src: logoDarkAsset, format: 'webp', width: 128 });

interface Props {
  siteSettings?: {
    siteName?: string;
    title?: string;
    tagline?: string;
    primaryCtaLabel?: string;
    headerTagline?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    availabilityStatus?: string;
    /** Editor-supplied logo. When set it replaces the built-in theme-aware pair. */
    logo?: { asset?: { _ref?: string; _id?: string }; alt?: string } | null;
    /** Chrome options (see src/lib/siteSettings.ts). All optional; empty keeps the built-ins. */
    navItems?: RawNavItem[] | null;
    headerCta?: {
      show?: boolean | null;
      label?: string | null;
      link?: RawNavLink | null;
    } | null;
    showEmail?: boolean | null;
    showSocials?: boolean | null;
    sectionVisibility?: {
      showPortfolio?: boolean | null;
      showJournal?: boolean | null;
      showShop?: boolean | null;
      showEDesign?: boolean | null;
      showGiftCertificates?: boolean | null;
      showPress?: boolean | null;
      showResources?: boolean | null;
      showGuides?: boolean | null;
      showStyleQuiz?: boolean | null;
      showBudgetCalculator?: boolean | null;
    } | null;
  } | null;
  navPages?: NavPage[];
}

interface NavPage {
  title?: string;
  slug?: string;
  navLabel?: string;
  addToMainNav?: boolean;
  navGroup?: 'top' | 'services' | 'resources';
  addToFooter?: boolean;
}

const { siteSettings, navPages } = Astro.props as Props;

// Normalize section visibility from siteSettings. Unset => visible.
const visible: SectionVisibility = getSectionVisibility(siteSettings?.sectionVisibility);
const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;
const availability = siteSettings?.availabilityStatus ?? '';

// Editor-managed chrome: the top menu, the header button, and the show/hide
// switches for the contact details. Every one of them is opt-in — an untouched
// Site settings document resolves to exactly the built-ins below.
const chrome = resolveChrome(siteSettings);
const ctaLabel = chrome.headerCta.label;
const ctaHref = chrome.headerCta.href;

// An editor-supplied logo replaces the built-in theme-aware pair.
const customLogo = siteSettings?.logo?.asset ? siteSettings.logo : null;

// Subset of siteSettings the mobile menu needs. Pass as a plain object so the
// React island doesn't try to serialize the whole Sanity document graph.
const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: siteSettings.email,
      phone: siteSettings.phone,
      socialInstagram: siteSettings.socialInstagram,
      socialFacebook: siteSettings.socialFacebook,
      primaryCtaLabel: siteSettings.primaryCtaLabel,
    }
  : null;

// The switches above decide whether the eyebrow strip and the phone menu carry
// these at all. Unset means yes, so an untouched site is unchanged.
const showEmail = chrome.showEmail;
const showSocials = chrome.showSocials;

// MobileNav is a hydrated island (client:idle since 2026-09-29, PORTS.md card
// 52), so every prop it receives is SERIALIZED INTO THE HTML, in the island's
// `props` attribute, exactly as it was under client:only. Pass it only what actually DIFFERS from the defaults it
// already applies on its own, so a Site settings document nobody has touched
// renders a byte-identical page — the same opt-in promise the rest of these
// fields make, held to at the level of the island's props attribute.
const mobileCtaIsDefault =
  chrome.headerCta.show &&
  chrome.headerCta.href === DEFAULT_CTA_HREF &&
  chrome.headerCta.label === (siteSettings?.primaryCtaLabel ?? DEFAULT_CTA_LABEL);
const mobileChrome = {
  ...(mobileCtaIsDefault ? {} : { cta: chrome.headerCta }),
  ...(showEmail ? {} : { showEmail: false }),
  ...(showSocials ? {} : { showSocials: false }),
};

// Grouped nav structure. Flat items render as plain anchor links; dropdown
// items render as native <details>/<summary> disclosure groups on desktop
// (server-rendered, see the nav markup below) and as indented expandable
// groups in MobileNav.
//
// Why <details> and not a React island: the desktop nav must exist in the
// server-rendered HTML so search-engine crawlers see every internal link and
// so there is no flash-of-missing-nav (or CLS) before hydration. A native
// <details> disclosure is crawlable, keyboard-accessible, and works with zero
// JS. A tiny progressive-enhancement script (further down) adds the niceties
// browsers don't give us for free: open-on-hover, close-on-outside-click,
// close-on-Escape, and close-on-navigation. The links work without it.
//
// "Contact" is intentionally NOT in the primary nav — the "Book a consultation"
// CTA at the right of the nav row does that job, and the MobileNav drawer also
// surfaces the CTA at the top.
// Build Services dropdown children. Services and Process are always shown;
// E-Design and Gift Certificates are gated by visibility.
// Custom pages flagged for the menu, split by where Staci placed each one.
const customNav = (navPages ?? []).filter((p) => p.addToMainNav && p.slug);
const toNavItem = (p: NavPage) => ({ label: p.navLabel || p.title || 'Page', href: `/${p.slug}` });
const customTopItems = customNav.filter((p) => (p.navGroup ?? 'top') === 'top').map(toNavItem);
const customServicesItems = customNav.filter((p) => p.navGroup === 'services').map(toNavItem);
const customResourcesItems = customNav.filter((p) => p.navGroup === 'resources').map(toNavItem);

const servicesDropdownItems = [
  { label: 'Services', href: '/services' },
  ...(visible.eDesign ? [{ label: 'E-Design', href: '/e-design' }] : []),
  { label: 'Process', href: '/process' },
  ...(visible.giftCertificates ? [{ label: 'Gift Certificates', href: '/gift-certificates' }] : []),
  ...customServicesItems,
];

// Build Resources dropdown children. FAQ is always shown; the rest are gated.
const resourcesDropdownItems = [
  ...(visible.styleQuiz ? [{ label: 'Style Quiz', href: '/quiz' }] : []),
  ...(visible.budgetCalculator ? [{ label: 'Cost Calculator', href: '/calculator' }] : []),
  ...(visible.guides ? [{ label: 'Guides', href: '/guides' }] : []),
  { label: 'FAQ', href: '/faq' },
  ...(visible.journal ? [{ label: 'Journal', href: '/journal' }] : []),
  ...(visible.portfolio ? [{ label: 'Before & After', href: '/portfolio/before-after' }] : []),
  ...customResourcesItems,
];

// Assemble the full nav. Flat items Portfolio and Shop are gated by visibility.
// Dropdown groups are omitted entirely when their children list ends up empty.
const BUILT_IN_NAV_ITEMS = [
  { kind: 'flat' as const, label: 'Home', href: '/' },
  ...(visible.portfolio ? [{ kind: 'flat' as const, label: 'Portfolio', href: '/portfolio' }] : []),
  // Services dropdown — always present (Services + Process are core).
  {
    kind: 'dropdown' as const,
    label: 'Services',
    items: servicesDropdownItems,
  },
  ...(visible.shop ? [{ kind: 'flat' as const, label: 'Shop', href: '/shop' }] : []),
  // Resources dropdown — only show when at least one child is visible (FAQ always is).
  ...(resourcesDropdownItems.length > 0
    ? [{ kind: 'dropdown' as const, label: 'Resources', items: resourcesDropdownItems }]
    : []),
  // Custom pages Staci set to their own top-level menu item.
  ...customTopItems.map((it) => ({ kind: 'flat' as const, label: it.label, href: it.href })),
  { kind: 'flat' as const, label: 'About', href: '/about' },
];

// Site settings -> Top menu links, when Staci has filled it in, replaces the
// whole computed menu above. Empty (the default) keeps the built-in one.
const NAV_ITEMS = chrome.navItems ?? BUILT_IN_NAV_ITEMS;

// Flatten NAV_ITEMS into the shape MobileNav expects (a list of NavLink[]
// with optional sub-items for the groups). MobileNav already handles both
// shapes via its updated interface.
const NAV_LINKS = NAV_ITEMS;

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
// A dropdown group is "active" (its trigger underline locks wide + aria-current
// is set) when the current route matches any of its child links.
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<header class="site-header hdr">
  {
    /* Rebuilt 2026-09-29 (art-direction rebuild). One row: logo, the
      server-rendered nav (flat links + native <details> dropdowns, unchanged
      behaviour), the availability pill, search, and the ink "book" pill. The
      old eyebrow strip (tagline, email, phone, socials, theme toggle) is gone:
      contact details live in the footer and the phone menu, and the site is
      light only. Phone: logo left; availability, search, hamburger right. */
  }
  <div class="hdr__row r-wrap">
    <a href="/" class="hdr__logo" aria-label={`${brandName} home`}>
      {
        customLogo ? (
          /* Editor-supplied logo (Site settings -> Logo). One file for both
           themes, so it skips the light/dark swap machinery entirely. */
          <SanityImage
            source={customLogo}
            width={160}
            alt={customLogo.alt || brandName}
            loading="eager"
            class="hdr__logo-img"
          />
        ) : (
          /* Single theme-aware logo: the img ships with NO src so nothing is
           fetched until the inline script below picks the variant (light
           only since the rebuild, but the machinery stays so dark mode can
           return). 100x106 matches the source 378:400, so no CLS. */
          <img
            alt={brandName}
            width={100}
            height={106}
            class="hdr__logo-img"
            loading="eager"
            decoding="async"
            data-theme-logo
            data-logo-light-src={logoLight1x.src}
            data-logo-light-srcset={logoLightSrcset}
            data-logo-dark-src={logoDark1x.src}
            data-logo-dark-srcset={logoDarkSrcset}
          />
        )
      }
    </a>
    <script is:inline>
      (function () {
        const img = document.querySelector('header img[data-theme-logo]');
        if (!img) return;
        const dark = document.documentElement.classList.contains('dark');
        img.src = dark ? img.dataset.logoDarkSrc : img.dataset.logoLightSrc;
        img.srcset = dark ? img.dataset.logoDarkSrcset : img.dataset.logoLightSrcset;
      })();
    </script>

    {
      /* Desktop nav (lg+). Real <a> tags + native <details> groups, in the
        HTML at build time: crawlable, keyboard-usable, no CLS. The script at
        the bottom adds hover-open and outside-click / Escape close. */
    }
    <nav class="site-nav hdr__nav" aria-label="Primary">
      {
        NAV_ITEMS.map((item) =>
          item.kind === 'flat' ? (
            <a
              href={item.href}
              class="hdr__link"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <details class="site-nav__group hdr__group">
              <summary
                class="hdr__link hdr__summary"
                aria-current={isGroupActive(item.items) ? 'page' : undefined}
              >
                {item.label}
                <ChevronDown size={14} className="site-nav__chevron" aria-hidden="true" />
              </summary>
              <div class="site-nav__menu hdr__menu">
                {item.items.map((sub) => (
                  <a
                    href={sub.href}
                    class="hdr__menu-link"
                    aria-current={isActive(sub.href) ? 'page' : undefined}
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )
      }
    </nav>

    <div class="hdr__tools">
      {
        availability && (
          <a href="/contact" class="hdr__status" aria-label={`${availability}. Get in touch.`}>
            <span class="hdr__dot" aria-hidden="true" />
            <span class="hdr__status-long" aria-hidden="true">
              {availability}
            </span>
            <span class="hdr__status-short" aria-hidden="true">
              Open
            </span>
          </a>
        )
      }
      <a href="/search" aria-label="Search the site" class="hdr__icon">
        <Search size={19} aria-hidden="true" />
      </a>
      {
        chrome.headerCta.show && (
          <a href={ctaHref} class="r-btn r-btn--ink hdr__cta">
            {ctaLabel}
          </a>
        )
      }
      {
        /* client:idle, not client:only (2026-09-29, PORTS.md card 52): the
           closed Sheet server-renders its trigger, so the hamburger is in the
           HTML before React loads. See the header of MobileNav.tsx. */
      }
      <div class="hdr__burger">
        <MobileNav
          client:idle
          links={NAV_LINKS}
          siteSettings={mobileNavSettings}
          {...mobileChrome}
          logoLightUrl={logoLightWebpMobile.src}
          logoDarkUrl={logoDarkWebpMobile.src}
        />
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    background: color-mix(in oklab, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(1.1) blur(10px);
    -webkit-backdrop-filter: saturate(1.1) blur(10px);
    border-bottom: 1px solid var(--color-rule);
  }
  .hdr__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 5.5rem;
  }
  .hdr__logo {
    display: inline-flex;
    flex: none;
    transition: opacity 300ms;
  }
  .hdr__logo:hover {
    opacity: 0.8;
  }
  .hdr__logo :global(.hdr__logo-img),
  .hdr__logo-img {
    height: 4.25rem;
    width: auto;
  }

  .hdr__nav {
    display: none;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding-block: 0.5rem;
    font: 500 0.95rem/1 var(--font-body);
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
  }
  /* Underline draws in from the left; locked on for the current page. */
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1rem;
    height: 1.5px;
    background: var(--color-chip-5);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hdr__link:hover::after,
  .hdr__link:focus-visible::after,
  .hdr__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .hdr__link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .hdr__group {
    position: relative;
  }
  .hdr__summary {
    list-style: none;
  }
  .hdr__summary::-webkit-details-marker,
  .hdr__summary::marker {
    display: none;
    content: '';
  }
  .hdr__group[open] :global(.site-nav__chevron) {
    transform: rotate(180deg);
  }
  .hdr :global(.site-nav__chevron) {
    transition: transform 200ms;
  }
  .hdr__menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.6rem);
    left: -1rem;
    z-index: 50;
    min-width: 13rem;
    padding: 0.5rem;
    background: var(--color-paper);
    border-radius: 0.75rem;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 24px 40px -24px rgb(35 30 27 / 0.45);
  }
  .hdr__group[open] > .hdr__menu {
    display: block;
  }
  .hdr__menu-link {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    font: 500 0.95rem/1.2 var(--font-body);
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 200ms;
  }
  .hdr__menu-link:hover,
  .hdr__menu-link:focus-visible {
    background: var(--color-chip-1);
    outline: none;
  }
  .hdr__menu-link[aria-current='page'] {
    color: var(--color-chip-7);
  }

  .hdr__tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .hdr__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.85rem 0 0.7rem;
    border-radius: 999px;
    background: var(--color-chip-1);
    font: 500 0.82rem/1 var(--font-body);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__status:hover {
    background: var(--color-chip-2);
  }
  .hdr__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #6f8a5f;
    box-shadow: 0 0 0 3px rgb(111 138 95 / 0.2);
  }
  .hdr__status-long {
    display: none;
  }
  .hdr__icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--color-ink);
    transition: background-color 200ms;
  }
  .hdr__icon:hover {
    background: var(--color-chip-1);
  }
  .hdr__icon:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .hdr__cta {
    display: none;
    min-height: 2.75rem;
    padding: 0.8em 1.3em;
    font-size: 0.9rem;
  }
  /* MobileNav positions its own trigger; give it a normal flow slot here. */
  .hdr__burger {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
  }

  @media (min-width: 1024px) {
    .hdr__nav {
      display: flex;
    }
    .hdr__tools {
      margin-left: 0.5rem;
    }
    .hdr__cta {
      display: inline-flex;
    }
    .hdr__burger {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    .hdr__status-long {
      display: inline;
    }
    .hdr__status-short {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    .hdr__row {
      height: 4.75rem;
    }
    .hdr__logo :global(.hdr__logo-img),
    .hdr__logo-img {
      height: 3.5rem;
    }
    .hdr__tools {
      gap: 0.25rem;
    }
  }
</style>

{
  /* Progressive enhancement for the desktop dropdown nav. Everything still
    works without this (native <details> toggles on click/Enter/Space, links
    are real <a> tags). This adds: open-on-hover with a small close delay,
    close-on-outside-click, close-on-Escape, and close-when-a-link-is-followed.
    Re-binds on astro:page-load so it survives View Transitions navigations. */
}
<script>
  // Query groups fresh each call — the nav DOM is replaced on every View
  // Transitions navigation, so a captured list would go stale.
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;

    const closeAll = closeAllGroups;

    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // Hover intent: open immediately on enter, close after a short delay on
      // leave so a diagonal mouse path to the menu doesn't snap it shut. Only
      // engages on pointers that can actually hover (skips touch).
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeAll(group);
        group.open = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
        }, 140);
      });

      // When opened via keyboard/click, make sure the others close.
      summary?.addEventListener('click', () => {
        // <details> toggles AFTER this handler, so the post-toggle state is the
        // inverse of the current one. If it's about to open, close the rest.
        if (!group.open) closeAll(group);
      });

      // Following a link inside the menu should close the group (so it isn't
      // left open behind the next page during a View Transitions swap).
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // Document-level listeners bind ONCE (guarded by a window flag), so they
  // don't stack up across View Transitions navigations. They query the nav
  // groups fresh each time they fire, so the swapped-in DOM is always covered.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;

    // Close any open group when clicking outside the nav.
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });

    // Escape closes the open group and returns focus to its summary.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);
</script>
