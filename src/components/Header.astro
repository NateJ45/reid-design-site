---
// Foundation, edit with care
// Site header. Two structural rows on desktop, one on mobile:
//   ┌─────────────────────────────────────── 4px Warm Bronze accent stripe
//   │ ─────────────────────────────────────── eyebrow strip (desktop-only)
//   │   Plainfield Interior Design · ...    staci@…  · IG · FB · theme
//   ├─────────────────────────────────────── main row
//   │   [logo]                  [nav]  │  [Book a consultation CTA]
//   └───────────────────────────────────────
// On mobile the eyebrow strip is hidden (its info lives in the redesigned
// MobileNav drawer) and the main row centers the logo with the hamburger
// pinned absolute to the right.
//
// siteSettings is optional. Defaults render cleanly so the header works
// even before Sanity content is wired up.

import { Image, getImage } from 'astro:assets';
import { site } from '@/data/site';
import { Mail } from 'lucide-react';
import { IconBrandInstagram, IconBrandFacebook } from '@tabler/icons-react';
import ThemeToggle from './ThemeToggle';
import MobileNav from './MobileNav';
import logoLightAsset from '@/assets/logo-light.png';
import logoDarkAsset from '@/assets/logo-dark.png';

// Pre-render the logo variants through Astro's image pipeline once, then
// reuse the resulting WebP URLs in both the desktop <Image> tags and the
// MobileNav drawer. getImage() returns the same hashed/optimized file the
// <Image> component would emit, which means there's only one WebP per
// logo on disk no matter how many times it's referenced.
const logoLightWebp = await getImage({ src: logoLightAsset, format: 'webp', width: 378 });
const logoDarkWebp = await getImage({ src: logoDarkAsset, format: 'webp', width: 378 });

interface Props {
  siteSettings?: {
    siteName?: string;
    title?: string;
    tagline?: string;
    email?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    availabilityStatus?: string;
  } | null;
}

const { siteSettings } = Astro.props as Props;
const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;
const availability = siteSettings?.availabilityStatus ?? '';

// Subset of siteSettings the mobile menu needs. Pass as a plain object so the
// React island doesn't try to serialize the whole Sanity document graph.
const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: siteSettings.email,
      socialInstagram: siteSettings.socialInstagram,
      socialFacebook: siteSettings.socialFacebook,
    }
  : null;

const email = siteSettings?.email ?? '';
const ig = siteSettings?.socialInstagram ?? '';
const fb = siteSettings?.socialFacebook ?? '';

const NAV_LINKS = [
  { label: 'Home',      href: '/' },
  { label: 'Process',   href: '/process' },
  { label: 'Services',  href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Journal',   href: '/journal' },
  { label: 'FAQ',       href: '/faq' },
  { label: 'About',     href: '/about' },
];
// "Contact" is intentionally NOT in the primary nav — the "Book a consultation"
// CTA at the right of the nav row does that job, and the MobileNav drawer also
// surfaces the CTA at the top.

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header bg-background">
  {/* Brand accent stripe — same visual signature used at the top of the
      mobile menu drawer. Visible on every viewport. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {/* Eyebrow strip (desktop only). Carries the locked positioning line and
      utility controls (email + social icons + theme toggle). Mobile gets
      the same info through the MobileNav drawer. */}
  <div class="hidden md:block bg-muted border-b border-border-soft">
    <div class="mx-auto flex max-w-content items-center justify-between px-l py-2">
      <p class="text-xs uppercase tracking-eyebrow text-foreground/65">
        Plainfield Interior Design · Serving Greater Indianapolis
      </p>
      <div class="flex items-center gap-m">
        {email && (
          <a
            href={`mailto:${email}`}
            class="inline-flex items-center gap-xs text-xs text-foreground hover:text-link transition-colors"
          >
            <Mail size={12} aria-hidden="true" />
            {email}
          </a>
        )}
        {(ig || fb) && (
          <div class="flex items-center gap-1">
            {ig && (
              <a
                href={ig}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="inline-flex h-7 w-7 items-center justify-center rounded-full text-foreground hover:bg-accent hover:text-link transition-colors"
              >
                <IconBrandInstagram size={14} stroke={1.5} />
              </a>
            )}
            {fb && (
              <a
                href={fb}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="inline-flex h-7 w-7 items-center justify-center rounded-full text-foreground hover:bg-accent hover:text-link transition-colors"
              >
                <IconBrandFacebook size={14} stroke={1.5} />
              </a>
            )}
          </div>
        )}
        {/* Hydrate when idle, not on load — the anti-FOUC inline script in
            BaseLayout already applies the correct theme class before first
            paint, so this React island only needs to be live by the time the
            visitor moves to click it. Demoting from client:load shaves real
            TBT off mobile Lighthouse runs. */}
        <ThemeToggle client:idle />
      </div>
    </div>
  </div>

  {/* Main nav row. Mobile centers the logo; desktop justifies logo left,
      nav+CTA grouped right. px-l gives the logo and CTA breathing room
      when the viewport is narrower than max-w-content so neither element
      kisses the edge of the page. */}
  <div class="relative mx-auto flex max-w-content items-center justify-center md:justify-between px-l py-m border-b border-border">
    {/* Mobile-only availability pill, mirroring the hamburger menu's
        absolute-right placement. Gives mobile visitors an at-a-glance trust
        signal ("Open / accepting new clients") and a single-tap path to
        /contact — meaningfully conversion-positive in a tiny footprint. Renders
        nothing when siteSettings.availabilityStatus is empty so the slot just
        stays empty negative space. */}
    {availability && (
      <a
        href="/contact"
        class="md:hidden absolute left-m top-1/2 -translate-y-1/2 inline-flex items-center gap-1.5 h-9 pl-2 pr-2.5 rounded-full bg-muted border border-border-soft text-foreground hover:border-primary hover:text-primary-dark transition-colors"
        aria-label={`Availability: ${availability}. Tap to start a conversation.`}
      >
        <span
          class="relative flex w-2 h-2 shrink-0"
          aria-hidden="true"
        >
          {/* Soft pulsing halo — kills under prefers-reduced-motion via the
              global rule that flattens all animations. */}
          <span class="absolute inline-flex h-full w-full rounded-full bg-tertiary opacity-60 animate-ping"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-tertiary"></span>
        </span>
        {/* Full pill — visible at every mobile width. The h-9 pill is
            compact enough that even at 320px it doesn't collide with the
            centered logo. */}
        <span class="text-[0.65rem] uppercase tracking-eyebrow font-semibold whitespace-nowrap">
          Open
        </span>
      </a>
    )}

    <a
      href="/"
      class="inline-flex items-center hover:opacity-80 transition-opacity"
      aria-label={`${brandName} home`}
    >
      {/*
        Two logo variants — Astro's <Image> auto-emits WebP and content-
        hashes the filename. `densities={[1, 2]}` gives mobile + retina
        coverage without bloating the srcset further (the display height
        is fixed at 100 px; we don't need a 4-width responsive ladder).
        Eager-loaded because the header logo is above the fold on every
        page; the dark variant is `loading="lazy"` since most visitors
        see the light variant first.
      */}
      <Image
        src={logoLightAsset}
        alt={brandName}
        width={378}
        height={400}
        format="webp"
        densities={[1, 2]}
        class="block dark:hidden h-[6.25rem] w-auto"
        loading="eager"
        decoding="async"
      />
      <Image
        src={logoDarkAsset}
        alt=""
        aria-hidden="true"
        width={378}
        height={400}
        format="webp"
        densities={[1, 2]}
        class="hidden dark:block h-[6.25rem] w-auto"
        loading="lazy"
        decoding="async"
      />
    </a>

    {/* Nav + CTA grouped on the right (desktop only). */}
    <div class="hidden md:flex items-center gap-l">
      <nav class="flex items-center gap-l" aria-label="Primary">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'nav-underline text-sm tracking-wide transition-colors',
              isActive(link.href)
                ? 'text-link font-semibold'
                : 'text-foreground hover:text-link',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <span class="h-6 w-px bg-border-soft" aria-hidden="true"></span>
      <a
        href="/contact"
        class:list={[
          'press-tactile inline-flex items-center px-m py-2 rounded-md text-xs uppercase tracking-eyebrow font-semibold',
          isActive('/contact')
            ? 'bg-accent-dark text-white'
            : 'bg-primary-dark text-white hover:bg-accent-dark',
        ]}
      >
        Book a consultation
      </a>
    </div>

    <MobileNav
      client:only="react"
      links={NAV_LINKS}
      siteSettings={mobileNavSettings}
      logoLightUrl={logoLightWebp.src}
      logoDarkUrl={logoDarkWebp.src}
    />
  </div>
</header>
