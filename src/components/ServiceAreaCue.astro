---
// Safe to edit by hand
// Home service-area band (rebuilt 2026-09-29). A short heading and the towns
// on the left, home base first in Espresso italic, and Staci's own note
// (homePage.serviceAreaCue) under them. On the right, the same framed, toned
// Google map as Contact (ServiceAreaMap.astro), centred on her home base and
// loaded only as it nears the screen. It replaced a hand-drawn sketch map on
// 2026-10-01 (Nathan: not up to standard). Towns come from Business info ->
// Service areas.
//
// Phone: heading and towns first, the map under them.
//
// Only the home page uses this component.
import ServiceAreaMap from '@/components/ServiceAreaMap.astro';

interface Props {
  /** Staci's note under the towns (homePage.serviceAreaCue). Optional. */
  text?: string;
  /** Business info -> Service areas. The first one is treated as home base. */
  cities?: string[];
  /** Kept for the renderer's existing call; the rebuild does not print it. */
  eyebrow?: string;
}

const { text, cities } = Astro.props as Props;

const cityList = Array.isArray(cities) ? cities.filter(Boolean) : [];
const [home, ...rest] = cityList;
const note = text ?? 'Serving Plainfield, Indianapolis, and the surrounding suburbs.';
---

<section class="area" aria-labelledby="area-heading">
  <div class="r-wrap area__grid">
    <div class="area__copy">
      <h2 id="area-heading" class="r-h2 area__h">
        Based in {home || 'Plainfield'}. <span class="r-accent">Happy to drive.</span>
      </h2>
      {
        cityList.length > 0 && (
          <p class="area__towns">
            <b>{home}</b>
            {rest.map((c) => (
              <>
                {' '}
                <i aria-hidden="true">/</i> {c}
              </>
            ))}
          </p>
        )
      }
      <p class="area__note">{note}</p>
    </div>
    <div class="area__map">
      <ServiceAreaMap towns={cityList} caption={false} />
    </div>
  </div>
</section>

<style>
  .area {
    position: relative;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    border-top: 1px solid var(--color-rule);
    overflow: clip;
  }
  .area__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: center;
  }
  .area__copy {
    position: relative;
    z-index: 1;
    grid-column: 1 / 6;
  }
  .area__h {
    margin: 0;
    font-size: clamp(2.2rem, 1.3rem + 2.8vw, 4rem);
  }
  .area__towns {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font: 300 clamp(1.35rem, 1.05rem + 0.9vw, 1.9rem) / 1.35 var(--font-display);
    letter-spacing: -0.012em;
    color: var(--color-ink-2);
  }
  .area__towns b {
    font-weight: 300;
    font-style: italic;
    color: var(--color-chip-7);
  }
  .area__towns i {
    font-style: normal;
    color: var(--color-chip-3);
    padding-inline: 0.12em;
  }
  .area__note {
    margin: 1.5rem 0 0;
    max-width: 44ch;
    color: var(--color-ink-2);
  }
  /* The map: the right-hand seven columns, framed like a print. */
  .area__map {
    grid-column: 7 / 13;
  }
  @media (max-width: 1023px) {
    .area__grid {
      display: block;
    }
    .area__map {
      margin-top: 2rem;
    }
  }
</style>
