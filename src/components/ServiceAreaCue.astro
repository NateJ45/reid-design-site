---
// Safe to edit by hand
// Home service-area band (rebuilt 2026-09-29). A short heading on the left,
// the towns set large on the right with the home base first, in bronze
// italic. Staci's own note (homePage.serviceAreaCue) sits under the list.
// Towns come from Business info -> Service areas.
//
// Only the home page uses this component.

interface Props {
  /** Staci's note under the towns (homePage.serviceAreaCue). Optional. */
  text?: string;
  /** Business info -> Service areas. The first one is treated as home base. */
  cities?: string[];
  /** Kept for the renderer's existing call; the rebuild does not print it. */
  eyebrow?: string;
}

const { text, cities } = Astro.props as Props;

const cityList = Array.isArray(cities) ? cities.filter(Boolean) : [];
const [home, ...rest] = cityList;
const note = text ?? 'Serving Plainfield, Indianapolis, and the surrounding suburbs.';
---

<section class="area" aria-labelledby="area-heading">
  <div class="r-wrap area__grid">
    <h2 id="area-heading" class="r-h2 area__h">
      Based in {home || 'Plainfield'}. <span class="r-accent">Happy to drive.</span>
    </h2>
    <div class="area__list">
      {
        cityList.length > 0 && (
          <p>
            <b>{home}</b>
            {rest.map((c) => (
              <>
                {' '}
                <i aria-hidden="true">/</i> {c}
              </>
            ))}
          </p>
        )
      }
      <p class="area__note">{note}</p>
    </div>
  </div>
</section>

<style>
  .area {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    border-top: 1px solid var(--color-rule);
  }
  .area__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .area__h {
    grid-column: 1 / 6;
    margin: 0;
    font-size: clamp(2.2rem, 1.3rem + 2.8vw, 4rem);
  }
  .area__list {
    grid-column: 6 / 13;
  }
  .area__list > p:first-child {
    margin: 0;
    font: 300 clamp(1.7rem, 1.2rem + 1.6vw, 2.9rem) / 1.25 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-ink-2);
  }
  .area__list b {
    font-weight: 300;
    font-style: italic;
    color: var(--color-chip-7);
  }
  .area__list i {
    font-style: normal;
    color: var(--color-chip-3);
    padding-inline: 0.15em;
  }
  .area__note {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    color: var(--color-ink-2);
  }
  @media (max-width: 1023px) {
    .area__grid {
      display: block;
    }
    .area__list {
      margin-top: 1.5rem;
    }
  }
</style>
