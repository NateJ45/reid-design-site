---
// Foundation, edit with care
// Renders the Home page from its `pageBuilder` layout array of homeSectionMarker
// blocks. Each marker maps to the existing home section component, reading the
// unchanged homePage fields + collections (no content migration). Inserted
// general blocks delegate to SectionRenderer. Falls back to the default order
// when the array is empty.
//
// Retired markers (2026-09-30): 'featuredJournal' and 'press' can still be
// stored on the home page's layout (their option values stay in the schema so
// those rows do not fail validation and block publishing), but the journal and
// press were removed, so both fall through to the final `null` below and
// render nothing.
//
// Instagram feed (2026-09-30): the layouts stored before its marker existed
// do not have it, so placeMarker() puts it just before the service-area line;
// siteSettings.instagramFeedOnHome === false removes it. It renders nothing
// until the build has a feed (INSTAGRAM_TOKEN), so this changes no HTML today.
//
// Concept room (2026-09-30): the same pattern (CLAUDE.md rule 13). A stored
// layout without the `roomStory` row gets it just after "How it works" (i.e.
// before whichever section follows it in DEFAULT_ORDER);
// homePage.roomStoryShow === false removes it. RoomStory renders nothing until
// src/assets/room/ holds a valid manifest and its frames.
import HomeHero from '@/components/home/HomeHero.astro';
import HomeStaci from '@/components/home/HomeStaci.astro';
import HomeWords from '@/components/home/HomeWords.astro';
import TapeProcess from '@/components/home/TapeProcess.astro';
import PaintChips from '@/components/home/PaintChips.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import ServiceAreaCue from '@/components/ServiceAreaCue.astro';
import FinalCta from '@/components/FinalCta.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import InstagramFeed from '@/components/InstagramFeed.astro';
import RoomStory from '@/components/home/RoomStory.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import { placeMarker } from '@/lib/auto-marker';

interface Props {
  sections?: any[];
  page: any;
  siteSettings?: any;
  visible: any;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, siteSettings, visible, editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};

const DEFAULT_ORDER = [
  'hero',
  'meetStaci',
  'featuredWork',
  'testimonials',
  'processPreview',
  'roomStory',
  'services',
  'instagram',
  'serviceAreaCue',
  'finalCta',
].map((section) => ({ _type: 'homeSectionMarker', section }));

const list = (sections ?? []).filter((s) => s && s._type);
const withRoom = placeMarker(list.length > 0 ? list : DEFAULT_ORDER, {
  markerType: 'homeSectionMarker',
  value: 'roomStory',
  show: page?.roomStoryShow,
  // Everything that follows "How it works" in DEFAULT_ORDER, so the room lands
  // right after it (or at the end if none of these is in the stored layout).
  before: ['services', 'instagram', 'serviceAreaCue', 'finalCta'],
});
const rows = placeMarker(withRoom, {
  markerType: 'homeSectionMarker',
  value: 'instagram',
  show: siteSettings?.instagramFeedOnHome,
  before: ['serviceAreaCue', 'finalCta'],
});
---

{
  rows.map((s: any, i: number) => (
    <Wrap {...wrapAttrs(s._key)}>
      {s._type === 'homeSectionMarker' ? (
        s.section === 'hero' ? (
          <HomeHero
            eyebrow={page?.heroEyebrow}
            headline={page?.heroHeadline ?? 'Interior design for homes that feel completely yours.'}
            accent={page?.heroScriptAccent}
            subhead={page?.heroSubhead}
            portrait={page?.heroPortrait}
            fallbackImages={page?.heroImages}
            fallbackImage={page?.heroImage}
            primaryCta={page?.heroPrimaryCta}
            secondaryCta={page?.heroSecondaryCta}
            headingId="hero-heading"
            ratingSettings={siteSettings}
          />
        ) : s.section === 'meetStaci' ? (
          <HomeStaci
            photo={page?.meetStaciPhoto}
            eyebrow={page?.meetStaciEyebrow}
            headline={page?.meetStaciHeadline}
            content={page?.meetStaciContent}
            cta={page?.meetStaciCta}
          />
        ) : s.section === 'featuredWork' ? (
          visible.portfolio ? (
            <FeaturedWork
              projects={page?.featuredProjects ?? []}
              eyebrow={page?.featuredWorkEyebrow ?? 'Recent Work'}
              headline={page?.featuredWorkHeadline ?? 'Rooms that feel finished.'}
              subhead={
                page?.featuredWorkSubhead ??
                'A look at recent projects across Plainfield and the Indianapolis suburbs. Each one starts with a conversation about how the space actually needs to function, then the design follows from there. Open any project to see the brief, the design call, and exactly how the room came together.'
              }
              cta={page?.featuredWorkCta}
            />
          ) : null
        ) : s.section === 'testimonials' ? (
          <HomeWords
            headline={page?.testimonialsHeadline}
            scriptAccent={page?.testimonialsScriptAccent}
            subhead={page?.testimonialsSubhead}
            attribution={page?.testimonialsAttribution}
            featuredQuote={page?.featuredTestimonial}
            gridQuotes={page?.testimonialsToShow ?? []}
            googleReviews={page?.googleReviews ?? []}
            reviewsNote={siteSettings?.reviewsNote}
            googleBusinessUrl={siteSettings?.googleBusinessUrl}
            facebookUrl={siteSettings?.socialFacebook}
            ratingSettings={siteSettings}
          />
        ) : s.section === 'processPreview' ? (
          <TapeProcess
            headline={page?.processPreviewHeadline}
            subhead={page?.processPreviewSubhead}
            steps={page?.processSteps ?? []}
            cta={page?.processPreviewCta}
          />
        ) : s.section === 'roomStory' ? (
          <RoomStory
            headline={page?.roomStoryHeadline}
            scriptAccent={page?.roomStoryScriptAccent}
            intro={page?.roomStoryIntro}
          />
        ) : s.section === 'services' ? (
          <PaintChips
            headline={page?.servicesGridHeadline}
            scriptAccent={page?.servicesGridScriptAccent}
            subhead={page?.servicesGridSubhead}
            services={page?.services ?? []}
            cta={page?.servicesGridCta}
            footnote={page?.servicesGridFootnote}
          />
        ) : s.section === 'instagram' ? (
          <InstagramFeed settings={siteSettings} headingId="home-instagram-heading" />
        ) : s.section === 'serviceAreaCue' ? (
          <ServiceAreaCue text={page?.serviceAreaCue} cities={siteSettings?.serviceAreas} />
        ) : s.section === 'finalCta' ? (
          <FinalCta
            eyebrow={page?.finalCtaEyebrow}
            headline={page?.finalCtaHeadline}
            subhead={page?.finalCtaSubhead}
            cta={page?.finalCta}
            scriptAccent={page?.finalCtaScriptAccent}
            backgroundImage={page?.finalCtaBackgroundImage}
          />
        ) : null
      ) : (
        <SectionRenderer sections={[s]} idPrefix={`home-extra-${i}`} coach={Boolean(editDoc)} />
      )}
    </Wrap>
  ))
}
