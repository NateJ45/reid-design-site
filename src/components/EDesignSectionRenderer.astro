---
// Foundation, edit with care
// Renders the E-Design page's reorderable content sections from its `pageBuilder`
// layout array of eDesignSectionMarker blocks. Hero, the coming-soon state, and
// the closing CTA stay in e-design.astro. Inserted general blocks delegate to
// SectionRenderer.
//
// Phase 2 rebuild (2026-09-30, DESIGN.md "Services and E-Design"): each marker
// now draws a component from src/components/edesign/ (intro as a Zodiak lede,
// how-it-works as a thread of swatch pins, what's-included as sample tags on an Oat
// board, the tiers as paint chips). The FAQ keeps its FaqAccordion island
// exactly as it was called before; only the section around it changed.
import SectionHeading from '@/components/SectionHeading.astro';
import EDesignIntro from '@/components/edesign/EDesignIntro.astro';
import EDesignSteps from '@/components/edesign/EDesignSteps.astro';
import EDesignIncluded from '@/components/edesign/EDesignIncluded.astro';
import EDesignTiers from '@/components/edesign/EDesignTiers.astro';
import FaqAccordion from '@/components/FaqAccordion';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  sections?: any[];
  page: any;
  /**
   * PREVIEW ONLY (added 2026-08-28, PORTS.md card 17). When the Studio preview
   * route passes the document this layout array belongs to, each row is wrapped
   * in a real block box carrying a `data-sanity` attribute, which is what gives
   * the Presentation overlay its in-canvas insert / duplicate / remove /
   * drag-to-reorder controls over this page's `pageBuilder` array.
   *
   * The live page never passes it, and with it absent the wrapper is a
   * `<Fragment>`, which renders nothing. `npm run parity compare` is the gate.
   */
  editDoc?: EditDoc;
}

const { sections = [], page, editDoc } = Astro.props as Props;

// A real element in preview, nothing at all on the live site. Must NOT be
// `display: contents`: the overlay outlines the element's rect and a contents
// element has none.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};
const CONTACT_HREF = '/contact/?type=e-design';

const DEFAULT_ORDER = ['intro', 'howItWorks', 'whatsIncluded', 'tiers', 'faq'].map((section) => ({
  _type: 'eDesignSectionMarker',
  section,
}));

const list = (sections ?? []).filter((s) => s && s._type);
const rows = list.length > 0 ? list : DEFAULT_ORDER;
---

{
  rows.map((s: any, i: number) => (
    <Wrap {...wrapAttrs(s._key)}>
      {s._type === 'eDesignSectionMarker' ? (
        s.section === 'intro' ? (
          <EDesignIntro intro={page.intro} />
        ) : s.section === 'howItWorks' ? (
          <EDesignSteps steps={page.howItWorks} />
        ) : s.section === 'whatsIncluded' ? (
          <EDesignIncluded items={page.whatsIncluded} />
        ) : s.section === 'tiers' ? (
          <EDesignTiers tiers={page.tiers} href={CONTACT_HREF} />
        ) : s.section === 'faq' ? (
          page.faqRefs && page.faqRefs.length > 0 ? (
            <section class="edf" aria-labelledby="edesign-faq-heading">
              <div class="r-wrap edf__grid">
                <div class="edf__head">
                  <SectionHeading headline="E-Design questions" headingId="edesign-faq-heading" />
                </div>
                <div class="edf__list">
                  <FaqAccordion client:visible faqs={page.faqRefs} idPrefix="edesign-faq" />
                </div>
              </div>
            </section>
          ) : null
        ) : null
      ) : (
        <SectionRenderer sections={[s]} idPrefix={`edesign-extra-${i}`} coach={Boolean(editDoc)} />
      )}
    </Wrap>
  ))
}

<style>
  /* FAQ: the question list on paper, its heading held on the left while the
     answers open on the right. The accordion itself is FaqAccordion's. */
  .edf {
    background: var(--color-paper);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .edf__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    align-items: start;
  }
  .edf__head {
    grid-column: 1 / 5;
    position: sticky;
    top: 7rem;
  }
  .edf__list {
    grid-column: 6 / 13;
  }
  @media (max-width: 1023px) {
    .edf__grid {
      display: block;
    }
    .edf__head {
      position: static;
      margin-bottom: 2rem;
    }
  }
</style>
