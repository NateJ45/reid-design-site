---
// Safe to edit by hand
// The service-area map on /contact (2026-09-30 design pass).
//
// Until this pass it was an OpenStreetMap iframe, warmed with a CSS filter.
// Nathan found it ugly (standard map tiles, a green pin, zoom buttons and an
// attribution bar fighting the page), so it is now Staci's area drawn as a
// fine-line sketch map in the house colours (AreaSketchMap.astro), set in the
// house photo frame with a caption and a link out to a real map for anyone
// who wants directions. No iframe, no third-party request, no script, and
// none of the old embed's ~294KB of map JavaScript.
//
// The towns come in from ContactArea (Business info -> Service areas).
import AreaSketchMap from '@/components/AreaSketchMap.astro';

interface Props {
  /** Business info -> Service areas; the first is home base. */
  towns?: string[] | null;
  class?: string;
}

const { towns, class: className } = Astro.props as Props;
const list = (towns ?? []).filter(Boolean);
const home = list[0] ?? 'Plainfield';
// A real map for directions, opened in a new tab.
const mapLink = `https://www.google.com/maps/place/${encodeURIComponent(`${home}, Indiana`)}`;
---

<div class:list={['samap', className]}>
  <AreaSketchMap towns={list} home={home} variant="framed" idPrefix="contact-area" />
  <p class="samap__cap">
    <span>Based in {home}, serving Greater Indianapolis.</span>
    <a href={mapLink} target="_blank" rel="noopener noreferrer" class="r-link">
      Open in Google Maps
    </a>
  </p>
</div>

<style>
  .samap__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin: 1rem 0 0;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }
  .samap__cap a {
    color: var(--color-ink);
  }
</style>
