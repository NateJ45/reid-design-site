---
// Safe to edit by hand
// OpenStreetMap iframe centered on Plainfield, IN with the broader service area visible.
// No API key, no JS, no tracker. The iframe is keyboard-focusable; aria-label
// describes what the visitor is looking at for screen readers.
//
// Restyled 2026-09-30 (phase 2 of the art-direction rebuild): square corners
// in a hairline frame, the tiles warmed toward the linen palette with a CSS
// filter (colour returns on hover or focus, when someone is actually reading
// the map), and a quiet caption line with the "larger map" link under it.
// Props unchanged. Used on /contact.
//
// Loaded on approach (2026-09-30): the iframe ships with NO src and a script
// sets it when the map comes within ~400px of the viewport. loading="lazy" was
// not enough: Chrome's lazy-iframe threshold is generous, so the embed's
// ~294KB of map JavaScript loaded at ~240ms on every /contact and /services
// visit, competing with the hero photo (Lighthouse CI, LCP 4.6s on /contact).
// Without JS the frame stays empty and the "View larger map" link still works.
//
// To recenter or rezoom, get a new bbox from openstreetmap.org/export.

interface Props {
  /** Override the visible bbox if Staci's coverage area shifts. Format: minLon,minLat,maxLon,maxLat */
  bbox?: string;
  /** Marker position. Defaults to Plainfield, IN. */
  markerLat?: number;
  markerLon?: number;
  /** Iframe height in pixels (width is always 100%). */
  height?: number;
  class?: string;
}

const {
  bbox = '-86.85,39.55,-85.95,39.95', // Roughly Plainfield → Noblesville → Greenfield
  markerLat = 39.7042,
  markerLon = -86.3994,
  height = 360,
  class: className,
} = Astro.props as Props;

const src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${markerLat},${markerLon}`;
const link = `https://www.openstreetmap.org/?mlat=${markerLat}&mlon=${markerLon}#map=10/${markerLat}/${markerLon}`;
---

<figure class:list={['samap', className]}>
  <div class="samap__frame">
    <iframe
      data-samap-src={src}
      width="100%"
      height={height}
      title="Map showing Reid Design's service area centered on Plainfield, Indiana"
      aria-label="Map showing Reid Design's service area centered on Plainfield, Indiana, extending through Indianapolis and the northern suburbs"
      loading="lazy"></iframe>
  </div>
  <figcaption class="samap__cap">
    <span>Based in Plainfield, serving Greater Indianapolis.</span>
    <a href={link} target="_blank" rel="noopener noreferrer" class="r-link">View larger map</a>
  </figcaption>
</figure>

<script>
  // Set each map's src only when it nears the viewport (see the header).
  function armMaps() {
    const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-samap-src]');
    if (!frames.length) return;
    const load = (f: HTMLIFrameElement) => {
      if (!f.src && f.dataset.samapSrc) f.src = f.dataset.samapSrc;
    };
    if (!('IntersectionObserver' in window)) return frames.forEach(load);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            load(e.target as HTMLIFrameElement);
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '400px 0px' },
    );
    frames.forEach((f) => io.observe(f));
  }
  armMaps();
  document.addEventListener('astro:page-load', armMaps);
</script>

<style>
  .samap {
    margin: 0;
  }
  .samap__frame {
    padding: 0.5rem;
    background: var(--color-paper);
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 24px 36px -30px rgb(35 30 27 / 0.6);
  }
  .samap__frame iframe {
    display: block;
    border: 0;
    filter: sepia(0.35) saturate(0.7) contrast(0.95);
    transition: filter 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .samap__frame:hover iframe,
  .samap__frame:focus-within iframe {
    filter: none;
  }
  .samap__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-top: 0.85rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }
  .samap__cap a {
    color: var(--color-ink);
  }
</style>
