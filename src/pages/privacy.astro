---
// Safe to edit by hand
// Privacy policy page. Fetches the privacyPage singleton from Sanity for the
// body and lastUpdated date. When the doc doesn't exist yet (or Sanity isn't
// reachable), a plain-voice fallback policy is rendered so the page is always
// live and accurate.
//
// Reuses PortableText for the body when Sanity content is present; falls back
// to static HTML copy for the period before Staci publishes the doc.
//
// "How traffic is measured" is NOT editable copy, on purpose (PORTS.md card 54).
// It renders after either body and is derived from src/lib/analytics-config.ts,
// the same booleans that decide whether Analytics.astro ships a tag, so this page
// can never deny a cookie the site is setting. Until 2026-09-28 it did: GA4 was
// live while the Sanity body said "There is no Google Analytics". Google's own
// Analytics terms require disclosing the use of Analytics and its cookies.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PortableTextStatic from '@/components/PortableTextStatic.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPrivacyPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { hasCfAnalytics, hasGa } from '@/lib/analytics-config';

const [page, siteSettings] = await Promise.all([
  getPrivacyPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title = page?.seoTitle ?? 'Privacy Policy · Reid Design';
const description =
  page?.seoDescription ??
  'How Reid Design handles the information you share when you reach out or subscribe.';

const heroEyebrow = page?.heroEyebrow ?? 'Transparency first.';
const heroHeadline = page?.heroHeadline ?? 'Privacy Policy';
const heroSubhead = page?.heroSubhead ?? '';

// Format the lastUpdated date from Sanity or fall back to a static string.
function formatDate(d?: string): string {
  if (!d) return '';
  const date = new Date(d);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
const lastUpdated = formatDate(page?.lastUpdated);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Privacy Policy', url: `${site.url}/privacy` },
  ]),
];

// Contact email for the fallback copy
const contactEmail = siteSettings?.email ?? 'staci@reiddesignllc.com';

// Whether to use Sanity body content
const hasSanityBody = Boolean(page?.body);

// The derived "How traffic is measured" section borrows the styling of whichever
// body rendered above it, so it reads as part of the policy, not an appendix.
// These match PortableTextStatic's h2 / normal-block classes and the fallback's.
const measuredH2 = hasSanityBody
  ? 'mt-section-md mb-m font-display text-h2 text-foreground'
  : 'mt-l mb-s font-display text-h3 text-foreground';
const measuredP = hasSanityBody ? 'my-m text-foreground' : 'mt-s text-foreground/80';
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  {/* Hero — text variant, short height. */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    headingId="privacy-hero-heading"
    size="short"
  />

  {
    /* No aria-label here on purpose. The hero section is already a landmark
      named by the "Privacy Policy" heading, and labelling this one the same
      thing produced two identically-named regions (axe: landmark-unique). A
      <section> without an accessible name is not exposed as a landmark, which
      is the right answer for a plain content wrapper. */
  }
  <section class="bg-background">
    <div class="mx-auto max-w-3xl px-m py-section-lg">
      {
        lastUpdated && (
          <p class="mb-l text-xs tracking-eyebrow text-foreground/80 uppercase">
            Last updated: {lastUpdated}
          </p>
        )
      }

      {
        hasSanityBody ? (
          <PortableTextStatic value={page!.body} className="prose-friendly" />
        ) : (
          <div class="space-y-l leading-relaxed text-foreground">
            <p class="text-foreground/80">
              This is the privacy policy for Reid Design LLC, a one-person interior design studio
              based in Plainfield, Indiana. The goal here is to be straightforward about what
              information is collected and why.
            </p>

            <div>
              <h2 class="mb-s font-display text-h3 text-foreground">What gets collected</h2>
              <p class="text-foreground/80">
                When you fill out the contact form on this site, you share your name, email address,
                and whatever details you include in your message. That information is used only to
                respond to you and to help plan your project. Nothing else.
              </p>
              <p class="mt-s text-foreground/80">
                If you subscribe to the newsletter, your email address goes to the email marketing
                provider so occasional studio updates, room ideas, and project previews can reach
                you. It is not shared with anyone else.
              </p>
            </div>

            <div>
              <h2 class="mb-s font-display text-h3 text-foreground">What doesn't happen</h2>
              <ul class="list-disc space-y-1 pl-l text-foreground/80">
                <li>Your information is never sold.</li>
                <li>There is no ad targeting or retargeting on this site.</li>
              </ul>
            </div>

            <div>
              <h2 class="mb-s font-display text-h3 text-foreground">
                Unsubscribing from the newsletter
              </h2>
              <p class="text-foreground/80">
                Every email includes an unsubscribe link at the bottom. Click it and you're off the
                list right away. If you run into any trouble, email directly and it'll be handled
                promptly.
              </p>
            </div>

            <div>
              <h2 class="mb-s font-display text-h3 text-foreground">Questions or data requests</h2>
              <p class="text-foreground/80">
                If you have questions about how your information is handled, or want your data
                removed, reach out at{' '}
                <a
                  href={`mailto:${contactEmail}`}
                  class="text-link underline underline-offset-2 transition-colors hover:text-primary"
                >
                  {contactEmail}
                </a>
                . You'll hear back within a few business days.
              </p>
            </div>

            <p class="border-t border-border-soft pt-l text-xs text-foreground/80">
              This policy was last reviewed in May 2026 and will be updated if anything meaningful
              changes about how this site handles your data.
            </p>
          </div>
        )
      }

      {
        /*
        Measurement, described from the build's real configuration rather than
        asserted (see the header). Each branch says what the tool actually does,
        including the cookie.
      */
      }
      <div class="leading-relaxed text-foreground">
        <h2 class={measuredH2}>How traffic is measured</h2>
        {
          !hasGa && !hasCfAnalytics && (
            <p class={measuredP}>
              This site runs no analytics. Visits are not counted, and nothing is stored on your
              device for measurement.
            </p>
          )
        }
        {
          hasCfAnalytics && (
            <p class={measuredP}>
              Page visits are counted with Cloudflare Web Analytics, which sets no cookies and does
              not identify individual visitors.
            </p>
          )
        }
        {
          hasGa && (
            <p class={measuredP}>
              {/* "also" only reads right when the cookieless paragraph above rendered. */}
              Visits are {hasCfAnalytics ? 'also ' : ''}measured with Google Analytics, which sets
              cookies on your device (named <code>_ga</code> and <code>_ga_</code> followed by an
              id) so a returning visit is recognized as the same visitor. It records which pages are
              opened, roughly where the visit came from, and what kind of device was used. It is not
              used for advertising, and the data is not sold. You can block these cookies in your
              browser settings or with a tracker-blocking extension, and the site works exactly the
              same.
            </p>
          )
        }
      </div>
    </div>
  </section>

  {/* Extra sections (optional, editor-added in Studio) */}
  <SectionRenderer sections={page?.additionalSections} idPrefix="privacy-extra" />
</BaseLayout>
