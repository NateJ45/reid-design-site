---
// Safe to edit by hand for copy + structure changes.
// Home page. Renders from the homePage `pageBuilder` layout array via
// HomeSectionRenderer: each built-in section is a marker that reads the homePage
// fields + collections, so Staci can reorder/hide sections and insert library
// blocks. Content is still edited in each section's own tab.
//
// Default order is conversion-tuned: Hero, Meet Staci, Featured Work (visual
// proof), Kind Words (social proof), How It Works, Services + pricing, Featured
// Journal (depth), Press strip, Service-area cue, Final CTA. Featured Work +
// Featured Journal + the press strip auto-populate and self-suppress when empty
// or when their section is turned off.

import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeSectionRenderer from '@/components/HomeSectionRenderer.astro';
import { getHomePage, getSiteSettings, getPressItems } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { site } from '@/data/site';

const [page, siteSettings, pressItems] = await Promise.all([
  getHomePage().catch(() => null),
  getSiteSettings().catch(() => null),
  getPressItems().catch(() => []),
]);

// Unset visibility fields count as visible, so the live site is unchanged until
// Staci explicitly turns something off in Studio.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

const title       = page?.seoTitle       ?? site.name;
const description = page?.seoDescription ?? 'Plainfield interior design for homes that feel genuinely yours.';
---

<BaseLayout {title} {description} {siteSettings} seoImage={page?.seoImage}>
  <HomeSectionRenderer
    sections={page?.pageBuilder}
    page={page}
    siteSettings={siteSettings}
    pressItems={pressItems}
    visible={visible}
  />
</BaseLayout>
