---
// Safe to edit by hand for copy + structure changes.
// Home page. Renders the 9 sections in this order:
//   1. Hero (Plainfield-first eyebrow, headline, two CTAs, background image)
//   2. Meet Staci (photo, intro copy, CTA to About)
//   3. Featured Work (hero project + 3 companion cards, pulled from Sanity)
//   4. Featured Journal (hero entry + 3 companion cards, pulled from Sanity)
//   5. How It Works (4-step process preview, CTA to Process)
//   6. Kind Words (1 featured testimonial + grid)
//   7. How Reid Design Can Help (services grid)
//   8. Service area cue line
//   9. Final CTA (full-bleed)
//
// Sections 3 + 4 auto-populate from the Project + JournalEntry collections,
// ordered featured-first then by publish date. Staci pins a piece via the
// `featured` boolean on the doc; otherwise the section just shows the latest
// 4. Both sections suppress entirely when there's no content yet.
//
// Everything inside each section is editable in Sanity via the homePage singleton plus the
// service / testimonial / processStep / project / journalEntry collections.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import SanityImage from '@/components/SanityImage.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import PortableText from '@/components/PortableText';
import ProcessStep from '@/components/ProcessStep.astro';
import FeaturedTestimonial from '@/components/FeaturedTestimonial.astro';
import TestimonialGrid from '@/components/TestimonialGrid.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ServiceAreaCue from '@/components/ServiceAreaCue.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import FinalCta from '@/components/FinalCta.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import FeaturedJournal from '@/components/FeaturedJournal.astro';

const [page, siteSettings] = await Promise.all([
  getHomePage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

// Top-level SEO meta. Fall back to site identity when Sanity is empty (e.g., before content seed).
const title       = page?.seoTitle       ?? site.name;
const description = page?.seoDescription ?? 'Plainfield interior design for homes that feel genuinely yours.';

// Hero defaults — keep them aligned with CLAUDE.md voice in case the homePage doc is bare.
const heroEyebrow  = page?.heroEyebrow  ?? 'Plainfield, Indiana.';
const heroHeadline = page?.heroHeadline ?? 'Interior design for homes that feel genuinely yours.';
const heroSubhead  = page?.heroSubhead  ?? '';

// Collections: services with showOnHomepage, testimonialsToShow (in order), process steps in order.
const services       = page?.services       ?? [];
const processSteps   = page?.processSteps   ?? [];
const featuredQuote  = page?.featuredTestimonial;
const gridQuotes     = page?.testimonialsToShow ?? [];

// Section copy fallbacks (lock the home page in even before all Sanity copy lands).
const meetStaciEyebrow  = page?.meetStaciEyebrow  ?? 'The Designer.';
const meetStaciHeadline = page?.meetStaciHeadline ?? 'Hi, I’m Staci.';
const meetStaciContent  = page?.meetStaciContent  ?? null;

const processPreviewEyebrow  = page?.processPreviewEyebrow  ?? 'How It Works.';
const processPreviewHeadline = page?.processPreviewHeadline ?? 'A clear path from first conversation to final reveal.';

const testimonialsEyebrow      = page?.testimonialsEyebrow      ?? 'Kind Words.';
const testimonialsHeadline     = page?.testimonialsHeadline     ?? 'Words from real homes.';
const testimonialsAttribution  = page?.testimonialsAttribution;

const servicesGridEyebrow   = page?.servicesGridEyebrow   ?? 'Reid Design.';
const servicesGridHeadline  = page?.servicesGridHeadline  ?? 'How we can help your home.';
const servicesGridSubhead   = page?.servicesGridSubhead;
const servicesGridFootnote  = page?.servicesGridFootnote;

// Featured Work section. Auto-fetches the 4 most-relevant projects
// (featured-pinned items first, then newest). Empty array suppresses the
// section, so the home page degrades gracefully pre-launch.
// Subhead defaults are written for conversion — they explain what a click
// will reveal so visitors are pulled into a case study, not just an image.
const featuredWorkEyebrow  = page?.featuredWorkEyebrow  ?? 'Recent Work.';
const featuredWorkHeadline = page?.featuredWorkHeadline ?? 'Rooms that feel finished.';
const featuredWorkSubhead  = page?.featuredWorkSubhead  ??
  'A look at recent projects across Plainfield and the Indianapolis suburbs. Each one starts with a conversation about how the space actually needs to function, then the design follows from there. Open any project to see the brief, the design call, and exactly how the room came together.';
const featuredProjects     = page?.featuredProjects     ?? [];

// Featured Journal section. Same auto-fetch logic for journal entries.
const featuredJournalEyebrow  = page?.featuredJournalEyebrow  ?? 'From the Journal.';
const featuredJournalHeadline = page?.featuredJournalHeadline ?? 'How I think about design.';
const featuredJournalSubhead  = page?.featuredJournalSubhead  ??
  'Posts on the design moves that change a room, source roundups behind specific projects, and the occasional honest note about what I would do differently. The thinking that informs every consultation.';
const featuredJournalEntries  = page?.featuredJournalEntries  ?? [];
---

<BaseLayout {title} {description} {siteSettings}>
  {/* ------- 1. Hero --------------------------------------------------------- */}
  {/* rotatingWords cycles the first word of the headline once on first visit
      per session, then settles back to the original. Tasteful flourish that
      hints at the design vocabulary without becoming a marquee. Honors
      prefers-reduced-motion. Both rotatingWords and scriptAccent are
      Sanity-editable on homePage; sensible defaults keep the design intact
      if Staci clears the fields. */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage}
    primaryCta={page?.heroPrimaryCta}
    secondaryCta={page?.heroSecondaryCta}
    headingId="hero-heading"
    size="tall"
    rotatingWords={page?.heroRotatingWords ?? ['Lived-in', 'Considered', 'Quiet']}
    scriptAccent={page?.heroScriptAccent}
  />

  {/* ------- 2. Meet Staci --------------------------------------------------- */}
  <section
    class="bg-background"
    aria-labelledby="meet-staci-heading"
  >
    <div data-reveal class="mx-auto max-w-content px-m py-section-lg grid grid-cols-1 md:grid-cols-2 gap-l md:gap-section-md items-center">
      {page?.meetStaciPhoto?.asset ? (
        <div class="order-1 md:order-1">
          {/* width=800 caps the responsive ladder at 800w — the column
              never exceeds ~648 px (45vw of a 1440 px viewport) and
              mobile only needs ~750 px even at high DPR. The previous
              900 px cap was triggering Lighthouse's "image larger than
              displayed" warning by ~112 KB on the Meet Staci photo. */}
          <SanityImage
            source={page.meetStaciPhoto}
            width={800}
            sizes="(min-width: 768px) 45vw, 100vw"
            quality={75}
            class="w-full h-auto rounded-md"
          />
        </div>
      ) : (
        <div class="order-1 md:order-1 aspect-[4/5] bg-muted rounded-md" aria-hidden="true"></div>
      )}

      <div class="order-2 md:order-2">
        <p class="text-xs uppercase tracking-[0.22em] text-foreground/80 mb-s">{meetStaciEyebrow}</p>
        <h2 id="meet-staci-heading" class="font-display text-h2 text-foreground">
          {meetStaciHeadline}
        </h2>
        {meetStaciContent ? (
          <PortableText
            value={meetStaciContent}
            className="mt-m text-foreground/85 text-lg leading-relaxed"
          />
        ) : (
          <p class="mt-m text-foreground/85 text-lg leading-relaxed">
            Plainfield-based interior designer working with homeowners across Greater Indianapolis to
            create spaces that feel calm, considered, and unmistakably theirs.
          </p>
        )}
        <div class="mt-l flex justify-center md:justify-start">
          <CtaLink
            cta={page?.meetStaciCta}
            variant="secondary"
            fallbackHref="/about"
            fallbackLabel="Get to Know Me"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ------- 3. Featured Work ----------------------------------------------- */}
  {/* Auto-populated by query: 1 hero + up to 3 companion cards, ordered
      featured-then-newest. Section is render-suppressed when there are no
      projects yet. Editor controls headline + eyebrow + CTA via homePage. */}
  <FeaturedWork
    projects={featuredProjects}
    eyebrow={featuredWorkEyebrow}
    headline={featuredWorkHeadline}
    subhead={featuredWorkSubhead}
    cta={page?.featuredWorkCta}
  />

  {/* ------- 4. Featured Journal -------------------------------------------- */}
  {/* Mirrors Featured Work — paired editorial rhythm. */}
  <FeaturedJournal
    entries={featuredJournalEntries}
    eyebrow={featuredJournalEyebrow}
    headline={featuredJournalHeadline}
    subhead={featuredJournalSubhead}
    cta={page?.featuredJournalCta}
  />

  {/* ------- 5. How It Works (process preview) ------------------------------- */}
  <section
    class="bg-muted"
    aria-labelledby="process-preview-heading"
  >
    <div data-reveal class="mx-auto max-w-content px-m py-section-lg">
      <SectionHeading
        eyebrow={processPreviewEyebrow}
        headline={processPreviewHeadline}
        headingId="process-preview-heading"
        align="center"
        class="mx-auto"
      />

      {processSteps.length > 0 && (
        <div class="mt-section-lg grid grid-cols-1 md:grid-cols-2 gap-section-md">
          {processSteps.slice(0, 4).map((step: any) => (
            <ProcessStep step={step} variant="preview" />
          ))}
        </div>
      )}

      <div class="mt-section-lg flex justify-center">
        <CtaLink
          cta={page?.processPreviewCta}
          variant="secondary"
          fallbackHref="/process"
          fallbackLabel="See the Full Process"
        />
      </div>
    </div>
  </section>

  {/* ------- 6. Kind Words --------------------------------------------------- */}
  {(featuredQuote || gridQuotes.length > 0) && (
    <section
      class="surface-warm bg-background"
      aria-labelledby="testimonials-heading"
    >
      <div data-reveal class="mx-auto max-w-content px-m py-section-lg">
        <SectionHeading
          eyebrow={testimonialsEyebrow}
          headline={testimonialsHeadline}
          headingId="testimonials-heading"
          align="center"
          class="mx-auto"
        />

        {featuredQuote && (
          <div class="mt-section-lg">
            <FeaturedTestimonial testimonial={featuredQuote} />
          </div>
        )}

        {gridQuotes.length > 0 && (
          <div class="mt-section-lg">
            <TestimonialGrid testimonials={gridQuotes} limit={6} />
          </div>
        )}

        {testimonialsAttribution && (
          <p class="mt-section-md text-center text-sm text-muted-foreground italic">
            {testimonialsAttribution}
          </p>
        )}
      </div>
    </section>
  )}

  {/* ------- 7. How Reid Design Can Help (services grid) -------------------- */}
  <section
    class="surface-warm bg-muted"
    aria-labelledby="services-heading"
  >
    <div data-reveal class="mx-auto max-w-content px-m py-section-lg">
      <SectionHeading
        eyebrow={servicesGridEyebrow}
        headline={servicesGridHeadline}
        subhead={servicesGridSubhead}
        headingId="services-heading"
        align="center"
        class="mx-auto"
      />

      {services.length > 0 && (
        <div class="mt-section-lg grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-m">
          {services.slice(0, 4).map((service: any) => (
            <ServiceCard service={service} compact={true} />
          ))}
        </div>
      )}

      <div class="mt-section-lg flex justify-center">
        <CtaLink
          cta={page?.servicesGridCta}
          variant="secondary"
          fallbackHref="/services"
          fallbackLabel="See All Services"
        />
      </div>

      {servicesGridFootnote && (
        <p class="mt-section-md text-center text-sm text-muted-foreground italic">
          {servicesGridFootnote}
        </p>
      )}
    </div>
  </section>

  {/* Bronze ornament between the services grid and the service-area cue.
      Both sit on muted-toned backgrounds, so the alternating color cadence
      isn't doing the work — this is the case the ornament was built for. */}
  <div class="bg-muted">
    <SectionDivider variant="ornament" />
  </div>

  {/* ------- 8. Service area cue line --------------------------------------- */}
  <ServiceAreaCue
    text={page?.serviceAreaCue}
    cities={siteSettings?.serviceAreas}
    eyebrow="Where Reid Design works"
  />

  {/* ------- 9. Final CTA --------------------------------------------------- */}
  <FinalCta
    eyebrow={page?.finalCtaEyebrow}
    headline={page?.finalCtaHeadline}
    subhead={page?.finalCtaSubhead}
    cta={page?.finalCta}
  />
</BaseLayout>
