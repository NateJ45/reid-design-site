---
// Safe to edit by hand for copy + structure changes.
// Home page. Renders from the homePage `pageBuilder` layout array via
// HomeSectionRenderer: each built-in section is a marker that reads the homePage
// fields + collections, so Staci can reorder/hide sections and insert library
// blocks. Content is still edited in each section's own tab.
//
// Default order is conversion-tuned: Hero, Meet Staci, Featured Work (visual
// proof), Kind Words (social proof), How It Works, Services + pricing,
// Service-area cue, Final CTA. Featured Work auto-populates and self-suppresses
// when the portfolio is turned off. (The Featured Journal and press strip
// sections were removed on 2026-09-30.)

import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeSectionRenderer from '@/components/HomeSectionRenderer.astro';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { site } from '@/data/site';

const [page, siteSettings] = await Promise.all([getHomePage(), getSiteSettings()]);

// Unset visibility fields count as visible, so the live site is unchanged until
// Staci explicitly turns something off in Studio.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

// The header sits on the Walnut hero in cream (Header.astro "On hero") only
// when the hero really is the first section. Same rule HomeSectionRenderer
// uses: no saved layout means the built-in order, which starts with the hero.
const homeRows = (page?.pageBuilder ?? []).filter((s: { _type?: string }) => s && s._type);
const first = homeRows[0] as { _type?: string; section?: string } | undefined;
const headerOverHero =
  homeRows.length === 0 || (first?._type === 'homeSectionMarker' && first.section === 'hero');

const title = page?.seoTitle ?? site.name;
const description =
  page?.seoDescription ?? 'Plainfield interior design for homes that feel completely yours.';
---

<BaseLayout
  {title}
  {description}
  {siteSettings}
  seoImage={page?.seoImage}
  card={{ kind: 'home' }}
  {headerOverHero}
>
  <HomeSectionRenderer
    sections={page?.pageBuilder}
    page={page}
    siteSettings={siteSettings}
    visible={visible}
  />
</BaseLayout>
