---
// Safe to edit by hand for copy + structure changes.
// Process page. Renders from the processPage `pageBuilder` layout array via
// ProcessSectionRenderer: built-in sections are reorderable markers reading the
// processPage fields + collections. Content stays in each section's own tab.
//
// Default order: Hero, Process steps, FAQ block (faqItems flagged for the
// process page), Final CTA.

import BaseLayout from '@/layouts/BaseLayout.astro';
import ProcessSectionRenderer from '@/components/ProcessSectionRenderer.astro';
import { getProcessPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [page, siteSettings] = await Promise.all([
  getProcessPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title = page?.seoTitle ?? 'The Process · Reid Design';
const description =
  page?.seoDescription ??
  "From first call to final reveal — here's exactly how working with Reid Design unfolds.";

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Process', url: `${site.url}/process` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <ProcessSectionRenderer sections={page?.pageBuilder} page={page} />
</BaseLayout>
