---
// Safe to edit by hand for copy + structure changes.
// Services page. Renders from the servicesPage `pageBuilder` layout array via
// ServicesSectionRenderer: built-in sections are reorderable markers that read
// the servicesPage fields, so Staci can reorder/hide sections and insert library
// blocks. Content stays in each section's own tab.
//
// Default order: Hero, Services + prices, Builders & Realtors, Service area +
// travel fees, Satisfaction guarantee, Final CTA. Still injects the Service
// ItemList JSON-LD (serviceListSchema) and the scroll-triggered sticky CTA chip.

import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicesSectionRenderer from '@/components/ServicesSectionRenderer.astro';
import { getServicesPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema, serviceListSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import StickyCTAChip from '@/components/StickyCTAChip';

const [page, siteSettings] = await Promise.all([
  getServicesPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title       = page?.seoTitle       ?? 'Services & Pricing · Reid Design';
const description = page?.seoDescription ?? 'Interior design services for every space and stage — from $150 consultations to full-room design across Greater Indianapolis.';

const services = page?.services ?? [];
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

// Locality for the per-service areaServed, from businessInfo (editable) with the
// stable Plainfield, IN fallback so the structured data is unchanged by default.
const areaServed = `${siteSettings?.city ?? 'Plainfield'} and ${siteSettings?.serviceRegion ?? 'Greater Indianapolis'}`;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Services', url: `${site.url}/services` },
  ]),
  serviceListSchema(services, areaServed),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <ServicesSectionRenderer
    sections={page?.pageBuilder}
    page={page}
    siteSettings={siteSettings}
    visible={visible}
  />

  {/* Sticky contextual CTA — appears past 50% scroll on this long page.
      Label is Sanity-editable on servicesPage; clearing the field hides it. */}
  {page?.stickyCtaLabel !== '' && (
    <StickyCTAChip
      client:idle
      label={page?.stickyCtaLabel ?? 'Ready to talk it through?'}
      href="/contact"
    />
  )}
</BaseLayout>
