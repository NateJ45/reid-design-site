---
// Safe to edit by hand for copy + structure changes.
// Services page. Full tier ladder with prices so visitors can self-qualify before
// they reach the contact form.
//
// Sections:
//   1. Hero (text-only)
//   2. Services list (full cards with features + best-for, anchor-deep-linkable by slug)
//   3. Builder & Realtor partnerships (separate audience block)
//   4. Service area + travel-fee tiers from siteSettings
//   5. Final CTA
//
// Per CLAUDE.md: this page also injects an ItemList of Service JSON-LD with each Service
// linked to the LocalBusiness via @id. serviceListSchema() builds it.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServicesPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema, serviceListSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaLink from '@/components/CtaLink.astro';
import PortableText from '@/components/PortableText';
import FinalCta from '@/components/FinalCta.astro';

const [page, siteSettings] = await Promise.all([
  getServicesPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title       = page?.seoTitle       ?? 'Services & Pricing · Reid Design';
const description = page?.seoDescription ?? 'Interior design services for every space and stage — from $150 consultations to full-room design across Greater Indianapolis.';

const heroEyebrow  = page?.heroEyebrow  ?? 'What We Offer.';
const heroHeadline = page?.heroHeadline ?? 'Design Services for Every Space and Stage.';
const heroSubhead  = page?.heroSubhead  ?? '';

const listEyebrow  = page?.servicesListEyebrow  ?? 'The Tiers.';
const listHeadline = page?.servicesListHeadline ?? 'Find the right fit for your project.';
const listSubhead  = page?.servicesListSubhead;

const services   = page?.services ?? [];
const builders   = page?.builderRealtorSection;
const areaSec    = page?.serviceAreaSection;
const travelFees = page?.travelFees ?? [];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Services', url: `${site.url}/services` },
  ]),
  serviceListSchema(services),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  {/* ------- 1. Hero --------------------------------------------------------- */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    headingId="services-hero-heading"
    size="short"
  />

  {/* ------- 2. Services list ----------------------------------------------- */}
  <section
    class="bg-background"
    aria-labelledby="services-list-heading"
  >
    <div class="mx-auto max-w-content px-m py-section-lg">
      <SectionHeading
        eyebrow={listEyebrow}
        headline={listHeadline}
        subhead={listSubhead}
        headingId="services-list-heading"
        align="center"
        class="mx-auto"
      />

      {services.length > 0 ? (
        <div class="mt-section-lg grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-l">
          {services.map((service: any) => (
            <ServiceCard service={service} withAnchor={true} />
          ))}
        </div>
      ) : (
        <p class="mt-section-lg text-center text-muted-foreground italic">
          Services are being updated. <a href="/contact" class="text-link underline underline-offset-2">Get in touch</a> and we'll talk through what you need.
        </p>
      )}
    </div>
  </section>

  {/* ------- 3. Builders & Realtors ----------------------------------------- */}
  {builders && (builders.headline || builders.description) && (
    <section
      class="bg-muted"
      aria-labelledby="builders-realtors-heading"
    >
      <div class="mx-auto max-w-content px-m py-section-lg">
        <SectionHeading
          eyebrow={builders.eyebrow ?? 'For Professionals.'}
          headline={builders.headline ?? 'Builder & Realtor Partnerships.'}
          headingId="builders-realtors-heading"
          class="max-w-3xl"
        />

        {builders.description && (
          <div class="mt-l max-w-3xl">
            <PortableText
              value={builders.description}
              className="text-foreground/85 text-lg leading-relaxed"
            />
          </div>
        )}

        {(builders.forBuildersText || builders.forRealtorsText || builders.forContractorsText) && (
          <div class="mt-section-md grid grid-cols-1 md:grid-cols-3 gap-l">
            {builders.forBuildersText && (
              <article class="bg-card p-l rounded-md border border-border-soft">
                <p class="text-xs uppercase tracking-widest text-secondary mb-xs">For Builders</p>
                <p class="text-foreground/85 leading-relaxed">{builders.forBuildersText}</p>
              </article>
            )}
            {builders.forRealtorsText && (
              <article class="bg-card p-l rounded-md border border-border-soft">
                <p class="text-xs uppercase tracking-widest text-secondary mb-xs">For Realtors</p>
                <p class="text-foreground/85 leading-relaxed">{builders.forRealtorsText}</p>
              </article>
            )}
            {builders.forContractorsText && (
              <article class="bg-card p-l rounded-md border border-border-soft">
                <p class="text-xs uppercase tracking-widest text-secondary mb-xs">For Contractors</p>
                <p class="text-foreground/85 leading-relaxed">{builders.forContractorsText}</p>
              </article>
            )}
          </div>
        )}

        {builders.cta && (
          <div class="mt-section-md">
            <CtaLink
              cta={builders.cta}
              variant="primary"
              fallbackHref="/contact"
              fallbackLabel="Start a Partnership Conversation"
            />
          </div>
        )}
      </div>
    </section>
  )}

  {/* ------- 4. Service area + travel fees ---------------------------------- */}
  {(areaSec?.headline || travelFees.length > 0) && (
    <section
      class="bg-background"
      aria-labelledby="service-area-heading"
    >
      <div class="mx-auto max-w-content px-m py-section-lg grid grid-cols-1 md:grid-cols-2 gap-l md:gap-section-md items-start">
        <div>
          <SectionHeading
            eyebrow={areaSec?.eyebrow ?? 'Service Area.'}
            headline={areaSec?.headline ?? 'Travel for Out-of-Area Projects.'}
            headingId="service-area-heading"
          />
          {areaSec?.description && (
            <p class="mt-m text-foreground/85 text-lg leading-relaxed">{areaSec.description}</p>
          )}
        </div>

        {travelFees.length > 0 && (
          <div class="bg-muted p-l rounded-md">
            <p class="text-xs uppercase tracking-widest text-secondary mb-m">Travel fee tiers</p>
            <dl class="divide-y divide-border-soft">
              {travelFees.map((tier: any) => (
                <div class="flex items-baseline justify-between py-s gap-m">
                  <dt class="text-foreground/85">{tier.distanceLabel}</dt>
                  <dd class="font-mono text-sm font-semibold text-primary-dark whitespace-nowrap">
                    {tier.fee}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    </section>
  )}

  {/* ------- 5. Final CTA ---------------------------------------------------- */}
  <FinalCta
    eyebrow={page?.finalCtaEyebrow}
    headline={page?.finalCtaHeadline}
    subhead={page?.finalCtaSubhead}
    cta={page?.finalCta}
  />
</BaseLayout>
