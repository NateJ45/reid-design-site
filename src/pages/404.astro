---
// Safe to edit by hand
// Custom 404. Warm, on-brand, clear paths back, plus a search box that hands off
// to /search (Pagefind). The box is a plain GET form, so it works with no JS.
//
// Layout: two-column on desktop (text + photograph), stacked on mobile. The
// photo grounds the page as Reid Design, using a styled vignette from the
// media library (Staci's dogs on the studio sofa) reads as "smart friend, not
// 404 chrome." Asset is referenced by _ref so it pipes through the same
// SanityImage CDN/transform pipeline as every other photo on the site.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';
import SanityImage from '@/components/SanityImage.astro';

const [notFoundPage, siteSettings] = await Promise.all([getNotFoundPage(), getSiteSettings()]);

// Fallback photo: Studio dogs on the sofa, in case the singleton hasn't been
// populated. Sanity singleton always wins if its image field is set.
const fallbackPhoto = {
  asset: { _ref: 'image-ce9be41407b946b7453724575c3cfd7aec2f7c4c-3024x4032-jpg' },
  alt: 'Reid Design studio dogs resting on a sofa.',
};

const seoTitle = notFoundPage?.seoTitle ?? 'Page not found';
const seoDescription =
  notFoundPage?.seoDescription ??
  'That page wandered off. Head back to the homepage or get in touch.';

const eyebrow = notFoundPage?.eyebrow ?? '404';
const headline = notFoundPage?.headline ?? 'That page wandered off.';
const body =
  notFoundPage?.body ??
  "It happens. Maybe a link is old, maybe the URL has a typo. Either way, here's where to head next.";

const primaryLabel = notFoundPage?.primaryCtaLabel ?? 'Back home';
const primaryHref = notFoundPage?.primaryCtaHref ?? '/';
const secondaryLabel = notFoundPage?.secondaryCtaLabel ?? 'Browse the portfolio';
const secondaryHref = notFoundPage?.secondaryCtaHref ?? '/portfolio';
const tertiaryLabel = notFoundPage?.tertiaryCtaLabel ?? 'Get in touch';
const tertiaryHref = notFoundPage?.tertiaryCtaHref ?? '/contact';

const photo = notFoundPage?.heroImage ?? fallbackPhoto;
const caption = notFoundPage?.heroImage?.caption ?? 'From the studio';
---

<BaseLayout title={seoTitle} description={seoDescription} siteSettings={siteSettings} noindex>
  <section
    class="mx-auto grid max-w-content grid-cols-1 items-center gap-section-md px-m py-section-lg md:grid-cols-[1fr_1.1fr]"
    aria-labelledby="not-found-heading"
  >
    {
      /* Text column. Three clear paths back, then a search box (a plain GET form to
        /search, which reads ?q=).
        Centered on mobile so the lone-element page reads as a sympathetic
        "you're off-path" moment; left-aligned on desktop where the
        two-column layout needs the text anchored beside the photo column. */
    }
    <div class="text-center md:text-left">
      <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">{eyebrow}</p>
      <h1
        id="not-found-heading"
        class="font-display text-h1 leading-headline-tight text-foreground"
      >
        {headline}
      </h1>
      <p class="mx-auto mt-m max-w-xl text-lg leading-relaxed text-foreground/80 md:mx-0">
        {body}
      </p>

      {
        /* One tag button, then underline links (the site's one button
          identity, 2026-10-01; reid.css "Buttons"). */
      }
      <div class="mt-l flex flex-wrap items-center justify-center gap-x-l gap-y-m md:justify-start">
        <a href={primaryHref} class="r-btn r-btn--ink">
          {primaryLabel}
        </a>
        <a href={secondaryHref} class="r-link">
          {secondaryLabel}
        </a>
        <a href={tertiaryHref} class="r-link">
          {tertiaryLabel}
        </a>
      </div>

      {/* Search hand-off. Native GET form to /search?q=..., no JS needed. */}
      <form
        action="/search"
        method="get"
        role="search"
        class="mx-auto mt-l flex max-w-md gap-s md:mx-0"
      >
        <label for="notfound-search" class="sr-only">Search the site</label>
        <input
          id="notfound-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Or search the site"
          class="min-w-0 flex-1 rounded-sm border border-border-soft bg-card px-m py-2.5 text-base text-foreground placeholder:text-foreground/60 focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        />
        {
          /* An underline link, not a second button: "Back home" above is
            this screen's one tag (DESIGN.md "Primitives"). */
        }
        <button
          type="submit"
          class="r-link shrink-0 cursor-pointer self-center border-0 bg-transparent px-0 text-foreground"
        >
          Search
        </button>
      </form>
    </div>

    {
      /* Photo column. Stacks above the text on mobile (md:order-2 swaps it on
        desktop so the eye lands on text first, photo balances right). */
    }
    <figure class="order-first md:order-2">
      <SanityImage
        source={photo}
        width={1200}
        sizes="(min-width: 768px) 50vw, 100vw"
        quality={75}
        class="h-auto w-full rounded-md"
      />
      <figcaption class="mt-s text-right text-xs tracking-eyebrow text-foreground/80 uppercase">
        {caption}
      </figcaption>
    </figure>
  </section>
</BaseLayout>
