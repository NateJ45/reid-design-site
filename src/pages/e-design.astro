---
// Safe to edit by hand for copy + structure changes.
// E-Design landing page. The reorderable content sections (intro, how it works,
// what's included, pricing tiers, FAQ) render via EDesignSectionRenderer from the
// eDesignPage `pageBuilder` layout array. The hero, the coming-soon state (when
// the doc is unpublished), and the closing CTA stay here. Primary CTA always
// routes to /contact?type=e-design.

import BaseLayout from '@/layouts/BaseLayout.astro';
import EDesignSectionRenderer from '@/components/EDesignSectionRenderer.astro';
import { getEDesignPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FinalCta from '@/components/FinalCta.astro';

const [page, siteSettings] = await Promise.all([
  getEDesignPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

// Section visibility guard.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.eDesign) return Astro.redirect('/');

const title = page?.seoTitle ?? 'E-Design · Online Interior Design · Reid Design';
const description =
  page?.seoDescription ??
  'Professional interior design delivered remotely. Flat-fee pricing, digital mood boards, and a complete room plan, no travel required.';

const heroEyebrow = page?.heroEyebrow ?? 'Online Design.';
const heroHeadline = page?.heroHeadline ?? 'Beautiful Rooms, No Matter Where You Are.';
const heroSubhead = page?.heroSubhead ?? '';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'E-Design', url: `${site.url}/e-design` },
  ]),
];

// Contact CTA href: always preselects the E-Design option in the form.
const CONTACT_HREF = '/contact?type=e-design';
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  {/* ------- Hero ------------------------------------------------------------ */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage}
    headingId="edesign-hero-heading"
    size="short"
    scriptAccent={page?.heroScriptAccent ?? undefined}
  />

  {/* ------- Content sections (reorderable) or coming-soon state ------------ */}
  {
    !page ? (
      <section class="bg-background" aria-labelledby="edesign-coming-soon">
        <div class="mx-auto max-w-2xl max-w-content px-m py-section-lg text-center">
          <SectionHeading
            eyebrow="Coming Soon."
            headline="E-Design details are on the way."
            subhead="We're pulling together the full overview. In the meantime, reach out. We're happy to walk you through the remote design process directly."
            headingId="edesign-coming-soon"
            align="center"
            class="mx-auto"
          />
          <div class="mt-l flex justify-center">
            <a
              href={CONTACT_HREF}
              class="press-tactile inline-flex min-h-[44px] items-center justify-center rounded-sm bg-primary-dark px-l py-s text-xs font-semibold tracking-[0.18em] text-white uppercase transition-colors hover:bg-accent-dark"
            >
              Inquire about E-Design
            </a>
          </div>
        </div>
      </section>
    ) : (
      <EDesignSectionRenderer sections={page.pageBuilder} page={page} />
    )
  }

  {/* ------- Final CTA ------------------------------------------------------- */}
  {
    page?.finalCta ? (
      <FinalCta
        eyebrow={page.finalCtaEyebrow}
        headline={page.finalCtaHeadline}
        subhead={page.finalCtaSubhead}
        cta={page.finalCta}
        scriptAccent={page.finalCtaScriptAccent}
        backgroundImage={page.finalCtaBackgroundImage}
      />
    ) : (
      <section class="bg-accent-dark text-bg" aria-labelledby="edesign-final-cta">
        <div class="h-0.5 bg-primary" aria-hidden="true" />
        <div class="mx-auto max-w-content px-m py-section-lg text-center">
          <p class="text-xs tracking-[0.22em] text-bg/75 uppercase">Ready to Start?</p>
          <div class="mx-auto mt-s mb-m h-px w-12 bg-bg/40" aria-hidden="true" />
          <h2 id="edesign-final-cta" class="font-display text-h1 leading-tight text-bg">
            Get a Room You Love From Wherever You Are.
          </h2>
          <p class="mx-auto mt-m max-w-2xl text-lg text-bg/85">
            Reach out and we'll walk through what E-Design looks like for your space.
          </p>
          <div class="mt-l flex justify-center">
            <a
              href={CONTACT_HREF}
              class="press-tactile inline-flex min-h-[44px] items-center justify-center rounded-sm bg-primary-dark px-l py-s text-xs font-semibold tracking-[0.18em] text-white uppercase transition-colors hover:bg-primary"
            >
              Inquire about E-Design
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
