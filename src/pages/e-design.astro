---
// Safe to edit by hand for copy + structure changes.
// E-Design landing page. The reorderable content sections (intro, how it works,
// what's included, pricing tiers, FAQ) render via EDesignSectionRenderer from the
// eDesignPage `pageBuilder` layout array. The hero, the coming-soon state (when
// the doc is unpublished), and the closing CTA stay here. Primary CTA always
// routes to /contact?type=e-design.

import BaseLayout from '@/layouts/BaseLayout.astro';
import EDesignSectionRenderer from '@/components/EDesignSectionRenderer.astro';
import { getEDesignPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';

const [page, siteSettings] = await Promise.all([getEDesignPage(), getSiteSettings()]);

// Section visibility guard.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.eDesign) return Astro.redirect('/');

const title = page?.seoTitle ?? 'E-Design · Online Interior Design · Reid Design';
const description =
  page?.seoDescription ??
  'Professional interior design delivered remotely. Flat-fee pricing, digital mood boards, and a complete room plan, no travel required.';

const heroEyebrow = page?.heroEyebrow ?? 'Online Design.';
const heroHeadline = page?.heroHeadline ?? 'Beautiful Rooms, No Matter Where You Are.';
const heroSubhead = page?.heroSubhead ?? '';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'E-Design', url: `${site.url}/e-design/` },
  ]),
];

// Contact CTA href: always preselects the E-Design option in the form.
const CONTACT_HREF = '/contact/?type=e-design';
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  card={{ kind: 'e-design' }}
>
  {/* ------- Hero ------------------------------------------------------------ */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage}
    headingId="edesign-hero-heading"
    size="short"
    scriptAccent={page?.heroScriptAccent ?? undefined}
  />

  {/* ------- Content sections (reorderable) or coming-soon state ------------ */}
  {
    /* Coming soon (no eDesignPage document yet): one quiet fold on linen with
      a single ink button, in the phase 2 vocabulary (DESIGN.md). */
  }
  {
    !page ? (
      <section class="eds-soon" aria-labelledby="edesign-coming-soon">
        <div class="r-wrap">
          <h2 id="edesign-coming-soon" class="r-h2 eds-soon__h">
            E-Design details are <span class="r-accent">on the way.</span>
          </h2>
          <p class="r-lede eds-soon__p">
            We're pulling together the full overview. In the meantime, reach out. We're happy to
            walk you through the remote design process directly.
          </p>
          <a href={CONTACT_HREF} class="r-btn r-btn--ink">
            Inquire about E-Design
            <span class="r-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </section>
    ) : (
      <EDesignSectionRenderer sections={page.pageBuilder} page={page} />
    )
  }

  {/* ------- Final CTA ------------------------------------------------------- */}
  {
    /* With no finalCta set in Sanity, a Walnut close drawn here so the button
      keeps its ?type=e-design (FinalCta's own fallback is plain /contact). */
  }
  {
    page?.finalCta ? (
      <FinalCta
        eyebrow={page.finalCtaEyebrow}
        headline={page.finalCtaHeadline}
        subhead={page.finalCtaSubhead}
        cta={page.finalCta}
        scriptAccent={page.finalCtaScriptAccent}
        backgroundImage={page.finalCtaBackgroundImage}
      />
    ) : (
      <section class="eds-close" aria-labelledby="edesign-final-cta">
        <div class="r-wrap eds-close__grid">
          <h2 id="edesign-final-cta" class="eds-close__h">
            Get a room you love from <span class="r-accent">wherever you are.</span>
          </h2>
          <div>
            <p class="eds-close__p">
              Reach out and we'll walk through what E-Design looks like for your space.
            </p>
            <a href={CONTACT_HREF} class="r-btn r-btn--cream">
              Inquire about E-Design
              <span class="r-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .eds-soon {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .eds-soon__h {
    margin: 0;
    max-width: 14ch;
  }
  .eds-soon__p {
    margin: 1.5rem 0 2.25rem;
  }
  .eds-close {
    background: var(--color-chip-6);
    color: var(--color-cream);
    padding-block: clamp(4.5rem, 10vw, 8rem);
    --accent-color: var(--color-chip-2);
  }
  .eds-close__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .eds-close__h {
    margin: 0;
    font: 300 var(--text-h2) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-wrap: balance;
  }
  .eds-close__p {
    margin: 0 0 1.75rem;
    max-width: 34ch;
    line-height: 1.55;
  }
  @media (max-width: 1023px) {
    .eds-close__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
