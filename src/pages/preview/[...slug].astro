---
/* ============================================================================
   Preview route - draft-aware pages for the Studio Presentation tool
   (ported from ncs-astro-sanity-starter 2026-08-28; PORTS.md cards 10 + 17)
   ============================================================================
   One SSR route renders ANY page in draft mode for the Presentation Tool: it
   reads the perspective cookie, fetches the doc draft-aware (stega on) through
   the SAME query functions the live pages use, and renders it through the SAME
   renderer, so the preview cannot drift from the page.

   THIS SITE HAS THREE PAGE SHAPES, and the preview treats them differently.

    1. BUILDER SINGLETONS - home, about, process, services, e-design. Their
       layout IS a `pageBuilder`
       array of section markers plus inserted library blocks, rendered by a
       MarkerPage with the page's marker map (HomeMarkers and friends). The preview is
       FULL FIDELITY: same query, same renderer, same props. The only things
       missing are the site header, the footer and the polish layer, which
       PreviewLayout deliberately leaves out (see its header for why).

    2. CUSTOM `page` DOCS - the pages Staci builds herself. Their whole body is
       a `pageBuilder` array of library blocks through SectionRenderer. Also
       full fidelity.

    3. BESPOKE SINGLETONS - faq, contact, portfolio, privacy, 404. Their
       middles are drawn in code (the FAQ accordion, the contact form, the
       portfolio grid), so what previews is their
       EDITABLE SURFACE: the hero fields, the "Extra sections" array, and the
       closing call to action, with a note on the page saying so. Converting
       one of these to the page builder would upgrade its preview for free, but
       that conversion is a separate job (PORTS.md card 12) and is deliberately
       not attempted here.

    4. DETAIL PAGES (2026-09-29) - a project (/preview/portfolio/<slug>).
       (Journal posts and guides also previewed here until those sections
       were removed on 2026-09-30.) Rendered through the SAME body component the
       live page uses (src/components/detail/*), so full fidelity minus the
       site chrome. Added because the Studio's "Copy share link" on a project
       used to mint a link to a path this route could not draw (a 404).

   WHICH PATHS THIS ROUTE CAN DRAW is decided in ONE place,
   src/sanity/preview-routes.ts (previewTargetFor). The Presentation resolver,
   the share action, the page navigator and PreviewLayout's click interceptor
   all read the same module, so they cannot promise a preview this route does
   not have. Teach the route a new type there first. noindex comes from
   PreviewLayout.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import { isStudioPreview } from '@/lib/preview-auth';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import HomeMarkers from '@/components/HomeMarkers.astro';
import AboutMarkers from '@/components/AboutMarkers.astro';
import ProcessMarkers from '@/components/ProcessMarkers.astro';
import ServicesMarkers from '@/components/ServicesMarkers.astro';
import EDesignMarkers from '@/components/EDesignMarkers.astro';
import {
  getPreviewClient,
  previewConfig,
  previewUnconfiguredResponse,
  withPostedDraft,
} from '@/lib/cms-preview';
import { readPostedDraft } from '@/lib/preview-posted-draft';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { BUILDER_SINGLETON_TYPES, previewTargetFor } from '@/sanity/preview-routes';
import ProjectDetail from '@/components/detail/ProjectDetail.astro';
import { SHARE_PARAM } from '@/lib/preview-share';
import { sharedPreviewAccess } from '@/lib/preview-share-server';
import {
  getSiteSettings,
  getHomePage,
  getAboutPage,
  getProcessPage,
  getServicesPage,
  getEDesignPage,
  getFaqPage,
  getContactPage,
  getPortfolioPage,
  getPrivacyPage,
  getNotFoundPage,
  getPage,
  getProjectBySlug,
} from '@/lib/queries';

// A clone with no project id or no runtime token: say so, do not 500.
const config = previewConfig();
if (!config.ok) {
  return previewUnconfiguredResponse(config.missing);
}

// The cookie's VALUE is checked, not just its presence (2026-09-29, PORTS.md
// card 57): a presence check let anyone who typed the cookie into their
// browser read drafts through the server's token. isStudioPreview compares it
// with the fingerprint /api/draft-mode/enable writes (src/lib/preview-auth.ts).
// A failed check shows published content, exactly as a missing cookie did.
const draftMode = await isStudioPreview(Astro.cookies.get(perspectiveCookieName)?.value);

// A private preview link (PORTS.md card 117): `?share=<signed token>` shows
// THIS page's draft to someone with no login, until the link expires or Staci
// stops it. It never turns on draftMode: no overlay, no live channel, no stega,
// and everything else on the page (site settings, the header data) stays
// published. src/lib/preview-share.ts is the tested half.
const share = draftMode
  ? null
  : await sharedPreviewAccess(Astro.url.searchParams.get(SHARE_PARAM), Astro.url.pathname);
if (share) Astro.response.headers.set('Referrer-Policy', 'no-referrer');

// Never let a browser cache a preview page (2026-08-28). These SSR responses
// carried NO Cache-Control, so browsers applied heuristic caching - and the
// Presentation iframe kept serving the PREVIOUS deploy's page (stale island
// hashes, invisible new editor features) until the cache aged out. Draft
// content is per-cookie anyway; caching it was never right.
Astro.response.headers.set('Cache-Control', 'no-store');
const slug = ((Astro.params.slug as string | undefined) || '').replace(/\/+$/, '');
// A share link reads drafts WITHOUT stega (no edit markers in a reader's copy).
let client = share
  ? getPreviewClient(true).withConfig({ stega: false })
  : getPreviewClient(draftMode);

// What this path is: a singleton, a detail page, a custom page, or nothing
// this route can draw (src/sanity/preview-routes.ts is the one map).
const target = previewTargetFor(slug);
const singletonType = target?.kind === 'singleton' ? target.type : undefined;
const detailType = target?.kind === 'detail' ? target.type : undefined;

// Singleton documents are pinned to a document id equal to their type (the
// convention src/sanity/structure.ts enforces with documentId(schemaType)), so
// there is no id to look up for those. A custom page's id comes off the doc.
const isBuilderSingleton = BUILDER_SINGLETON_TYPES.has(singletonType ?? '');

// THE STUDIO'S OWN COPY OF THE DRAFT (2026-10-26, PORTS.md card 184). The
// soft refresh POSTs the newest draft the Studio holds, so a structural edit
// (a new section, a toggle) renders without waiting for the autosave and the
// query index. Same cookie gate (draftMode), same one request: the page
// query's projection runs over the posted draft and resolves references from
// the dataset. Used only when it is THIS path's document (the loader's own
// filter names it); anything else reads the stored draft as before. Only the
// page loader gets it (site settings never do). src/lib/preview-posted-draft.ts
// has the checks and the stega; withPostedDraft in src/lib/cms-preview.ts is
// this site's glue, because each page here has its own loader.
const posted = draftMode ? await readPostedDraft(Astro.request, Astro.url.origin) : null;
const postedType = singletonType ?? detailType ?? (target?.kind === 'page' ? 'page' : undefined);

// ---------------------------------------------------------------------------
// Load. Every fetch goes through the DRAFT-aware client, including the shared
// documents (site settings), so an unpublished edit to a service
// or a testimonial shows up in the page that renders it.
// ---------------------------------------------------------------------------
const siteSettings = await getSiteSettings(share ? getPreviewClient(false) : client).catch(
  () => null,
);
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

async function loadPage(): Promise<any> {
  const pc = posted && postedType ? withPostedDraft(client, posted, postedType) : client;
  if (singletonType) {
    const loaders: Record<string, () => Promise<any>> = {
      homePage: () => getHomePage(pc),
      aboutPage: () => getAboutPage(pc),
      processPage: () => getProcessPage(pc),
      servicesPage: () => getServicesPage(pc),
      eDesignPage: () => getEDesignPage(pc),
      faqPage: () => getFaqPage(pc),
      contactPage: () => getContactPage(pc),
      portfolioPage: () => getPortfolioPage(pc),
      privacyPage: () => getPrivacyPage(pc),
      notFoundPage: () => getNotFoundPage(pc),
    };
    return loaders[singletonType]().catch(() => null);
  }
  if (target?.kind === 'detail' && detailType === 'project') {
    return getProjectBySlug(target.slug, pc).catch(() => null);
  }
  if (target?.kind === 'page') {
    return getPage(target.slug, pc).catch(() => null);
  }
  return null;
}

let page: any = await loadPage();

// A share link shows ONE document's draft. If this path now resolves to a
// different document (a web address moved), show the published page instead.
if (
  share &&
  page &&
  (singletonType ?? String(page._id ?? '').replace(/^drafts\./, '')) !== share.d
) {
  client = getPreviewClient(false);
  page = await loadPage();
}
const sharedUntil = share
  ? new Intl.DateTimeFormat('en-US', {
      dateStyle: 'long',
      timeZone: 'America/Indiana/Indianapolis',
    }).format(new Date(share.e * 1000))
  : null;

if (!page) {
  return new Response(
    `No document found for "${slug || 'home'}". Create it in the Studio, then reopen the preview.`,
    { status: 404 },
  );
}

// The doc id the overlay and /preview/live listen on. Singleton ids equal their
// type; a Studio-created page has a random id, and the draft perspective can
// return the drafts. twin's id, so strip the prefix to match both twins.
const pageId = singletonType ?? String(page._id ?? '').replace(/^drafts\./, '');
const docType = singletonType ?? detailType ?? 'page';

// ---------------------------------------------------------------------------
// In-canvas section controls (PORTS.md card 17)
// ---------------------------------------------------------------------------
// The doc and array field each rendered section belongs to. The renderers turn
// this into one `data-sanity` attribute per section, which is what lets the
// Presentation overlay outline a section and offer insert / duplicate / remove
// / drag-to-reorder right in the preview instead of only in the Structure
// panel. See src/lib/preview-edit-attr.ts.
//
// TWO FIELD NAMES on this site: the builder pages and custom pages hold their
// layout in `pageBuilder`; the bespoke pages' editable array is
// `additionalSections`. Point a renderer at the wrong one and its controls edit
// nothing, silently.
//
// Passed regardless of draftMode. The attribute is inert without the Studio's
// overlay, this route is noindex and never part of the static build, and a
// preview opened before the cookie lands would otherwise render uncontrollable
// sections.
const builderEditDoc = { id: pageId, type: docType, field: 'pageBuilder' as const };
const extraEditDoc = { id: pageId, type: docType, field: 'additionalSections' as const };

// The bespoke pages carry hero fields; the 404 page names them differently.
const heroHeadline = page.heroHeadline || page.headline || '';
const heroEyebrow = page.heroEyebrow || page.eyebrow || '';
const isBespoke = Boolean(singletonType) && !isBuilderSingleton;
const showHero = isBespoke && Boolean(heroHeadline);
const hasFinalCta = isBespoke && Boolean(page.finalCtaHeadline || page.finalCta);
const extraSections = page.additionalSections ?? [];

const label = page.title || page.seoTitle || heroHeadline || slug || 'Home';
const title = `${label} - Preview`;
---

<PreviewLayout {title} {draftMode} {pageId}>
  {sharedUntil && (
    <div class="mx-auto max-w-3xl px-4 pt-6" data-share-banner>
      <p class="rounded-md border border-rule bg-bg-soft px-4 py-3 text-sm text-ink">
        You are looking at a draft of this page that has not been published yet. This private link
        works until {sharedUntil}.
      </p>
    </div>
  )}
  {singletonType === 'homePage' && (
    <HomeMarkers
      sections={page.pageBuilder}
      page={page}
      siteSettings={siteSettings}
      visible={visible}
      editDoc={builderEditDoc}
    />
  )}
  {singletonType === 'aboutPage' && (
    <AboutMarkers
      sections={page.pageBuilder}
      page={page}
      philosophyPoints={page.philosophyPoints ?? []}
      siteSettings={siteSettings}
      editDoc={builderEditDoc}
    />
  )}
  {singletonType === 'processPage' && (
    <ProcessMarkers sections={page.pageBuilder} page={page} editDoc={builderEditDoc} />
  )}
  {singletonType === 'servicesPage' && (
    <ServicesMarkers
      sections={page.pageBuilder}
      page={page}
      siteSettings={siteSettings}
      visible={visible}
      editDoc={builderEditDoc}
    />
  )}
  {singletonType === 'eDesignPage' && (
    <EDesignMarkers sections={page.pageBuilder} page={page} editDoc={builderEditDoc} />
  )}

  {/* Detail pages: the same body component the live page renders. */}
  {detailType === 'project' && <ProjectDetail project={page} />}

  {/* Custom page built in the page builder. */}
  {target?.kind === 'page' && (
    <SectionRenderer sections={page.pageBuilder} idPrefix="page" editDoc={builderEditDoc} />
  )}

  {/* Bespoke page: hero, a note about what is not shown, the Extra sections
      array, and the closing call to action. */}
  {showHero && (
    <Hero
      eyebrow={heroEyebrow}
      headline={heroHeadline}
      subhead={page.heroSubhead ?? ''}
      backgroundImage={page.heroImage ?? null}
      scriptAccent={page.heroScriptAccent}
      headingId="preview-hero"
      size="short"
    />
  )}
  {isBespoke && (
    <div class="mx-auto max-w-3xl px-m py-m">
      <p class="rounded-md border border-border-soft bg-bg-soft px-m py-s text-sm text-foreground/80">
        This page's middle is drawn in code (the list, form or grid it is built around), so it
        previews as its editable surface only: the hero above, any extra sections below, and the
        closing call to action. The parts held in code render on the live site.
      </p>
    </div>
  )}
  {isBespoke && (
    <SectionRenderer sections={extraSections} idPrefix="preview-extra" editDoc={extraEditDoc} />
  )}
  {hasFinalCta && (
    <FinalCta
      eyebrow={page.finalCtaEyebrow}
      headline={page.finalCtaHeadline}
      subhead={page.finalCtaSubhead}
      scriptAccent={page.finalCtaScriptAccent}
      cta={page.finalCta ?? null}
      backgroundImage={page.finalCtaBackgroundImage ?? null}
    />
  )}
</PreviewLayout>
