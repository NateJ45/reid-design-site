---
// Safe to edit by hand for copy + structure changes.
// Contact page. Rebuilt 2026-09-30 (phase 2 of the art-direction rebuild;
// DESIGN.md "Contact and Privacy"). Reads the contactPage singleton, plus two
// read-only borrowings: Staci's portrait from the home page and the
// consultation price from the services list (so the price is never typed twice).
//
// Rhythm, top to bottom:
//   Hero (linen, framed photo)                       Hero.astro
//   The note: form left, Staci + ways in right       ContactForm + contact/ContactAside
//   Rather talk first? (ink, Calendly on click)      contact/CallBand
//   What happens next (paper, pinned steps)          PostInquiryRoadmap (or the legacy rich text)
//   Where Staci works (linen, towns + map)           contact/ContactArea
//   Latest Instagram posts (Linen chip, optional)    InstagramFeed (nothing without a feed)
//   Extra sections (Studio, optional)                SectionRenderer
//
// The form's behaviour (fields, Web3Forms payload, validation, honeypot,
// ?type= preselect, draft autosave) lives in ContactForm.tsx and did not change
// in the rebuild; only its look and grouping did.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContactPage, getHomePage, getServicesPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import Hero from '@/components/Hero.astro';
import PortableTextStatic from '@/components/PortableTextStatic.astro';
import ContactForm from '@/components/ContactForm';
import PostInquiryRoadmap from '@/components/PostInquiryRoadmap.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import ContactAside from '@/components/contact/ContactAside.astro';
import CallBand from '@/components/contact/CallBand.astro';
import ContactArea from '@/components/contact/ContactArea.astro';
import InstagramFeed from '@/components/InstagramFeed.astro';
// The coffee mug doodle beside "A note to Staci" (2026-09-30).
import Doodle from '@/components/Doodle.astro';

const [page, siteSettings, home, servicesPage] = await Promise.all([
  getContactPage(),
  getSiteSettings(),
  getHomePage(),
  getServicesPage(),
]);

const title = page?.seoTitle ?? 'Contact Reid Design';
const description =
  page?.seoDescription ??
  'Start a conversation about your space. Plainfield, Indianapolis, and the surrounding suburbs.';

const heroEyebrow = page?.heroEyebrow ?? 'Request a Consultation.';
const heroHeadline = page?.heroHeadline ?? 'Start the Conversation.';
const heroSubhead = page?.heroSubhead ?? '';
const formIntroNote = page?.formIntroNote ?? '';

const schedulingLink = page?.schedulingLink ?? import.meta.env.PUBLIC_CALENDLY_URL;
const schedulingLinkLabel = page?.schedulingLinkLabel ?? 'Schedule a 20-minute discovery call.';

const availability = page?.availabilityNote ?? siteSettings?.availabilityStatus;
const email = siteSettings?.email;
const phone = siteSettings?.phone;

// Satisfaction guarantee. Renders beside the form's opening when set in siteSettings.
const satisfactionGuarantee = siteSettings?.satisfactionGuarantee;

// Staci's portrait: the home "Meet Staci" photo, else the home hero portrait.
// Nothing on either = the aside simply has no photo.
const staciPhoto = home?.meetStaciPhoto?.asset
  ? home.meetStaciPhoto
  : home?.heroPortrait?.asset
    ? home.heroPortrait
    : null;

// The consultation price, said out loud. Found by slug or name so a renamed
// service still matches; no match (or no price) = no price tag at all.
interface ServiceLite {
  name?: string | null;
  slug?: { current?: string | null } | null;
  price?: string | null;
}
const services: ServiceLite[] = Array.isArray(servicesPage?.services) ? servicesPage.services : [];
const consult = services.find(
  (s) => /consult/i.test(s?.slug?.current ?? '') || /consult/i.test(s?.name ?? ''),
);

// Post-inquiry roadmap: prefer the structured steps when present; fall through
// to the legacy whatToExpectContent when the array is empty.
interface RoadmapStep {
  title?: string;
  body?: string;
  timeEstimate?: string;
}
const roadmapSteps = ((page?.postInquiryRoadmap ?? []) as RoadmapStep[]).filter((s) =>
  s?.title?.trim(),
);
const hasRoadmap = roadmapSteps.length > 0;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Contact', url: `${site.url}/contact` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  card={{ headline: page?.heroHeadline, image: page?.heroImage }}
>
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage}
    headingId="contact-hero-heading"
    size="short"
    scriptAccent={page?.heroScriptAccent}
  />

  {/* ---- The note ---------------------------------------------------- */}
  <section class="note" aria-labelledby="contact-form-heading">
    <div class="r-wrap note__grid">
      <header class="note__head">
        <Doodle name="coffee-mug" class="note__doodle" />
        <h2 id="contact-form-heading" class="r-h2 note__h">
          A note to <span class="r-accent">Staci</span>
        </h2>
        {formIntroNote && <p class="note__intro">{formIntroNote}</p>}
        {satisfactionGuarantee && <p class="note__promise">{satisfactionGuarantee}</p>}
      </header>

      <div class="note__aside">
        <ContactAside
          photo={staciPhoto}
          availability={availability}
          consultPrice={consult?.price}
          consultName={consult?.name}
          email={email}
          phone={phone}
          hasScheduling={Boolean(schedulingLink)}
          ratingSettings={siteSettings}
        />
      </div>

      <div class="note__form">
        <ContactForm
          client:visible
          projectTypes={page?.formProjectTypeOptions}
          locations={page?.formLocationOptions}
          budgets={page?.formBudgetOptions}
          timelines={page?.formTimelineOptions}
          sources={page?.formSourceOptions}
        />
      </div>
    </div>
  </section>

  {/* ---- Rather talk first? ------------------------------------------ */}
  {schedulingLink && <CallBand url={schedulingLink} label={schedulingLinkLabel} />}

  {/* ---- What happens next ------------------------------------------- */}
  {
    hasRoadmap ? (
      <PostInquiryRoadmap
        steps={roadmapSteps}
        eyebrow={page?.whatToExpectEyebrow}
        headline={page?.whatToExpectHeadline}
      />
    ) : (
      page?.whatToExpectContent && (
        <section
          class="expect"
          aria-labelledby={page.whatToExpectHeadline ? 'expect-heading' : undefined}
        >
          <div class="r-wrap expect__grid">
            <div>
              {page.whatToExpectEyebrow && (
                <p class="expect__eyebrow">{page.whatToExpectEyebrow}</p>
              )}
              {page.whatToExpectHeadline && (
                <h2 id="expect-heading" class="r-h2 expect__h">
                  {page.whatToExpectHeadline}
                </h2>
              )}
            </div>
            <PortableTextStatic value={page.whatToExpectContent} className="expect__body" />
          </div>
        </section>
      )
    )
  }

  {/* ---- Where Staci works ------------------------------------------- */}
  <ContactArea towns={siteSettings?.serviceAreas} />

  {
    /* ---- Latest Instagram posts (2026-09-30). Renders nothing without a
      feed; Site settings > Instagram feed > "Show on the Contact page". ---- */
  }
  {
    siteSettings?.instagramFeedOnContact !== false && (
      <InstagramFeed settings={siteSettings} headingId="contact-instagram-heading" />
    )
  }

  {/* Extra sections (optional, editor-added in Studio) */}
  <SectionRenderer sections={page?.additionalSections} idPrefix="contact-extra" />
</BaseLayout>

<style>
  /* ---- The note: heading + form on the left, Staci on the right. Grid
     areas put the aside BEFORE the form on phones (so email and phone are
     close to the top) and beside it, sticky, on desktop. ---- */
  .note {
    padding-block: clamp(4rem, 8vw, 7rem) clamp(4.5rem, 9vw, 8rem);
  }
  .note__grid {
    display: grid;
    grid-template-areas:
      'head'
      'aside'
      'form';
    gap: 2.5rem;
  }
  .note__head {
    position: relative;
    grid-area: head;
  }
  /* The coffee a consultation starts with, steaming beside the heading. */
  .note__head :global(.note__doodle) {
    position: absolute;
    top: clamp(-4.5rem, -6vw, -2.5rem);
    right: 0;
    width: clamp(4.5rem, 8vw, 6.5rem);
    rotate: -8deg;
  }
  .note__aside {
    grid-area: aside;
  }
  .note__form {
    grid-area: form;
    min-width: 0;
  }
  .note__h {
    margin: 0;
    color: var(--color-ink);
  }
  .note__intro {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    font: 300 clamp(1.2rem, 1.05rem + 0.45vw, 1.45rem) / 1.45 var(--font-display);
    letter-spacing: -0.005em;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .note__promise {
    margin: 1.5rem 0 0;
    max-width: 56ch;
    /* A soft tint, not a side stripe (DESIGN.md absolute bans). */
    padding: 0.9rem 1.1rem;
    border-radius: 0.5rem;
    background: var(--color-chip-1);
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    .note__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      grid-template-areas:
        'head aside'
        'form aside';
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 7vw, 7rem);
      row-gap: 3rem;
    }
    .note__aside {
      position: sticky;
      top: 6.5rem;
      align-self: start;
    }
  }

  /* ---- Legacy "what to expect" rich text (only when no roadmap steps) ---- */
  .expect {
    background: var(--color-paper);
    border-block: 1px solid var(--color-rule);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .expect__grid {
    display: grid;
    gap: 2rem;
  }
  .expect__eyebrow {
    margin: 0 0 1.25rem;
    font: 500 0.95rem/1.35 var(--font-body);
    color: var(--color-chip-7);
  }
  .expect__h {
    margin: 0;
    max-width: 16ch;
  }
  .expect :global(.expect__body) {
    max-width: 62ch;
    color: var(--color-ink-2);
  }
  @media (min-width: 1024px) {
    .expect__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2rem, 6vw, 6rem);
    }
  }
</style>
