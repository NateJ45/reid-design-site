---
// Safe to edit by hand for copy + structure changes.
// Pulls contactPage singleton from Sanity, renders form + scheduling link + map + sidebar.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContactPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import PortableText from '@/components/PortableText';
import ContactForm from '@/components/ContactForm';
import CopyEmailButton from '@/components/CopyEmailButton';
import ServiceAreaMap from '@/components/ServiceAreaMap.astro';

const [page, siteSettings] = await Promise.all([
  getContactPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title = page?.seoTitle ?? 'Contact Reid Design';
const description = page?.seoDescription ?? 'Start a conversation about your space. Plainfield, Indianapolis, and the surrounding suburbs.';

const heroEyebrow   = page?.heroEyebrow   ?? 'Request a Consultation.';
const heroHeadline  = page?.heroHeadline  ?? 'Start the Conversation.';
const heroSubhead   = page?.heroSubhead   ?? '';
const formIntroNote = page?.formIntroNote ?? '';

const schedulingLink      = page?.schedulingLink;
const schedulingLinkLabel = page?.schedulingLinkLabel ?? 'Schedule a 20-minute discovery call.';

const availability = page?.availabilityNote ?? siteSettings?.availabilityStatus;
const email        = siteSettings?.email;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Contact', url: `${site.url}/contact` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <section class="mx-auto max-w-content px-m py-section-md">
    <p class="text-xs uppercase tracking-widest text-secondary mb-s">{heroEyebrow}</p>
    <h1 class="font-display text-h1 text-foreground">{heroHeadline}</h1>
    {heroSubhead && <p class="mt-m max-w-2xl text-lg text-foreground/80">{heroSubhead}</p>}
  </section>

  <section class="mx-auto max-w-content px-m pb-section-lg grid grid-cols-1 lg:grid-cols-3 gap-section-md">
    {/* Form column */}
    <div class="lg:col-span-2">
      {formIntroNote && (
        <p class="mb-m text-foreground/80 text-base">{formIntroNote}</p>
      )}

      <ContactForm client:visible projectTypes={page?.formProjectTypeOptions} />

      {page?.whatToExpectContent && (
        <div class="mt-section-lg border-t border-border-soft pt-l">
          {page.whatToExpectEyebrow && (
            <p class="text-xs uppercase tracking-[0.22em] text-secondary mb-s">{page.whatToExpectEyebrow}</p>
          )}
          {page.whatToExpectHeadline && (
            <h2 class="font-display text-h3 text-foreground">{page.whatToExpectHeadline}</h2>
          )}
          <PortableText client:visible value={page.whatToExpectContent} className="mt-s text-foreground/90" />
        </div>
      )}
    </div>

    {/* Sidebar */}
    <aside class="space-y-l">
      {availability && (
        <div class="flex items-center gap-2 text-sm text-foreground">
          <span class="inline-block w-2 h-2 rounded-full bg-tertiary" aria-hidden="true"></span>
          <span>{availability}</span>
        </div>
      )}

      {email && (
        <div>
          <p class="text-xs uppercase tracking-widest text-secondary mb-xs">Email</p>
          <CopyEmailButton client:visible email={email} variant="link" />
        </div>
      )}

      {schedulingLink && (
        <div>
          <p class="text-xs uppercase tracking-widest text-secondary mb-xs">Prefer to schedule?</p>
          <a
            href={schedulingLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-m py-s border border-primary text-link hover:bg-accent transition-colors text-sm font-semibold"
          >
            {schedulingLinkLabel}
          </a>
        </div>
      )}

      {siteSettings?.serviceAreas && siteSettings.serviceAreas.length > 0 && (
        <div>
          <p class="text-xs uppercase tracking-widest text-secondary mb-xs">Service area</p>
          <ul class="text-sm text-foreground space-y-0.5">
            {siteSettings.serviceAreas.slice(0, 8).map((area: string) => <li>{area}</li>)}
          </ul>
        </div>
      )}

      <div>
        <p class="text-xs uppercase tracking-widest text-secondary mb-xs">Where Reid Design is</p>
        <ServiceAreaMap height={280} />
      </div>
    </aside>
  </section>
</BaseLayout>
