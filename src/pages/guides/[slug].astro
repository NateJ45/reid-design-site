---
// Safe to edit by hand
// /guides/[slug] — Individual lead magnet landing + gated download page.
//
// Static prerender: getAllLeadMagnetSlugs() returns only published magnets.
// When there are zero published magnets this file generates 0 paths — the
// build still succeeds because getStaticPaths returning an empty array is valid.
//
// Layout:
//   - Hero (text variant) with the magnet title + summary as headline/subhead
//   - Two-column at lg: cover image on the left, gate form on the right
//   - On success the form reveals the download link (fileUrl from Sanity asset)
//   - FinalCta closes the page
//
// The body is src/components/detail/GuideDetail.astro (2026-09-29), shared
// with the Studio's draft preview. This file keeps the static paths, the SEO,
// the JSON-LD and the share card.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLeadMagnet, getAllLeadMagnetSlugs, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import GuideDetail from '@/components/detail/GuideDetail.astro';

export async function getStaticPaths() {
  const [slugs, settings] = await Promise.all([getAllLeadMagnetSlugs(), getSiteSettings()]);
  // When guides is off, return no paths — detail pages 404.
  const visible = getSectionVisibility(settings?.sectionVisibility);
  if (!visible.guides) return [];
  // Zero published magnets → zero paths → index still builds (empty state).
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const [magnet, siteSettings] = await Promise.all([getLeadMagnet(slug), getSiteSettings()]);

// Listed by getStaticPaths but empty on the per-page read: in a production
// build that is a failed or racing read, not a real 404, so refuse to
// publish the page as a redirect (2026-09-29, PORTS.md card 56). Dev keeps
// the redirect so local work without a configured project still runs.
if (!magnet && import.meta.env.PROD) {
  throw new Error(
    `Guide "${slug}" was listed but came back empty; refusing to publish it as a redirect`,
  );
}
// If the magnet isn't found (shouldn't happen via static paths, but be safe)
// redirect to the index rather than rendering a broken page.
if (!magnet) {
  return Astro.redirect('/guides', 302);
}

const title = magnet.seoTitle ?? `${magnet.title}: A Free Guide from Reid Design`;
const description =
  magnet.seoDescription ??
  magnet.summary ??
  `Download the free "${magnet.title}" guide from Reid Design. Practical advice for your home.`;

// The ESP form-action URL comes from siteSettings (shared across all forms).
const formActionUrl = siteSettings?.newsletter?.formActionUrl ?? null;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Guides', url: `${site.url}/guides` },
    { name: magnet.title ?? 'Guide', url: `${site.url}/guides/${slug}` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  card={{ headline: magnet.title, kicker: 'Free guide', image: magnet.coverImage }}
>
  <GuideDetail {magnet} {slug} {formActionUrl} />
</BaseLayout>
