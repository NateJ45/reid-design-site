---
// Custom pages Staci builds in the page builder. Generates one static page per
// published `page` document at /<slug>. Built-in routes (about.astro, etc.) are
// explicit files and take precedence; the schema blocks reserved slugs, and the
// filter below is a second guard so a custom page can never shadow a real route.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPage, getAllPageSlugs, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

export async function getStaticPaths() {
  // Defined inside getStaticPaths: Astro runs this function in an isolated
  // scope that cannot see component-level consts. Mirrors the page schema's
  // reserved list so a custom page can never shadow a built-in route. The
  // "retired" slugs are the sections removed on 2026-09-30: public/_redirects
  // forwards them, so they stay reserved (see preview-routes.ts).
  const RESERVED = new Set([
    'about',
    'services',
    'process',
    'portfolio',
    'faq',
    'contact',
    'journal', // retired
    'e-design',
    'shop', // retired
    'gift-certificates', // retired
    'quiz', // retired
    'calculator', // retired
    'resources', // retired
    'guides', // retired
    'press', // retired
    'privacy',
    'search',
    'pagefind',
    '404',
    'sitemap-index.xml',
  ]);
  const slugs = await getAllPageSlugs();
  return slugs.filter((slug) => !RESERVED.has(slug)).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [pageDoc, siteSettings] = await Promise.all([getPage(slug as string), getSiteSettings()]);

// Listed by getStaticPaths but empty on the per-page read: in a production
// build that is a failed or racing read, not a real 404, so refuse to
// publish the page as a redirect (2026-09-29, PORTS.md card 56). Dev keeps
// the redirect so local work without a configured project still runs.
if (!pageDoc && import.meta.env.PROD) {
  throw new Error(
    `Page "${slug}" was listed but came back empty; refusing to publish it as a redirect`,
  );
}
if (!pageDoc) return Astro.redirect('/404');

const title = pageDoc.seoTitle ?? pageDoc.title ?? 'Reid Design';

// Every page needs one h1. A page that opens with a hero block gets it from
// the hero; one that opens with anything else (a text section, a gallery)
// gets the page title as a visually hidden h1, so screen readers and search
// engines still find the page's name (2026-09-30, phase 2 of the rebuild).
const blocks: any[] = Array.isArray(pageDoc.pageBuilder) ? pageDoc.pageBuilder : [];
const opensWithHero = blocks.find((b) => b?._type)?._type === 'heroSection';
const description = pageDoc.seoDescription ?? '';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: pageDoc.title ?? 'Page', url: `${site.url}/${pageDoc.slug}/` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={pageDoc.seoImage}
  card={{ label: pageDoc.title }}
>
  {!opensWithHero && <h1 class="sr-only">{pageDoc.title ?? title}</h1>}
  <SectionRenderer sections={pageDoc.pageBuilder} idPrefix="page" />
</BaseLayout>
