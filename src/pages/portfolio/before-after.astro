---
// Safe to edit by hand
// Before/After gallery page. Lists all projects that have at least one
// before/after pair, ordered by displayOrder then publishedAt.
//
// Uses the existing BeforeAfterSlider.tsx React island (client:visible).
// Projects without pairs are excluded at the query layer (getProjectsWithBeforeAfter).
// Graceful empty state when no projects have pairs yet.
//
// Rebuilt 2026-09-30 (phase 2 of the art-direction rebuild; DESIGN.md "Blocks
// and Portfolio"): the interior Hero opens the page (same fields as before),
// then one entry per project, title in Zodiak on the left and the link to the
// full case study on the right, its sliders full width underneath, entries
// split by a hairline.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjectsWithBeforeAfter, getSiteSettings, getPortfolioPage } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import BeforeAfterSlider from '@/components/BeforeAfterSlider';
import Hero from '@/components/Hero.astro';
import CtaLink from '@/components/CtaLink.astro';
import { humanizeEnum } from '@/components/portfolio/labels';

const [projects, siteSettings, page] = await Promise.all([
  getProjectsWithBeforeAfter(),
  getSiteSettings(),
  getPortfolioPage(),
]);

// Section visibility guard — before/after is part of the portfolio section.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.portfolio) return Astro.redirect('/');

const title = page?.beforeAfterSeoTitle ?? 'Before & After · Reid Design Portfolio';
const description =
  page?.beforeAfterSeoDescription ??
  'Side-by-side before and after reveals from Reid Design projects across Plainfield and Indianapolis.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Portfolio', url: `${site.url}/portfolio` },
    { name: 'Before & After', url: `${site.url}/portfolio/before-after` },
  ]),
];

const projectsArr: any[] = Array.isArray(projects) ? projects : [];
const hasProjects = projectsArr.length > 0;
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <Hero
    eyebrow={page?.beforeAfterEyebrow ?? 'Before and after'}
    headline={page?.beforeAfterHeadline ?? 'See the difference.'}
    subhead={page?.beforeAfterSubhead ??
      'Drag the slider to reveal what changed. Each pair is from a real project, same room, same angle.'}
    headingId="before-after-heading"
  />

  {
    hasProjects ? (
      <section class="ba" aria-labelledby="before-after-projects-heading">
        <div class="r-wrap">
          <h2 id="before-after-projects-heading" class="sr-only">
            Before and after project sliders
          </h2>
          <p class="ba__back">
            <a href="/portfolio" class="r-link">
              <span aria-hidden="true">← </span>All projects
            </a>
          </p>

          {projectsArr.map((project) => {
            const pairs = (project.beforeAfters ?? []).filter(
              (p: any) => p?.beforeImage?.asset && p?.afterImage?.asset,
            );
            if (pairs.length === 0) return null;
            const meta = [humanizeEnum(project.roomType), project.location]
              .filter(Boolean)
              .join(' · ');

            return (
              <article class="ba__entry" aria-labelledby={`project-${project._id}-heading`}>
                <div class="ba__head">
                  <div>
                    <h3 id={`project-${project._id}-heading`} class="ba__title">
                      {project.title}
                    </h3>
                    {meta && <p class="ba__meta">{meta}</p>}
                  </div>
                  {project.slug && (
                    <a href={`/portfolio/${project.slug}`} class="r-link ba__link">
                      The full project <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>

                {/* One slider per pair; several pairs stack. */}
                <div class="ba__pairs">
                  {pairs.map((pair: any) => (
                    <BeforeAfterSlider
                      client:visible
                      beforeImage={pair.beforeImage}
                      afterImage={pair.afterImage}
                      caption={pair.caption}
                    />
                  ))}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ) : (
      <section class="ba" aria-labelledby="before-after-empty-heading">
        <div class="r-wrap ba__empty">
          <h2 id="before-after-empty-heading" class="ba__empty-h">
            Before and afters are coming soon.
          </h2>
          <p class="ba__empty-p">
            These side-by-side reveals take time to photograph well. Check back once the first
            projects wrap up, or browse the full portfolio in the meantime.
          </p>
          <div class="ba__empty-cta">
            <CtaLink
              variant="secondary"
              fallbackHref="/portfolio"
              fallbackLabel="Browse the portfolio"
            />
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .ba {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(5rem, 10vw, 8.5rem);
  }
  .ba__back {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-size: 0.98rem;
  }
  .ba__back .r-link {
    color: var(--color-ink);
  }
  .ba__entry {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-rule);
  }
  .ba__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: 1.75rem;
  }
  .ba__title {
    margin: 0;
    font: 300 clamp(1.8rem, 1.2rem + 1.9vw, 3rem) / 1.05 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .ba__meta {
    margin: 0.6rem 0 0;
    font: 500 0.95rem/1.35 var(--font-body);
    color: var(--color-chip-7);
  }
  .ba__link {
    color: var(--color-ink);
  }
  .ba__pairs {
    min-width: 0;
    max-width: 66rem;
  }
  /* Desktop: the project's name and link on the left, its sliders on the
     right (an upright pair is height-capped, so it never runs off alone). */
  @media (min-width: 1024px) {
    .ba__entry {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
    .ba__head {
      display: grid;
      justify-content: start;
      gap: 1.25rem;
      position: sticky;
      top: 7rem;
    }
  }
  .ba__pairs :global(figure:first-child) {
    margin-top: 0;
  }
  .ba__pairs :global(figure:last-child) {
    margin-bottom: 0;
  }

  .ba__empty-h {
    margin: 0;
    max-width: 18ch;
    font: 300 clamp(2rem, 1.3rem + 2.4vw, 3.4rem) / 1.02 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .ba__empty-p {
    margin: 1.25rem 0 0;
    max-width: 48ch;
    color: var(--color-ink-2);
  }
  .ba__empty-cta {
    margin-top: 1.75rem;
  }
</style>
