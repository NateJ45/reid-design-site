---
// Safe to edit by hand
// Portfolio: a heading and Staci's photos, nothing else (2026-11-04, her call).
// The photos are `portfolioPage.gallery`, added in the Studio. Room stories are
// retired: src/pages/portfolio/[slug].astro stays but builds no pages, because
// no `project` is published and the Studio no longer offers them.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPortfolioPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import PhotoWall from '@/components/portfolio/PhotoWall.astro';
import { DEFAULT_CTA_LABEL } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([getPortfolioPage(), getSiteSettings()]);

// Section visibility guard. Redirect home when portfolio is explicitly off.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.portfolio) return Astro.redirect('/');

const title = page?.seoTitle ?? 'Portfolio';
const description =
  page?.seoDescription ??
  'A look at recent Reid Design projects across Plainfield and the Indianapolis area.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Portfolio', url: `${site.url}/portfolio/` },
  ]),
];

const photos = (page?.gallery ?? []).filter((p: { asset?: unknown }) => p?.asset);
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  card={{ kind: 'portfolio', image: photos[0] ?? page?.heroImage }}
>
  <section class="pf" aria-labelledby="portfolio-heading">
    <div class="r-wrap">
      <h1 id="portfolio-heading" class="r-display pf__h">
        Portfolio
      </h1>
      {photos.length > 0 ? (
        <PhotoWall photos={photos} />
      ) : (
        <div class="pf__empty">
          <p class="pf__empty-p">New photos are on the way.</p>
          <a class="r-btn r-btn--ink" href="/contact/">
            {siteSettings?.primaryCtaLabel ?? DEFAULT_CTA_LABEL}
            <span class="r-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .pf {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 9vw, 7.5rem);
  }
  .pf__h {
    margin: 0 0 clamp(1.75rem, 4vw, 3rem);
    color: var(--color-ink);
  }
  .pf__empty-p {
    margin: 0 0 1.75rem;
    color: var(--color-ink-2);
  }
</style>
