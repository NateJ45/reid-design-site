---
// Safe to edit by hand
// Portfolio index. Grid of project cards, sorted by displayOrder then publishedAt.
// Renders an empty state when no projects exist yet (launch state).
//
// Rebuilt 2026-09-30 (phase 2 of the art-direction rebuild; DESIGN.md "Blocks
// and Portfolio"). The filter tabs and the varied, image-led grid live in
// src/components/portfolio/ProjectBoard.astro; this page keeps the hero, the
// empty state and the Extra sections zone.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllProjects, getPortfolioPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import Hero from '@/components/Hero.astro';
import ProjectBoard from '@/components/portfolio/ProjectBoard.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';

const [projects, page, siteSettings] = await Promise.all([
  getAllProjects(),
  getPortfolioPage(),
  getSiteSettings(),
]);

// Section visibility guard. Redirect home when portfolio is explicitly off.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.portfolio) return Astro.redirect('/');

const title = page?.seoTitle ?? 'Portfolio';
const description =
  page?.seoDescription ??
  'A look at recent Reid Design projects across Plainfield and the Indianapolis area.';

const heroEyebrow = page?.heroEyebrow ?? 'Recent work';
const heroHeadline = page?.heroHeadline ?? 'Projects across Plainfield and Indianapolis.';
const heroSubhead =
  page?.heroSubhead ??
  'A look at how rooms come together. Each project starts with a conversation about how the space needs to function, then works back from there.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Portfolio', url: `${site.url}/portfolio` },
  ]),
];

const hasProjects = Array.isArray(projects) && projects.length > 0;

// Portfolio index now backed by the portfolioPage singleton. The fallback
// asset _ref preserves the previous hero image for any environment where the
// singleton hasn't been populated yet, defensive only; the patch script
// backfills the field on launch.
const fallbackHeroImage = {
  asset: { _ref: 'image-95cf8e9cffed47a11f9f74386dc1659d3b45ffba-4736x4280-jpg' },
  alt: 'Reid Design kitchen with island and woven counter stools.',
};
const heroBackground = page?.heroImage ?? fallbackHeroImage;
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  card={{ kind: 'portfolio', image: page?.heroImage }}
>
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={heroBackground}
    headingId="portfolio-hero-heading"
    size="short"
    scriptAccent={page?.heroScriptAccent ?? 'Plainfield'}
  />

  {
    hasProjects ? (
      <ProjectBoard projects={projects} />
    ) : (
      <section class="pf pf--empty" aria-labelledby="portfolio-empty-heading">
        <div class="r-wrap pf__empty">
          <div class="pf__chips" aria-hidden="true">
            <span />
            <span />
            <span />
            <span />
          </div>
          <div>
            <h2 id="portfolio-empty-heading" class="pf__empty-h">
              Case studies are on the way.
            </h2>
            <p class="pf__empty-p">
              The first projects are wrapping up now, with full write-ups to follow. Until then,
              here is{' '}
              <a href="/process" class="r-link">
                how Reid Design works
              </a>
              , or you can
              <a href="/contact" class="r-link">
                start a conversation about your space
              </a>
              .
            </p>
          </div>
        </div>
      </section>
    )
  }

  {/* Extra sections (optional, editor-added in Studio) */}
  <SectionRenderer sections={page?.additionalSections} idPrefix="portfolio-extra" />
</BaseLayout>

<style>
  .pf {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(5rem, 10vw, 8.5rem);
  }
  /* ---- No projects yet ---- */
  .pf__empty {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .pf__empty-h {
    margin: 0;
    font: 300 clamp(2rem, 1.3rem + 2.4vw, 3.4rem) / 1.02 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .pf__empty-p {
    margin: 1.25rem 0 0;
    max-width: 48ch;
    color: var(--color-ink-2);
  }
  .pf__empty-p .r-link {
    color: var(--color-ink);
  }
  /* Four blank chips off the ramp, waiting for their photos. */
  .pf__chips {
    display: flex;
    gap: 0.6rem;
  }
  .pf__chips span {
    position: relative;
    width: clamp(3.5rem, 9vw, 5.5rem);
    aspect-ratio: 4 / 5;
  }
  .pf__chips span::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    translate: -50% 0;
    background: var(--color-bg);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.2);
  }
  .pf__chips span:nth-child(1) {
    background: var(--color-chip-1);
  }
  .pf__chips span:nth-child(2) {
    background: var(--color-chip-2);
    translate: 0 0.75rem;
  }
  .pf__chips span:nth-child(3) {
    background: var(--color-chip-3);
  }
  .pf__chips span:nth-child(4) {
    background: var(--color-chip-4);
    translate: 0 0.75rem;
  }
  @media (min-width: 1024px) {
    .pf__empty {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 6rem);
    }
  }
</style>
