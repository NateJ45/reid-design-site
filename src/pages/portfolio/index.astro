---
// Safe to edit by hand
// Portfolio index. Grid of project cards, sorted by displayOrder then publishedAt.
// Renders an empty state when no projects exist yet (launch state).

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllProjects, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import Hero from '@/components/Hero.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const [projects, siteSettings] = await Promise.all([
  getAllProjects().catch(() => []),
  getSiteSettings().catch(() => null),
]);

const title = 'Portfolio';
const description = 'A look at recent Reid Design projects across Plainfield and the Indianapolis area.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Portfolio', url: `${site.url}/portfolio` },
  ]),
];

const hasProjects = Array.isArray(projects) && projects.length > 0;

// Portfolio doesn't have a Sanity singleton (just a hardcoded landing). The hero
// background is referenced by asset _ref so it pipes through the same SanityImage
// CDN/transform path as the other page heros. To swap the image, change the _ref.
const heroBackground = {
  asset: { _ref: 'image-95cf8e9cffed47a11f9f74386dc1659d3b45ffba-4736x4280-jpg' },
  alt: 'Reid Design kitchen with island and woven counter stools.',
};
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <Hero
    eyebrow="Recent work"
    headline="Projects across Plainfield and Indianapolis."
    subhead="A look at how rooms come together. Each project starts with a conversation about how the space needs to function, then works back from there."
    backgroundImage={heroBackground}
    headingId="portfolio-hero-heading"
    size="short"
  />

  {hasProjects ? (
    <section class="mx-auto max-w-content px-m pb-section-lg">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-l list-none p-0">
        {projects.map((p: any) => (
          <li><ProjectCard project={p} /></li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="mx-auto max-w-content px-m pb-section-lg">
      <div class="rounded-md border border-border bg-muted p-section-md text-center">
        <h2 class="font-display text-h3 text-foreground">Case studies are on the way.</h2>
        <p class="mt-s text-foreground/80 max-w-prose mx-auto">
          The first projects under Reid Design LLC are wrapping up now, with full write-ups
          coming shortly. In the meantime, you can read about
          <a href="/process" class="text-link underline underline-offset-2 hover:text-primary"> how Reid Design works</a>
          or
          <a href="/contact" class="text-link underline underline-offset-2 hover:text-primary"> start a conversation about your space</a>.
        </p>
      </div>
    </section>
  )}
</BaseLayout>
