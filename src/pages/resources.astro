---
// Safe to edit by hand
// /resources — Resources hub page. Renders from the resourcesPage `pageBuilder`
// layout array via ResourcesSectionRenderer; built-in sections (hero, intro,
// cards) are reorderable markers reading the resourcesPage fields. The cards
// section falls back to nav-style default cards and filters by section
// visibility. Content stays in each section's own tab.

import BaseLayout from '@/layouts/BaseLayout.astro';
import ResourcesSectionRenderer from '@/components/ResourcesSectionRenderer.astro';
import { getResourcesPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [page, siteSettings] = await Promise.all([
  getResourcesPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

// Section visibility guard.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.resources) return Astro.redirect('/');

const title = page?.seoTitle ?? 'Free Resources · Reid Design';
const description =
  page?.seoDescription ??
  'Planning tools and guides from Reid Design: the style quiz, budget calculator, free guides, FAQ, and more.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Resources', url: `${site.url}/resources` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <ResourcesSectionRenderer sections={page?.pageBuilder} page={page} visible={visible} />
</BaseLayout>
