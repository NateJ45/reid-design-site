---
// Safe to edit by hand for copy + structure changes.
// About page. Renders from the aboutPage `pageBuilder` layout array via
// AboutSectionRenderer: each built-in section is a marker that reads the
// aboutPage fields, so Staci can reorder or remove sections (and insert library
// blocks) without any content moving. The words and photos are still edited in
// the named field tabs (Story, Philosophy, Personal, Stats, Final CTA).
//
// Section order (default): Hero, Story, Philosophy, Personal, Press strip
// (when press is on + populated), Stats, Final CTA.

import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutSectionRenderer from '@/components/AboutSectionRenderer.astro';
import { getAboutPage, getSiteSettings, getPressItems } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [page, siteSettings, pressItems] = await Promise.all([
  getAboutPage().catch(() => null),
  getSiteSettings().catch(() => null),
  getPressItems().catch(() => []),
]);

const visible = getSectionVisibility(siteSettings?.sectionVisibility);

const title       = page?.seoTitle       ?? 'About Staci · Reid Design';
const description = page?.seoDescription ?? 'Meet Staci Perkins, founder of Reid Design — a Plainfield-based interior designer working across Greater Indianapolis.';

const philosophyPoints = page?.philosophyPoints ?? [];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'About', url: `${site.url}/about` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <AboutSectionRenderer
    sections={page?.pageBuilder}
    page={page}
    philosophyPoints={philosophyPoints}
    pressItems={pressItems}
    visiblePress={visible.press}
  />
</BaseLayout>
