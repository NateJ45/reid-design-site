---
// Safe to edit by hand for copy + structure changes.
// About page. Tells Staci's story so visitors feel they're hiring a person, not a brand.
//
// Sections:
//   1. Hero (text-only)
//   2. Story (Staci portrait + intro story PortableText + attribution + background line + service area mention)
//   3. Philosophy (3+ philosophyPoint documents in a responsive grid)
//   4. Final CTA
//
// Per CLAUDE.md: the page is fully editable through the aboutPage singleton plus the
// philosophyPoint collection. Order in the grid follows philosophyPoint.displayOrder.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAboutPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import FinalCta from '@/components/FinalCta.astro';

const [page, siteSettings] = await Promise.all([
  getAboutPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title       = page?.seoTitle       ?? 'About Staci · Reid Design';
const description = page?.seoDescription ?? 'Meet Staci Perkins, founder of Reid Design — a Plainfield-based interior designer working across Greater Indianapolis.';

const heroEyebrow  = page?.heroEyebrow  ?? 'The Designer.';
const heroHeadline = page?.heroHeadline ?? 'People Hire People.';
const heroSubhead  = page?.heroSubhead  ?? "Here's who you'd be working with.";

const storyEyebrow  = page?.storyEyebrow  ?? 'My Story.';
const storyHeadline = page?.storyHeadline ?? 'Why I Started Reid Design.';

const philosophyEyebrow  = page?.philosophyEyebrow  ?? 'How I Work.';
const philosophyHeadline = page?.philosophyHeadline ?? 'A philosophy that puts your home first.';

const philosophyPoints = page?.philosophyPoints ?? [];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'About', url: `${site.url}/about` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  {/* ------- 1. Hero --------------------------------------------------------- */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    headingId="about-hero-heading"
    size="short"
  />

  {/* ------- 2. Story -------------------------------------------------------- */}
  <section
    class="bg-background"
    aria-labelledby="about-story-heading"
  >
    <div class="mx-auto max-w-content px-m py-2xl grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-l md:gap-xl items-start">
      <div class="md:sticky md:top-2xl">
        {page?.staciPhoto?.asset ? (
          <SanityImage
            source={page.staciPhoto}
            width={900}
            sizes="(min-width: 768px) 40vw, 100vw"
            quality={75}
            class="w-full h-auto rounded-md"
          />
        ) : (
          <div class="aspect-[4/5] bg-muted rounded-md" aria-hidden="true"></div>
        )}
        {page?.staciAttribution && (
          <p class="mt-s text-xs uppercase tracking-widest text-secondary">
            {page.staciAttribution}
          </p>
        )}
      </div>

      <div>
        <SectionHeading
          eyebrow={storyEyebrow}
          headline={storyHeadline}
          headingId="about-story-heading"
        />

        {page?.storyContent && (
          <PortableText
            value={page.storyContent}
            className="mt-l text-foreground/85 text-lg leading-relaxed"
          />
        )}

        {(page?.backgroundLine || page?.serviceAreaMention) && (
          <div class="mt-xl pt-l border-t border-border-soft space-y-m text-foreground/80">
            {page?.backgroundLine && (
              <p>
                <span class="block text-xs uppercase tracking-widest text-secondary mb-xs">Background</span>
                {page.backgroundLine}
              </p>
            )}
            {page?.serviceAreaMention && (
              <p>
                <span class="block text-xs uppercase tracking-widest text-secondary mb-xs">Service area</span>
                {page.serviceAreaMention}
              </p>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  {/* ------- 3. Philosophy --------------------------------------------------- */}
  {philosophyPoints.length > 0 && (
    <section
      class="bg-muted"
      aria-labelledby="about-philosophy-heading"
    >
      <div class="mx-auto max-w-content px-m py-2xl">
        <SectionHeading
          eyebrow={philosophyEyebrow}
          headline={philosophyHeadline}
          headingId="about-philosophy-heading"
          align="center"
          class="mx-auto"
        />

        <div class="mt-2xl grid grid-cols-1 md:grid-cols-3 gap-l">
          {philosophyPoints.map((point: any, idx: number) => (
            <article class="bg-card p-l rounded-md border border-border-soft">
              <p
                class="font-display text-h2 text-primary-dark/70 leading-none mb-s"
                aria-hidden="true"
              >
                {String((point.displayOrder ?? idx + 1)).padStart(2, '0')}
              </p>
              <h3 class="font-display text-h3 text-foreground">{point.title}</h3>
              <p class="mt-s text-foreground/85 leading-relaxed">{point.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ------- 4. Final CTA ---------------------------------------------------- */}
  <FinalCta
    eyebrow={page?.finalCtaEyebrow}
    headline={page?.finalCtaHeadline}
    subhead={page?.finalCtaSubhead}
    cta={page?.finalCta}
  />
</BaseLayout>
