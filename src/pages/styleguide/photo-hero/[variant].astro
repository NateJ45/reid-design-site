---
// Foundation, edit with care
//
// THE PHOTO HERO WALL (PORTS.md card 189): the opening banner in its "Photo behind the words"
// style, rendered through the real SectionRenderer with FIXED data, one page per variant because a
// page has one h1:
//   /styleguide/photo-hero/home/  a tall hero with the short-facts card and a silent clip (and a
//                                 phone copy), the home-page shape (Reid draws its real Home with home/HomeHero.astro; this is the opt-in interior style, card 189);
//   /styleguide/photo-hero/page/  a short hero with no card and no clip, the inner-page shape;
//   /styleguide/photo-hero/services/  the Services page's own hero marker (ServicesMarkers.astro)
//                                 with Opening style set to Photo behind the words (phase D,
//                                 2026-10-28): the editor choice on Services and E-Design, which
//                                 pass the page's heroStyle to Hero.astro. Home keeps its framed crop.
// Each is followed by a text block so the hero is seen against the page under it.
//
// It is the fixture tests/photo-hero.spec.ts drives. The image is a fake Sanity reference and the
// clips fake Sanity file URLs: the spec answers the CDN with tests/visual/fixtures/layout-hero.jpg
// and hero-clip.mp4, so no network is needed. noindex, out of the sitemap ('/styleguide' is
// filtered in astro.config.mjs) and under a reserved slug, like the other walls.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import ServicesMarkers from '@/components/ServicesMarkers.astro';
import { site } from '@/data/site';

export function getStaticPaths() {
  return [
    { params: { variant: 'home' } },
    { params: { variant: 'page' } },
    { params: { variant: 'services' } },
  ];
}

const { variant } = Astro.params;

const image = {
  _type: 'image',
  alt: 'A bright, styled living room with a bay window',
  asset: {
    _type: 'reference',
    _ref: 'image-0123456789abcdef0123456789abcdef01234567-1600x900-jpg',
  },
};
const cta = (label: string) => ({
  _type: 'ctaBlock',
  label,
  linkType: 'external',
  externalUrl: '#',
});
const FILES = 'https://cdn.sanity.io/files/fixture/production';

const HOME = {
  _type: 'heroSection',
  _key: 'hero',
  heroStyle: 'photo',
  size: 'tall',
  eyebrow: 'Interior design',
  headline: 'A clear promise in a few words',
  // The accent word (card 203): Waterfall, still white over the shade.
  scriptAccent: 'promise',
  subhead: 'Fixture words: a wide, sharp photo of a finished room under the words.',
  backgroundImage: image,
  primaryCta: cta('Book a consultation'),
  secondaryCta: cta('See the process'),
  glance: {
    title: 'At a glance',
    lines: ['Open Monday to Friday, 9 to 5', 'Accepting new clients', 'Serving the local area'],
    link: cta('Ask a question'),
  },
  backgroundVideo: { url: `${FILES}/hero-clip.mp4`, mimeType: 'video/mp4' },
  backgroundVideoPhone: { url: `${FILES}/hero-clip-640.mp4`, mimeType: 'video/mp4' },
};

const PAGE = {
  _type: 'heroSection',
  _key: 'hero',
  heroStyle: 'photo',
  size: 'short',
  eyebrow: 'A room story',
  headline: 'A room story opening',
  subhead: 'Fixture words: the same photo treatment, a little shorter, with no card.',
  backgroundImage: image,
  primaryCta: cta('Start your project'),
};

// The Services page document as the marker reads it: its hero fields with the photo style on.
const SERVICES_PAGE = {
  heroEyebrow: 'What we offer',
  heroHeadline: 'Design services for every space and stage',
  heroSubhead: 'Fixture words: the page hero itself, opened on a wide photograph.',
  heroImage: image,
  heroScriptAccent: 'every',
  heroStyle: 'photo',
};
const SECTIONS: Record<string, unknown>[] = [
  ...(variant === 'services' ? [] : [variant === 'home' ? HOME : PAGE]),
  {
    _type: 'richTextSection',
    _key: 'after',
    heading: 'The page carries on',
    body: [
      {
        _type: 'block',
        _key: 'p1',
        style: 'normal',
        markDefs: [],
        children: [
          {
            _type: 'span',
            _key: 'p1-s',
            marks: [],
            text: 'A plain block under the hero, so the band is seen against the page.',
          },
        ],
      },
    ],
  },
];
---

<BaseLayout
  title={`Photo hero wall | ${site.name}`}
  description="Fixed-data wall of the photo hero. Not for visitors."
  noindex
>
  {variant === 'services' && <ServicesMarkers section="hero" page={SERVICES_PAGE} visible={{}} />}
  <SectionRenderer sections={SECTIONS} idPrefix="photo-hero" />
</BaseLayout>
