---
// Safe to edit by hand
// =============================================================================
// /styleguide/sections/ - every page-builder block, once, with fixed data
// =============================================================================
// The authoring kit (PORTS.md card 109). `npm run thumbnails` shoots each block
// here into public/section-thumbnails/<type>.jpg, which is the picture Staci
// sees in the "+ Add item" grid. Built through the real SectionRenderer, so the
// pictures are Reid Design's own look. Not for visitors: noindex, left out of
// the sitemap (astro.config.mjs) and linked from nowhere.
//
// Every block in sections.ts pageSectionSchemas needs a fixture here and a
// picture on disk; src/lib/authoring.test.ts fails otherwise. The Instagram
// feed is the one exception: it draws the live feed, which a fixture cannot
// stand in for, so its picture (public/section-thumbnails/instagramSection.jpg)
// is drawn by scripts/shoot-section-thumbnails.mjs from tiles of the fixture
// photo. Photos here point at a made-up Sanity asset; the thumbnail script
// answers every cdn.sanity.io request with tests/fixtures/section-photo.jpg.
//
// The words obey the service scope like every template: styling around the
// existing basics, never cabinets, tile, appliances or layout changes.
// =============================================================================
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';

const image = (alt = 'A styled living room') => ({
  _type: 'image',
  alt,
  asset: {
    _type: 'reference',
    _ref: 'image-0123456789abcdef0123456789abcdef01234567-1600x900-jpg',
  },
});

const para = (key: string, text: string) => ({
  _type: 'block',
  _key: key,
  style: 'normal',
  markDefs: [],
  children: [{ _type: 'span', _key: `${key}-s`, marks: [], text }],
});

const cta = (label: string) => ({
  _type: 'ctaBlock',
  label,
  linkType: 'external',
  externalUrl: '#',
});

const SECTIONS: Record<string, unknown>[] = [
  {
    _type: 'heroSection',
    _key: 'hero',
    eyebrow: 'In-home service',
    headline: 'A room that finally feels like yours',
    subhead: 'Furniture, color and the finishing pieces, chosen around how you live.',
    size: 'short',
    backgroundImage: image(),
    primaryCta: cta('Book a consultation'),
  },
  {
    _type: 'richTextSection',
    _key: 'text',
    heading: 'What you get',
    width: 'narrow',
    align: 'left',
    body: [
      para('t1', 'A written plan for the room, a shopping list with links, and a follow-up call.'),
      para('t2', 'Everything works around the pieces you already love.'),
    ],
  },
  {
    _type: 'imageTextSection',
    _key: 'imagetext',
    imageSide: 'right',
    heading: 'How the visit works',
    body: [
      para('i1', 'We walk the room together, try paint samples against your light, and measure.'),
    ],
    image: image(),
    cta: cta('See the services'),
  },
  {
    _type: 'gallerySection',
    _key: 'gallery',
    heading: 'Recent rooms',
    columns: 3,
    images: [image('Living room'), image('Sitting area'), image('Reading corner')].map(
      (img, i) => ({ ...img, _key: `g${i}` }),
    ),
  },
  {
    _type: 'quoteSection',
    _key: 'quote',
    quote: 'A client in their own words, set large: what working together was like.',
    attribution: 'A client',
    detail: 'Their town and room',
  },
  {
    _type: 'statSection',
    _key: 'stats',
    heading: 'At a glance',
    stats: [
      { _key: 's1', _type: 'statItem', number: 3, label: 'Ways to work together' },
      { _key: 's2', _type: 'statItem', number: 1, label: 'Visit to get started' },
    ],
  },
  {
    _type: 'ctaBandSection',
    _key: 'ctaband',
    headline: 'Ready to talk about your room?',
    subhead: 'Start with a consultation in your home.',
    cta: cta('Book a consultation'),
  },
  {
    _type: 'videoSection',
    _key: 'video',
    heading: 'A room, start to finish',
    url: 'https://www.youtube.com/watch?v=aaaaaaaaaaa',
    caption: 'A short caption under the video.',
  },
  { _type: 'spacerSection', _key: 'spacer', variant: 'ornament' },
  {
    _type: 'pressSection',
    _key: 'press',
    count: 4,
    // Fixture only: the live section reads the Press list.
    mentions: [
      {
        _id: 'p1',
        outlet: 'A city magazine',
        date: '2026-09-01',
        url: 'https://example.com',
        quote: 'A line the writer said about the studio.',
      },
      { _id: 'p2', outlet: 'A local paper', date: '2026-05-12' },
      { _id: 'p3', outlet: 'A design podcast', date: '2026-02-20' },
    ],
  },
  { _type: 'instagramSection', _key: 'instagram' },
];
---

<BaseLayout
  title="Sections wall | Reid Design"
  description="Fixed-data wall of every page-builder section. Not for visitors."
  noindex
>
  {SECTIONS.map((section) => (
    <div data-section-type={String(section._type)}>
      <SectionRenderer
        sections={[section]}
        idPrefix={`fx-${String(section._key)}`}
        anchors="numbered"
      />
    </div>
  ))}
</BaseLayout>
