---
// Foundation, edit with care
// Site-wide layout. Provides:
//   - <html lang>, document head, OG/Twitter meta
//   - Anti-FOUC theme bootstrap (runs before first paint)
//   - cdn.sanity.io preconnect (no font preload: measured, it cost LCP)
//   - The icon set links (favicon.svg/.ico, apple-touch-icon, manifest)
//   - Analytics (GA4 + Cloudflare beacon, both conditional) via Analytics.astro
//   - Astro View Transitions <ClientRouter />
//   - Skip-to-main link, Header, <main id="main">, Footer
//   - Lenis smooth scroll init (prefers-reduced-motion-aware)
//   - BackToTop React island

import { ClientRouter } from 'astro:transitions';
import { site } from '@/data/site';
import { urlFor } from '@/lib/sanity';
import { localBusinessSchema } from '@/lib/schemas';
import { getNavPages, getAnnouncements, getChromeFacts } from '@/lib/queries';
import {
  CARD_SPEC_ID,
  cardContent,
  ogCardPath,
  serializeSpec,
  type CardInput,
  type CardPhoto,
  type CardSpec,
} from '@/lib/og-card';
import { resolveChromeFacts } from '@/lib/chrome-facts';
import { doodlesForPage } from '@/lib/doodle-map';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Announcements from '@/components/Announcements.astro';
import BackToTop from '@/components/BackToTop';
import Analytics from '@/components/Analytics.astro';
import { Toaster } from '@/components/ui/sonner';
import '@/styles/globals.css';
// Starwind UI CSS — accordion keyframes + @theme inline for new semantic tokens.
// Imported AFTER globals.css so the brand :root declarations in globals.css win
// the cascade over starwind.css's fallback :root defaults.
import '@/styles/starwind.css';

interface Props {
  title: string;
  description: string;
  /** Explicit share image URL. Wins over everything, including the generated card. Leave it unset to get the page's generated card at /og/&lt;route&gt;.png. */
  ogImage?: string;
  /**
   * What the generated share card says and shows (design F "the cover",
   * 2026-09-30; src/lib/og-card.ts decides the rest). All optional:
   * `kind` (which page this is: decides the big label, the fact, the object,
   * the colour, and whether the photo is Staci or a room; unset = a custom
   * page), `label` (overrides the big line; custom pages pass their nav label),
   * `headline` (a custom page's last-resort label), `title` (a project's title),
   * `line` (a short line of the page's own copy), `list` + `listHeading` (a
   * checklist, e.g. the FAQ's topics), `role` (the small line on Staci's name
   * tag), `image` (the page's own photo, used when the card shows a room).
   * Staci's portrait is picked at build time from src/data/card-portraits.mjs.
   */
  card?: CardInput & { image?: any };
  /** Raw Sanity image object for a per-page social share override (seoImage on the page singleton). Resolved through the Sanity image pipeline to a 1200x630 OG URL. Lower priority than ogImage, higher than the siteSettings default. */
  seoImage?: any;
  /** Pre-serialized JSON-LD strings injected into <head>. LocalBusiness is auto-injected from siteSettings on every page; pass per-page schemas (Service, FAQPage, BreadcrumbList, CreativeWork) here. */
  schemas?: string[];
  /** Sanity siteSettings document — drives footer, header, and the LocalBusiness schema. */
  siteSettings?: any;
  /** When true, emit <meta name="robots" content="noindex, follow">. Used by the 404 page so it never gets indexed. Defaults to false (the page is indexable). */
  noindex?: boolean;
  /** OG type. Defaults to 'website'. Pass 'article' for a dated article-style page (none today). */
  ogType?: 'website' | 'article';
  /** Article-specific OG metadata. Only used when ogType is 'article'. */
  ogArticle?: {
    publishedAt?: string;
    author?: string;
  };
}

const {
  title,
  description,
  ogImage,
  card,
  seoImage,
  schemas = [],
  siteSettings = null,
  noindex = false,
  ogType = 'website',
  ogArticle,
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, site.url).toString();

// Custom pages Staci flagged for the menu/footer. Fetched here once so every
// page's Header + Footer can surface them without each page threading the data.
// No .catch (2026-09-29, PORTS.md card 56): BaseLayout only renders at build
// time, and a failed read there must fail the build rather than ship every
// page with the custom pages missing from the menu. Dev still degrades to []
// inside sanityFetch.
const navPages = await getNavPages();

// Announcements Staci posts in the Studio (bar / popup). One memoized query per
// build; Announcements.astro picks the ones that belong on this page and renders
// nothing at all when there are none. A failed read throws in a production
// build via sanityFetch (cards 55 + 56), like every other build-time read.
const announcements = await getAnnouncements();

// Resolve a raw Sanity image object to a 1200x630 OG URL through the image
// pipeline. Returns null when there's no asset (so the ?? chain falls through
// to the next source) or if the URL builder throws on a malformed object.
function ogUrlFromImage(img: any): string | null {
  if (!img?.asset) return null;
  try { return urlFor(img).width(1200).height(630).fit('crop').auto('format').url(); } catch { return null; }
}
// The plain CDN URL of a photo, for the card builder to crop itself.
function cardPhoto(img: any): CardPhoto | null {
  if (!img?.asset) return null;
  try { return { src: urlFor(img).url(), hotspot: img.hotspot ?? null }; } catch { return null; }
}

// SHARE CARD (2026-09-29; design F "the cover" since 2026-09-30). Priority:
//   1. `ogImage` prop: a page that deliberately supplies its own share image.
//   2. `seoImage`: the per-page override Staci sets in that page's SEO tab.
//   3. The generated card at /og/<route>.png, drawn after the build by
//      src/integrations/og-cards.ts from the card spec emitted below.
//   4. siteSettings.seoImage, then /og-default.png: ONLY for pages that get no
//      card (noindex pages such as the 404), and as the image copied into a
//      card's place if that card fails to draw. The global value deliberately
//      does NOT override the generated cards: before 2026-09-29 it sat above
//      them, so setting one site-wide photo would have hidden every page's card.
const perPageOg = ogUrlFromImage(seoImage);
const globalOg = ogUrlFromImage(siteSettings?.seoImage);
const fallbackOg = globalOg ?? site.assets.ogDefault;
const explicitOg = ogImage ?? perPageOg;
const wantsCard = !explicitOg && !noindex;

let cardSpec: CardSpec | null = null;
if (wantsCard) {
  // The same facts the header price tag and the footer index print (memoized:
  // one Sanity read per build). A failed read throws in a production build,
  // like every other static read (CLAUDE.md rule 9).
  const facts = resolveChromeFacts(await getChromeFacts());
  const { warnings, ...content } = cardContent(card ?? {}, {
    facts,
    city: siteSettings?.city,
    serviceRegion: siteSettings?.serviceRegion,
    owner: site.owner,
    seoTitle: title,
  });
  cardSpec = {
    v: 2,
    out: ogCardPath(Astro.url.pathname),
    route: Astro.url.pathname,
    ...content,
    photos: [cardPhoto(card?.image)].filter((p): p is CardPhoto => !!p),
    doodle: doodlesForPage(Astro.url.pathname, 1)[0] ?? 'olive-sprig',
    fallback: globalOg,
    warnings,
  };
}
const resolvedOg = explicitOg ?? cardSpec?.out ?? fallbackOg;
const absOg = resolvedOg.startsWith('http') ? resolvedOg : new URL(resolvedOg, site.url).toString();

// Build the document title. If the editor-supplied seoTitle already contains
// the brand anywhere (e.g. "Reid Design LLC — Plainfield Interior Design" or
// "About Staci · Reid Design"), use it verbatim. Otherwise append " — Reid
// Design LLC" so the tab + search-result line carries the brand. Strips a
// trailing " — Reid Design LLC" once before evaluating so any legacy
// pre-baked suffix is handled. The looser brand check (matches "Reid Design"
// not just "Reid Design LLC") catches the most common editor abbreviation
// without producing duplicates.
const brandSuffix = ` — ${site.name}`;
const cleanTitle = title.endsWith(brandSuffix)
  ? title.slice(0, -brandSuffix.length)
  : title;
const brandRoot = 'Reid Design'; // base brand match for de-duplication
const hasBrandInline = cleanTitle.toLowerCase().includes(brandRoot.toLowerCase());
const fullTitle = cleanTitle === site.name || hasBrandInline
  ? cleanTitle
  : `${cleanTitle} — ${site.name}`;

// Alt text for the social-share image. Prefer the per-page seoImage's alt, then
// the site default's alt, falling back to the page title. Describes the visible
// image for assistive tech and link unfurls, instead of repeating the title.
const ogImageAlt = seoImage?.alt ?? siteSettings?.seoImage?.alt ?? fullTitle;

// Auto-inject LocalBusiness on every page when siteSettings is available.
// Pages can still pass their own additional schemas (Service, FAQPage, BreadcrumbList).
const allSchemas = siteSettings ? [localBusinessSchema(siteSettings), ...schemas] : schemas;

// Analytics (GA4 + Cloudflare Web Analytics) lives in src/components/Analytics.astro,
// which owns the environment variables and the conditions (PORTS.md cards 54 + 58).
// Nothing is configured here on purpose: that file is PORTABLE and this layout is
// not. PUBLIC_GA_ID is set ONLY on the production Workers Build; the component also
// refuses to fire off the hostname of `site` in astro.config, which is what stops a
// local .env from filing localhost sessions (it did: 470 of them, 2026-07/08).
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Mobile browser UI chrome color: the Linen page ground. One value since
        the 2026-09-29 rebuild made the site light only. */}
    <meta name="theme-color" content="#F7F3EE" />

    {/* THE ICON SET, all rendered from public/favicon.svg by `npm run favicon`
        (scripts/generate-favicons.mjs, PORTS.md card 47). The .ico answers the
        bare /favicon.ico request every browser makes whether it is linked or
        not; apple-touch-icon is the iOS home screen, which ignores both of the
        others; the manifest carries the Android icons. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Every page's photos come from Sanity's image CDN, and the home hero (the
        LCP element) is one of them, so open that connection while the HTML is
        still parsing. No crossorigin: images are no-cors requests, and a
        crossorigin preconnect would open a second, unused socket. */}
    <link rel="preconnect" href="https://cdn.sanity.io" />

    {/* NO FONT PRELOAD, ON PURPOSE (measured 2026-09-29). A preload of
        Cormorant's latin 400 file IS possible: a Vite `?url` import of
        '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2'
        returns exactly the hashed URL the @fontsource CSS points at (the old
        note here said the hash made it impossible; that was only true of a
        hand-typed path). It was built and measured, and it made things worse:
        on Lighthouse mobile the 23KB font went out at high priority beside the
        stylesheet and the hero photo, both finished about 150ms later, and LCP
        (always the hero PHOTO here, never text) rose by roughly 250-300ms on
        /, /about and /services. What a preload would buy, no reflow when the
        font lands, the metric-matched fallback faces in globals.css already
        buy for free. Revisit only if a page's LCP element becomes text. */}


    {/* (The journal RSS autodiscovery link lived here until the journal was
        removed on 2026-09-30; /journal/rss.xml now redirects home.) */}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {/* Share-card spec: consumed AND REMOVED after the build by
        src/integrations/og-cards.ts, so it never ships. See src/lib/og-card.ts. */}
    {cardSpec && (
      <script is:inline type="application/json" id={CARD_SPEC_ID} set:html={serializeSpec(cardSpec)} />
    )}
    {/* article:* meta — only emitted when a page passes ogType 'article' (none today) */}
    {ogType === 'article' && ogArticle?.publishedAt && (
      <meta property="article:published_time" content={ogArticle.publishedAt} />
    )}
    {ogType === 'article' && ogArticle?.author && (
      <meta property="article:author" content={ogArticle.author} />
    )}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absOg} />

    {/* JSON-LD (LocalBusiness auto-injected from siteSettings + per-page schemas) */}
    {allSchemas.map((json) => (
      <script type="application/ld+json" set:html={json} />
    ))}

    {/* Anti-FOUC theme bootstrap — must run inline before first paint.
        Also re-applies the theme + theme-aware images (header logo) after
        every Astro View Transitions navigation: the transition swap
        replaces <html>'s className with the new page's (empty), so without
        this listener a user who set dark mode would see the next page
        render in light. The listener registers exactly once via the
        __themeBootstrapBound flag. */}
    <script is:inline define:vars={{ key: site.themeStorageKey }}>
      (function () {
        function applyTheme() {
          // LIGHT ONLY since the 2026-09-29 art-direction rebuild (Nathan's
          // call, the FBCM precedent): one fully art-directed theme. The dark
          // tokens in globals.css and this bootstrap stay in place, dormant,
          // so dark mode can come back by restoring the stored-preference
          // read below. A visitor who picked dark before the rebuild gets
          // light; their stored key is left alone.
          const dark = false;
          void key;
          try {
            document.documentElement.classList.toggle('dark', dark);
            document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          } catch (_) { /* localStorage unavailable, default light */ }

          // Theme-aware images (header logo) — swap src/srcset to match the
          // active theme. Single-img approach means only one variant is ever
          // fetched per page load, so Lighthouse doesn't flag the inactive
          // variant as "image larger than displayed."
          const imgs = document.querySelectorAll('img[data-theme-logo]');
          for (let i = 0; i < imgs.length; i++) {
            const img = imgs[i];
            const nextSrc = dark ? img.dataset.logoDarkSrc : img.dataset.logoLightSrc;
            const nextSrcset = dark ? img.dataset.logoDarkSrcset : img.dataset.logoLightSrcset;
            if (nextSrc && img.src !== nextSrc) img.src = nextSrc;
            if (nextSrcset && img.srcset !== nextSrcset) img.srcset = nextSrcset;
          }
        }
        applyTheme();
        if (!window.__themeBootstrapBound) {
          window.__themeBootstrapBound = true;
          // The first applyTheme() runs in <head> before the body is
          // parsed, so theme-aware imgs below the fold (footer logo) don't
          // exist yet and never get their src set. Run once more after the
          // body is in the DOM. (Header logo is handled by its own inline
          // script directly after the img, so it's already set by here.)
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', applyTheme, { once: true });
          }
          // View Transitions: html className gets reset on every swap, so
          // re-apply the persisted theme after each navigation.
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>

    {/* GA4 + Cloudflare Web Analytics. See Analytics.astro. */}
    <Analytics />

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to main content</a>

    <Announcements announcements={announcements} currentPath={Astro.url.pathname} />

    <Header siteSettings={siteSettings} navPages={navPages} />

    {/* data-pagefind-body: site search (Pagefind) indexes ONLY the text inside this
        element, so the header, footer, announcement bar and menus never show up in
        results. noindex pages (404, /search) are left out of the index too. */}
    <main id="main" class="flex-1" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>

    <Footer siteSettings={siteSettings} navPages={navPages} />

    {/*
      Both islands were previously `client:load` which forced the JS to
      execute before the first paint completed. Neither is interactive
      until later in the page lifecycle (BackToTop only appears after the
      visitor scrolls 600px; Toaster only mounts a region, the toast call
      sites import it on demand). Hydrating with `client:idle` lets the
      browser settle the main thread first and shifts ~10–20ms of TBT off
      the critical path on mobile.
    */}
    <BackToTop client:idle />

    {/* Sonner toast region. Used by CopyEmailButton and ContactForm. Position bottom-right by default. */}
    <Toaster client:idle position="bottom-right" />

    {/* Lenis smooth scroll. The reduced-motion guard in globals.css already
        kills smooth-scroll behavior; we also bail out here so we don't pay
        for the Lenis runtime when the user prefers reduced motion.

        Wrapped in requestIdleCallback so the ~10KB Lenis chunk isn't
        fetched until the browser is genuinely idle — keeps it out of the
        critical-path race with hero LCP. setTimeout fallback for browsers
        without rIC support. */}
    <script>
      function startLenis() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // Wheel devices only: a fine pointer at desktop widths (2026-09-29,
        // from presacademy). Touch scrolling is already inertial, so on a
        // phone Lenis only spends main-thread time fighting the browser's own
        // physics, and phones are most of this site's visitors.
        //
        // The navigation scroll reset below (CLAUDE.md rule 5) is still
        // correct without Lenis: it exists ONLY to cancel Lenis's in-flight
        // momentum. With no Lenis, Astro's ClientRouter does the plain job
        // itself (top of page on a link click, restored position on
        // back/forward). tests/scroll-reset.spec.ts pins both paths: a phone
        // (no Lenis) and a desktop mouse (Lenis).
        const wheelDevice =
          window.matchMedia('(pointer: fine)').matches &&
          window.matchMedia('(min-width: 1024px)').matches;
        if (!wheelDevice) return;
        import('lenis').then(({ default: Lenis }) => {
          // wheelMultiplier > 1 makes each wheel/trackpad notch cover more
          // distance (default 1), so scrolling feels faster. lerp is separate:
          // it controls how fast the smoothed position catches the target
          // (higher = snappier and settles sooner, lower = more glide).
          const lenis = new Lenis({ smoothWheel: true, lerp: 0.1, wheelMultiplier: 1.4 });
          // Expose the instance so in-page controls (e.g. the homepage hero
          // scroll cue) can trigger a smooth programmatic scroll through Lenis
          // instead of fighting it with a native scrollTo.
          (window as unknown as { lenis?: typeof lenis }).lenis = lenis;
          function raf(time: number) { lenis.raf(time); requestAnimationFrame(raf); }
          requestAnimationFrame(raf);

          // Astro View Transitions reuse this single Lenis instance across
          // navigations. If a link is clicked mid-scroll, Lenis is still
          // smoothing toward the PREVIOUS page's scroll target and, while it is
          // smoothing, it ignores the router's scroll-to-top reset. The new
          // (often shorter) page then inherits that stale target, clamped to
          // its own maximum, so it opens at the bottom.
          //
          // Fix: on a forward navigation (a link/button click, navigationType
          // "push" or "replace") snap Lenis to the top instantly, which kills
          // the in-flight momentum and cancels any active scrollTo animation.
          // On history traversal (browser back/forward, navigationType
          // "traverse") leave the scroll position alone so the browser's scroll
          // restoration still works. navigationType is only carried on the
          // before-swap event, so capture it there and read it in after-swap.
          // resize() re-reads the new page's scroll height either way.
          let lastNavType = 'push';
          document.addEventListener('astro:before-swap', (e) => {
            lastNavType = (e as any).navigationType;
          });
          document.addEventListener('astro:after-swap', () => {
            if (lastNavType !== 'traverse') {
              lenis.scrollTo(0, { immediate: true, force: true });
            }
            lenis.resize();
          });
        });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(startLenis, { timeout: 2000 });
      } else {
        setTimeout(startLenis, 1500);
      }
    </script>

    {/* Polish layer: scroll-triggered reveal observer + sticky-header
        hide-on-scroll-down behavior. Both honor prefers-reduced-motion.
        Re-init on astro:page-load so they survive View Transitions. */}
    <script>
      function initPolish() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ---- Scroll reveals ---------------------------------------------
        // Mark elements visible the moment they cross the viewport edge so
        // the fade-up reads as the user scrolls toward them, not after.
        const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (reveals.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            // No motion / no observer support: just show everything immediately.
            reveals.forEach((el) => el.classList.add('is-visible'));
          } else {
            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
            );
            reveals.forEach((el) => observer.observe(el));
          }
        }

        // ---- Grid stagger entrance ------------------------------------------
        // Adds .is-staggered to each [data-stagger-grid] container as it enters
        // the viewport. The CSS transition-delay on nth-child handles sequencing.
        const staggerGrids = document.querySelectorAll<HTMLElement>('[data-stagger-grid]:not(.is-staggered)');
        if (staggerGrids.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            staggerGrids.forEach((el) => el.classList.add('is-staggered'));
          } else {
            const staggerObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-staggered');
                    staggerObserver.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -60px 0px', threshold: 0.05 },
            );
            staggerGrids.forEach((el) => staggerObserver.observe(el));
          }
        }

        // ---- Image curtain reveal -------------------------------------------
        // Adds .is-revealed to each .img-curtain when it enters the viewport.
        // Under reduced-motion, CSS hides curtains entirely so this loop is moot.
        const curtains = document.querySelectorAll<HTMLElement>('.img-curtain:not(.is-revealed)');
        if (curtains.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            curtains.forEach((el) => el.classList.add('is-revealed'));
          } else {
            const curtainObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-revealed');
                    curtainObserver.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -80px 0px', threshold: 0.1 },
            );
            curtains.forEach((el) => curtainObserver.observe(el));
          }
        }

        // ---- Process connector lines ----------------------------------------
        // Adds .is-visible to each .step-connector when it enters the viewport,
        // triggering the scaleY draw animation on the ::after fill.
        const connectors = document.querySelectorAll<HTMLElement>('.step-connector:not(.is-visible)');
        if (connectors.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            connectors.forEach((el) => el.classList.add('is-visible'));
          } else {
            const connectorObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    connectorObserver.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -60px 0px', threshold: 0.05 },
            );
            connectors.forEach((el) => connectorObserver.observe(el));
          }
        }

        // ---- Sticky header: condense on scroll ---------------------------
        // The header (.site-header, position: sticky) rests as a bare row with
        // the hanging logo, and condenses into a floating paper strip once the
        // page moves (the swatch book chrome, 2026-09-30). This only toggles a
        // data-scrolled attribute; Header.astro's CSS does the rest inside a
        // fixed-height box, so nothing reflows. It used to hide the header on
        // scroll-down; the condensed strip is small enough to stay.
        // Re-queried on every page load: the header is swapped by View
        // Transitions, and a reload mid-page must start condensed.
        const header = document.querySelector<HTMLElement>('.site-header');
        if (header) {
          const sync = () => {
            header.toggleAttribute('data-scrolled', window.scrollY > 8);
          };
          sync();
          const w = window as typeof window & { __hdrScrollBound?: boolean };
          if (!w.__hdrScrollBound) {
            w.__hdrScrollBound = true;
            let ticking = false;
            window.addEventListener(
              'scroll',
              () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                  document
                    .querySelector<HTMLElement>('.site-header')
                    ?.toggleAttribute('data-scrolled', window.scrollY > 8);
                  ticking = false;
                });
              },
              { passive: true },
            );
          }
        }
      }

      // Run on first load and after every View Transitions navigation.
      initPolish();
      document.addEventListener('astro:page-load', initPolish);
    </script>

    {/* Ambient doodles (2026-09-30): one faint ink doodle in a corner of each
        content section, drawn in as it scrolls into view. See the script. */}
    <script>
      import { initAmbientDoodles } from '@/scripts/ambient-doodles';
      initAmbientDoodles();
      document.addEventListener('astro:page-load', initAmbientDoodles);
    </script>
  </body>
</html>
