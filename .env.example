# Copy this file to `.env` and fill in real values for local dev.
# In production these are set in Cloudflare → Workers & Pages → Reid Design → Settings → Variables.
#
# BUILD-TIME ONLY. Everything here is read while `astro build` runs and inlined
# by Vite. The live-preview stack (/preview/*, /api/draft-mode/*) needs a Worker
# RUNTIME secret instead, which lives in `.dev.vars` locally and behind
# `npx wrangler secret put SANITY_TOKEN` in production. See `.dev.vars.example`.
#
# The embedded Studio at /studio reads PUBLIC_SANITY_PROJECT_ID /
# PUBLIC_SANITY_DATASET from here too (see astro.config.mjs and
# src/sanity/urls.ts), so a build with these unset serves a Studio that cannot
# find its project.

# Sanity — required for any page that fetches content
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-05-01

# REQUIRED. Despite the dataset being marked Public in Sanity Manage, anonymous
# API queries against this project only return the page singletons — every
# collection (service, testimonial, processStep, philosophyPoint, faqItem, project)
# comes back empty. The token bypasses that filter so build-time reads see
# everything. Create at https://sanity.io/manage/project/<projectId>/api/tokens
# with Viewer (read-only) permission. Mark as Secret in Cloudflare.
SANITY_API_READ_TOKEN=

# Contact form — without this the form falls back to a no-op + inline notice
PUBLIC_WEB3FORMS_KEY=

# Scheduling — Staci's Calendly public scheduling URL
# Find it in Calendly → Event Types → Share link
PUBLIC_CALENDLY_URL=

# Google Analytics — without this the gtag snippet doesn't render. Leave it EMPTY
# locally: production sets it on Cloudflare Workers Builds. (The snippet also
# refuses to fire off the host of `site` in astro.config, but there is no reason to build it in.)
PUBLIC_GA_ID=

# Cloudflare Web Analytics — without this the beacon doesn't render
PUBLIC_CF_ANALYTICS_TOKEN=

# Newsletter: RETIRED 2026-09-30. The footer signup, the lead-magnet and quiz email
# gates and src/lib/subscribe.ts were removed, so PUBLIC_NEWSLETTER_FORM_ACTION and
# NEWSLETTER_API_KEY are no longer read by anything. Delete them from any local .env
# and from the Workers Build environment if they were ever set there.

# Instagram feed (2026-09-30). The long-lived Instagram token; production sets it
# as a SECRET build variable on the Workers Build (docs/agent/deployment.md,
# "Instagram feed"). Leave it EMPTY locally unless you want the real feed under
# `npm run dev`: without it the feed renders nothing. To see the populated state
# without a token, run `INSTAGRAM_FIXTURE_DIR=<folder of .jpg files> npm run dev`.
INSTAGRAM_TOKEN=
