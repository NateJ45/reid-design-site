# Hand-written rules. Cloudflare Workers Static Assets reads this file; it is never served.
#
# @astrojs/cloudflare APPENDS the editor-managed redirects (Studio -> Pages -> Redirects,
# read at build time in astro.config.mjs) BELOW these lines in dist/client/_redirects, so
# a rule here is listed first. Keep this file to rules the Studio cannot express.
#
# Studio deep links (2026-09-29). The Studio is one prerendered page at /studio/ that
# routes on the URL hash (/studio/#/structure/pages). A PATH-style link such as
# /studio/structure/pages, /studio/media or /studio/intent/edit/... has no file behind it
# and used to answer the site's 404 page, in production too. This 200 proxies every
# /studio/* path to the Studio shell (the address bar keeps the typed path, and the
# /studio/* Content-Security-Policy in _headers still applies). The shell then moves the
# path into the hash before the Studio starts: src/sanity/lib/studio-deep-link.ts.
# The unit test in that folder pins this exact line.
/studio/* /studio/ 200

# Retired sections (2026-09-30). Eight sections that were built but never launched were
# removed from the site and the Studio: the journal, shop, style quiz, budget calculator,
# guides, press, gift certificates and resources hub. None was ever linked publicly, but
# an address may be bookmarked or indexed from the Squarespace days, so each one forwards
# permanently to the closest page that still exists. Both the bare and the trailing-slash
# form are listed so the match never depends on how the visitor typed it. These eight
# slugs also stay RESERVED against custom pages (src/sanity/preview-routes.ts), because a
# rule here would win over a page at the same address. Pinned by
# src/lib/retired-redirects.test.ts.
/journal / 301
/journal/ / 301
/journal/* / 301
/shop / 301
/shop/ / 301
/quiz /services/ 301
/quiz/ /services/ 301
/calculator /services/ 301
/calculator/ /services/ 301
/guides / 301
/guides/ / 301
/guides/* / 301
/press /about/ 301
/press/ /about/ 301
/gift-certificates /contact/ 301
/gift-certificates/ /contact/ 301
/resources /faq/ 301
/resources/ /faq/ 301

# Before & After page removed 2026-10-02 (Nathan's call). The sliders still live on each
# project page; the standalone gallery is gone.
/portfolio/before-after /portfolio/ 301
/portfolio/before-after/ /portfolio/ 301
