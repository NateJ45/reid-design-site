{
  "name": "reid-design-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "astro build",
    "free-dist": "node scripts/free-dist.mjs",
    "build:full": "npm run typegen && astro build",
    "preview": "wrangler dev",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "generate-types": "wrangler types",
    "typegen": "npm --prefix studio run typegen",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "studio:import": "node scripts/import-content.mjs",
    "check": "npm run typegen && astro build && npm --prefix studio run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "parity": "node scripts/page-parity.mjs",
    "sync-check": "node scripts/sync-check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.4.0",
    "@sanity/image-url": "^2.1.1",
    "@tabler/icons": "^3.46.0",
    "@tabler/icons-react": "^3.46.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "primereact": "^10.9.8",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-photo-album": "^3.6.1",
    "shadcn": "^4.19.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.95.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "http-server": "^14.1.1",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
