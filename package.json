{
  "name": "reid-design-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs && node scripts/fetch-instagram.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs && node scripts/fetch-fonts.mjs && node scripts/fetch-instagram.mjs",
    "build": "node scripts/with-workerd.mjs astro build",
    "postbuild": "pagefind --site dist/client",
    "free-dist": "node scripts/free-dist.mjs",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "favicon": "node scripts/generate-favicons.mjs",
    "og:cards": "node scripts/og-cards.mjs",
    "room:generate": "npm --prefix tools/room-lab run generate --",
    "room:grade": "npm --prefix tools/room-lab run grade --",
    "room:candidates": "npm --prefix tools/room-lab run candidates --",
    "room:relock": "npm --prefix tools/room-lab run relock --",
    "room:walls": "npm --prefix tools/room-lab run walls --",
    "room:wall": "npm --prefix tools/room-lab run wall --",
    "room:layers": "npm --prefix tools/room-lab run layers --",
    "room:sheet": "npm --prefix tools/room-lab run sheet --",
    "room:preview": "npm --prefix tools/room-lab run preview --",
    "room:publish": "npm --prefix tools/room-lab run publish --",
    "doodles": "node scripts/generate-doodles.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:import": "node scripts/import-content.mjs",
    "check": "astro check && npm run lint",
    "check:full": "npm run typegen && npm run build && npm run test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run && npm run test:kit && npm run test:scripts",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:unit:watch": "vitest",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "check:links": "linkinator ./dist/client --recurse --skip \"^https?://(?!127[.]0[.]0[.]1)\" --skip \"/studio\" --skip \"/preview\" --skip \"/api/\"",
    "parity": "node scripts/page-parity.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "audit:data": "node scripts/audit-data-vs-schema.mjs",
    "fonts:update": "node scripts/fetch-fonts.mjs --update",
    "instagram:fetch": "node scripts/fetch-instagram.mjs",
    "test:kit": "node --experimental-strip-types --test src/lib/studio-*.test.ts src/lib/deploy-status.test.ts src/lib/preview-share.test.ts src/lib/custom-code.test.ts src/lib/photo-post.test.ts src/lib/earlier-versions.test.ts src/lib/guide-shots.test.ts",
    "restore:doc": "node scripts/restore-doc.mjs",
    "studio:banner": "node scripts/gen-studio-banner.mjs",
    "thumbnails": "node scripts/shoot-section-thumbnails.mjs",
    "seed:patterns": "node scripts/content/seed-section-patterns.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/pinyon-script": "^5.2.8",
    "@fontsource/source-sans-3": "5.3.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@resvg/resvg-js": "2.6.2",
    "@sanity/astro": "3.5.1",
    "@sanity/client": "8.9.0",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "2.0.28",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/ui": "4.4.9",
    "@sanity/vision": "6.19.0",
    "@sanity/visual-editing": "6.1.3",
    "@tabler/icons": "^3.49.0",
    "@tabler/icons-react": "^3.49.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.2.0",
    "next-themes": "^0.4.6",
    "primereact": "^10.9.8",
    "radix-ui": "^1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-photo-album": "^3.6.0",
    "sanity": "6.19.0",
    "sanity-plugin-asset-source-unsplash": "7.0.29",
    "sanity-plugin-media": "6.3.5",
    "satori": "0.47.1",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "styled-components": "6.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.129.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "comment:overrides": "2026-08-28, versions refreshed 2026-09-06. (1) The old `vite: ^7` override was REMOVED with the Astro 7 upgrade. Astro 7.2.9 peers vite ^8.0.13 and its static build calls vite.createBuilder(); pinned to 7.3.3 the build got through the client bundle and then died on 'Could not find the prerender entry point in the build output. This is likely a bug in Astro.' It is not a bug in Astro, it is a silently-downgraded vite. Check Astro's peer range before ever pinning vite again. (2) The two entries below are load-bearing, not cosmetic: a PLAIN dependency pin is proven insufficient because npm will happily nest a newer copy under a dependant. sanity-plugin-utils defaults to 2.0.17, which drags in @sanity/ui v4; @sanity/astro depends on @sanity/visual-editing by caret range and nests a newer copy under @sanity/astro/node_modules, which drags a second @sanity/ui in with it. Either one breaks the one-@sanity/ui-instance invariant that keeps the styled-components theme context alive (PORTS.md card 10). Verify on DISK after any Sanity dependency work, not in the install output: `Get-ChildItem -Recurse node_modules -Filter package.json | Where-Object FullName -like '*@sanity\\ui\\package.json'` must print exactly one line.",
  "overrides": {
    "sanity-plugin-utils": "2.0.22",
    "@sanity/visual-editing": "6.1.3",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.1",
      "smol-toml": "^1.6.1"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "opentype.js": "^2.0.0",
    "pagefind": "1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
